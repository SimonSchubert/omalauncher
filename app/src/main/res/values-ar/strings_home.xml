    <string name="home_widget_needs_linux">بحاجة إلى Linux</string>
    <string name="home_widget_needs_linux_text">تشغّل أوامر في Arch Linux الاختياري</string>
    <string name="home_widget_linux_stopped">نظام Linux متوقف</string>
    <string name="home_start_linux">تشغيل</string>

    <!-- A terminal tile whose terminal isn't showing. -->
    <string name="home_terminal_starting">جارٍ التشغيل…</string>
    <string name="home_terminal_exited">انتهت · انقر لإعادة التشغيل</string>

    <!-- The prompt bar's hint on the side rail in landscape, the longest that fits. %1$s is an agent's command, like "claude". -->
    <string name="home_prompt_hint_agent">افتح تطبيقا أو اسأل ⁨%1$s⁩</string>
    <string name="home_prompt_hint">افتح تطبيقا</string>
    <string name="home_prompt_hint_short">التطبيقات</string>

    <!-- What screen readers say for a folder on home. %1$s is its name. -->
    <string name="home_folder_named">مجلد ⁨%1$s⁩</string>
    <string name="home_app_has_notifications">⁨%1$s⁩، توجد إشعارات</string>
    <string name="home_folder">مجلد</string>
