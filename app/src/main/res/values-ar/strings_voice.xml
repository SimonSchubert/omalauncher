    <string name="voice_stopped">توقف ⁨%1$s⁩: ⁨%2$s⁩</string>
    <string name="voice_nothing_to_say">لم يكن في رد ⁨%1$s⁩ ما يقال</string>
    <string name="voice_no_answer">لا رد من ⁨%1$s⁩ بعد؛ ربما استنفد حصته أو لم يسجل الدخول</string>
    <string name="voice_quiet">لم يصدر عن ⁨%1$s⁩ شيء منذ دقيقتين؛ أوقفه إن كان عالقا</string>
    <string name="voice_offline">لا اتصال بالإنترنت: لن يرد ⁨%1$s⁩ حتى يتصل الهاتف</string>
    <!-- When the agent gave no reason for a failure. -->
    <string name="voice_failed">فشل</string>
    <!-- %1$s is the agent's error, like a network error. -->
    <string name="voice_retrying">جارٍ إعادة المحاولة: ⁨%1$s⁩</string>
