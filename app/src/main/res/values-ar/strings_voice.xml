    <string name="voice_recognition_phone">خدمة الهاتف</string>
    <string name="voice_recognition_parakeet">⁨Parakeet⁩، على هذا الهاتف</string>
    <string name="voice_parakeet_about">يتعرف Parakeet على الكلام على هذا الهاتف نفسه: بلا إنترنت، وبلا صفير، وفي 25 لغة أوروبية. حجم التنزيل ⁨%1$s⁩.</string>
    <string name="voice_parakeet_download">تنزيل</string>
    <string name="voice_parakeet_mobile_data">أنت تستخدم بيانات الجوال</string>
    <!-- Download progress: %1$s and %2$s are sizes, like 312 MB of 670 MB. -->
    <string name="voice_parakeet_progress">⁨%1$s⁩ من ⁨%2$s⁩</string>
    <string name="voice_parakeet_checking">جارٍ فحص التنزيل…</string>
    <string name="voice_parakeet_cancel">إلغاء</string>
    <string name="voice_parakeet_delete">حذف Parakeet · ⁨%1$s⁩</string>
    <string name="voice_parakeet_failed">توقف التنزيل: ⁨%1$s⁩</string>
    <string name="voice_parakeet_space">المساحة لا تكفي: يلزم ⁨%1$s⁩ إضافية</string>
    <string name="voice_parakeet_damaged">تلف التنزيل؛ أعد المحاولة</string>
    <!-- %1$s is a language name, like Japanese. -->
    <string name="voice_parakeet_language">لا يعرف Parakeet اللغة ⁨%1$s⁩: تستمع خدمة الهاتف بدلا منه.</string>
    <!-- Reading aloud in the voice settings: the phone's text-to-speech, or Supertonic, downloaded on request. -->
    <string name="voice_reading">القراءة الصوتية</string>
    <string name="voice_reading_phone">تحويل النص إلى كلام في الهاتف</string>
    <string name="voice_reading_supertonic">⁨Supertonic⁩، على هذا الهاتف</string>
    <string name="voice_supertonic_about">يقرأ Supertonic الردود بصوت مسموع على هذا الهاتف نفسه: بلا إنترنت، وبأصوات طبيعية، وفي 31 لغة. حجم التنزيل ⁨%1$s⁩.</string>
    <string name="voice_supertonic_delete">حذف Supertonic · ⁨%1$s⁩</string>
    <!-- %1$s is a language name, like Chinese. -->
    <string name="voice_supertonic_language">لا يعرف Supertonic اللغة ⁨%1$s⁩: تقرأ خدمة تحويل النص إلى كلام في الهاتف بدلا منه.</string>
    <!-- Supertonic's voices, numbered: female 1 to 5, male 1 to 5. -->
    <string name="voice_female">صوت نسائي %1$d</string>
    <string name="voice_male">صوت رجالي %1$d</string>
    <!-- In the voice settings: how long a pause in speech sends it to the agent; off means only a tap on the orb does. -->
    <string name="voice_send_after">الإرسال بعد صمت</string>
    <string name="voice_send_after_off">إيقاف</string>
    <!-- A number of seconds, short: 2 s. -->
    <string name="voice_seconds">%1$d ث</string>
    <!-- Under the orb while the agent waits for the answer to a question it asked; %1$s is the time it has been working. -->
    <string name="voice_needs_answer">بانتظار إجابتك · ⁨%1$s⁩</string>
    <string name="voice_your_answer">إجابتك</string>
    <!-- Above a question the agent asks the user; %1$s is the agent, like Hermes. -->
    <string name="voice_asks">يسأل ⁨%1$s⁩</string>
    <!-- Answers the agent's question with nothing. -->
    <string name="voice_skip">تخطي</string>
    <string name="voice_skipped">تم تخطي السؤال</string>
    <string name="voice_or_type_answer">أو اكتب إجابتك أنت</string>
    <string name="voice_or_say_answer">أو انقر على الدائرة وقل إجابتك</string>
    <!-- Said aloud after a question the agent asks; %1$s is its choices, separated by commas. -->
    <string name="voice_say_choices">الخيارات: ⁨%1$s⁩.</string>
    <!-- In the conversation when Voice was opened to change a widget or app; %1$s is its name. -->
    <string name="voice_note_edit">تعديل ⁨%1$s⁩ · قل ما تريد تغييره</string>
    <!-- The button by the controls that adds a picture or what's copied to the next message, said or typed. -->
    <string name="voice_attach">إرفاق صورة أو محتوى الحافظة</string>
    <!-- Its two choices: one from the phone's photos, or what's on the clipboard. -->
    <string name="voice_attach_picture">صورة</string>
    <string name="voice_attach_paste">لصق</string>
    <string name="voice_attach_failed">تعذر إرفاق هذه الصورة</string>
    <!-- Takes a picture or pasted text off the message before it's sent. -->
    <string name="voice_detach">إزالة</string>
</resources>
