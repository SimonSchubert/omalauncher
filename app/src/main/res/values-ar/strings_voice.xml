<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="voice_listening">جارٍ الاستماع · انقر للإرسال</string>
    <string name="voice_listening_working">جارٍ الاستماع · العمل مستمر</string>
    <!-- Under the orb right after a tap, while on-device speech recognition loads: what's said is kept. -->
    <string name="voice_listening_preparing">قيد التحضير · يمكنك التحدث من الآن</string>
    <string name="voice_starting">جارٍ التشغيل</string>
    <!-- Under the orb while an agent waits for an OK; %1$s is the time it has been working, like 0:12. -->
    <string name="voice_needs_ok">بانتظار موافقتك · ⁨%1$s⁩</string>
    <string name="voice_working">يعمل · ⁨%1$s⁩</string>
    <!-- Under the orb while a reply is read aloud: a tap talks over it. -->
    <string name="voice_tap_over">انقر للتحدث ومقاطعته</string>
    <string name="voice_tap">انقر للتحدث</string>
    <!-- A toggle: every question the agent asks is answered yes. -->
    <string name="voice_allow_all">السماح بالكل</string>
    <!-- Starts a new conversation; the last one can be resumed. -->
    <string name="voice_new">جديدة</string>
    <!-- Brings back the last conversation. -->
    <string name="voice_resume">استئناف</string>
    <string name="voice_no_speech">يحتاج «الصوت» إلى خدمة للتعرف على الكلام، ولا توجد واحدة على هذا الهاتف. ثبّت خدمة مثل Speech Recognition &amp; Synthesis من Google، واخترها في إعدادات الإدخال الصوتي في Android. أو اكتب بدلا من ذلك.</string>
    <string name="voice_input_settings">الإدخال الصوتي</string>
    <!-- Switches from talking to typing. -->
    <string name="voice_type">كتابة</string>
    <string name="voice_no_agent">يتحدث «الصوت» مع وكيل برمجة في Linux. ثبّت وكيلا لتتحدث معه.</string>
    <string name="voice_agents">الوكلاء</string>
    <string name="voice_log_in">تسجيل الدخول</string>
    <string name="voice_thinking">يفكر</string>
    <plurals name="voice_steps">
        <item quantity="zero">لا خطوات</item>
        <item quantity="one">خطوة واحدة</item>
        <item quantity="two">خطوتان</item>
        <item quantity="few">%1$d خطوات</item>
        <item quantity="many">%1$d خطوة</item>
        <item quantity="other">%1$d خطوة</item>
    </plurals>
    <!-- The text field's hint; %1$s is the agent, like Claude Code. -->
    <string name="voice_message">رسالة إلى ⁨%1$s⁩</string>
    <string name="voice_answer_hint">نعم، أو لا، أو ما تريده بدلا من ذلك</string>
    <string name="voice_send">إرسال</string>
    <string name="voice_erase">مسح ما قلته</string>
    <string name="voice_stop">إيقاف</string>
    <!-- The approval card; %1$s is the agent, %2$s what it wants to do (a voice_do_ phrase, like "run a command"). -->
    <string name="voice_wants">يريد ⁨%1$s⁩ %2$s</string>
    <string name="voice_allow">سماح</string>
    <string name="voice_always">دائما</string>
    <string name="voice_deny">رفض</string>
    <string name="voice_or_type">أو اكتب نعم، أو لا، أو ما تريده بدلا من ذلك</string>
    <string name="voice_or_say">أو انقر على الدائرة وقل نعم، أو لا، أو ما تريده بدلا من ذلك</string>
    <!-- Under a picture shown whole. -->
    <string name="voice_tap_close">انقر للإغلاق</string>
    <!-- Steps of a task, shown as they happen. %1$s is a command's description or the command. -->
    <string name="voice_step_run">تشغيل: ⁨%1$s⁩</string>
