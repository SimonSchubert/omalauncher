    <string name="voice_do_write">كتابة ⁨%1$s⁩</string>
    <string name="voice_do_edit">تعديل ⁨%1$s⁩</string>
    <string name="voice_do_delete">حذف ⁨%1$s⁩</string>
    <string name="voice_do_search">البحث عن ⁨%1$s⁩</string>
    <string name="voice_do_web">البحث في الويب عن ⁨%1$s⁩</string>
