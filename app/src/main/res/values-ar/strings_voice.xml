    <string name="voice_step_search">البحث عن ⁨%1$s⁩</string>
    <string name="voice_step_web">البحث في الويب: ⁨%1$s⁩</string>
    <string name="voice_step_subtask">مهمة فرعية: ⁨%1$s⁩</string>
    <string name="voice_step_plan">التخطيط</string>
