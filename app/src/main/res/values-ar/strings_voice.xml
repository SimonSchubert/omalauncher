    <string name="voice_voice">الصوت</string>
    <string name="voice_language">اللغة</string>
    <!-- The language picked in the launcher, which Voice uses unless another is picked; %1$s is its name. -->
    <string name="voice_language_launcher">الافتراضية (⁨%1$s⁩)</string>
    <string name="voice_default">الافتراضي</string>
    <string name="voice_default_named">الافتراضي (⁨%1$s⁩)</string>
    <!-- After a voice that needs the internet. -->
    <string name="voice_online">عبر الإنترنت</string>
    <string name="voice_speed">السرعة</string>
    <string name="voice_tts_settings">إعدادات تحويل النص إلى كلام</string>
    <string name="voice_no_voice">لا يوجد صوت للغة ⁨%1$s⁩ على هذا الهاتف بعد: نزّل واحدا من إعدادات تحويل النص إلى كلام.</string>
    <string name="voice_sample">هكذا سيكون صوت الردود.</string>
