    <string name="voice_say_failed">عذرا، لم ينجح ذلك.</string>
    <!-- In place of the agent's name when there is none. -->
    <string name="voice_the_agent">الوكيل</string>
    <!-- Notes in the conversation, lower case. -->
    <string name="voice_note_allow_all">السماح بكل ما يطلبه ⁨%1$s⁩</string>
    <string name="voice_note_ask_again">العودة إلى السؤال قبل كل إجراء</string>
    <string name="voice_note_task_stopped">أُوقفت المهمة الأخيرة؛ قل «تابع» لإكمالها</string>
    <string name="voice_note_cant_continue">تعذرت متابعة المحادثة الأخيرة؛ هذه محادثة جديدة</string>
