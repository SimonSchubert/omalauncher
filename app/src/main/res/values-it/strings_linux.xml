    <string name="link_title">collega un dispositivo</string>
    <string name="link_ask">%1$s vuole collegarsi a questo dispositivo</string>
    <string name="link_what">una volta collegato, può elencare, aggiungere, modificare e rimuovere i tuoi widget e tenerli sincronizzati, con i loro valori, il tema e lo sfondo, tramite la rete mentre linux è attivo. nient\'altro su questo dispositivo.</string>
    <string name="link_compare">collegalo solo se %1$s mostra questo codice:</string>
    <string name="link_confirm">collega</string>
    <string name="link_done">collegato. %1$s trova questo dispositivo in pochi secondi se sono sulla stessa rete.</string>
    <string name="link_close">chiudi</string>
    <string name="link_unreadable">questo codice non si può leggere. mostrane uno nuovo: in omarchy, omalauncher nella barra, devices, connect a device.</string>
    <string name="link_needs_linux">collegare un dispositivo richiede linux: installalo nelle impostazioni, poi scansiona di nuovo il codice.</string>
    <string name="link_computers_title">dispositivi collegati</string>
    <string name="link_computers_none">nessuno · collegane uno da omarchy</string>
    <string name="link_computers_listening">raggiungibile in rete · porta %1$d</string>
    <string name="link_computers_waiting">non ancora raggiungibile · lo avvia linux</string>
    <string name="link_unlink">scollega</string>
    <string name="link_computers_about">tieni uguali sui tuoi dispositivi i widget, i loro valori, il tema e lo sfondo. un dispositivo collegato può cambiare widget, tema e sfondo di questo mentre linux è attivo. nient\'altro.</string>
    <string name="link_computers_how">collega un dispositivo</string>
    <string name="link_computers_how_body">un altro telefono: mostra qui un codice e scansionalo con la fotocamera di quel telefono. omarchy: fai clic su omalauncher nella barra, poi devices, poi connect a device, e scansiona quel codice con la fotocamera di questo dispositivo. entrambi sulla stessa rete.</string>
