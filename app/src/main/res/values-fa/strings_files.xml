<?xml version="1.0" encoding="utf-8"?>
<!-- Files (ui/FilesScreen.kt, FilesChrome.kt, FileDialogs.kt), the editor (ui/EditorScreen.kt) and the prompt bar
     with its speech input (ui/PromptBar.kt, ui/Speech.kt). -->
<resources>
    <!-- A file operation failed without saying why. -->
    <string name="files_failed">ناموفق</string>
    <!-- %1$s is a file name. -->
    <string name="files_cant_hand_over">نمی‌توان ⁨%1$s⁩ را به برنامه‌های دیگر داد</string>
    <!-- %1$s is a file name. -->
    <string name="files_no_app">هیچ برنامه‌ای ⁨%1$s⁩ را باز نمی‌کند</string>
    <!-- Why a link can't be opened: its target doesn't exist. Shown as %2$s of files_cant_open. -->
    <string name="files_leads_to_nothing">به هیچ‌جا نمی‌رسد</string>
    <!-- %1$s is a file name, %2$s why it can't be opened. -->
    <string name="files_cant_open">⁨%1$s⁩ باز نمی‌شود: ⁨%2$s⁩</string>
