    <string name="prompt_hint_ask">باز کردن برنامه یا پرسش از ⁨%1$s⁩…</string>
    <!-- Shown after typing: Enter sends the text to the coding agent. -->
    <string name="prompt_enter_ask">⏎ پرسش</string>
