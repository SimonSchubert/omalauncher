    <!-- The first-run screen. -->
    <string name="linux_welcome_title">\u200fomarchy روی صفحه اصلی شما</string>
    <string name="linux_welcome_body">پوسته‌ها و پس‌زمینه‌های Omarchy، برنامه‌های Android شما و ابزارک‌های صفحه اصلی. Arch Linux برنامه‌های ترمینال و عامل‌های برنامه‌نویسی را هم اضافه می‌کند؛ همین حالا یا بعداً در تنظیمات.</string>
    <!-- A section heading, shown in capitals. -->
    <string name="linux_welcome_linux">linux</string>
    <string name="linux_welcome_choice">\u200fArch Linux هم راه‌اندازی شود</string>
    <string name="linux_welcome_choice_detail">برنامه‌های ترمینال، عامل‌ها، pacman · حدود 1 GB بارگیری، 3 GB فضا</string>
    <string name="linux_welcome_start">شروع</string>
    <string name="linux_welcome_start_linux">شروع و راه‌اندازی linux</string>
    <string name="linux_welcome_start_hint">تصویر پس‌زمینه این پوسته همین حالا بارگیری می‌شود و بقیه پوسته‌های Omarchy (حدود 70 MB) بعد از آن، پشت صحنه.</string>
    <string name="linux_welcome_start_linux_hint">\u200fLinux حدود 1 GB بارگیری می‌کند، پس Wi-Fi بهتر است، و 3 GB فضا می‌گیرد. نصب آن در پس‌زمینه 10 تا 20 دقیقه طول می‌کشد؛ صفحه اصلی همان لحظه آماده است.</string>
