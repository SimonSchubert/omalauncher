    <!-- Settings › pages (ui/PagesScreen.kt). -->
    <string name="pages_title">صفحه‌ها</string>
    <string name="pages_intro">صفحه‌های صفحه اصلی، از چپ به راست. برای جابه‌جا کردن، صفحه را با ≡ بکشید، یا با کلیدها ≡ را با Enter بردارید و با کلیدهای جهت‌نما جابه‌جایش کنید. صفحه اصلی روی اولین صفحه‌ای که کاشی دارد باز می‌شود؛ ابزارک‌های تمام‌صفحه پیش از آن، سمت چپش می‌نشینند.</string>
