    <string name="voice_recognition">تشخیص گفتار</string>
    <!-- Which recognizer listens: the phone's own (usually Google's), as opposed to Parakeet. -->
    <string name="voice_recognition_phone">تشخیص گفتار تلفن</string>
    <string name="voice_recognition_parakeet">\u200fParakeet، در همین تلفن</string>
    <string name="voice_parakeet_about">\u200fParakeet گفتار را در خود همین تلفن تشخیص می‌دهد: آفلاین، بدون بوق، به 25 زبان اروپایی. حجم بارگیری: ⁨%1$s⁩.</string>
    <string name="voice_parakeet_download">بارگیری</string>
    <string name="voice_parakeet_mobile_data">با داده تلفن همراه وصل هستید</string>
    <!-- Download progress: %1$s and %2$s are sizes, like 312 MB of 670 MB. -->
    <string name="voice_parakeet_progress">⁨%1$s⁩ از ⁨%2$s⁩</string>
