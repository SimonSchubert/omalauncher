    <string name="voice_parakeet_cancel">لغو</string>
    <string name="voice_parakeet_delete">حذف Parakeet · ⁨%1$s⁩</string>
    <string name="voice_parakeet_failed">بارگیری متوقف شد: ⁨%1$s⁩</string>
    <string name="voice_parakeet_space">فضای کافی نیست: ⁨%1$s⁩ دیگر لازم است</string>
    <string name="voice_parakeet_damaged">فایل بارگیری‌شده خراب بود؛ دوباره تلاش کنید</string>
    <!-- %1$s is a language name, like Japanese. -->
    <string name="voice_parakeet_language">\u200fParakeet این زبان را نمی‌شناسد: ⁨%1$s⁩. به‌جایش تشخیص گفتار تلفن گوش می‌دهد.</string>
    <!-- Reading aloud in the voice settings: the phone's text-to-speech, or Supertonic, downloaded on request. -->
    <string name="voice_reading">خواندن با صدای بلند</string>
    <string name="voice_reading_phone">تبدیل متن به گفتار تلفن</string>
    <string name="voice_reading_supertonic">\u200fSupertonic، در همین تلفن</string>
    <string name="voice_supertonic_about">\u200fSupertonic جواب‌ها را در خود همین تلفن با صدای بلند می‌خواند: آفلاین، با صداهای طبیعی، به 31 زبان. حجم بارگیری: ⁨%1$s⁩.</string>
    <string name="voice_supertonic_delete">حذف Supertonic · ⁨%1$s⁩</string>
    <!-- %1$s is a language name, like Chinese. -->
    <string name="voice_supertonic_language">\u200fSupertonic این زبان را نمی‌شناسد: ⁨%1$s⁩. به‌جایش تبدیل متن به گفتار تلفن می‌خواند.</string>
    <!-- Supertonic's voices, numbered: female 1 to 5, male 1 to 5. -->
    <string name="voice_female">زن %1$d</string>
    <string name="voice_male">مرد %1$d</string>
    <!-- In the voice settings: how long a pause in speech sends it to the agent; off means only a tap on the orb does. -->
    <string name="voice_send_after">ارسال پس از مکث</string>
    <string name="voice_send_after_off">خاموش</string>
    <!-- A number of seconds, short: 2 s. -->
    <string name="voice_seconds">%1$d ثانیه</string>
    <!-- Under the orb while the agent waits for the answer to a question it asked; %1$s is the time it has been working. -->
    <string name="voice_needs_answer">منتظر جواب شما · ⁨%1$s⁩</string>
    <string name="voice_your_answer">جواب شما</string>
    <!-- Above a question the agent asks the user; %1$s is the agent, like Hermes. -->
    <string name="voice_asks">⁨%1$s⁩ می‌پرسد</string>
    <!-- Answers the agent's question with nothing. -->
    <string name="voice_skip">رد شدن</string>
    <string name="voice_skipped">از سؤال رد شدید</string>
    <string name="voice_or_type_answer">یا جواب خودتان را تایپ کنید</string>
    <string name="voice_or_say_answer">یا روی گوی ضربه بزنید و جوابتان را بگویید</string>
    <!-- Said aloud after a question the agent asks; %1$s is its choices, separated by commas. -->
    <string name="voice_say_choices">گزینه‌ها: ⁨%1$s⁩.</string>
    <!-- In the conversation when Voice was opened to change a widget or app; %1$s is its name. -->
    <string name="voice_note_edit">در حال ویرایش ⁨%1$s⁩ · بگویید چه چیزی تغییر کند</string>
    <!-- The button by the controls that adds a picture or what's copied to the next message, said or typed. -->
    <string name="voice_attach">پیوست تصویر یا بریده‌دان</string>
    <!-- Its two choices: one from the phone's photos, or what's on the clipboard. -->
    <string name="voice_attach_picture">یک تصویر</string>
    <string name="voice_attach_paste">جای‌گذاری</string>
    <string name="voice_attach_failed">آن تصویر پیوست نشد</string>
    <!-- Takes a picture or pasted text off the message before it's sent. -->
    <string name="voice_detach">برداشتن</string>
</resources>
