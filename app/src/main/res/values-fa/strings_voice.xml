    <string name="voice_note_cant_continue">گفتگوی قبلی ادامه پیدا نکرد؛ این یک گفتگوی تازه است</string>
    <string name="voice_cant_start">⁨%1$s⁩ شروع نشد: ⁨%2$s⁩</string>
    <string name="voice_restarted">⁨%1$s⁩ متوقف شد و دوباره راه افتاد؛ دوباره بپرسید</string>
    <!-- %2$s is what the agent printed last, in its own words. -->
    <string name="voice_stopped">⁨%1$s⁩ متوقف شد: ⁨%2$s⁩</string>
    <string name="voice_nothing_to_say">⁨%1$s⁩ جواب داد ولی چیزی برای گفتن نداشت</string>
    <string name="voice_no_answer">هنوز جوابی از ⁨%1$s⁩ نیامده؛ شاید سهمیه‌اش تمام شده یا وارد حساب نشده باشد</string>
    <string name="voice_quiet">⁨%1$s⁩ دو دقیقه است که ساکت مانده؛ اگر گیر کرده متوقفش کنید</string>
    <string name="voice_offline">اینترنت نیست: تا تلفن آنلاین نشود ⁨%1$s⁩ نمی‌تواند جواب بدهد</string>
    <!-- When the agent gave no reason for a failure. -->
    <string name="voice_failed">ناموفق</string>
    <!-- %1$s is the agent's error, like a network error. -->
    <string name="voice_retrying">تلاش دوباره: ⁨%1$s⁩</string>
    <!-- The voice settings: the chip in the top row and the dialog it opens. -->
    <string name="voice_voice">صدا</string>
    <string name="voice_language">زبان</string>
    <!-- The language picked in the launcher, which Voice uses unless another is picked; %1$s is its name. -->
    <string name="voice_language_launcher">پیش‌فرض (⁨%1$s⁩)</string>
    <string name="voice_default">پیش‌فرض</string>
    <string name="voice_default_named">پیش‌فرض (⁨%1$s⁩)</string>
    <!-- After a voice that needs the internet. -->
    <string name="voice_online">آنلاین</string>
    <string name="voice_speed">سرعت</string>
    <string name="voice_tts_settings">تنظیمات تبدیل متن به گفتار</string>
    <string name="voice_no_voice">هنوز صدایی برای ⁨%1$s⁩ در این تلفن نیست: از تنظیمات تبدیل متن به گفتار یکی بگیرید.</string>
    <string name="voice_sample">جواب‌ها با این صدا خوانده می‌شوند.</string>
