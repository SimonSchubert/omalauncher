    <string name="voice_do_command">یک فرمان اجرا کند</string>
    <string name="voice_do_read">⁨%1$s⁩ را بخواند</string>
    <string name="voice_do_write">⁨%1$s⁩ را بنویسد</string>
    <string name="voice_do_edit">⁨%1$s⁩ را ویرایش کند</string>
    <string name="voice_do_delete">⁨%1$s⁩ را حذف کند</string>
    <string name="voice_do_search">⁨%1$s⁩ را جستجو کند</string>
    <string name="voice_do_web">در وب جستجو کند: ⁨%1$s⁩</string>
    <string name="voice_do_subtask">یک کار فرعی شروع کند: ⁨%1$s⁩</string>
    <string name="voice_do_plan">برنامه‌ریزی کند</string>
    <string name="voice_do_tool">از ⁨%1$s⁩ استفاده کند</string>
    <string name="voice_do_tool_unknown">از یک ابزار استفاده کند</string>
    <!-- Said aloud when the agent asks to do something; %2$s is one of the voice_do_ phrases. -->
    <string name="voice_say_wants">⁨%1$s⁩ می‌خواهد ⁨%2$s⁩. اجازه می‌دهید؟</string>
    <!-- Said aloud while the agent works quietly. -->
    <string name="voice_say_failed">ببخشید، نشد.</string>
    <!-- In place of the agent's name when there is none. -->
    <string name="voice_the_agent">عامل</string>
    <!-- Notes in the conversation, lower case. -->
    <string name="voice_note_allow_all">هر چه ⁨%1$s⁩ بخواهد اجازه داده می‌شود</string>
    <string name="voice_note_ask_again">دوباره پیش از هر کار پرسیده می‌شود</string>
