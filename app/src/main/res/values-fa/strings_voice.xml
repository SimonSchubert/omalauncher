<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="voice_listening">در حال گوش دادن · برای ارسال ضربه بزنید</string>
    <string name="voice_listening_working">در حال گوش دادن · هنوز مشغول کار</string>
    <!-- Under the orb right after a tap, while on-device speech recognition loads: what's said is kept. -->
    <string name="voice_listening_preparing">در حال آماده شدن · از همین حالا صحبت کنید</string>
    <string name="voice_starting">در حال شروع</string>
    <!-- Under the orb while an agent waits for an OK; %1$s is the time it has been working, like 0:12. -->
    <string name="voice_needs_ok">منتظر تأیید شما · ⁨%1$s⁩</string>
    <string name="voice_working">مشغول کار · ⁨%1$s⁩</string>
    <!-- Under the orb while a reply is read aloud: a tap talks over it. -->
    <string name="voice_tap_over">برای قطع کردن و صحبت ضربه بزنید</string>
    <string name="voice_tap">برای صحبت ضربه بزنید</string>
    <!-- A toggle: every question the agent asks is answered yes. -->
    <string name="voice_allow_all">اجازه همه‌چیز</string>
    <!-- Starts a new conversation; the last one can be resumed. -->
    <string name="voice_new">جدید</string>
    <!-- Brings back the last conversation. -->
    <string name="voice_resume">ادامه</string>
    <string name="voice_no_speech">«صدا» به تشخیص گفتار نیاز دارد و این تلفن ندارد. یکی نصب کنید، مثل Speech Recognition &amp; Synthesis از Google، و آن را در تنظیمات ورودی صوتی Android انتخاب کنید. یا به‌جایش تایپ کنید.</string>
    <string name="voice_input_settings">ورودی صوتی</string>
    <!-- Switches from talking to typing. -->
    <string name="voice_type">تایپ</string>
    <string name="voice_no_agent">«صدا» با یک عامل برنامه‌نویسی در Linux صحبت می‌کند. برای صحبت یکی نصب کنید.</string>
    <string name="voice_agents">عامل‌ها</string>
    <string name="voice_log_in">ورود</string>
    <string name="voice_thinking">در حال فکر کردن</string>
    <plurals name="voice_steps">
        <item quantity="one">%1$d مرحله</item>
        <item quantity="other">%1$d مرحله</item>
    </plurals>
    <!-- The text field's hint; %1$s is the agent, like Claude Code. -->
    <string name="voice_message">پیام به ⁨%1$s⁩</string>
    <string name="voice_answer_hint">بله، نه، یا اینکه به‌جایش چه کند</string>
    <string name="voice_send">ارسال</string>
    <string name="voice_erase">پاک کردن گفته‌هایتان</string>
    <string name="voice_stop">توقف</string>
    <!-- The approval card; %1$s is the agent, %2$s what it wants to do (a voice_do_ phrase, like "run a command"). -->
    <string name="voice_wants">⁨%1$s⁩ می‌خواهد ⁨%2$s⁩</string>
    <string name="voice_allow">اجازه</string>
    <string name="voice_always">همیشه</string>
    <string name="voice_deny">رد</string>
    <string name="voice_or_type">یا تایپ کنید بله، نه، یا اینکه به‌جایش چه کند</string>
    <string name="voice_or_say">یا روی گوی ضربه بزنید و بگویید بله، نه، یا اینکه به‌جایش چه کند</string>
    <!-- Under a picture shown whole. -->
    <string name="voice_tap_close">برای بستن ضربه بزنید</string>
    <!-- Steps of a task, shown as they happen. %1$s is a command's description or the command. -->
    <string name="voice_step_run">در حال اجرا: ⁨%1$s⁩</string>
