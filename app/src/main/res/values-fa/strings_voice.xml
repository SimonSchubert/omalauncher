    <string name="voice_step_read">در حال خواندن ⁨%1$s⁩</string>
    <string name="voice_step_write">در حال نوشتن ⁨%1$s⁩</string>
    <string name="voice_step_edit">در حال ویرایش ⁨%1$s⁩</string>
    <string name="voice_step_delete">در حال حذف ⁨%1$s⁩</string>
    <string name="voice_step_search">در حال جستجوی ⁨%1$s⁩</string>
    <string name="voice_step_web">در حال جستجو در وب: ⁨%1$s⁩</string>
    <string name="voice_step_subtask">کار فرعی: ⁨%1$s⁩</string>
    <string name="voice_step_plan">در حال برنامه‌ریزی</string>
    <!-- A step whose tool has no name. -->
    <string name="voice_step_tool">یک ابزار</string>
    <!-- What the agent wants to do, in "%1$s wants to %2$s" (voice_wants, voice_say_wants): an infinitive phrase. -->
    <string name="voice_do_run">این فرمان را اجرا کند: ⁨%1$s⁩</string>
