<?xml version="1.0" encoding="utf-8"?>
<!-- Home, its tiles and menus, the app drawer, and shared bits of the launcher's UI. -->
<resources>
    <!-- A selected tile's edit bar, and the drawer's long-press menu. -->
    <string name="home_edit">ویرایش</string>
    <!-- Beside edit on a selected tile and in the drawer's long-press menu: Voice, to say what to change. -->
    <string name="home_edit_by_voice">ویرایش با صدا</string>
    <string name="home_share">هم‌رسانی</string>
    <string name="home_remove">برداشتن</string>

    <!-- %1$s is a coding agent's name in lower case, like "claude code". -->
    <string name="home_create_with">ساخت با ⁨%1$s⁩</string>
    <string name="home_create_with_an_agent">ساخت با عامل</string>
    <string name="home_browse_store">مرور فروشگاه</string>
    <!-- After "create with …" in home's long-press menu: what the agent builds. -->
    <string name="home_create_widget">ابزارک</string>
    <string name="home_create_app">برنامه</string>
    <string name="home_create_panel">پنل</string>

    <!-- The empty page left of home's first, where a stock launcher has its news feed. A face is a full-screen widget, and the UI calls it that. -->
    <string name="home_face_invite_title">ابزارک تمام‌صفحه خودتان</string>
    <!-- %1$s is a coding agent's name, like "Claude Code". -->
    <string name="home_face_invite_text">این صفحه مال شماست تا با یک ابزارک تمام‌صفحه آن را پر کنید: فید، داشبورد، صفحه شروع، بازی. بگویید چه می‌خواهید تا ⁨%1$s⁩ همین‌جا آن را بسازد.</string>
    <string name="home_face_invite_text_no_agent">این صفحه مال شماست تا با یک ابزارک تمام‌صفحه آن را پر کنید: فید، داشبورد، صفحه شروع، بازی. بگویید چه می‌خواهید تا یک عامل همین‌جا آن را بسازد.</string>
    <!-- An empty page of home's tiles. -->
    <string name="home_widget_invite_title">جا برای ابزارک‌ها</string>
    <!-- %1$s is a coding agent's name, like "Claude Code". -->
    <string name="home_widget_invite_text">این صفحه هنوز خالی است. با ابزارک آن را پر کنید: ساعت، آب‌وهوا، فهرست کارها، عامل‌هایتان در حال کار. بگویید چه می‌خواهید تا ⁨%1$s⁩ آن را بسازد.</string>
    <string name="home_widget_invite_text_no_agent">این صفحه هنوز خالی است. با ابزارک آن را پر کنید: ساعت، آب‌وهوا، فهرست کارها، عامل‌هایتان در حال کار. بگویید چه می‌خواهید تا یک عامل آن را بسازد.</string>

    <!-- On an empty page while a tile is dragged. -->
    <string name="home_drop_here">اینجا رها کنید</string>
    <string name="home_drop_face_only">اینجا فقط جای ابزارک تمام‌صفحه است</string>
    <!-- The cue over a locked home screen. -->
    <string name="home_lock_locked">صفحه قفل است</string>
    <string name="home_lock_unlock">باز کردن قفل</string>

    <!-- The red banner over home when style.toml or layout.toml has errors. %1$s is the file's name. -->
    <plurals name="home_file_problems">
        <item quantity="one">⁨%1$s⁩: %2$d مشکل</item>
        <item quantity="other">⁨%1$s⁩: %2$d مشکل</item>
    </plurals>
    <!-- %1$d problems more than the banner shows; errors.txt is a file name. -->
    <plurals name="home_file_problems_more">
        <item quantity="one">%1$d مورد دیگر در errors.txt · برای پنهان کردن ضربه بزنید</item>
        <item quantity="other">%1$d مورد دیگر در errors.txt · برای پنهان کردن ضربه بزنید</item>
    </plurals>
    <string name="home_file_problems_hide">برای پنهان کردن ضربه بزنید</string>

    <!-- A widget tile whose Linux packages are missing. %1$s lists the packages, like "jq, curl". -->
    <string name="home_widget_needs">نیاز به ⁨%1$s⁩</string>
    <string name="home_installing">در حال نصب…</string>
    <string name="home_install">نصب</string>
    <string name="home_retry">تلاش دوباره</string>
    <string name="home_fix_with_agent">رفع با عامل</string>
    <!-- A widget tile that runs Linux commands, before Linux is installed. -->
    <string name="home_widget_needs_linux">نیاز به Linux</string>
    <string name="home_widget_needs_linux_text">در Arch Linux اختیاری فرمان اجرا می‌کند</string>
    <string name="home_widget_linux_stopped">اجرای Linux متوقف است</string>
    <string name="home_start_linux">شروع</string>

    <!-- A terminal tile whose terminal isn't showing. -->
    <string name="home_terminal_starting">در حال شروع…</string>
    <string name="home_terminal_exited">بسته شد · برای شروع دوباره ضربه بزنید</string>

    <!-- The prompt bar's hint on the side rail in landscape, the longest that fits. %1$s is an agent's command, like "claude". -->
    <string name="home_prompt_hint_agent">برنامه یا پرسش از ⁨%1$s⁩</string>
    <string name="home_prompt_hint">باز کردن برنامه</string>
    <string name="home_prompt_hint_short">برنامه‌ها</string>

    <!-- What screen readers say for a folder on home. %1$s is its name. -->
    <string name="home_folder_named">پوشه ⁨%1$s⁩</string>
    <string name="home_app_has_notifications">⁨%1$s⁩، اعلان دارد</string>
    <string name="home_folder">پوشه</string>
    <!-- An open folder's name while it has none. -->
    <string name="home_folder_tap_to_name">برای نام‌گذاری ضربه بزنید</string>

    <!-- Screen reader labels of a list's refresh button. -->
    <string name="home_refresh">تازه‌سازی</string>
    <string name="home_refreshing">در حال تازه‌سازی</string>
    <!-- Above the last lines of a Linux job that failed. -->
    <string name="home_job_failed">ناموفق:</string>
    <!-- Under the last lines of a Linux job: opens all of it, closes it again, copies it. -->
    <string name="home_job_whole_log">گزارش کامل</string>
    <string name="home_job_less">کمتر</string>
    <string name="home_job_copy">کپی</string>
    <!-- Screen reader label of the gear that opens settings. -->
    <string name="home_settings">تنظیمات</string>

    <!-- A Linux window's name in Recents when it has no other. -->
    <string name="home_linux_window">Linux</string>

    <!-- The drawer's long-press menu of an app. -->
    <!-- A message from the developer, shown once over home. -->
    <string name="home_news_close">بستن</string>
    <string name="home_news_off">خبرها دیگر نشان داده نشوند</string>
    <!-- Under the numbers of a message's countdown. -->
    <string name="home_news_days">روز</string>
    <string name="home_news_hours">ساعت</string>
    <string name="home_news_minutes">دقیقه</string>
    <string name="home_news_seconds">ثانیه</string>
