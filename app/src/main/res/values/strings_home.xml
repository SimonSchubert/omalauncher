<?xml version="1.0" encoding="utf-8"?>
<!-- Home, its tiles and menus, the app drawer, and shared bits of the launcher's UI. -->
<resources>
    <!-- A selected tile's edit bar, and the drawer's long-press menu. -->
    <string name="home_edit">edit</string>
    <string name="home_share">share</string>
    <string name="home_remove">remove</string>

    <!-- %1$s is a coding agent's name in lower case, like "claude code". -->
    <string name="home_create_with">create with %1$s</string>
    <string name="home_create_with_an_agent">create with an agent</string>
    <string name="home_browse_store">browse store</string>
    <!-- After "create with …" in home's long-press menu: what the agent builds. -->
    <string name="home_create_widget">widget</string>
    <string name="home_create_app">app</string>
    <string name="home_create_panel">panel</string>

    <!-- The empty page left of home's first, where a stock launcher has its news feed. A face is a full-screen widget. -->
    <string name="home_face_invite_title">a face of your own</string>
    <!-- %1$s is a coding agent's name, like "Claude Code". -->
    <string name="home_face_invite_text">This page is yours to fill with a face: a feed, a dashboard, a start page, a game. Say what you want and %1$s builds it here, full screen.</string>
    <string name="home_face_invite_text_no_agent">This page is yours to fill with a face: a feed, a dashboard, a start page, a game. Say what you want and an agent builds it here, full screen.</string>
    <!-- An empty page of home's tiles. -->
    <string name="home_widget_invite_title">room for widgets</string>
    <!-- %1$s is a coding agent's name, like "Claude Code". -->
    <string name="home_widget_invite_text">Nothing on this page yet. Fill it with widgets: a clock, the weather, a todo list, your agents at work. Say what you want and %1$s builds it.</string>
    <string name="home_widget_invite_text_no_agent">Nothing on this page yet. Fill it with widgets: a clock, the weather, a todo list, your agents at work. Say what you want and an agent builds it.</string>

    <!-- On an empty page while a tile is dragged. -->
    <string name="home_drop_here">drop here</string>
    <string name="home_drop_face_only">only a face goes here</string>

    <!-- The red banner over home when style.toml or layout.toml has errors. %1$s is the file's name. -->
    <plurals name="home_file_problems">
        <item quantity="one">%1$s: %2$d problem</item>
        <item quantity="other">%1$s: %2$d problems</item>
    </plurals>
    <!-- %1$d problems more than the banner shows; errors.txt is a file name. -->
    <plurals name="home_file_problems_more">
        <item quantity="one">%1$d more in errors.txt · tap to hide</item>
        <item quantity="other">%1$d more in errors.txt · tap to hide</item>
    </plurals>
    <string name="home_file_problems_hide">tap to hide</string>

    <!-- A widget tile whose Linux packages are missing. %1$s lists the packages, like "jq, curl". -->
    <string name="home_widget_needs">needs %1$s</string>
    <string name="home_installing">installing…</string>
    <string name="home_install">install</string>
    <string name="home_retry">retry</string>
    <string name="home_fix_with_agent">fix with agent</string>
    <!-- A widget tile that runs Linux commands, before Linux is installed. -->
    <string name="home_widget_needs_linux">needs Linux</string>
    <string name="home_widget_needs_linux_text">runs commands in the optional Arch Linux</string>

    <!-- A terminal tile whose terminal isn't showing. -->
    <string name="home_terminal_starting">starting…</string>
    <string name="home_terminal_exited">exited · tap to restart</string>

    <!-- The prompt bar's hint on the side rail in landscape, the longest that fits. %1$s is an agent's command, like "claude". -->
    <string name="home_prompt_hint_agent">open an app or ask %1$s</string>
    <string name="home_prompt_hint">open an app</string>
    <string name="home_prompt_hint_short">apps</string>

    <!-- What screen readers say for a folder on home. %1$s is its name. -->
    <string name="home_folder_named">%1$s folder</string>
    <string name="home_folder">folder</string>
    <!-- An open folder's name while it has none. -->
    <string name="home_folder_tap_to_name">tap to name</string>

    <!-- Screen reader labels of a list's refresh button. -->
    <string name="home_refresh">refresh</string>
    <string name="home_refreshing">refreshing</string>
    <!-- Above the last lines of a Linux job that failed. -->
    <string name="home_job_failed">failed:</string>
    <!-- Screen reader label of the gear that opens settings. -->
    <string name="home_settings">settings</string>

    <!-- A Linux window's name in Recents when it has no other. -->
    <string name="home_linux_window">Linux</string>

    <!-- The drawer's long-press menu of an app. -->
    <string name="drawer_action_pin">add to home</string>
    <string name="drawer_action_info">app info</string>
    <string name="drawer_action_uninstall">uninstall</string>
</resources>
