    <string name="voice_voice">giọng đọc</string>
    <string name="voice_language">ngôn ngữ</string>
    <!-- The language picked in the launcher, which Voice uses unless another is picked; %1$s is its name. -->
    <string name="voice_language_launcher">mặc định (%1$s)</string>
    <string name="voice_default">mặc định</string>
    <string name="voice_default_named">mặc định (%1$s)</string>
