    <string name="voice_do_write">ghi %1$s</string>
    <string name="voice_do_edit">chỉnh sửa %1$s</string>
    <string name="voice_do_delete">xóa %1$s</string>
    <string name="voice_do_search">tìm %1$s</string>
    <string name="voice_do_web">tìm %1$s trên web</string>
