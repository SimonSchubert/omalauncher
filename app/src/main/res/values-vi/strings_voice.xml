    <string name="voice_note_task_stopped">tác vụ trước đã bị dừng; nói tiếp tục để làm tiếp</string>
    <string name="voice_note_cant_continue">không tiếp tục được cuộc trò chuyện trước; đây là cuộc trò chuyện mới</string>
