    <string name="voice_stopped">%1$s đã dừng: %2$s</string>
    <string name="voice_nothing_to_say">%1$s trả lời nhưng không có gì để nói</string>
    <string name="voice_no_answer">%1$s chưa trả lời; có thể đã hết hạn mức hoặc chưa đăng nhập</string>
    <string name="voice_quiet">%1$s đã im lặng hai phút; dừng nó nếu bị kẹt</string>
    <string name="voice_offline">không có internet: %1$s không trả lời được cho đến khi điện thoại có mạng</string>
    <!-- When the agent gave no reason for a failure. -->
    <string name="voice_failed">lỗi</string>
    <!-- %1$s is the agent's error, like a network error. -->
    <string name="voice_retrying">đang thử lại: %1$s</string>
