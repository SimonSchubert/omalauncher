    <string name="voice_parakeet_cancel">hủy</string>
    <string name="voice_parakeet_delete">xóa Parakeet · %1$s</string>
    <string name="voice_parakeet_failed">tải xuống đã dừng: %1$s</string>
    <string name="voice_parakeet_space">không đủ dung lượng: cần thêm %1$s</string>
    <string name="voice_parakeet_damaged">bản tải xuống bị hỏng; thử lại</string>
    <!-- %1$s is a language name, like Japanese. -->
    <string name="voice_parakeet_language">Parakeet không hỗ trợ %1$s: trình nhận dạng của điện thoại sẽ nghe thay.</string>
    <!-- In the voice settings: how long a pause in speech sends it to the agent; off means only a tap on the orb does. -->
    <string name="voice_send_after">gửi sau khi ngừng nói</string>
    <string name="voice_send_after_off">tắt</string>
