    <string name="voice_recognition_phone">của điện thoại</string>
    <string name="voice_recognition_parakeet">Parakeet, trên điện thoại này</string>
    <string name="voice_parakeet_about">Parakeet nhận dạng giọng nói ngay trên điện thoại này: không cần mạng, không có tiếng bíp, với 25 ngôn ngữ châu Âu. Dung lượng tải xuống %1$s.</string>
    <string name="voice_parakeet_download">tải xuống</string>
    <string name="voice_parakeet_mobile_data">bạn đang dùng dữ liệu di động</string>
    <!-- Download progress: %1$s and %2$s are sizes, like 312 MB of 670 MB. -->
