    <string name="voice_needs_answer">cần bạn trả lời · %1$s</string>
    <string name="voice_your_answer">câu trả lời của bạn</string>
    <!-- Above a question the agent asks the user; %1$s is the agent, like Hermes. -->
    <string name="voice_asks">%1$s hỏi</string>
    <!-- Answers the agent's question with nothing. -->
    <string name="voice_skip">bỏ qua</string>
    <string name="voice_skipped">đã bỏ qua câu hỏi</string>
    <string name="voice_or_type_answer">hoặc tự nhập câu trả lời</string>
    <string name="voice_or_say_answer">hoặc chạm vào vòng tròn và nói câu trả lời</string>
    <!-- Said aloud after a question the agent asks; %1$s is its choices, separated by commas. -->
    <string name="voice_say_choices">Các lựa chọn: %1$s.</string>
    <!-- In the conversation when Voice was opened to change a widget or app; %1$s is its name. -->
    <string name="voice_note_edit">đang chỉnh sửa %1$s · nói cần thay đổi gì</string>
