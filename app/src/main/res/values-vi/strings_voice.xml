    <string name="voice_allow">cho phép</string>
    <string name="voice_always">luôn cho phép</string>
    <string name="voice_deny">từ chối</string>
    <string name="voice_or_type">hoặc nhập có, không, hoặc nên làm gì thay vào đó</string>
    <string name="voice_or_say">hoặc chạm vào vòng tròn và nói có, không, hoặc nên làm gì thay vào đó</string>
    <!-- Under a picture shown whole. -->
    <string name="voice_tap_close">chạm để đóng</string>
    <!-- Steps of a task, shown as they happen. %1$s is a command's description or the command. -->
    <string name="voice_step_run">đang chạy: %1$s</string>
