<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="voice_listening">đang nghe · chạm để gửi</string>
    <string name="voice_listening_working">đang nghe · vẫn đang làm</string>
    <!-- Under the orb right after a tap, while on-device speech recognition loads: what's said is kept. -->
    <string name="voice_listening_preparing">đang chuẩn bị · có thể nói ngay</string>
    <string name="voice_starting">đang khởi động</string>
    <!-- Under the orb while an agent waits for an OK; %1$s is the time it has been working, like 0:12. -->
    <string name="voice_needs_ok">cần bạn cho phép · %1$s</string>
    <string name="voice_working">đang làm · %1$s</string>
    <!-- Under the orb while a reply is read aloud: a tap talks over it. -->
    <string name="voice_tap_over">chạm để nói chen vào</string>
    <string name="voice_tap">chạm để nói</string>
    <!-- A toggle: every question the agent asks is answered yes. -->
    <string name="voice_allow_all">cho phép tất cả</string>
    <!-- Starts a new conversation; the last one can be resumed. -->
    <string name="voice_new">mới</string>
    <!-- Brings back the last conversation. -->
    <string name="voice_resume">tiếp tục</string>
    <string name="voice_no_speech">Giọng nói cần tính năng nhận dạng giọng nói, nhưng điện thoại này không có. Hãy cài một ứng dụng, như Dịch vụ nhận dạng và tổng hợp giọng nói của Google, rồi chọn nó trong cài đặt nhập liệu bằng giọng nói của Android. Hoặc nhập bằng bàn phím.</string>
    <string name="voice_input_settings">nhập bằng giọng nói</string>
    <!-- Switches from talking to typing. -->
    <string name="voice_type">nhập</string>
    <string name="voice_no_agent">Giọng nói trò chuyện với một tác nhân lập trình trong Linux. Cài một tác nhân để bắt đầu nói.</string>
    <string name="voice_agents">tác nhân</string>
    <string name="voice_log_in">đăng nhập</string>
    <string name="voice_thinking">đang nghĩ</string>
    <plurals name="voice_steps">
        <item quantity="other">%1$d bước</item>
    </plurals>
    <!-- The text field's hint; %1$s is the agent, like Claude Code. -->
