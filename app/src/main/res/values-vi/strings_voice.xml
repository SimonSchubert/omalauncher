    <string name="voice_no_voice">Điện thoại này chưa có giọng đọc cho %1$s: tải một giọng trong cài đặt chuyển văn bản thành giọng nói.</string>
    <string name="voice_sample">Câu trả lời sẽ được đọc như thế này.</string>
