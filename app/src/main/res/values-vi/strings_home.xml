<?xml version="1.0" encoding="utf-8"?>
<!-- Home, its tiles and menus, the app drawer, and shared bits of the launcher's UI. -->
<resources>
    <!-- A selected tile's edit bar, and the drawer's long-press menu. -->
    <string name="home_edit">chỉnh sửa</string>
    <!-- Beside edit on a selected tile and in the drawer's long-press menu: Voice, to say what to change. -->
    <string name="home_edit_by_voice">chỉnh sửa bằng giọng nói</string>
    <string name="home_share">chia sẻ</string>
    <string name="home_remove">gỡ</string>

    <!-- %1$s is a coding agent's name in lower case, like "claude code". -->
    <string name="home_create_with">tạo bằng %1$s</string>
    <string name="home_create_with_an_agent">tạo bằng tác nhân</string>
    <string name="home_browse_store">xem cửa hàng</string>
    <!-- After "create with …" in home's long-press menu: what the agent builds. -->
    <string name="home_create_widget">tiện ích</string>
    <string name="home_create_app">ứng dụng</string>
    <string name="home_create_panel">bảng</string>

    <!-- The empty page left of home's first, where a stock launcher has its news feed. A face is a full-screen widget, and the UI calls it that. -->
    <string name="home_face_invite_title">tiện ích toàn màn hình của riêng bạn</string>
    <!-- %1$s is a coding agent's name, like "Claude Code". -->
    <string name="home_face_invite_text">Trang này để bạn đặt một tiện ích toàn màn hình: bảng tin, bảng điều khiển, trang khởi đầu, trò chơi. Nói điều bạn muốn và %1$s sẽ tạo ở đây.</string>
    <string name="home_face_invite_text_no_agent">Trang này để bạn đặt một tiện ích toàn màn hình: bảng tin, bảng điều khiển, trang khởi đầu, trò chơi. Nói điều bạn muốn và một tác nhân sẽ tạo ở đây.</string>
    <!-- An empty page of home's tiles. -->
    <string name="home_widget_invite_title">chỗ cho tiện ích</string>
    <!-- %1$s is a coding agent's name, like "Claude Code". -->
    <string name="home_widget_invite_text">Trang này chưa có gì. Hãy thêm tiện ích: đồng hồ, thời tiết, danh sách việc cần làm, tác nhân đang làm việc. Nói điều bạn muốn và %1$s sẽ tạo.</string>
    <string name="home_widget_invite_text_no_agent">Trang này chưa có gì. Hãy thêm tiện ích: đồng hồ, thời tiết, danh sách việc cần làm, tác nhân đang làm việc. Nói điều bạn muốn và một tác nhân sẽ tạo.</string>

    <!-- On an empty page while a tile is dragged. -->
    <string name="home_drop_here">thả vào đây</string>
    <string name="home_drop_face_only">chỉ tiện ích toàn màn hình mới đặt được ở đây</string>
    <!-- The cue over a locked home screen. -->
    <string name="home_lock_locked">màn hình đã khóa</string>
    <string name="home_lock_unlock">mở khóa</string>

    <!-- The red banner over home when style.toml or layout.toml has errors. %1$s is the file's name. -->
    <plurals name="home_file_problems">
        <item quantity="other">%1$s: %2$d lỗi</item>
    </plurals>
    <!-- %1$d problems more than the banner shows; errors.txt is a file name. -->
    <plurals name="home_file_problems_more">
        <item quantity="other">thêm %1$d lỗi trong errors.txt · chạm để ẩn</item>
    </plurals>
    <string name="home_file_problems_hide">chạm để ẩn</string>

    <!-- A widget tile whose Linux packages are missing. %1$s lists the packages, like "jq, curl". -->
    <string name="home_widget_needs">cần %1$s</string>
    <string name="home_installing">đang cài đặt…</string>
    <string name="home_install">cài đặt</string>
    <string name="home_retry">thử lại</string>
    <string name="home_fix_with_agent">sửa bằng tác nhân</string>
    <!-- A widget tile that runs Linux commands, before Linux is installed. -->
    <string name="home_widget_needs_linux">cần Linux</string>
    <string name="home_widget_needs_linux_text">chạy lệnh trong Arch Linux (không bắt buộc)</string>
    <string name="home_widget_linux_stopped">Linux đã dừng</string>
    <string name="home_start_linux">khởi động</string>

    <!-- A terminal tile whose terminal isn't showing. -->
    <string name="home_terminal_starting">đang khởi động…</string>
    <string name="home_terminal_exited">đã thoát · chạm để khởi động lại</string>

    <!-- The prompt bar's hint on the side rail in landscape, the longest that fits. %1$s is an agent's command, like "claude". -->
    <string name="home_prompt_hint_agent">mở ứng dụng hoặc hỏi %1$s</string>
    <string name="home_prompt_hint">mở ứng dụng</string>
    <string name="home_prompt_hint_short">ứng dụng</string>

    <!-- What screen readers say for a folder on home. %1$s is its name. -->
    <string name="home_folder_named">thư mục %1$s</string>
    <string name="home_app_has_notifications">%1$s, có thông báo</string>
    <string name="home_folder">thư mục</string>
    <!-- An open folder's name while it has none. -->
    <string name="home_folder_tap_to_name">chạm để đặt tên</string>

    <!-- Screen reader labels of a list's refresh button. -->
    <string name="home_refresh">làm mới</string>
    <string name="home_refreshing">đang làm mới</string>
    <!-- Above the last lines of a Linux job that failed. -->
    <string name="home_job_failed">lỗi:</string>
    <!-- Under the last lines of a Linux job: opens all of it, closes it again, copies it. -->
    <string name="home_job_whole_log">toàn bộ nhật ký</string>
    <string name="home_job_less">thu gọn</string>
    <string name="home_job_copy">sao chép</string>
    <!-- Screen reader label of the gear that opens settings. -->
    <string name="home_settings">cài đặt</string>

    <!-- A Linux window's name in Recents when it has no other. -->
    <string name="home_linux_window">Linux</string>

    <!-- The drawer's long-press menu of an app. -->
    <!-- A message from the developer, shown once over home. -->
    <string name="home_news_close">đóng</string>
    <string name="home_news_off">không hiện tin tức nữa</string>
    <!-- Under the numbers of a message's countdown. -->
    <string name="home_news_days">ngày</string>
    <string name="home_news_hours">giờ</string>
    <string name="home_news_minutes">phút</string>
    <string name="home_news_seconds">giây</string>
</resources>
