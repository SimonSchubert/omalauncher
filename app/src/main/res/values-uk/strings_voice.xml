    <string name="voice_starting">запуск</string>
    <!-- Under the orb while an agent waits for an OK; %1$s is the time it has been working, like 0:12. -->
    <string name="voice_needs_ok">чекає підтвердження · %1$s</string>
    <string name="voice_working">працює · %1$s</string>
    <!-- Under the orb while a reply is read aloud: a tap talks over it. -->
    <string name="voice_tap_over">торкніться, щоб перебити</string>
    <string name="voice_tap">торкніться й говоріть</string>
    <!-- A toggle: every question the agent asks is answered yes. -->
    <string name="voice_allow_all">дозволяти все</string>
