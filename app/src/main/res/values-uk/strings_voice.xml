    <string name="voice_resume">продовжити</string>
    <string name="voice_no_speech">Для Голосу потрібне розпізнавання мовлення, а на цьому телефоні його немає. Встановіть його, наприклад «Розпізнавання й синтез мовлення» від Google, і виберіть у налаштуваннях голосового введення Android. Або пишіть текстом.</string>
    <string name="voice_input_settings">голосове введення</string>
    <!-- Switches from talking to typing. -->
    <string name="voice_type">ввести текст</string>
    <string name="voice_no_agent">Голос спілкується з ШІ-агентом у Linux. Встановіть агента, щоб із ним поговорити.</string>
    <string name="voice_agents">агенти</string>
    <string name="voice_log_in">увійти</string>
    <string name="voice_thinking">думає</string>
