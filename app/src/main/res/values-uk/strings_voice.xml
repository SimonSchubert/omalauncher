        <item quantity="many">%1$d кроків</item>
        <item quantity="other">%1$d кроку</item>
    </plurals>
    <!-- The text field's hint; %1$s is the agent, like Claude Code. -->
    <string name="voice_message">повідомлення для %1$s</string>
