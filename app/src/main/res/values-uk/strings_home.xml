<?xml version="1.0" encoding="utf-8"?>
<!-- Home, its tiles and menus, the app drawer, and shared bits of the launcher's UI. -->
<resources>
    <!-- A selected tile's edit bar, and the drawer's long-press menu. -->
    <string name="home_edit">змінити</string>
    <string name="home_share">поділитися</string>
    <string name="home_remove">прибрати</string>

    <!-- %1$s is a coding agent's name in lower case, like "claude code". -->
    <string name="home_create_with">створити з %1$s</string>
    <string name="home_create_with_an_agent">створити з агентом</string>
    <string name="home_browse_store">відкрити магазин</string>
    <!-- After "create with …" in home's long-press menu: what the agent builds. -->
    <string name="home_create_widget">віджет</string>
    <string name="home_create_app">додаток</string>
    <string name="home_create_panel">панель</string>

    <!-- The empty page left of home's first, where a stock launcher has its news feed. A face is a full-screen widget, and the UI calls it that. -->
    <string name="home_face_invite_title">власний повноекранний віджет</string>
    <!-- %1$s is a coding agent's name, like "Claude Code". -->
    <string name="home_face_invite_text">Цю сторінку можна заповнити повноекранним віджетом: стрічкою новин, дашбордом, стартовою сторінкою, грою. Опишіть, що вам потрібно, і %1$s створить його тут.</string>
    <string name="home_face_invite_text_no_agent">Цю сторінку можна заповнити повноекранним віджетом: стрічкою новин, дашбордом, стартовою сторінкою, грою. Опишіть, що вам потрібно, і агент створить його тут.</string>
    <!-- An empty page of home's tiles. -->
    <string name="home_widget_invite_title">місце для віджетів</string>
    <!-- %1$s is a coding agent's name, like "Claude Code". -->
    <string name="home_widget_invite_text">На цій сторінці поки порожньо. Додайте сюди віджети: годинник, погоду, список справ, роботу ваших агентів. Опишіть, що вам потрібно, і %1$s їх створить.</string>
    <string name="home_widget_invite_text_no_agent">На цій сторінці поки порожньо. Додайте сюди віджети: годинник, погоду, список справ, роботу ваших агентів. Опишіть, що вам потрібно, і агент їх створить.</string>

    <!-- On an empty page while a tile is dragged. -->
    <string name="home_drop_here">відпустіть тут</string>
    <string name="home_drop_face_only">сюди можна покласти лише повноекранний віджет</string>
    <!-- The cue over a locked home screen. -->
    <string name="home_lock_locked">екран заблоковано</string>
    <string name="home_lock_unlock">розблокувати</string>

    <!-- The red banner over home when style.toml or layout.toml has errors. %1$s is the file's name. -->
    <plurals name="home_file_problems">
        <item quantity="one">%1$s: %2$d помилка</item>
        <item quantity="few">%1$s: %2$d помилки</item>
        <item quantity="many">%1$s: %2$d помилок</item>
        <item quantity="other">%1$s: %2$d помилки</item>
    </plurals>
    <!-- %1$d problems more than the banner shows; errors.txt is a file name. -->
    <plurals name="home_file_problems_more">
        <item quantity="one">ще %1$d в errors.txt · торкніться, щоб сховати</item>
        <item quantity="few">ще %1$d в errors.txt · торкніться, щоб сховати</item>
        <item quantity="many">ще %1$d в errors.txt · торкніться, щоб сховати</item>
        <item quantity="other">ще %1$d в errors.txt · торкніться, щоб сховати</item>
    </plurals>
    <string name="home_file_problems_hide">торкніться, щоб сховати</string>

    <!-- A widget tile whose Linux packages are missing. %1$s lists the packages, like "jq, curl". -->
    <string name="home_widget_needs">потрібно: %1$s</string>
    <string name="home_installing">встановлення…</string>
    <string name="home_install">встановити</string>
    <string name="home_retry">ще раз</string>
    <string name="home_fix_with_agent">виправити з агентом</string>
    <!-- A widget tile that runs Linux commands, before Linux is installed. -->
    <string name="home_widget_needs_linux">потрібен Linux</string>
    <string name="home_widget_needs_linux_text">виконує команди в Arch Linux, який встановлюється за бажанням</string>

    <!-- A terminal tile whose terminal isn't showing. -->
    <string name="home_terminal_starting">запуск…</string>
    <string name="home_terminal_exited">завершено · торкніться, щоб перезапустити</string>

    <!-- The prompt bar's hint on the side rail in landscape, the longest that fits. %1$s is an agent's command, like "claude". -->
    <string name="home_prompt_hint_agent">відкрити додаток або спитати %1$s</string>
    <string name="home_prompt_hint">відкрити додаток</string>
    <string name="home_prompt_hint_short">додатки</string>

    <!-- What screen readers say for a folder on home. %1$s is its name. -->
    <string name="home_folder_named">папка %1$s</string>
    <string name="home_app_has_notifications">%1$s, є сповіщення</string>
    <string name="home_folder">папка</string>
    <!-- An open folder's name while it has none. -->
    <string name="home_folder_tap_to_name">торкніться, щоб назвати</string>

    <!-- Screen reader labels of a list's refresh button. -->
    <string name="home_refresh">оновити</string>
    <string name="home_refreshing">оновлення</string>
    <!-- Above the last lines of a Linux job that failed. -->
    <string name="home_job_failed">помилка:</string>
    <!-- Under the last lines of a Linux job: opens all of it, closes it again, copies it. -->
    <string name="home_job_whole_log">увесь лог</string>
    <string name="home_job_less">згорнути</string>
    <string name="home_job_copy">копіювати</string>
    <!-- Screen reader label of the gear that opens settings. -->
    <string name="home_settings">налаштування</string>

    <!-- A Linux window's name in Recents when it has no other. -->
    <string name="home_linux_window">Linux</string>

    <!-- The drawer's long-press menu of an app. -->
    <string name="drawer_action_pin">додати на головний екран</string>
    <string name="drawer_action_info">про додаток</string>
    <string name="drawer_action_uninstall">видалити</string>
    <!-- A message from the developer, shown once over home. -->
    <string name="home_news_close">закрити</string>
    <string name="home_news_off">більше не показувати новини</string>
    <!-- Under the numbers of a message's countdown. -->
    <string name="home_news_days">дн</string>
    <string name="home_news_hours">год</string>
    <string name="home_news_minutes">хв</string>
    <string name="home_news_seconds">с</string>
</resources>
