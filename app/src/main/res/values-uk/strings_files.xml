<?xml version="1.0" encoding="utf-8"?>
<!-- Files (ui/FilesScreen.kt, FilesChrome.kt, FileDialogs.kt), the editor (ui/EditorScreen.kt) and the prompt bar
     with its speech input (ui/PromptBar.kt, ui/Speech.kt). -->
<resources>
    <!-- A file operation failed without saying why. -->
    <string name="files_failed">не вдалося</string>
    <!-- %1$s is a file name. -->
    <string name="files_cant_hand_over">не вдається передати %1$s іншим додаткам</string>
    <!-- %1$s is a file name. -->
    <string name="files_no_app">%1$s немає чим відкрити</string>
    <!-- Why a link can't be opened: its target doesn't exist. Shown as %2$s of files_cant_open. -->
    <string name="files_leads_to_nothing">посилання нікуди не веде</string>
    <!-- %1$s is a file name, %2$s why it can't be opened. -->
    <string name="files_cant_open">не вдається відкрити %1$s: %2$s</string>
