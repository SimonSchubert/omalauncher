        <item quantity="one">видалити %1$d елемент?</item>
        <item quantity="few">видалити %1$d елементи?</item>
        <item quantity="many">видалити %1$d елементів?</item>
        <item quantity="other">видалити %1$d елемента?</item>
    </plurals>
    <string name="files_delete_message">Цю дію не можна скасувати.</string>
    <string name="files_delete">видалити</string>
