<?xml version="1.0" encoding="utf-8"?>
<!-- No window content: only which app came to the front (for the launcher's recents) and screenshots for its cards. The service draws edge strips and performs back, home and recents. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/navigation_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0" />
