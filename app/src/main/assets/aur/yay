#!/bin/sh
# yay for proot's fake root, first on PATH as /usr/local/bin/yay. As root, yay
# runs git and makepkg through systemd-run, which a guest without systemd
# doesn't have (and makepkg refuses root anyway). So a root call runs yay as
# the unprivileged `builder` instead, which sudo lets run pacman. Apps that
# drive yay themselves, like App Finder, get the same build as the Packages
# screen. Their --sudo (App Finder's pkexec, which has no polkit here) loses
# to ours: yay takes an option's first value.
[ "$(id -u)" = 0 ] || exec /usr/bin/yay "$@"

# The rootfs ships without sudo, and a terminal's yay doesn't come through
# install.sh: without it makepkg and yay fall back to su and ask for root's
# password. A full sync, like install.sh: never a partial upgrade.
pacman -Qq base-devel git >/dev/null 2>&1 || pacman -Syu --noconfirm --needed base-devel git || exit

id builder >/dev/null 2>&1 || useradd -m -s /bin/bash builder
echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/aur-builder
chmod 440 /etc/sudoers.d/aur-builder

# Runs script $1 as builder, with the rest as its "$@". The fakeroot shim is
# first on PATH for builds only.
build() {
    script=$1
    shift
    # -- first: su would read yay's own options (-S) as its.
    su -s /bin/sh -c "export PATH=/usr/local/lib/aur/bin:\$PATH; cd; $script" -- builder yay "$@"
}

if [ ! -x /usr/bin/yay ]; then
    # yay-bin ships prebuilt aarch64 binaries; building yay itself needs Go.
    build 'rm -rf yay-bin && git clone --depth 1 https://aur.archlinux.org/yay-bin.git && cd yay-bin && makepkg -si --noconfirm && cd && rm -rf yay-bin' || exit
fi

build 'exec /usr/bin/yay --sudo sudo --sudoflags "" "$@"' "$@"
