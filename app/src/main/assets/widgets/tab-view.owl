panel "tab view" {
  // Home's pages as a tab view, like a browser: every page is a card with its tiles where they sit, and a tap
  // jumps home there. With a dozen pages, one tab view beats a dozen swipes. It reads ../home/layout.toml, so it
  // shows the pages as they are now, faces and all. Pick it in settings › gestures, or set
  // gestures.swipe-down = "tab-view.owl" in ../style/style.toml; like any panel it is yours to change.
  meta { description: "Swipe down for home's pages as tabs: a card per page with its tiles in place, a tap to jump there"; version: "1.0"; license: "MIT"; category: "system"; owl: 15 }

  // How much of home the panel covers: 1 solid, 0 clear. The cards carry their own background.
  opacity: 0.97

  // Every app, for the icons and names of the apps pinned on pages.
  source d = android.drawer
  // Home's pages as JSON: the columns, the rows in use, then each page's number, its face's name and its tiles with
  // the cells they sit in. It reads layout.toml with awk, which is part of Arch's base, so there is nothing to
  // install; a page's widget is named by its own file's `widget "…"`, not by the file name. Every 5 s while the
  // panel shows, so a change made meanwhile shows. `optional`: without Linux there is no home to read, and it says so.
  source home = cmd("""
    awk -v wdir="$HOME/.config/omalauncher/widgets" '
    # layout.toml as the tab view needs it: the columns, the rows in use, and every page with its face or its tiles.
    function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }

    function trim(s) { gsub(/\r/, "", s); sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }

    function unquote(s,   c) {
      s = trim(s)
      c = substr(s, 1, 1)
      if (c == "\"" || c == SQ) {
        s = substr(s, 2)
        if (substr(s, length(s)) == c) s = substr(s, 1, length(s) - 1)
      }
      return s
    }

    function whole(s, d,   n) { n = unquote(s) + 0; return n < 1 ? d : int(n) }

    # A cell: 0 is the first.
    function cell(s) { return int(unquote(s) + 0) }

    # The name a widget gives itself in its first `widget "…"`, else its file name without .owl.
    function title(name,   f, l, n, m) {
      if (name ~ /\.owl$/) {
        f = dir "/" name
        n = 0
        while ((getline l < f) > 0 && n++ < 200) {
          if (match(l, /^(widget|face|app|panel)[ \t]+"[^"]*"/)) {
            m = substr(l, RSTART, RLENGTH)
            sub(/^[^"]*"/, "", m)
            sub(/"$/, "", m)
            close(f)
            return m
          }
        }
        close(f)
      }
      sub(/\.owl$/, "", name)
      return name
    }

    # The text as it is, with its comment (# outside quotes) and any blank cut off.
    function uncomment(s,   out, i, c, q, n) {
      out = ""; q = ""
      n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (q != "") { if (c == q) q = "" }
        else if (c == "\"" || c == SQ) q = c
        else if (c == "#") break
        out = out c
      }
      return out
    }

    # How much of the text is still open: 0 once every [ and { in it is closed.
    function depthOf(s,   i, c, d, q, n) {
      d = 0; q = ""; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (q != "") { if (c == q) q = "" }
        else if (c == "\"" || c == SQ) q = c
        else if (c == "[" || c == "{") d++
        else if (c == "]" || c == "}") d--
      }
      return d
    }

    # The parts of s between its top-level commas: the pairs of a tile, the apps of a folder.
    function parts(s, arr,   i, c, d, q, cur, n, k) {
      d = 0; q = ""; cur = ""; k = 0; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (q != "") { if (c == q) q = ""; cur = cur c; continue }
        if (c == "\"" || c == SQ) { q = c; cur = cur c; continue }
        if (c == "[" || c == "{") d++
        else if (c == "]" || c == "}") d--
        if (c == "," && d == 0) { arr[++k] = trim(cur); cur = ""; continue }
        cur = cur c
      }
      if (trim(cur) != "") arr[++k] = trim(cur)
      return k
    }

    function guess(name) {
      if (name ~ /^linux:/) return "l:" substr(name, 7)
      if (name ~ /^owl:/) return "o:" substr(name, 5)
      if (name ~ /^shortcut:/) return "s:" substr(name, 10)
      return "a:" name (index(name, "/") ? "" : "/")
    }

    function newTile(p,   j) { j = ++ntiles[p]; kind[p, j] = ""; name[p, j] = ""; w[p, j] = 1; h[p, j] = 1; nap[p, j] = 0; return j }

    # One key = value of the tile j on page p.
    function pair(s, p, j,   eq, k, v, i, q, d, n, c, apps, a, cnt) {
      eq = 0; d = 0; q = ""; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (q != "") { if (c == q) q = ""; continue }
        if (c == "\"" || c == SQ) q = c
        else if (c == "[" || c == "{") d++
        else if (c == "]" || c == "}") d--
        else if (c == "=" && d == 0) { eq = i; break }
      }
      if (eq == 0) return
      k = trim(substr(s, 1, eq - 1))
      v = substr(s, eq + 1)
      if (k == "widget") { kind[p, j] = "widget"; name[p, j] = unquote(v) }
      else if (k == "app") { kind[p, j] = "app"; name[p, j] = unquote(v) }
      else if (k == "folder") { kind[p, j] = "folder"; name[p, j] = unquote(v) }
      else if (k == "x") x[p, j] = cell(v)
      else if (k == "y") y[p, j] = cell(v)
      else if (k == "w") w[p, j] = whole(v, 1)
      else if (k == "h") h[p, j] = whole(v, 1)
      else if (k == "apps") {
        apps = substr(v, index(v, "[") + 1)
        sub(/][^]]*$/, "", apps)
        cnt = parts(apps, a)
        nap[p, j] = 0
        for (i = 1; i <= cnt; i++) if (a[i] != "") nap[p, j]++
      }
    }

    function pairsIn(s, p, j,   i, k, ps) {
      k = parts(s, ps)
      for (i = 1; i <= k; i++) pair(ps[i], p, j)
    }

    # A `tiles = [ … ]` array: each { … } in it is a tile.
    function tileArray(s, p,   i, c, d, q, cur, n, open, j) {
      d = 0; q = ""; cur = ""; open = 0; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (q != "") { if (c == q) q = ""; if (open) cur = cur c; continue }
        if (c == "\"" || c == SQ) { q = c; if (open) cur = cur c; continue }
        if (c == "{") {
          d++
          if (d == 1) { open = 1; cur = "" } else cur = cur c
          continue
        }
        if (c == "}") {
          d--
          if (d == 0 && open) { j = newTile(p); pairsIn(cur, p, j); open = 0; cur = "" }
          else if (open) cur = cur c
          continue
        }
        if (open) cur = cur c
      }
    }

    function newPage() { npage++; ntiles[npage] = 0; pface[npage] = ""; curTile = 0 }

    BEGIN { dir = wdir; cols = 6; npage = 0; skip = 0; acc = ""; curTile = 0; SQ = sprintf("%c", 39) }
    {
      line = trim(uncomment($0))
      if (line == "") next

      # A tiles array across lines: read on until its ] closes it.
      if (acc != "") {
        acc = acc "\n" line
        if (depthOf(acc) <= 0) { tileArray(acc, npage); acc = "" }
        next
      }

      if (line ~ /^\[\[/) {
        if (line ~ /^\[\[[ \t]*page[ \t]*\]\]/) { skip = 0; newPage() }
        else if (line ~ /^\[\[[ \t]*page\.tiles[ \t]*\]\]/) { skip = 0; if (npage == 0) newPage(); curTile = newTile(npage) }
        else skip = 1
        next
      }
      if (line ~ /^\[/) { skip = 1; next }
      if (skip) next

      key = line
      sub(/[ \t]*=.*$/, "", key)
      val = line
      sub(/^[^=]*=[ \t]*/, "", val)

      if (key == "tiles" && substr(val, 1, 1) == "[") {
        if (npage == 0) newPage()
        acc = val
        if (depthOf(acc) <= 0) { tileArray(acc, npage); acc = "" }
        next
      }
      if (key == "columns") { cols = whole(val, 6); next }
      if (key == "face") { if (npage == 0) newPage(); pface[npage] = unquote(val); next }
      if (curTile > 0) pair(line, npage, curTile)
    }

    END {
      # Where each tile sits: its own x and y, or the first free spot, as home gives it.
      used = 0
      for (p = 1; p <= npage; p++) {
        for (j = 1; j <= ntiles[p]; j++) {
          if (w[p, j] > cols) w[p, j] = cols
          if (h[p, j] > 24) h[p, j] = 24
          if (x[p, j] == "" || y[p, j] == "") {
            spot = 0
            for (cy = 0; cy < 80 && !spot; cy++) {
              for (cx = 0; cx + w[p, j] <= cols && !spot; cx++) {
                free = 1
                for (dx = 0; dx < w[p, j] && free; dx++)
                  for (dy = 0; dy < h[p, j] && free; dy++)
                    if ((p, cx + dx, cy + dy) in taken) free = 0
                if (free) { x[p, j] = cx; y[p, j] = cy; spot = 1 }
              }
            }
          }
          if (x[p, j] == "") x[p, j] = 0
          if (y[p, j] == "") y[p, j] = 0
          if (x[p, j] > cols - w[p, j]) x[p, j] = cols - w[p, j]
          for (dx = 0; dx < w[p, j]; dx++)
            for (dy = 0; dy < h[p, j]; dy++) taken[p, x[p, j] + dx, y[p, j] + dy] = 1
          if (y[p, j] + h[p, j] > used) used = y[p, j] + h[p, j]
        }
      }

      # As home numbers them: the first page of tiles is page 1, the faces before it 0, -1, ….
      first = npage + 1
      for (p = 1; p <= npage; p++) if (ntiles[p] > 0) { first = p; break }

      printf "{\"columns\":%d,\"used\":%d,\"pages\":[", cols, used
      for (p = 1; p <= npage; p++) {
        if (p > 1) printf ","
        printf "{\"page\":%d,\"face\":", p - first + 1
        if (pface[p] != "") printf "\"%s\"", esc(title(pface[p])); else printf "null"
        printf ",\"tiles\":["
        for (j = 1; j <= ntiles[p]; j++) {
          if (j > 1) printf ","
          k = kind[p, j]
          printf "{\"kind\":\"%s\",\"name\":\"%s\",\"w\":%d,\"h\":%d,\"x\":%d,\"y\":%d",
            k, esc(name[p, j]), w[p, j], h[p, j], x[p, j], y[p, j]
          if (k == "widget") printf ",\"title\":\"%s\"", esc(title(name[p, j]))
          if (k == "folder") printf ",\"apps\":%d", nap[p, j]
          if (k == "app") printf ",\"lookup\":\"%s\"", esc(guess(name[p, j]))
          printf "}"
        }
        printf "]}"
      }
      printf "]}\n"
    }
    ' "$HOME/.config/omalauncher/home/layout.toml"
  """) every 5s json status optional

  let pages = home.out.pages ?? []
  let cols = home.out.columns ?? 6
  // The panel's size, and the cards: three to a row, so a dozen pages are nearly one screen, each card a page's
  // shape. Two make bigger previews, with more scrolling.
  let wide = screenWidth ?? 400
  let perRow = 3
  let outer = 8
  let gap = 10
  let cardW = floor((wide - 2 * outer - (perRow - 1) * gap) / perRow) - 1
  let pad = 4
  let cell = (cardW - 2 * pad) / cols
  // As many rows as the tiles use; at least 8, so a page with one small widget is not a sliver, and no more than
  // they need, so a page of two widgets is not a screen of empty cells.
  let rows = max(8, home.out.used ?? 8)
  let cardH = 2 * pad + cell * rows

  Column {
    fill: true
    gap: 12
    padding: outer
    scroll: true

    Row {
      fill: width
      align: center
      Text { text: "tab view"; fontSize: 28; color: accent; weight: 1 }
      Text { text: len(pages) == 1 ? "1 page" : "${len(pages)} pages"; style: small; color: muted }
    }
    Text { text: "tap a page to jump there"; style: small; color: muted }

    if len(pages) == 0 {
      Text {
        text: linux == false ? "home's pages need Linux: install it in settings, then swipe down again" : home == null ? "reading home…" : home.ok ? "home has no pages yet" : "can't read home's layout: ${home.err}"
        style: muted
        maxLines: 3
      }
    } else {
      Flow {
        gap: gap
        for p in pages key p.page {
          let names = p.tiles.map(t => t.kind == "widget" ? t.title : t.kind == "folder" ? "${t.name == "" ? "folder" : t.name} (${t.apps})" : t.kind == "app" ? (find(d.apps, a => a.key == t.lookup || startsWith(a.key, t.lookup)).name ?? t.name) : t.name)
          Column {
            width: cardW
            gap: 4
            // A page as home shows it: its tiles in their cells, a face filling it.
            Box {
              width: cardW
              height: cardH
              clip: true
              radius: 10 * corners
              background: alpha(surface, 0.55)
              border: 1
              borderColor: alpha(border, 0.9)
              align: topStart
              onTap: {
                haptic()
                launcher("page:${p.page}")
              }
              for t in p.tiles {
                // A widget, an app or a folder, drawn a cell at a time, tiny: the page's shape, not its contents.
                Box {
                  offset: [pad + t.x * cell + 1, pad + t.y * cell + 1]
                  width: t.w * cell - 2
                  height: t.h * cell - 2
                  clip: true
                  radius: 4 * corners
                  background: t.kind == "widget" ? alpha(accent, 0.16) : alpha(foreground, 0.07)
                  border: 1
                  borderColor: t.kind == "widget" ? alpha(accent, 0.45) : alpha(border, 0.5)
                  align: center
                  if t.kind == "app" {
                    let app = find(d.apps, a => a.key == t.lookup || startsWith(a.key, t.lookup))
                    if app.hasIcon {
                      Image { src: app.icon; size: cell * 0.8; label: app.name }
                    } else {
                      Text { text: app.initials ?? ""; fontSize: 8; color: muted }
                    }
                  } else if t.kind == "folder" {
                    Text { text: t.name; fontSize: 7; color: muted; maxLines: 1; align: center }
                  } else {
                    Text { text: t.title; fontSize: 6; color: muted; maxLines: 3; align: center; padding: 1 }
                  }
                }
              }
              if p.face != null {
                // A face fills its page: its name across it, on the accent, as it has no cells to draw.
                Box {
                  fill: true
                  align: center
                  background: alpha(accent, 0.12)
                  Text { text: p.face; fontSize: 13; color: accent; align: center; padding: 6; maxLines: 3 }
                }
              }
            }
            Row {
              gap: 6
              align: top
              Text { text: "${p.page}"; fontSize: 13; color: accent }
              Text { text: p.face != null ? "face" : (len(names) == 0 ? "empty" : join(names, " · ")); style: small; color: muted; maxLines: 2; weight: 1 }
            }
          }
        }
      }
    }
  }
}
