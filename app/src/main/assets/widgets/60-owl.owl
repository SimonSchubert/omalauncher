widget "owl" {
  meta { owl: 16; description: "A pixel owl to look after. Tap to hatch it, feed it and pet it; it sleeps at night and dances to your music"; version: "1.1"; license: "MIT"; category: "fun" }
  page: 2
  order: 1
  size: 3x3
  minSize: 2x2

  // A Tamagotchi in theme colors. Its moods come from real things: the hour
  // (it sleeps from 23 to 7), when it was last fed (it gets hungry after 8 h),
  // whether music is playing, and the phone's battery. Everything comes from
  // Android, so it works without Linux. A tap does whatever it needs most: hatch
  // the egg, feed it, or pet it.

  // What it says under the owl, in the phone's language where it has a set; short: for a 2-column tile, which fits
  // about 16 letters. ago takes minutes or hours as the unit's letter.
  strings {
    en {
      eggShort: "tap to hatch"; egg: "an egg · tap to hatch"; hungryShort: "tap to feed"; hungry: "hungry · tap to feed"
      music: "music"; minutes: n => "${n}m"; hours: n => "${n}h"
      day: d => "day ${d}"; tiredShort: b => "tired · ${b}%"; tired: b => "tired · battery ${b}%"; fed: t => "fed ${t} ago"
    }
    id {
      eggShort: "ketuk: tetaskan"; egg: "telur · ketuk: tetaskan"; hungryShort: "beri makan"; hungry: "lapar · ketuk: beri makan"
      music: "musik"; minutes: n => "${n}m"; hours: n => "${n}j"
      day: d => "hari ${d}"; tiredShort: b => "lelah · ${b}%"; tired: b => "lelah · baterai ${b}%"; fed: t => "makan ${t} lalu"
    }
  }

  source now = clock every 1s
  source bat = android.battery
  source m = android.media

  state born = 0 persist             // Unix seconds; 0 is still an egg
  state fed = 0 persist              // Unix seconds
  state pets = 0 persist
  // The last tap, in Canvas `time` and in Unix seconds, and what it did: hatch,
  // feed, pet or peek.
  state tapAt = -100
  state tapNow = 0
  state tapKind = ""

  let hour = num(fmtTime(now, "H"))
  let hatched = born > 0
  let asleep = hatched && (hour >= 23 || hour < 7)
  let hungry = hatched && now - fed > 8 * 3600
  let dancing = m.playing == true
  let tired = bat != null && bat.level < 20 && !bat.charging
  let mood = !hatched ? "egg" : asleep ? "asleep" : hungry ? "hungry" : dancing ? "dancing" : tired ? "tired" : "content"
  let day = floor((now - born) / 86400) + 1
  let ago = now - fed < 3600 ? str.minutes(max(floor((now - fed) / 60), 1)) : str.hours(floor((now - fed) / 3600))

  // Sprites: one letter per art pixel, "." is empty, colored by a palette.
  let owlArt = [
    ".b..........b.",
    ".bb........bb.",
    ".bbbbbbbbbbbb.",
    "bbFFFFbbFFFFbb",
    "bFFFFFFFFFFFFb",
    "bFFFFFFFFFFFFb",
    "bbFFFFkkFFFFbb",
    "bbbbbbkkbbbbbb",
    "wbbllllllllbbw",
    "wwbvlvllvlvbww",
    "wwbllllllllbww",
    "wwbblvllvlbbww",
    ".wwbbllllbbww.",
    "..bbbbbbbbbb..",
    "...ff....ff..."
  ]
  let eggArt = [
    "..eeee..",
    ".eeeeee.",
    ".eeeeee.",
    "eeeeeeee",
    "eeeeseee",
    "eseeeeee",
    "eeeeeese",
    "eeeeeeee",
    ".eeeeee.",
    "..eeee.."
  ]
  // The top of the egg, in two halves that fly apart when it hatches.
  let shellLeft = eggArt.take(5).map(r => sub(r, 0, 4))
  let shellRight = eggArt.take(5).map(r => sub(r, 4, 8))
  let heartArt = [".h.h.", "hhhhh", "hhhhh", ".hhh.", "..h.."]
  let cookieArt = [".ccc.", "cdccc", "ccccd", "ccdcc", ".ccc."]

  let body = accent
  let pal = {
    b: body, F: mix(foreground, background, 0.12), k: yellow, w: mix(body, background, 0.35),
    l: mix(body, foreground, 0.45), v: mix(body, background, 0.2), f: orange,
    e: mix(foreground, background, 0.15), s: mix(accent, background, 0.3),
    h: red, c: mix(orange, yellow, 0.4), d: mix(orange, background, 0.6)
  }
  // The owl in three parts that move separately: a palette leaves out the letters it doesn't name.
  let bodyPal = {b: pal.b, F: pal.F, k: pal.k, l: pal.l, v: pal.v}
  let wingPal = {w: pal.w}
  let feetPal = {f: pal.f}

  Column {
    gap: 2
    Canvas {
      weight: 1
      fill: width
      onTap: {
        tapKind = !hatched ? "hatch" : asleep ? "peek" : hungry ? "feed" : "pet"
        tapAt = time
        tapNow = now
        // `born` last: the lines before it still see the egg.
        fed = !hatched || (hungry && !asleep) ? now : fed
        pets = hatched && !asleep && !hungry ? pets + 1 : pets
        born = hatched ? born : now
      }

      // One art pixel, in dp: owl, branch and room for hearts above.
      let p = clamp(floor(min(width / 18, height / 22)), 2, 8)
      let s = p + 0.5
      // Seconds since the last tap. `time` restarts with the frame clock (say,
      // after the page was off screen), so an old tap could look recent again:
      // the wall clock has the final say.
      let since = time >= tapAt && now - tapNow < 5 ? time - tapAt : 1000
      let branchY = floor((height - 3 * p) / p) * p
      let ox = floor((width / 2 - 7 * p) / p) * p
      let oy = branchY - 15 * p + p

      // Night sky: a crescent moon and a few twinkling stars.
      if asleep {
        for c in range(25) {
          let i = c % 5 - 2
          let j = floor(c / 5) - 2
          if i * i + j * j <= 5 && (i + 1) * (i + 1) + (j + 1) * (j + 1) > 4 {
            rect(2 * p + (i + 2) * p, 2 * p + (j + 2) * p, s, s, fill: yellow)
          }
        }
        for k in range(5) {
          let sx = floor(width * (0.3 + 0.15 * k) / p) * p
          let sy = (2 + (k * 7) % 5) * p
          rect(sx, sy, p, p, fill: alpha(foreground, 0.3 + 0.5 * abs(sin(time * 0.8 + k * 1.9))))
        }
      }

      // The branch, with a twig and leaves.
      rect(0, branchY, width, p * 2, fill: mix(orange, background, 0.55))
      rect(0, branchY + p, width, p, fill: mix(orange, background, 0.7))
      for l in [[0.12, -1], [0.18, 0], [0.82, -1], [0.88, -2]] {
        rect(floor(width * l[0] / p) * p, branchY + l[1] * p, 2 * p, p, fill: mix(green, background, 0.2))
      }

      if !hatched {
        // The egg rocks now and then.
        let rock = time % 4 < 0.6 ? sin(time * 25) * 12 : 0
        let ex = floor((width / 2 - 4 * p) / p) * p
        let ey = branchY - 10 * p
        rotate(rock, width / 2, branchY) { sprite(eggArt, ex, ey, p, palette: pal) }
      } else {
        let happy = since < 2.5 && (tapKind == "pet" || tapKind == "hatch")
        let eating = since < 2.2 && tapKind == "feed"
        // A hop when happy; otherwise a one-pixel breath (slower in sleep). Feet stay on the branch.
        let hop = happy ? round(abs(sin(since * 7)) * 2 * max(1.4 - since, 0)) * p : 0
        let breath = (floor(time / (asleep ? 1.6 : 0.8)) % 2) * p
        // Dancing: a step to each side, in time with a slow beat.
        let shake = mood == "dancing" ? [0, 1, 0, -1][floor(time * 2.5) % 4] * p : 0
        let flap = happy && floor(since * 8) % 2 == 0 ? -p : 0
        let bx = ox + shake
        let by = oy - hop

        sprite(owlArt, bx, by + breath, p, palette: bodyPal)
        sprite(owlArt, bx, by + breath + flap, p, palette: wingPal)
        sprite(owlArt, bx, by, p, palette: feetPal)

        // Eyes, drawn over the face discs (centred on columns 3.5 and 9.5).
        let ey = by + breath
        let dark = background
        let blink = time % 4.3 < 0.15
        if asleep && !(tapKind == "peek" && since < 2) {
          for e in [2, 8] { rect(bx + e * p, ey + 5 * p, 4 * p, s, fill: dark) }
        } else if asleep {
          // Woken by a tap: one grumpy eye.
          rect(bx + 2 * p, ey + 5 * p, 4 * p, s, fill: dark)
          rect(bx + 9 * p, ey + 4 * p, 2 * p, 2 * p, fill: dark)
        } else if happy || eating && since > 0.7 || mood == "dancing" {
          for e in [2, 8] {
            rect(bx + e * p, ey + 5 * p, s, s, fill: dark)
            rect(bx + (e + 1) * p, ey + 4 * p, 2 * p, s, fill: dark)
            rect(bx + (e + 3) * p, ey + 5 * p, s, s, fill: dark)
          }
        } else if blink {
          for e in [2, 8] { rect(bx + e * p, ey + 5 * p, 4 * p, s, fill: dark) }
        } else if mood == "tired" {
          for e in [2, 8] {
            rect(bx + e * p, ey + 4 * p, 4 * p, s, fill: mix(body, background, 0.2))
            rect(bx + (e + 1) * p, ey + 5 * p, 2 * p, s, fill: dark)
          }
        } else {
          // Looking around; a hungry one looks up at its thought.
          let lx = mood == "hungry" ? 1 : [0, 1, 0, -1][floor(time / 2.7) % 4]
          let ly = mood == "hungry" ? -1 : 0
          for e in [3, 9] { rect(bx + (e + lx) * p, ey + (4 + ly) * p, 2 * p, 2 * p, fill: dark) }
        }

        // Chomping: the beak opens and shuts, crumbs fall.
        if eating && since > 0.7 {
          if floor(since * 6) % 2 == 0 { rect(bx + 6 * p, ey + 7 * p, 2 * p, s, fill: dark) }
          for k in range(3) {
            let f = since - 0.7
            rect(bx + (5 + k * 2) * p + (k - 1) * f * 6 * p, ey + 8 * p + f * f * 20 * p, p, p, fill: get(pal, "c"))
          }
        }
        // The cookie drops into its beak.
        if eating && since <= 0.7 {
          let cy = lerp(-5 * p, ey + 5 * p, since / 0.7)
          sprite(cookieArt, bx + 4.5 * p, cy, p, palette: pal)
        }

        // Hearts float up.
        if happy {
          for k in range(3) {
            let t = since - k * 0.35
            if t > 0 && t < 1.8 {
              layer(1 - t / 1.8) {
                sprite(heartArt, floor((bx + [-1, 5, 11][k] * p + sin(t * 5 + k) * p) / p) * p, floor((by - t * 6 * p) / p) * p, p, palette: pal)
              }
            }
          }
        }

        // Shell pieces flying off a fresh hatchling.
        if tapKind == "hatch" && since < 1.2 {
          layer(1 - since / 1.2) {
            let fly = by - 2 * p - since * 12 * p + since * since * 30 * p
            sprite(shellLeft, bx + 3 * p - since * 30 * p, fly, p, palette: pal)
            sprite(shellRight, bx + 7 * p + since * 30 * p, fly, p, palette: pal)
          }
        }

        // Zzz.
        if asleep && !(tapKind == "peek" && since < 2) {
          for k in range(3) {
            let t = (time * 0.4 + k / 3) % 1
            text("z", bx + 12 * p + t * 4 * p, by + p - t * 8 * p, size: (2 + t * 2) * p, bold: true, color: alpha(foreground, 1 - t))
          }
        }

        // Music notes drift up while it dances.
        if mood == "dancing" {
          for k in range(2) {
            let t = (time * 0.5 + k / 2) % 1
            let nx = floor((bx + (k == 0 ? -2 : 14) * p + sin(t * 6) * p) / p) * p
            let ny = floor((by + 6 * p - t * 8 * p) / p) * p
            let nc = alpha(k == 0 ? cyan : magenta, 1 - t)
            rect(nx, ny + 2 * p, 2 * p, 2 * p, fill: nc)
            rect(nx + p, ny - p, p, 3 * p, fill: nc)
            rect(nx + 2 * p, ny - p, p, p, fill: nc)
          }
        }

        // Hungry: a thought bubble with a cookie.
        if mood == "hungry" && !eating {
          // Above its head on the right, as high as the tile allows.
          let cloud = mix(foreground, background, 0.4)
          let tx = bx + 9 * p
          let ty = max(by - 8 * p, 0)
          rect(tx - p, ty + 7 * p, p, p, fill: cloud)
          rect(tx, ty + 6 * p, p, p, fill: cloud)
          rect(tx + p, ty, 7 * p, 7 * p, radius: p, fill: cloud)
          sprite(cookieArt, tx + 2 * p, ty + p, p, palette: pal)
        }
      }
    }
    Text {
      font: mono
      style: small
      color: muted
      align: center
      maxLines: 1
      // A 2-column tile fits about 16 letters.
      text: cols != null && cols < 3 ?
        (mood == "egg" ? str.eggShort
        : mood == "asleep" ? "zzz · ${str.day(day)}"
        : mood == "hungry" ? str.hungryShort
        : mood == "dancing" ? "♪ ${lower(m.title ?? str.music)}"
        : mood == "tired" ? str.tiredShort(bat.level)
        : "${str.day(day)} · ♥︎${pets}")
        : mood == "egg" ? str.egg
        : mood == "asleep" ? "zzz · ${str.day(day)}"
        : mood == "hungry" ? str.hungry
        : mood == "dancing" ? "♪ ${lower(m.title ?? str.music)}"
        : mood == "tired" ? str.tired(bat.level)
        : "${str.day(day)} · ${str.fed(ago)} · ♥︎${pets}"
    }
  }
}
