app "boomtown" {
  meta { owl: 21; description: "A city builder on an isometric map: lay roads, zone homes, shops and industry, power them, bring water, police, fire, health, schools and parks, set taxes and keep the budget in the black while the city grows from a village to a metropolis"; version: "1.0"; license: "MIT"; category: "games" }
  // How it works. The map is 28 x 28 tiles, kept in two persisted lists: kind (what's on a tile) and lvl
  // (how far a zone has grown, negative while abandoned). A week passes every tick of `every frame`'s
  // clock (faster at 2x and 3x), and each week every zoned lot has a chance to grow or decline by its
  // score: the demand for its zone, its land value, pollution, crime and traffic. Most of the city's
  // numbers are lets, worked out again only when what they read changes; coverage, pollution, crime and
  // traffic are kept per block of 4 x 4 tiles to stay cheap. Power flows out from the plants along
  // anything built, a few tiles a step, so a new line visibly lights the city up.
  // Drawing: a Shader paints the grass, the map's edge and the grid, one Canvas draws the tiles that have
  // something on them (only those on screen, with less detail the more there are, to stay under the 2000
  // drawing calls), and a second Canvas on top draws what moves (cars, smoke, fires) and takes the touches.
  title: ""
  statusBar: false
  edge: true
  fps: speed > 0 || dragging || len(burn) > 0 ? 20 : 10
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <clipPath id="t"><rect width="256" height="256" rx="56"/></clipPath>
    <g clip-path="url(#t)">
      <rect width="256" height="256" fill="#1d2b3a"/>
      <circle cx="206" cy="58" r="18" fill="#f2c14e"/>
      <path d="M28 170L128 220L128 236L28 186Z" fill="#9a7650"/>
      <path d="M128 220L228 170L228 186L128 236Z" fill="#6b4f36"/>
      <path d="M28 170L128 120L228 170L128 220Z" fill="#6fa04e"/>
      <path d="M85.5 141.25L185.5 191.25L170.5 198.75L70.5 148.75Z" fill="#4a4d52"/>
      <path d="M108 145L128 155L128 77L108 67Z" fill="#c9d6e2"/>
      <path d="M128 155L148 145L148 67L128 77Z" fill="#8ea3b8"/>
      <path d="M128 57L148 67L128 77L108 67Z" fill="#e8eef4"/>
      <path d="M108 82L128 92L128 99L108 89ZM108 102L128 112L128 119L108 109ZM108 122L128 132L128 139L108 129Z" fill="#7f9fb8"/>
      <path d="M128 92L148 82L148 89L128 99ZM128 112L148 102L148 109L128 119ZM128 132L148 122L148 129L128 139Z" fill="#5f7a96"/>
      <path d="M158 170L178 180L178 125L158 115Z" fill="#5f8fc7"/>
      <path d="M178 180L198 170L198 115L178 125Z" fill="#3f6a9c"/>
      <path d="M178 105L198 115L178 125L158 115Z" fill="#8ab4e0"/>
      <path d="M60 170L78 179L78 163L60 154Z" fill="#e8c9a4"/>
      <path d="M78 179L96 170L96 154L87 148.5L78 163Z" fill="#c9a47e"/>
      <path d="M69 139.5L87 148.5L96 154L78 145Z" fill="#8e3f2e"/>
      <path d="M60 154L78 163L87 148.5L69 139.5Z" fill="#b5543e"/>
      <rect x="138" y="146" width="8" height="34" fill="#6b5d52"/>
      <path d="M106 195L128 206L128 184L106 173Z" fill="#a39586"/>
      <path d="M128 206L150 195L150 173L128 184Z" fill="#7d7064"/>
      <path d="M128 162L150 173L128 184L106 173Z" fill="#bfb2a2"/>
      <circle cx="144" cy="132" r="9" fill="#dfe6ea" fill-opacity="0.85"/>
      <circle cx="156" cy="116" r="12" fill="#dfe6ea" fill-opacity="0.6"/>
    </g>
  </svg>"""

  // The city, kept between sessions. kind codes:
  // 0 grass, 1 trees, 2 water, 3 road, 4 power line, 5 rubble, 6 bridge (a road on water), 7 a power line on water,
  // 10/11 homes light/dense, 12/13 shops, 14/15 industry, 20-24 power plants, 30/31 water, 40-45 services, 50-54 parks and landmarks
  state kind = [] persist
  state lvl = [] persist
  // how many steps along the built city each tile is from a power plant, CAP when it can't be reached
  state pw = [] persist
  state funds = 20000 persist
  state month = 0 persist
  state week = 0 persist
  state taxR = 8 persist
  state taxC = 8 persist
  state taxI = 8 persist
  state loan = 0 persist
  state redMonths = 0 persist
  state over = false persist
  state mile = 0 persist
  state popHist = [] persist
  state cashHist = [] persist
  state lastNet = 0 persist
  state disasters = true persist
  state cu = 0 persist
  state cv = 29 persist
  state zoom = 3 persist

  state speed = 1
  state acc = 0
  state pwT = 0
  state pwStable = false
  // fires burning: {i: tile, t: weeks}
  state burn = []
  state tool = -1
  state cat = 0
  state panel = ""
  state overlay = ""
  state sel = -1
  state dragging = false
  state ds = -1
  state de = -1
  state commit = 0
  state toast = ""
  state toastLeft = 0
  state toastAt = -1
  state confirmNew = false

  let N = 28
  let NN = 784
  let CAP = 60
  let W = screenWidth ?? 400
  let H = screenHeight ?? 800
  let TOP = screenTop ?? 0
  let BOT = screenInset ?? 0
  // the bars over and under the map, in dp
  let HUDH = 122
  let BARH = 150
  let MAPT = TOP + HUDH
  let MAPB = H - BOT - BARH
  let CX = W / 2
  let CY = (MAPT + MAPB) / 2
  let tw = [14, 22, 32, 46, 64][clamp(zoom, 0, 4)]
  let hw = tw / 2
  let hh = tw / 4

  // What each building is: what it costs, its upkeep a month, the power or water it makes, and how far
  // its service reaches (r, in tiles) and how strongly (s), and its looks: footprint f, height h, colors.
  let BLD = {
    "20": {n: "coal plant", cost: 3000, up: 40, mw: 400, c: "plant", f: 0.86, h: 0.5, wall: #6d6058, top: #4a403a},
    "21": {n: "gas plant", cost: 2000, up: 35, mw: 220, c: "plant", f: 0.8, h: 0.32, wall: #9aa3ab, top: #c4ccd2},
    "22": {n: "wind turbine", cost: 300, up: 4, mw: 25, c: "plant", f: 0.3, h: 0.1, wall: #d8dde0, top: #eef1f2},
    "23": {n: "solar farm", cost: 1500, up: 12, mw: 90, c: "plant", f: 0.9, h: 0.05, wall: #5a6470, top: #33507a},
    "24": {n: "nuclear plant", cost: 12000, up: 120, mw: 1600, c: "plant", f: 0.84, h: 0.4, wall: #c9cdd0, top: #e2e5e7},
    "30": {n: "water pump", cost: 500, up: 10, wat: 1200, c: "water", f: 0.6, h: 0.25, wall: #5c86a8, top: #7fa8c8},
    "31": {n: "water tower", cost: 250, up: 5, wat: 500, c: "water", f: 0.4, h: 0.1, wall: #8a9aa6, top: #b8c6d0},
    "40": {n: "police station", cost: 600, up: 45, c: "police", r: 11, s: 1, f: 0.78, h: 0.36, wall: #dfe3ea, top: #3b5ea8},
    "41": {n: "fire station", cost: 600, up: 45, c: "fire", r: 11, s: 1, f: 0.8, h: 0.36, wall: #c0473a, top: #8a2f28},
    "42": {n: "clinic", cost: 800, up: 50, c: "health", r: 8, s: 0.8, f: 0.7, h: 0.32, wall: #f2f2ee, top: #e0e0dc},
    "43": {n: "hospital", cost: 2500, up: 120, c: "health", r: 14, s: 1.2, f: 0.86, h: 0.75, wall: #f2f2ee, top: #d8dad6},
    "44": {n: "school", cost: 700, up: 45, c: "edu", r: 9, s: 0.8, f: 0.82, h: 0.3, wall: #d07a45, top: #e8c050},
    "45": {n: "college", cost: 3500, up: 130, c: "edu", r: 15, s: 0.9, f: 0.84, h: 0.45, wall: #c9c0b0, top: #7a5a9a},
    "50": {n: "park", cost: 80, up: 2, c: "leis", r: 5, s: 0.6, f: 0, h: 0, wall: #78b25a, top: #78b25a},
    "51": {n: "plaza", cost: 200, up: 4, c: "leis", r: 7, s: 0.8, f: 0, h: 0, wall: #cfc6b0, top: #cfc6b0},
    "52": {n: "stadium", cost: 6000, up: 60, c: "leis", r: 13, s: 1, f: 0, h: 0, wall: #b8bcc0, top: #b8bcc0},
    "53": {n: "city hall", cost: 1500, up: 30, c: "leis", r: 9, s: 0.6, f: 0.84, h: 0.42, wall: #f0ece0, top: #d8d0bc},
    "54": {n: "monument", cost: 4000, up: 10, c: "leis", r: 15, s: 1.2, f: 0.28, h: 1.7, wall: #d8c690, top: #f0dca0}
  }
  // The tools, by the tab they're under. k is the kind they build (-2 bulldozes), u the milestone that unlocks them.
  let TOOLS = [
    {id: 0, ic: "HOME", cat: 1, k: 10, n: "homes", sub: "light", cost: 5, u: 0},
    {id: 1, ic: "SHOP", cat: 1, k: 12, n: "shops", sub: "light", cost: 5, u: 0},
    {id: 2, ic: "FACT", cat: 1, k: 14, n: "industry", sub: "light", cost: 5, u: 0},
    {id: 3, ic: "TOWER", c: #5cb85c, cat: 1, k: 11, n: "homes", sub: "dense", cost: 10, u: 0},
    {id: 4, ic: "TOWER", c: #4a90d9, cat: 1, k: 13, n: "shops", sub: "dense", cost: 10, u: 0},
    {id: 5, ic: "TOWER", c: #e0b03a, cat: 1, k: 15, n: "industry", sub: "dense", cost: 10, u: 0},
    {id: 6, ic: "ROAD", cat: 2, k: 3, n: "road", sub: "drag", cost: 10, u: 0},
    {id: 7, ic: "LINE", cat: 2, k: 4, n: "power line", sub: "drag", cost: 4, u: 0},
    {id: 8, ic: "DOZE", cat: 2, k: -2, n: "bulldoze", sub: "drag", cost: 5, u: 0},
    {id: 9, ic: "COAL", cat: 3, k: 20, n: "coal", sub: "400 MW", cost: 3000, u: 0},
    {id: 10, ic: "WIND", cat: 3, k: 22, n: "wind", sub: "25 MW", cost: 300, u: 0},
    {id: 11, ic: "GAS", cat: 3, k: 21, n: "gas", sub: "220 MW", cost: 2000, u: 2},
    {id: 12, ic: "SOLAR", cat: 3, k: 23, n: "solar", sub: "90 MW", cost: 1500, u: 4},
    {id: 13, ic: "NUKE", cat: 3, k: 24, n: "nuclear", sub: "1600 MW", cost: 12000, u: 7},
    {id: 14, ic: "PUMP", cat: 3, k: 30, n: "pump", sub: "water", cost: 500, u: 0},
    {id: 15, ic: "WTOWER", cat: 3, k: 31, n: "tower", sub: "water", cost: 250, u: 0},
    {id: 16, ic: "POLICE", cat: 4, k: 40, n: "police", sub: "crime", cost: 600, u: 0},
    {id: 17, ic: "FIRE", cat: 4, k: 41, n: "fire", sub: "fires", cost: 600, u: 0},
    {id: 18, ic: "CROSS", cat: 4, k: 42, n: "clinic", sub: "health", cost: 800, u: 0},
    {id: 19, ic: "SCHOOL", cat: 4, k: 44, n: "school", sub: "education", cost: 700, u: 0},
    {id: 20, ic: "HOSP", cat: 4, k: 43, n: "hospital", sub: "health", cost: 2500, u: 3},
    {id: 21, ic: "COLLEGE", cat: 4, k: 45, n: "college", sub: "education", cost: 3500, u: 5},
    {id: 22, ic: "PARK", cat: 5, k: 50, n: "park", sub: "value", cost: 80, u: 0},
    {id: 23, ic: "PLAZA", cat: 5, k: 51, n: "plaza", sub: "value", cost: 200, u: 2},
    {id: 24, ic: "HALL", cat: 5, k: 53, n: "city hall", sub: "approval", cost: 1500, u: 1},
    {id: 25, ic: "STADIUM", cat: 5, k: 52, n: "stadium", sub: "shops", cost: 6000, u: 6},
    {id: 26, ic: "MONU", cat: 5, k: 54, n: "monument", sub: "value", cost: 4000, u: 8}
  ]
  let CATS = ["look", "zones", "roads", "power", "civic", "parks"]
  let CATIC = ["LOOK", "HOME", "ROAD", "BOLT", "CROSS", "PARK"]
  let MILES = [
    {p: 500, s: "500 people: a village. city hall unlocked"},
    {p: 1200, s: "1,200 people: a town. gas plants and plazas unlocked"},
    {p: 2500, s: "2,500 people. hospitals unlocked"},
    {p: 4000, s: "4,000 people. solar farms unlocked"},
    {p: 6000, s: "6,000 people: a city. colleges unlocked"},
    {p: 9000, s: "9,000 people. stadiums unlocked"},
    {p: 14000, s: "14,000 people. nuclear power unlocked"},
    {p: 22000, s: "22,000 people: a capital. monuments unlocked"},
    {p: 40000, s: "40,000 people: a metropolis"},
    {p: 70000, s: "70,000 people: a megalopolis"}
  ]
  let MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
  // residents and jobs a zone holds at each level, and the power and water it uses per level
  let RES = [0, 16, 48, 140, 320]
  let JC = [0, 10, 30, 90, 200]
  let JI = [0, 14, 40, 100, 200]
  let MWU = [1, 1.5, 3]
  let WU = [6, 8, 12]
  let ZC = [#5cb85c, #4a90d9, #e0b03a]
  let ZNAME = ["homes", "dense homes", "shops", "dense shops", "industry", "dense industry"]
  let TNAME = ["grass", "trees", "water", "road", "power line", "rubble", "bridge", "power line"]

  // The look: a 16-bit city builder's panels, bevelled light above and dark below, in two pixel fonts
  let SILK = "https://raw.githubusercontent.com/google/fonts/main/ofl/silkscreen/Silkscreen-Regular.ttf"
  let PIX = "https://raw.githubusercontent.com/google/fonts/main/ofl/pixelifysans/PixelifySans%5Bwght%5D.ttf"
  let FACE = #2b3256
  let HI = #6070a8
  let LO = #0c101e
  let INK = #f2ead2
  let DIM = #8a92b8
  let GOLD = #f8c838
  let LCD = #0a0f14
  let LCDG = #8ef070
  let RED = #ff6050
  let GRN = #7ad35a
  let BAR = #1a2040
  let TBAR = #3a48a8
  // the icons' colors; c is a zone's, set per tool
  let IPAL = {k: #0c101e, w: #f2ead2, y: #f8c838, o: #e08828, r: #e04838, g: #78c850, G: #3c7830, b: #58a8e8, B: #2860a0, s: #a8a8b8, S: #5c5c6c, n: #a06838, p: #b070d0, c: #78c850}
  let ICON = {
    LOOK: ["..kkkk....", ".kbwbbk...", "kbwbbbbk..", "kbbbbbbk..", "kbbbbbbk..", ".kbbbbk...", "..kkkkSk..", "......kSk.", ".......kSk", "........kk"],
    HOME: ["....kk....", "...krrk...", "..krrrrk..", ".krrrrrrk.", "krrrrrrrrk", ".kwwwwwwk.", ".kwbwwbwk.", ".kwwnnwwk.", ".kwwnnwwk.", ".kkkkkkkk."],
    SHOP: ["kkkkkkkkkk", "kbwbwbwbwk", "kbwbwbwbwk", ".kkkkkkkk.", ".kwwwwwwk.", ".kbbwwbbk.", ".kbbwwbbk.", ".kwwwwwwk.", ".kwwnnwwk.", ".kkkkkkkk."],
    FACT: ["......kkkk", "......kSSk", "......kSSk", "kkkkkkkSSk", "ksssssssSk", "ksyysyysSk", "ksyysyysSk", "ksssssssSk", "ksssnnsssk", "kkkkkkkkkk"],
    TOWER: [".kkkk.....", ".kcwk.....", ".kcck.kkkk", ".kwck.kcwk", ".kcck.kcck", ".kcwk.kwck", ".kcck.kcck", ".kwck.kcwk", ".kcck.kcck", "kkkkkkkkkk"],
    ROAD: ["gkSSSSSSkg", "gkSSSySSkg", "gkSSSySSkg", "gkSSSSSSkg", "gkSSSSSSkg", "gkSSSySSkg", "gkSSSySSkg", "gkSSSSSSkg", "gkSSSSSSkg", "gkSSSySSkg"],
    LINE: ["....kk....", "kkkkkkkkkk", ".k.kSSk.k.", "....kk....", "...kSSk...", "...kSSk...", "..kS..Sk..", "..kS..Sk..", ".kS....Sk.", ".kk....kk."],
    DOZE: ["...kkkk...", "...kbbk...", "..kkyykkk.", "k.kyyyyyyk", "kkkyyyyyyk", "kykkkkkkkk", "kkkSkSkSkk", "k.kSSSSSSk", "...kkkkkk.", ".........."],
    COAL: [".ss...ss..", "ssss.ssss.", ".kk...kk..", ".kk...kk..", ".kk...kk..", "kkkkkkkkkk", "knnnnnnnnk", "knyynnyynk", "knnnnnnnnk", "kkkkkkkkkk"],
    WIND: ["..kw......", "...kw.....", "....kk.kww", "....kkk...", "...kwk....", "..kw.k....", ".kw..k....", ".....k....", ".....k....", "...kkkkk.."],
    GAS: [".kkk..kkk.", "kwsskkwssk", "kssSkkssSk", "kssSkkssSk", ".kkk..kkk.", ".k.k..k.k.", "kkkkkkkkkk", "kbbbbbbbbk", "kbbbbbbbbk", "kkkkkkkkkk"],
    SOLAR: ["..........", "....kkkkkk", "...kBbBbBk", "..kBbBbBk.", ".kBbBbBk..", "kkkkkkkk..", "...k..k...", "...k..k...", "..kkkkkk..", ".........."],
    NUKE: ["..s.ss..s.", "...ssss...", "..kkkkkk..", "..kwwwsk..", "...kwwk...", "...kwsk...", "..kwwssk..", "..kwwssk..", ".kwwwsssk.", ".kkkkkkkk."],
    PUMP: ["....kk....", "...kbbk...", "...kbbk...", "..kbwbbk..", "..kbwbbk..", ".kbwbbbbk.", ".kbbbbbbk.", ".kbbbbBBk.", "..kbbBBk..", "...kkkk..."],
    WTOWER: ["..kkkkkk..", ".kbwbbbbk.", ".kbbbbbbk.", ".kbbbbBBk.", "..kkkkkk..", "..k.kk.k..", "..k.kk.k..", ".k..kk..k.", ".k..kk..k.", "kk..kk..kk"],
    POLICE: ["....kk....", "...kyyk...", "kkkkyykkkk", "kyyyyyyyyk", ".kyyBByyk.", "..kyBByk..", "..kyyyyk..", ".kyykkyyk.", ".kyk..kyk.", ".kk....kk."],
    FIRE: ["....k.....", "...krk....", "..krrk.k..", "..krrrkrk.", ".krrorrrk.", ".krooorrk.", "kroyyoork.", "kroyyyork.", ".kroyyork.", "..kkkkkk.."],
    CROSS: ["..kkkkkk..", ".kwwwwwwk.", "kwwwrrwwwk", "kwwwrrwwwk", "kwrrrrrrwk", "kwrrrrrrwk", "kwwwrrwwwk", "kwwwrrwwwk", ".kwwwwwwk.", "..kkkkkk.."],
    HOSP: ["kkkkkkkkkk", "kwwwwwwwwk", "kwrwwwwrwk", "kwrwwwwrwk", "kwrrrrrrwk", "kwrwwwwrwk", "kwrwwwwrwk", "kwwwwwwwwk", "kwwwbbwwwk", "kkkkkkkkkk"],
    SCHOOL: ["....kk....", "...kyyk...", "..kyyyyk..", ".kyyyyyyk.", "kkkkkkkkkk", "koowwwwook", "kowoooowok", "kooonnoook", "kooonnoook", "kkkkkkkkkk"],
    COLLEGE: ["..........", "....kk....", "..kkppkk..", "kkppppppkk", "..kkppkkyk", "..kppppkyk", "..kppppk.y", "...kkkk...", "..........", ".........."],
    PARK: ["...kkkk...", "..kggggk..", ".kgGggggk.", "kggggGgggk", "kgGggggGgk", ".kggggggk.", "..kkGGkk..", "....nn....", "....nn....", "..gkkkkg.."],
    PLAZA: ["....b.....", "...bwb....", "....b.....", "...kbk....", ".kkkbkkk..", "kbbbbbbbk.", "kswbbbbsk.", ".kkkkkkk..", "sssssssss.", ".........."],
    HALL: ["....yy....", "...yyyy...", "..yyyyyy..", "kkkkkkkkkk", ".w.w..w.w.", ".w.w..w.w.", ".w.w..w.w.", "kkkkkkkkkk", "ssssssssss", "kkkkkkkkkk"],
    STADIUM: ["..........", "..kkkkkk..", ".kssssssk.", "ksggggggsk", "ksgwggwgsk", "ksggggggsk", ".kssssssk.", "..kkkkkk..", "..........", ".........."],
    MONU: ["....kk....", "...kyok...", "...kyok...", "...kyok...", "...kyok...", "...kyok...", "...kyok...", "..kyyook..", ".kkkkkkkk.", ".ssssssss."],
    BOLT: [".....kkkk.", "....kyyyk.", "...kyyyk..", "..kyyyk...", ".kyyyyyyk.", ".kkkkyyk..", "....kyk...", "...kyk....", "...kk.....", "..k......."],
    COIN: ["..kkkkk...", ".kyyyyyk..", "kyywyyyok.", "kyywyyyok.", "kyyyyyyok.", ".kyyyyok..", "..kkkkk..."],
    PERSON: ["..kkk...", ".kwwwk..", ".kwwwk..", "..kkk...", ".kbbbk..", "kbbbbbk.", "kbbbbbk."],
    HAPPY: [".kkkkkkk.", "kyyyyyyyk", "kykyyykyk", "kyyyyyyyk", "kykyyykyk", "kyykkkyyk", ".kkkkkkk."],
    MEH: [".kkkkkkk.", "kyyyyyyyk", "kykyyykyk", "kyyyyyyyk", "kyyyyyyyk", "kykkkkkyk", ".kkkkkkk."],
    SAD: [".kkkkkkk.", "kyyyyyyyk", "kykyyykyk", "kyyyyyyyk", "kyykkkyyk", "kykyyykyk", ".kkkkkkk."]
  }
  // a tool button's width, seven to a row, and a data map button's, three to a row
  let BW = (W - 16 - 36) / 7
  let DW = (W - 64) / 3

  // Blocks of 4 x 4 tiles: which block a tile is in, the tiles of a block, a block's neighbours and middle.
  let BLK = range(NN).map(i => floor((i % N) / 4) + floor(floor(i / N) / 4) * 7)
  let BT = range(49).map(b => flatten(range(4).map(dy => range(4).map(dx => (floor(b / 7) * 4 + dy) * N + (b % 7) * 4 + dx))))
  let BN = range(49).map(b => [b % 7 > 0 ? b - 1 : -1, b % 7 < 6 ? b + 1 : -1, b >= 7 ? b - 7 : -1, b < 42 ? b + 7 : -1].filter(j => j >= 0))
  let BC = range(49).map(b => [(b % 7) * 4 + 2, floor(b / 7) * 4 + 2])

  // From kind alone: what each tile is
  let ready = len(kind) == NN && len(lvl) == NN && len(pw) == NN
  let zt = kind.map(k => k >= 10 && k <= 15 ? floor((k - 10) / 2) : -1)
  let ISR = kind.map(k => k == 3 || k == 6)
  let COND = kind.map(k => k >= 3 && k != 5)
  let SRC = kind.map(k => k >= 20 && k <= 24)
  let SHORE = range(NN).map(i => kind[i] != 2 && ((i % N > 0 && kind[i - 1] == 2) || (i % N < N - 1 && kind[i + 1] == 2) || (i >= N && kind[i - N] == 2) || (i < NN - N && kind[i + N] == 2)))
  // a road on the tile or next to it, then within two tiles
  let R1 = range(NN).map(i => ISR[i] || (i % N > 0 && ISR[i - 1]) || (i % N < N - 1 && ISR[i + 1]) || (i >= N && ISR[i - N]) || (i < NN - N && ISR[i + N]))
  let ROAD = range(NN).map(i => R1[i] || (i % N > 0 && R1[i - 1]) || (i % N < N - 1 && R1[i + 1]) || (i >= N && R1[i - N]) || (i < NN - N && R1[i + N]))
  let SVC = range(NN).filter(i => kind[i] >= 20).map(i => [get(BLD, str(kind[i]))].map(b => {i: i, k: kind[i], x: i % N + 0.5, y: floor(i / N) + 0.5, c: b.c, r: b.r ?? 1, s: b.s ?? 0})[0])
  let supply = sum(SVC.filter(s => s.c == "plant").map(s => get(BLD, str(s.k)).mw))
  let nRoads = count(kind, k => k == 3)
  let nBridges = count(kind, k => k == 6)
  let nLines = count(kind, k => k == 4 || k == 7)
  let nZones = count(zt, t => t >= 0)
  let costRoads = nRoads * 0.75 + nBridges * 2 + nLines * 0.2
  let costSvc = sum(SVC.map(s => get(BLD, str(s.k)).up))
  let hasHall = any(SVC, s => s.k == 53)
  let hasStadium = any(SVC, s => s.k == 52)

  // From lvl: people and jobs
  let popT = range(NN).map(i => zt[i] == 0 && lvl[i] > 0 ? RES[lvl[i]] : 0)
  let jobT = range(NN).map(i => zt[i] >= 1 && lvl[i] > 0 ? (zt[i] == 1 ? JC[lvl[i]] : JI[lvl[i]]) : 0)
  let pop = sum(popT)
  let jobsC = sum(range(NN).map(i => zt[i] == 1 ? jobT[i] : 0))
  let jobsI = sum(jobT) - jobsC
  let jobs = jobsC + jobsI
  let unemp = pop > 0 ? clamp((pop * 0.5 - jobs) / max(1, pop * 0.5), 0, 1) : 0

  // Power: what's joined to a plant, what it all uses, and who goes dark when there isn't enough
  let CONNECT = pw.map(d => d < CAP)
  let mwUse = sum(range(NN).map(i => !CONNECT[i] ? 0 : (zt[i] >= 0 ? max(0, lvl[i]) * MWU[zt[i]] : (kind[i] >= 30 ? 3 : 0))))
  let pratio = mwUse <= supply ? 1 : supply / max(1, mwUse)
  let powered = range(NN).map(i => CONNECT[i] && (pratio >= 1 || hash(i, month) < pratio))
  let nDark = count(range(NN), i => zt[i] >= 0 && !CONNECT[i])

  // Services reach the blocks around them, less with distance; only while powered (parks need none).
  let SON = SVC.filter(s => s.c == "leis" || powered[s.i])
  let WSRC = SON.filter(s => s.c == "water")
  let wsupply = sum(WSRC.map(s => s.k == 30 ? (SHORE[s.i] ? 2400 : 1200) : 500))
  let WCOVB = range(49).map(b => any(WSRC, s => sqrt(pow(s.x - BC[b][0], 2) + pow(s.y - BC[b][1], 2)) < (s.k == 30 ? 12 : 8)))
  let wdem = sum(range(NN).map(i => zt[i] >= 0 && lvl[i] > 0 && WCOVB[BLK[i]] ? lvl[i] * WU[zt[i]] : 0))
  let wratio = wdem <= wsupply ? 1 : wsupply / max(1, wdem)
  let WATERED = range(NN).map(i => WCOVB[BLK[i]] && (wratio >= 1 || hash(i, month, 5) < wratio))
  let SPOL = SON.filter(s => s.c == "police")
  let SFIRE = SON.filter(s => s.c == "fire")
  let SHEALTH = SON.filter(s => s.c == "health")
  let SEDU = SON.filter(s => s.c == "edu")
  let SLEIS = SON.filter(s => s.c == "leis")
  let POLC = range(49).map(b => min(1.5, sum(SPOL.map(s => s.s * max(0, 1 - sqrt(pow(s.x - BC[b][0], 2) + pow(s.y - BC[b][1], 2)) / s.r)))))
  let FIREC = range(49).map(b => min(1.5, sum(SFIRE.map(s => s.s * max(0, 1 - sqrt(pow(s.x - BC[b][0], 2) + pow(s.y - BC[b][1], 2)) / s.r)))))
  let HEALTH = range(49).map(b => min(1.5, sum(SHEALTH.map(s => s.s * max(0, 1 - sqrt(pow(s.x - BC[b][0], 2) + pow(s.y - BC[b][1], 2)) / s.r)))))
  let EDU = range(49).map(b => min(1.5, sum(SEDU.map(s => s.s * max(0, 1 - sqrt(pow(s.x - BC[b][0], 2) + pow(s.y - BC[b][1], 2)) / s.r)))))
  let LEIS = range(49).map(b => min(1.5, sum(SLEIS.map(s => s.s * max(0, 1 - sqrt(pow(s.x - BC[b][0], 2) + pow(s.y - BC[b][1], 2)) / s.r)))))

  // Per block: people, jobs, roads, what pollutes; then traffic, pollution and crime
  let bPop = BT.map(t => sum(t.map(i => popT[i])))
  let bJob = BT.map(t => sum(t.map(i => jobT[i])))
  let bRoad = BT.map(t => count(t, i => ISR[i]))
  let bSmoke = BT.map(t => sum(t.map(i => zt[i] == 2 ? max(0, lvl[i]) * 6 : (kind[i] == 20 ? 70 : (kind[i] == 21 ? 25 : 0)))))
  let TRIPS = range(49).map(b => bPop[b] * 0.4 + bJob[b] * 0.5 + 0.5 * sum(BN[b].map(j => bPop[j] * 0.4 + bJob[j] * 0.5)))
  let ROOM = range(49).map(b => bRoad[b] * 80 + 0.5 * sum(BN[b].map(j => bRoad[j] * 80)))
  let CONG = range(49).map(b => clamp(TRIPS[b] / max(30, ROOM[b]), 0, 1.5))
  let POLL = range(49).map(b => clamp((bSmoke[b] + 0.4 * sum(BN[b].map(j => bSmoke[j]))) / 3 + CONG[b] * 12, 0, 100))
  let CRIME = range(49).map(b => clamp(bPop[b] / 25 + bJob[b] / 50 + unemp * 30 - POLC[b] * 70, 0, 100))
  let LV = range(NN).map(i => [BLK[i]].map(b => clamp(44 + LEIS[b] * 20 + (SHORE[i] ? 12 : 0) + (EDU[b] + HEALTH[b]) * 6 + POLC[b] * 5 - POLL[b] * 0.4 - CRIME[b] * 0.25 - max(0, CONG[b] - 0.5) * 14, 0, 100))[0])

  // What the people think, weighed by where they live
  let pW = max(1, pop)
  let avgPoll = sum(range(49).map(b => POLL[b] * bPop[b])) / pW
  let avgCrime = sum(range(49).map(b => CRIME[b] * bPop[b])) / pW
  let avgHealth = sum(range(49).map(b => min(1, HEALTH[b]) * bPop[b])) / pW
  let avgEdu = sum(range(49).map(b => min(1, EDU[b]) * bPop[b])) / pW
  let avgFire = sum(range(49).map(b => min(1, FIREC[b]) * bPop[b])) / pW
  let avgLeis = sum(range(49).map(b => min(1, LEIS[b]) * bPop[b])) / pW
  let avgLV = pop > 0 ? sum(range(NN).map(i => LV[i] * popT[i])) / pW : 0
  let maxCong = max(0, CONG.sortBy(c => -c).first() ?? 0)
  let approval = clamp(round(64 - ((taxR + taxC + taxI) / 3 - 7) * 5 - avgPoll * 0.25 - avgCrime * 0.3 + avgHealth * 8 + avgEdu * 6 + avgLeis * 8 - unemp * 40 - (1 - pratio) * 40 - (1 - wratio) * 20 + (hasHall ? 6 : 0)), 0, 100)

  // Demand for each zone, -1 to 1: homes follow jobs, shops follow people, industry the outside market
  let demR = clamp(clamp((jobs * 2.1 + 160 - pop) / max(160, pop * 0.3), -1, 1) - (taxR - 7) * 0.09 + (approval - 50) / 150, -1, 1)
  let demC = clamp(clamp((pop * 0.32 + 30 - jobsC) / max(60, pop * 0.12), -1, 1) - (taxC - 7) * 0.09 + (hasStadium ? 0.1 : 0), -1, 1)
  let demI = clamp(clamp((pop * 0.3 + 60 + month * 2 - jobsI) / max(80, pop * 0.12), -1, 1) - (taxI - 7) * 0.09, -1, 1)
  let DEM = [demR, demC, demI]
  // How much a lot wants to grow, and how far it can: light zones stop at 2, dense ones need water,
  // land value, health care (homes) and education (industry) to go higher.
  let SCORE = range(NN).map(i => zt[i] < 0 ? 0 : [[zt[i], BLK[i]]].map(q =>
    DEM[q[0]] + (LV[i] - 40) / (q[0] == 2 ? 160 : 70) - (q[0] == 0 ? POLL[q[1]] / 110 : 0) - CRIME[q[1]] / 160 - CONG[q[1]] * (q[0] == 0 ? 0.12 : 0.3))[0])
  let CAPL = range(NN).map(i => zt[i] < 0 ? 0 : [[zt[i], BLK[i]]].map(q =>
    kind[i] % 2 == 0 || !WATERED[i] ? 2
    : (q[0] == 0 ? (LV[i] >= 48 && HEALTH[q[1]] >= 0.3 ? 4 : (LV[i] >= 32 ? 3 : 2))
    : (q[0] == 1 ? (LV[i] >= 50 ? 4 : (LV[i] >= 34 ? 3 : 2))
    : (EDU[q[1]] >= 0.9 ? 4 : (EDU[q[1]] >= 0.3 ? 3 : 2)))))[0])

  // The month's budget
  let incR = pop * taxR / 100 * 0.8
  let incC = jobsC * taxC / 100 * 1.1
  let incI = jobsI * taxI / 100 * 1.0
  let loanPay = min(loan, 120)
  let net = incR + incC + incI - costRoads - costSvc - loanPay

  // The advisor's line: the most pressing thing first
  let freeR = count(range(NN), i => zt[i] == 0 && lvl[i] == 0)
  let freeC = count(range(NN), i => zt[i] == 1 && lvl[i] == 0)
  let freeI = count(range(NN), i => zt[i] == 2 && lvl[i] == 0)
  let nDense = count(range(NN), i => zt[i] >= 0 && kind[i] % 2 == 1)
  let advice = nRoads + nBridges == 0 ? "start with a road: roads, then drag across the land"
    : (nZones == 0 ? "zone homes beside the road, and industry for jobs"
    : (supply == 0 ? "zones need power: build a plant, joined by road or line"
    : (nDark > 0 ? "${nDark} lots have no power: join them to a plant"
    : (pratio < 1 ? "power shortage: build another plant"
    : (redMonths > 0 ? "the budget is in the red: raise taxes or cut costs"
    : (nDense > 0 && len(WSRC) == 0 ? "dense zones need water to grow tall: build a pump"
    : (wratio < 1 ? "water shortage: build more pumps"
    : (len(burn) > 0 ? "fire! fire stations put fires out"
    : ((taxR + taxC + taxI) / 3 > 11 && (demR < 0 || demC < 0 || demI < 0) ? "taxes are too high: people and business are leaving"
    : (avgCrime > 35 ? "crime is rising: build police stations"
    : (unemp > 0.15 ? "people need jobs: zone shops and industry"
    : (demR > 0.4 && freeR == 0 ? "people want to move in: zone more homes"
    : (demC > 0.4 && freeC == 0 ? "shops want to open: zone more shops"
    : (demI > 0.4 && freeI == 0 ? "industry wants land: zone more industry"
    : (avgPoll > 35 ? "pollution is high: keep industry away, plant parks"
    : (maxCong > 1 ? "traffic jams: build more roads"
    : (pop > 1500 && avgFire < 0.3 ? "most homes have no fire station nearby"
    : (pop > 1500 && avgEdu < 0.25 ? "build schools: industry needs skilled workers"
    : (pop > 800 && avgHealth < 0.25 ? "build clinics: people want health care"
    : "the city is doing fine")))))))))))))))))))

  // The camera: which tiles are on screen, back to front
  let span = CX / hw + 1.5
  let vTop = cv - (CY - TOP) / hh - 2
  let vBot = cv + (H - CY) / hh + 6
  let ty0 = clamp(floor((vTop - (cu + span) - 1) / 2), 0, N - 1)
  let ty1 = clamp(ceil((vBot - (cu - span) - 1) / 2), 0, N - 1)
  let tx0 = clamp(floor((cu - span + vTop - 1) / 2), 0, N - 1)
  let tx1 = clamp(ceil((cu + span + vBot - 1) / 2), 0, N - 1)
  let vis = flatten(range(ty0, ty1 + 1).map(ty => range(tx0, tx1 + 1).filter(tx => abs(tx - ty - cu) <= span && tx + ty + 1 >= vTop && tx + ty + 1 <= vBot).map(tx => ty * N + tx)))
  let visB = ready ? vis.filter(i => kind[i] != 0) : []
  // Detail by how much there is to draw: 2 is everything, 1 plain boxes, 0 one shape a tile
  let nBld = count(visB, i => kind[i] >= 20 || (zt[i] >= 0 && lvl[i] != 0))
  let nRd = count(visB, i => ISR[i] || kind[i] == 4 || kind[i] == 7)
  let det = overlay != "" ? 0 : (tw >= 32 && nBld * 5 + nRd * 4 + (len(visB) - nBld - nRd) * 2 < 1400 ? 2 : (tw >= 22 && nBld * 2 + nRd * 2 + len(visB) < 1500 ? 1 : 0))

  // What moves, on screen only
  let CARS = det >= 1 && speed > 0 ? visB.filter(i => ISR[i] && CONG[BLK[i]] > 0.04).take(80) : []
  let SMOKERS = det >= 1 ? visB.filter(i => (zt[i] == 2 && lvl[i] >= 2) || kind[i] == 20 || kind[i] == 24).take(24) : []
  let TURBINES = det >= 1 ? visB.filter(i => kind[i] == 22).take(20) : []
  let DARK = visB.filter(i => (zt[i] >= 0 && lvl[i] > 0 || kind[i] >= 30) && !powered[i]).take(40)

  // The selection being dragged: a road or line runs along the start's row, then down the end's
  // column; zones and the bulldozer cover a rectangle, at most 12 x 12.
  let T = tool >= 0 ? TOOLS[tool] : null
  let isLine = T != null && (T.k == 3 || T.k == 4)
  let sx0 = ds % N
  let sy0 = floor(ds / N)
  let ex0 = de % N
  let ey0 = floor(de / N)
  let PIN = ds < 0 || de < 0 || T == null ? [] : range(NN).filter(i => [[i % N, floor(i / N)]].map(c => isLine
    ? (c[1] == sy0 && c[0] >= min(sx0, ex0) && c[0] <= max(sx0, ex0)) || (c[0] == ex0 && c[1] >= min(sy0, ey0) && c[1] <= max(sy0, ey0))
    : c[0] >= min(sx0, ex0) && c[0] <= max(sx0, ex0) && c[1] >= min(sy0, ey0) && c[1] <= max(sy0, ey0))[0])
  let POKS = T == null ? [] : PIN.filter(i => [[kind[i], lvl[i]]].map(q =>
    T.k == -2 ? q[0] != 0 && q[0] != 2
    : (T.k == 3 ? q[0] == 0 || q[0] == 1 || q[0] == 2 || q[0] == 4 || q[0] == 5 || q[0] == 7 || (q[0] >= 10 && q[0] <= 15 && q[1] == 0)
    : (T.k == 4 ? q[0] == 0 || q[0] == 1 || q[0] == 2 || q[0] == 5 || (q[0] >= 10 && q[0] <= 15 && q[1] == 0)
    : (T.k < 20 ? q[0] == 0 || q[0] == 1 || q[0] == 5 || (q[0] >= 10 && q[0] <= 15 && q[1] == 0 && q[0] != T.k)
    : q[0] == 0 || q[0] == 1 || q[0] == 5 || (q[0] >= 10 && q[0] <= 15 && q[1] == 0)))))[0])
  let PCOST = T == null ? 0 : sum(POKS.map(i => T.k == -2 ? (kind[i] >= 20 || lvl[i] != 0 ? 30 : 5)
    : (kind[i] == 2 || kind[i] == 7 ? T.cost * 5 : T.cost + (kind[i] == 1 || kind[i] == 5 ? 5 : 0))))
  let PSET = reduce(POKS, (m, i) => set(m, str(i), 1), {})

  // the tile being looked at
  let SK = sel >= 0 && ready ? kind[sel] : -1
  let SL = sel >= 0 && ready ? lvl[sel] : 0
  let SB = sel >= 0 ? BLK[sel] : 0

  // A new map: a river across it, a lake, and woods.
  when len(kind) != NN {
    let s = random(1000000)
    let r0 = 2 + hash(s, 1) * 8
    let rs = 0.45 + hash(s, 2) * 0.4
    let ph = hash(s, 3) * 6
    let lx = 16 + hash(s, 4) * 8
    let ly = 2 + hash(s, 5) * 6
    let lr = 2 + hash(s, 6) * 1.5
    kind = range(NN).map(i => [[i % N + 0.5, floor(i / N) + 0.5]].map(c =>
      abs(c[1] - (r0 + c[0] * rs + 2.2 * sin(c[0] * 0.38 + ph))) < 1.15 || pow(c[0] - lx, 2) + pow(c[1] - ly, 2) < lr * lr ? 2
      : ((hash(s, floor(c[0] / 4), floor(c[1] / 4)) > 0.6 && hash(s, i) > 0.3) || hash(s, i, 9) > 0.96 ? 1 : 0))[0])
    lvl = range(NN).map(i => 0)
    pw = range(NN).map(i => CAP)
    pwStable = true
    funds = 20000
    month = 0
    week = 0
    taxR = 8
    taxC = 8
    taxI = 8
    loan = 0
    redMonths = 0
    over = false
    mile = 0
    popHist = []
    cashHist = []
    lastNet = 0
    cu = 0
    cv = N + 1
    zoom = 3
    burn = []
    sel = -1
    tool = 6
    cat = 2
    panel = ""
    overlay = ""
    speed = 1
    toast = "welcome, mayor! drag a road across the land to begin"
    toastLeft = 10
    toastAt = -1
  }

  on kind { pwStable = false }

  every 1s {
    if toastLeft > 0 { toastLeft = toastLeft - 1 }
  }

  // Build what was dragged or tapped.
  on commit {
    if T != null && ready {
      if len(POKS) == 0 {
        toast = T.k == -2 ? "nothing to bulldoze there" : (T.k >= 20 ? "build on open land or an empty lot" : "can't build there")
        toastLeft = 3
        toastAt = -1
      } else if funds < PCOST {
        toast = "not enough money: $${fmtNum(PCOST)} needed"
        toastLeft = 4
        toastAt = -1
      } else {
        funds = funds - PCOST
        kind = kind.map((k, i) => PSET[str(i)] == 1
          ? (T.k == -2 ? (k == 6 || k == 7 ? 2 : 0) : (T.k == 3 ? (k == 2 || k == 7 ? 6 : 3) : (T.k == 4 ? (k == 2 ? 7 : 4) : T.k)))
          : k)
        lvl = lvl.map((l, i) => PSET[str(i)] == 1 ? 0 : l)
        burn = burn.filter(f => PSET[str(f.i)] != 1)
        if T.k == 30 && !SHORE[POKS[0]] {
          toast = "a pump pumps twice as much beside water"
          toastLeft = 4
          toastAt = -1
        }
      }
    }
    ds = -1
    de = -1
  }

  every frame {
    if ready && !over {
      // Power flows out from the plants a few tiles a step, even while paused.
      if !pwStable {
        pwT = pwT + dt
        if pwT >= 0.15 {
          pwT = 0
          let p1 = pw.map((d, i) => SRC[i] ? 0 : (!COND[i] ? CAP : min(CAP, 1 + min(i % N > 0 ? pw[i - 1] : CAP, i % N < N - 1 ? pw[i + 1] : CAP, i >= N ? pw[i - N] : CAP, i < NN - N ? pw[i + N] : CAP))))
          let p2 = p1.map((d, i) => SRC[i] ? 0 : (!COND[i] ? CAP : min(CAP, 1 + min(i % N > 0 ? p1[i - 1] : CAP, i % N < N - 1 ? p1[i + 1] : CAP, i >= N ? p1[i - N] : CAP, i < NN - N ? p1[i + N] : CAP))))
          let p3 = p2.map((d, i) => SRC[i] ? 0 : (!COND[i] ? CAP : min(CAP, 1 + min(i % N > 0 ? p2[i - 1] : CAP, i % N < N - 1 ? p2[i + 1] : CAP, i >= N ? p2[i - N] : CAP, i < NN - N ? p2[i + N] : CAP))))
          pwStable = p3 == p2
          pw = p3
        }
      }
      if speed > 0 {
        acc = acc + dt
        if acc >= [1, 1.4, 0.7, 0.35][speed] {
          acc = 0
          week = week + 1
          // Each lot has a chance a week to grow a level, decline, or be abandoned without power.
          lvl = lvl.map((L, i) => zt[i] < 0 || random() >= 0.06 ? L
            : (!ROAD[i] ? (L > 0 ? L - 1 : L)
            : (!powered[i] ? (L > 0 && random() < 0.35 ? -L : L)
            : (L < 0 ? (SCORE[i] > 0.05 ? -L : (SCORE[i] < -0.5 && random() < 0.08 ? 0 : L))
            : (SCORE[i] > 0.1 + L * 0.1 && L < CAPL[i] ? L + 1
            : ((SCORE[i] < -0.3 || L > CAPL[i]) && L > 0 ? L - 1 : L))))))
          // Fires: they start where no fire station reaches, spread, and burn down to rubble unless put out.
          let burnt = burn.filter(f => f.t >= 6).map(f => f.i)
          let out = burn.filter(f => f.t < 6 && random() < 0.06 + FIREC[BLK[f.i]] * 0.4).map(f => f.i)
          let spread = burn.filter(f => f.t == 2 && random() < 0.7 - FIREC[BLK[f.i]] * 0.5).map(f => [random(4)].map(r =>
              r == 0 ? (f.i % N > 0 ? f.i - 1 : -1) : (r == 1 ? (f.i % N < N - 1 ? f.i + 1 : -1) : (r == 2 ? (f.i >= N ? f.i - N : -1) : (f.i < NN - N ? f.i + N : -1))))[0])
            .filter(j => j >= 0 && (kind[j] == 1 || kind[j] >= 20 || (zt[j] >= 0 && lvl[j] != 0)) && !any(burn, f => f.i == j)).unique()
          let start = disasters && random() < 0.02 ? [random(NN)].filter(j => ((zt[j] >= 0 && lvl[j] > 0) || (kind[j] >= 40 && kind[j] <= 45)) && random() > FIREC[BLK[j]] * 0.85 && !any(burn, f => f.i == j)) : []
          burn = take(burn.filter(f => f.t < 6 && !any(out, o => o == f.i)).map(f => merge(f, {t: f.t + 1})) + spread.map(j => {i: j, t: 0}) + start.map(j => {i: j, t: 0}), 30)
          if len(burnt) > 0 {
            kind = kind.map((k, i) => any(burnt, j => j == i) ? 5 : k)
            lvl = lvl.map((l, i) => any(burnt, j => j == i) ? 0 : l)
          }
          if len(start) > 0 {
            toast = "fire! tap here to see it"
            toastLeft = 6
            toastAt = start[0]
          }
          // A month: the budget, the history, milestones
          if week % 4 == 0 {
            let n2 = round(net)
            month = month + 1
            funds = funds + n2
            lastNet = n2
            loan = max(0, loan - loanPay)
            redMonths = funds < 0 ? redMonths + 1 : 0
            popHist = drop(popHist + [pop], max(0, len(popHist) + 1 - 120))
            cashHist = drop(cashHist + [funds], max(0, len(cashHist) + 1 - 120))
            let reached = len(MILES.filter(m => pop >= m.p))
            if reached > mile {
              mile = reached
              toast = MILES[reached - 1].s
              toastLeft = 8
              toastAt = -1
            } else if redMonths == 1 {
              toast = "the city is in the red: raise taxes, cut costs or borrow"
              toastLeft = 8
              toastAt = -1
            }
            if redMonths >= 12 { over = true }
          }
        }
      }
    }
  }

  // A bevelled button, pressed in while on
  component Btn(label = "", sub = "", art = null, pal = null, on = false, dim = false, fsize = 10) {
    Column {
      fill: width
      background: on ? HI : LO
      padding: [0, 0, 2, 2]
      Column {
        fill: width
        background: on ? LO : HI
        padding: [2, 2, 0, 0]
        Column {
          fill: width
          gap: 2
          align: center
          padding: [4, 5]
          background: on ? GOLD : FACE
          if art != null {
            Canvas { width: 20; height: 20; layer(dim ? 0.35 : 1) { sprite(art, 0, 0, 2, palette: pal ?? IPAL) } }
          }
          if label != "" {
            Text { text: label; font: SILK; fontSize: fsize; maxLines: 1; align: center; color: on ? LO : (dim ? DIM : INK) }
          }
          if sub != "" {
            Text { text: sub; font: SILK; fontSize: 8; maxLines: 1; align: center; color: on ? FACE : (dim ? DIM : GOLD) }
          }
        }
      }
    }
  }
  // A readout sunk into the panel, like an LCD
  component Lcd(value, art = null, tint = LCDG, sub = "", subTint = DIM) {
    Row {
      fill: width
      background: HI
      padding: [0, 0, 2, 2]
      Row {
        weight: 1
        background: LO
        padding: [2, 2, 0, 0]
        Row {
          weight: 1
          gap: 5
          align: center
          padding: [6, 5]
          background: LCD
          if art != null {
            Canvas { width: len(art[0]) * 2; height: len(art) * 2; sprite(art, 0, 0, 2, palette: IPAL) }
          }
          Text { text: value; font: SILK; fontSize: 12; maxLines: 1; color: tint }
          if sub != "" {
            Text { text: sub; font: SILK; fontSize: 8; maxLines: 1; color: subTint }
          }
        }
      }
    }
  }
  component Stat(label, value, tint = INK) {
    Row {
      fill: width
      gap: 6
      align: center
      Text { text: label; font: PIX; fontSize: 13; color: DIM; weight: 1; maxLines: 1 }
      Text { text: value; font: SILK; fontSize: 10; color: tint }
    }
  }

  Box {
    fill: true
    background: #142019
    // The ground: grass in tiles, the map's earthen edge, and the grid while building
    Shader {
      fill: true
      fallback: #5f9143
      uniforms: { cu: cu, cv: cv, hw: hw, hh: hh, cx: CX, cy: CY, dpw: W, n: N, grid: tool >= 0 ? 1 : 0, g1: #6fa04e, g2: #62944a, g3: #7fb05a, vo: #142019, cl: #9a7650, cr: #6b4f36 }
      code: """
        uniform float cu;
        uniform float cv;
        uniform float hw;
        uniform float hh;
        uniform float cx;
        uniform float cy;
        uniform float dpw;
        uniform float n;
        uniform float grid;
        uniform half4 g1;
        uniform half4 g2;
        uniform half4 g3;
        uniform half4 vo;
        uniform half4 cl;
        uniform half4 cr;
        float rnd(float2 c) { return fract(sin(dot(c, float2(12.9898, 78.233))) * 43758.5453); }
        half4 main(float2 p) {
          float2 q = p * (dpw / size.x);
          float u = cu + (q.x - cx) / hw;
          float v = cv + (q.y - cy) / hh;
          float fx = (u + v) * 0.5;
          float fy = (v - u) * 0.5;
          if (fx >= 0.0 && fy >= 0.0 && fx < n && fy < n) {
            float2 t = floor(float2(fx, fy));
            half4 c = mix(g1, g2, half(rnd(t)));
            if (rnd(floor(float2(fx, fy) * 4.0)) > 0.86) { c = mix(c, g3, 0.6); }
            if (grid > 0.5) {
              float2 f = fract(float2(fx, fy));
              float e = min(min(f.x, f.y), min(1.0 - f.x, 1.0 - f.y));
              if (e < 0.7 / hw) { c = mix(c, half4(0.0, 0.0, 0.0, 1.0), 0.2); }
            }
            return c;
          }
          // the earth under the map's two front edges
          float dv = 0.45 * hw / hh;
          float v2 = v - dv;
          float gx = (u + v2) * 0.5;
          float gy = (v2 - u) * 0.5;
          if (gx >= 0.0 && gy >= 0.0 && gx < n && gy < n) {
            float d = fx >= n ? v - (2.0 * n - u) : v - (2.0 * n + u);
            if (d < dv * 0.14) { return mix(g2, half4(0.0, 0.0, 0.0, 1.0), 0.25); }
            half4 c = fx >= n ? cr : cl;
            if (fract(d / dv * 3.0) < 0.12) { c = mix(c, half4(0.0, 0.0, 0.0, 1.0), 0.12); }
            return c;
          }
          return mix(vo, half4(0.0, 0.0, 0.0, 1.0), half(clamp(q.y / (dpw * 4.0), 0.0, 0.5)));
        }
      """
    }

    // The tiles with something on them
    Canvas {
      fill: true
      for i in visB {
        let tx = i % N
        let ty = floor(i / N)
        let sx = CX + (tx - ty - cu) * hw
        let sy = CY + (tx + ty + 1 - cv) * hh
        let k = kind[i]
        let L = lvl[i]
        let A = abs(L)
        let z = zt[i]
        let hv = hash(i, 11)
        if k == 2 || k == 6 || k == 7 {
          path([[sx, sy - hh - 0.5], [sx + hw + 0.5, sy], [sx, sy + hh + 0.5], [sx - hw - 0.5, sy]], fill: hv < 0.5 ? #3d7bb0 : #4282b8, closed: true)
          if det == 2 && hash(i, 4) > 0.75 {
            line(sx - hw * 0.3, sy + hh * 0.1, sx + hw * 0.05, sy + hh * 0.1, stroke: alpha(#ffffff, 0.35), width: 1.2, cap: round)
          }
        }
        if k == 3 || k == 6 {
          // a road: a strip each way it joins another road, flat on the ground
          let jl = tx > 0 && ISR[i - 1]
          let jr = tx < N - 1 && ISR[i + 1]
          let ju = ty > 0 && ISR[i - N]
          let jd = ty < N - 1 && ISR[i + N]
          let asph = k == 6 ? #8a8070 : #4a4d52
          if det == 0 {
            path([[sx, sy - hh], [sx + hw, sy], [sx, sy + hh], [sx - hw, sy]], fill: asph, closed: true)
          } else {
            let xl = jl ? 0 : 0.28
            let xr = jr ? 1 : 0.72
            let yl = ju ? 0 : 0.28
            let yr = jd ? 1 : 0.72
            if jl || jr || !(ju || jd) {
              path([[sx + (xl - 0.28) * hw, sy + (xl + 0.28 - 1) * hh], [sx + (xr - 0.28) * hw, sy + (xr + 0.28 - 1) * hh], [sx + (xr - 0.72) * hw, sy + (xr + 0.72 - 1) * hh], [sx + (xl - 0.72) * hw, sy + (xl + 0.72 - 1) * hh]], fill: asph, closed: true)
            }
            if ju || jd {
              path([[sx + (0.28 - yl) * hw, sy + (0.28 + yl - 1) * hh], [sx + (0.72 - yl) * hw, sy + (0.72 + yl - 1) * hh], [sx + (0.72 - yr) * hw, sy + (0.72 + yr - 1) * hh], [sx + (0.28 - yr) * hw, sy + (0.28 + yr - 1) * hh]], fill: asph, closed: true)
            }
            if det == 2 && tw >= 46 {
              if jl || jr {
                line(sx + (xl - 0.5) * hw, sy + (xl - 0.5) * hh, sx + (xr - 0.5) * hw, sy + (xr - 0.5) * hh, stroke: alpha(#e8dca0, 0.55), width: 1)
              }
              if ju || jd {
                line(sx + (0.5 - yl) * hw, sy + (yl - 0.5) * hh, sx + (0.5 - yr) * hw, sy + (yr - 0.5) * hh, stroke: alpha(#e8dca0, 0.55), width: 1)
              }
            }
          }
        } else if k == 4 || k == 7 {
          // a pylon, with wires to the next ones
          let ph2 = tw * 0.55
          line(sx, sy, sx, sy - ph2, stroke: #5a4a3a, width: det == 2 ? 1.6 : 1.2)
          if det >= 1 {
            if tx < N - 1 && (kind[i + 1] == 4 || kind[i + 1] == 7 || SRC[i + 1]) {
              line(sx, sy - ph2, sx + hw, sy + hh - ph2, stroke: alpha(#2a2420, 0.7), width: 1)
            }
            if ty < N - 1 && (kind[i + N] == 4 || kind[i + N] == 7 || SRC[i + N]) {
              line(sx, sy - ph2, sx - hw, sy + hh - ph2, stroke: alpha(#2a2420, 0.7), width: 1)
            }
          }
        } else if k == 1 {
          let o = (hash(i, 3) - 0.5) * hw * 0.5
          circle(sx + o, sy - hh * 0.6, hw * 0.36, fill: hv < 0.5 ? #2f6a35 : #3a7a3a)
          if det == 2 {
            circle(sx + o - hw * 0.1, sy - hh * 0.85, hw * 0.17, fill: #5a9a4e)
            circle(sx - o * 1.4, sy + hh * 0.1, hw * 0.24, fill: #2a5e30)
          }
        } else if k == 5 {
          path([[sx, sy - hh * 0.8], [sx + hw * 0.8, sy], [sx, sy + hh * 0.8], [sx - hw * 0.8, sy]], fill: #7a6a58, closed: true)
          if det == 2 {
            rect(sx - hw * 0.3, sy - hh * 0.4, hw * 0.25, hh * 0.3, fill: #5a4c40)
            rect(sx + hw * 0.1, sy - hh * 0.1, hw * 0.2, hh * 0.3, fill: #9a8a74)
          }
        } else if z >= 0 && L == 0 {
          path([[sx, sy - hh], [sx + hw, sy], [sx, sy + hh], [sx - hw, sy]], fill: alpha(ZC[z], k % 2 == 1 ? 0.62 : 0.38), closed: true)
          if det == 2 {
            path([[sx, sy - hh * 0.55], [sx + hw * 0.55, sy], [sx, sy + hh * 0.55], [sx - hw * 0.55, sy]], stroke: alpha(#ffffff, 0.35), width: 1, closed: true)
          }
        } else if z >= 0 {
          // a zone's building, by its kind and level
          let f = [[0, 0.5, 0.66, 0.74, 0.64], [0, 0.66, 0.78, 0.76, 0.62], [0, 0.72, 0.84, 0.86, 0.9]][z][A]
          let hp = [[0, 0.2, 0.26, 0.8, 1.45], [0, 0.24, 0.38, 1.05, 2.0], [0, 0.24, 0.3, 0.42, 0.52]][z][A] * (0.85 + hv * 0.4) * tw
          let v4 = floor(hash(i, 5) * 4)
          let wall = L < 0 ? #77716b : (z == 0 ? [#ece0c8, #e8c9a4, #d6dfe6, #f0e4d4][v4] : (z == 1 ? [#8fb3d9, #7ec4c4, #a9b8c9, #c9b48f][v4] : [#a39586, #8d9399, #9b8a72, #a8a090][v4]))
          let a = hw * f
          let b = hh * f
          let cl = mix(wall, #000000, 0.14)
          let cr = mix(wall, #000000, 0.34)
          if det == 0 {
            path([[sx - a, sy - hp], [sx, sy - b - hp], [sx + a, sy - hp], [sx + a, sy], [sx, sy + b], [sx - a, sy]], fill: cl, closed: true)
          } else if det == 1 {
            path([[sx - a, sy], [sx, sy + b], [sx + a, sy], [sx + a, sy - hp], [sx, sy + b - hp], [sx - a, sy - hp]], fill: cr, closed: true)
            path([[sx, sy - b - hp], [sx + a, sy - hp], [sx, sy + b - hp], [sx - a, sy - hp]], fill: z == 0 && A <= 2 ? (L < 0 ? #5a5450 : [#b5543e, #8e593b, #59698c, #6c4a3a][v4]) : mix(wall, #ffffff, 0.12), closed: true)
          } else if z == 0 && A <= 2 {
            // a house with a pitched roof
            let rh = hw * 0.34 * f
            let roof = L < 0 ? #5a5450 : [#b5543e, #8e593b, #59698c, #6c4a3a][v4]
            path([[sx - a, sy], [sx, sy + b], [sx, sy + b - hp], [sx - a, sy - hp]], fill: cl, closed: true)
            path([[sx, sy + b], [sx + a, sy], [sx + a, sy - hp], [sx + a / 2, sy + b / 2 - hp - rh], [sx, sy + b - hp]], fill: cr, closed: true)
            path([[sx - a / 2, sy - b / 2 - hp - rh], [sx + a / 2, sy + b / 2 - hp - rh], [sx + a, sy - hp], [sx, sy - b - hp]], fill: mix(roof, #000000, 0.3), closed: true)
            path([[sx - a, sy - hp], [sx, sy + b - hp], [sx + a / 2, sy + b / 2 - hp - rh], [sx - a / 2, sy - b / 2 - hp - rh]], fill: roof, closed: true)
          } else {
            // a block: windows in bands on taller ones
            let glass = L < 0 ? #4a4744 : (z == 1 ? #3c5f86 : (z == 0 ? #7f9fb8 : #6a6560))
            let floors = max(1, round(hp / (tw * 0.13)))
            let bands = flatten(range(floors).map(j => [cl, cl, mix(glass, #000000, 0.1), cl]))
            let bandsR = flatten(range(floors).map(j => [cr, cr, mix(glass, #000000, 0.35), cr]))
            path([[sx - a, sy], [sx, sy + b], [sx, sy + b - hp], [sx - a, sy - hp]], fill: A >= 3 || z == 1 ? linear(sx - a, sy - hp, sx - a - 0.4 * hp, sy - 0.2 * hp, bands) : cl, closed: true)
            path([[sx, sy + b], [sx + a, sy], [sx + a, sy - hp], [sx, sy + b - hp]], fill: A >= 3 || z == 1 ? linear(sx + a, sy - hp, sx + a + 0.4 * hp, sy - 0.2 * hp, bandsR) : cr, closed: true)
            path([[sx, sy - b - hp], [sx + a, sy - hp], [sx, sy + b - hp], [sx - a, sy - hp]], fill: mix(wall, #ffffff, 0.12), closed: true)
            if z == 1 && A <= 2 && L > 0 {
              // a shop's awning
              path([[sx - a, sy - hp * 0.45], [sx, sy + b - hp * 0.45], [sx + hw * 0.08, sy + b - hp * 0.45 + hh * 0.12], [sx - a + hw * 0.08, sy - hp * 0.45 + hh * 0.12]], fill: [#c84a3a, #e0a030, #3a8a5a, #8a4ab0][v4], closed: true)
            }
            if z == 2 && A >= 2 {
              rect(sx + a * 0.35, sy - hp - tw * 0.42, tw * 0.07, tw * 0.42, fill: L < 0 ? #555050 : #6b5d52)
            }
            if A == 4 && z < 2 {
              path([[sx, sy - b * 0.5 - hp - tw * 0.1], [sx + a * 0.5, sy - hp - tw * 0.1], [sx + a * 0.5, sy - hp], [sx, sy + b * 0.5 - hp], [sx - a * 0.5, sy - hp], [sx - a * 0.5, sy - hp - tw * 0.1]], fill: mix(wall, #000000, 0.25), closed: true)
            }
          }
        } else if k >= 20 {
          let B = get(BLD, str(k))
          let a = hw * B.f
          let b = hh * B.f
          let hp = B.h * tw
          let wall = B.wall
          if k == 50 || k == 51 || k == 52 {
            path([[sx, sy - hh * 0.92], [sx + hw * 0.92, sy], [sx, sy + hh * 0.92], [sx - hw * 0.92, sy]], fill: wall, closed: true)
            if k == 50 && det >= 1 {
              circle(sx - hw * 0.3, sy - hh * 0.5, hw * 0.24, fill: #2f6a35)
              circle(sx + hw * 0.25, sy - hh * 0.2, hw * 0.2, fill: #3a7a3a)
              if det == 2 { line(sx - hw * 0.5, sy + hh * 0.3, sx + hw * 0.4, sy - hh * 0.5, stroke: #d8cca0, width: 1.5) }
            } else if k == 51 && det >= 1 {
              scale(1, 0.5, sx, sy) { circle(sx, sy, hw * 0.34, fill: #8aa0b0) }
              if det == 2 { scale(1, 0.5, sx, sy) { circle(sx, sy, hw * 0.22, fill: #6fb0e0) } }
            } else if k == 52 {
              scale(1, 0.5, sx, sy - hh * 0.2) { circle(sx, sy - hh * 0.2, hw * 0.86, fill: #9aa0a6) }
              scale(1, 0.5, sx, sy - hh * 0.4) { circle(sx, sy - hh * 0.4, hw * 0.56, fill: #5aa04a) }
              if det == 2 { scale(1, 0.5, sx, sy - hh * 0.4) { circle(sx, sy - hh * 0.4, hw * 0.56, stroke: #e8e8e8, width: 1) } }
            }
          } else if k == 22 {
            // a wind turbine's mast: the blades turn on the layer above
            line(sx, sy, sx, sy - tw * 0.95, stroke: #e6eaec, width: max(1.5, tw * 0.05), cap: round)
            circle(sx, sy - tw * 0.95, max(1.5, tw * 0.05), fill: #c8ccd0)
          } else if k == 23 {
            path([[sx, sy - hh * 0.85], [sx + hw * 0.85, sy], [sx, sy + hh * 0.85], [sx - hw * 0.85, sy]], fill: #5a6470, closed: true)
            path([[sx, sy - hh * 0.75 - tw * 0.06], [sx + hw * 0.75, sy - tw * 0.06], [sx, sy + hh * 0.75 - tw * 0.12], [sx - hw * 0.75, sy - tw * 0.12]], fill: det == 2 ? linear(sx - hw, sy, sx + hw, sy, [#2c4a72, #4a72a8, #2c4a72, #4a72a8, #2c4a72, #4a72a8, #2c4a72]) : #33507a, closed: true)
          } else if k == 31 {
            line(sx - hw * 0.15, sy + hh * 0.1, sx - hw * 0.15, sy - tw * 0.5, stroke: #6a747c, width: 1.5)
            line(sx + hw * 0.15, sy + hh * 0.1, sx + hw * 0.15, sy - tw * 0.5, stroke: #6a747c, width: 1.5)
            scale(1, 0.5, sx, sy - tw * 0.5) { circle(sx, sy - tw * 0.5, hw * 0.34, fill: #5c86a8) }
            rect(sx - hw * 0.34, sy - tw * 0.78, hw * 0.68, tw * 0.28, fill: #7fa8c8)
            scale(1, 0.5, sx, sy - tw * 0.78) { circle(sx, sy - tw * 0.78, hw * 0.34, fill: #a8c8e0) }
          } else if k == 54 {
            path([[sx - a, sy], [sx, sy + b], [sx, sy + b - hp], [sx - a * 0.4, sy - hp - b * 0.3]], fill: mix(wall, #000000, 0.1), closed: true)
            path([[sx, sy + b], [sx + a, sy], [sx + a * 0.4, sy - hp - b * 0.3], [sx, sy + b - hp]], fill: mix(wall, #000000, 0.3), closed: true)
            path([[sx - a * 0.4, sy - hp - b * 0.3], [sx, sy + b - hp], [sx + a * 0.4, sy - hp - b * 0.3], [sx, sy - hp - tw * 0.3]], fill: #f0dca0, closed: true)
          } else {
            // a plain building in its colors, then what marks it out
            if det == 0 {
              path([[sx - a, sy - hp], [sx, sy - b - hp], [sx + a, sy - hp], [sx + a, sy], [sx, sy + b], [sx - a, sy]], fill: mix(wall, #000000, 0.14), closed: true)
            } else {
              path([[sx - a, sy], [sx, sy + b], [sx, sy + b - hp], [sx - a, sy - hp]], fill: mix(wall, #000000, 0.12), closed: true)
              path([[sx, sy + b], [sx + a, sy], [sx + a, sy - hp], [sx, sy + b - hp]], fill: mix(wall, #000000, 0.32), closed: true)
              path([[sx, sy - b - hp], [sx + a, sy - hp], [sx, sy + b - hp], [sx - a, sy - hp]], fill: B.top, closed: true)
            }
            if det >= 1 {
              if k == 20 {
                rect(sx - a * 0.1, sy - hp - tw * 0.75, tw * 0.1, tw * 0.75, fill: #5a4e46)
                rect(sx + a * 0.35, sy - hp - tw * 0.6, tw * 0.1, tw * 0.6, fill: #5a4e46)
              } else if k == 21 {
                circle(sx - a * 0.3, sy - hp - tw * 0.12, tw * 0.17, fill: #dde2e6)
                circle(sx + a * 0.35, sy - hp - tw * 0.02, tw * 0.15, fill: #c8cfd6)
              } else if k == 24 {
                path([[sx - a * 0.55, sy - hp], [sx - a * 0.32, sy - hp - tw * 0.55], [sx - a * 0.4, sy - hp - tw * 0.85], [sx + a * 0.4, sy - hp - tw * 0.85], [sx + a * 0.32, sy - hp - tw * 0.55], [sx + a * 0.55, sy - hp]], fill: #b8bcc0, closed: true)
                scale(1, 0.4, sx, sy - hp - tw * 0.85) { circle(sx, sy - hp - tw * 0.85, a * 0.4, fill: #8a8e92) }
              } else if k == 30 {
                rect(sx - hw * 0.05, sy - hp - tw * 0.2, tw * 0.08, tw * 0.2, fill: #3a5a78)
              } else if k == 40 {
                rect(sx - hw * 0.12, sy - hp - tw * 0.06, hw * 0.24, tw * 0.06, fill: #e8e8f0)
              } else if k == 41 {
                path([[sx - a * 0.8, sy - b * 0.2], [sx - a * 0.2, sy + b * 0.8], [sx - a * 0.2, sy + b * 0.8 - hp * 0.6], [sx - a * 0.8, sy - b * 0.2 - hp * 0.6]], fill: #f0d0a0, closed: true)
              } else if k == 42 || k == 43 {
                line(sx - hw * 0.28, sy - hp - hh * 0.28, sx + hw * 0.28, sy - hp + hh * 0.28, stroke: #d83a3a, width: max(1.5, tw * 0.06))
                line(sx + hw * 0.28, sy - hp - hh * 0.28, sx - hw * 0.28, sy - hp + hh * 0.28, stroke: #d83a3a, width: max(1.5, tw * 0.06))
              } else if k == 44 {
                line(sx + a * 0.6, sy - hp, sx + a * 0.6, sy - hp - tw * 0.45, stroke: #5a4a3a, width: 1.2)
                rect(sx + a * 0.6, sy - hp - tw * 0.45, tw * 0.18, tw * 0.1, fill: #d83a3a)
              } else if k == 45 || k == 53 {
                scale(1, 0.75, sx, sy - hp) { circle(sx, sy - hp - tw * 0.05, a * 0.42, fill: k == 45 ? #8a6aaa : #d8b860) }
              }
            }
          }
        }
      }

      // Data maps: a color over each block, or each tile for power and traffic
      if overlay == "power" {
        for i in visB {
          if COND[i] && kind[i] != 3 && kind[i] != 6 {
            let tx = i % N
            let ty = floor(i / N)
            let sx = CX + (tx - ty - cu) * hw
            let sy = CY + (tx + ty + 1 - cv) * hh
            path([[sx, sy - hh], [sx + hw, sy], [sx, sy + hh], [sx - hw, sy]], fill: alpha(!CONNECT[i] ? #e53935 : (powered[i] ? #f2d23a : #ff8a3a), 0.6), closed: true)
          }
        }
      } else if overlay == "traffic" {
        for i in visB {
          if ISR[i] {
            let tx = i % N
            let ty = floor(i / N)
            let sx = CX + (tx - ty - cu) * hw
            let sy = CY + (tx + ty + 1 - cv) * hh
            path([[sx, sy - hh], [sx + hw, sy], [sx, sy + hh], [sx - hw, sy]], fill: mix(#4caf50, #e53935, clamp(CONG[BLK[i]], 0, 1)), closed: true)
          }
        }
      } else if overlay != "" {
        for b in range(49) {
          let v = overlay == "pollution" ? POLL[b] / 100 : (overlay == "crime" ? CRIME[b] / 100 : (overlay == "land value" ? sum(BT[b].map(i => LV[i])) / 1600 : (overlay == "water" ? (WCOVB[b] ? 1 : 0) : (overlay == "police" ? POLC[b] : (overlay == "fire" ? FIREC[b] : (overlay == "health" ? HEALTH[b] : (overlay == "education" ? EDU[b] : LEIS[b])))))))
          let bad = overlay == "pollution" || overlay == "crime"
          let x0 = (b % 7) * 4
          let y0 = floor(b / 7) * 4
          path([[CX + (x0 - y0 - cu) * hw, CY + (x0 + y0 - cv) * hh], [CX + (x0 + 4 - y0 - cu) * hw, CY + (x0 + 4 + y0 - cv) * hh], [CX + (x0 - y0 - cu) * hw, CY + (x0 + y0 + 8 - cv) * hh], [CX + (x0 - y0 - 4 - cu) * hw, CY + (x0 + y0 + 4 - cv) * hh]],
            fill: alpha(overlay == "land value" ? mix(#e53935, #4caf50, clamp(v, 0, 1)) : (bad ? #e53935 : #3a8ee6), overlay == "land value" ? 0.5 : clamp(v, 0, 1) * 0.65), closed: true)
        }
      }
    }

    // What moves, the selection, and the touches
    Canvas {
      fill: true
      ripple: false
      for i in CARS {
        let tx = i % N
        let ty = floor(i / N)
        let sx = CX + (tx - ty - cu) * hw
        let sy = CY + (tx + ty + 1 - cv) * hh
        let ax = (tx > 0 && ISR[i - 1]) || (tx < N - 1 && ISR[i + 1])
        let cg = CONG[BLK[i]]
        for j in range(cg > 0.5 ? 2 : 1) {
          let ln = hash(i, j, 2) < 0.5
          let p0 = time * (0.45 - min(cg, 1) * 0.3) + hash(i, j)
          let ph = ln ? p0 - floor(p0) : 1 - (p0 - floor(p0))
          let fx = ax ? ph : (ln ? 0.4 : 0.6)
          let fy = ax ? (ln ? 0.6 : 0.4) : ph
          circle(sx + (fx - fy) * hw, sy + (fx + fy - 1) * hh - tw * 0.02, max(1.2, tw * 0.045), fill: [#e8e4dc, #d83a3a, #3a6ad8, #f0c040, #2a2a2a][floor(hash(i, j, 3) * 5)])
        }
      }
      for i in SMOKERS {
        let tx = i % N
        let ty = floor(i / N)
        let sx = CX + (tx - ty - cu) * hw
        let sy = CY + (tx + ty + 1 - cv) * hh
        let top = kind[i] == 20 ? sy - tw * 1.2 : (kind[i] == 24 ? sy - tw * 1.2 : sy - tw * 0.85)
        for j in range(2) {
          let p0 = time * 0.35 + hash(i, j) + j * 0.5
          let ph = p0 - floor(p0)
          circle(sx + tw * 0.08 + ph * tw * 0.3, top - ph * tw * 0.7, tw * (0.08 + ph * 0.14), fill: alpha(kind[i] == 24 ? #ffffff : #c8c4bc, 0.55 * (1 - ph)))
        }
      }
      for i in TURBINES {
        let tx = i % N
        let ty = floor(i / N)
        let sx = CX + (tx - ty - cu) * hw
        let hy = CY + (tx + ty + 1 - cv) * hh - tw * 0.95
        for j in range(3) {
          rotate(time * 140 + hash(i) * 360 + j * 120, sx, hy) { line(sx, hy, sx, hy - tw * 0.42, stroke: #f4f6f7, width: max(1.2, tw * 0.035), cap: round) }
        }
      }
      for f in burn {
        let tx = f.i % N
        let ty = floor(f.i / N)
        let sx = CX + (tx - ty - cu) * hw
        let sy = CY + (tx + ty + 1 - cv) * hh
        for j in range(3) {
          let fl = sin(time * 900 + j * 97 + f.i) * 0.5 + 0.5
          let ox = (j - 1) * hw * 0.32
          path([[sx + ox - hw * 0.16, sy], [sx + ox + hw * 0.16, sy], [sx + ox, sy - tw * (0.35 + fl * 0.3)]], fill: j == 1 ? #ffb030 : #e8502a, closed: true)
        }
        let p0 = time * 0.5 + f.i * 0.13
        let ph = p0 - floor(p0)
        circle(sx, sy - tw * (0.6 + ph * 0.8), tw * (0.12 + ph * 0.2), fill: alpha(#3a3632, 0.6 * (1 - ph)))
      }
      if floor(time * 2) % 2 == 0 {
        for i in DARK {
          let tx = i % N
          let ty = floor(i / N)
          let sx = CX + (tx - ty - cu) * hw
          let sy = CY + (tx + ty + 1 - cv) * hh - tw * 0.75
          let s = max(5, tw * 0.16)
          path([[sx + s * 0.2, sy - s], [sx - s * 0.5, sy + s * 0.1], [sx, sy + s * 0.1], [sx - s * 0.2, sy + s], [sx + s * 0.5, sy - s * 0.1], [sx, sy - s * 0.1]], fill: #f2d23a, stroke: #2a2420, width: 1, closed: true)
        }
      }
      // what a drag would build, and what it costs
      if dragging || ds >= 0 {
        for i in POKS {
          let tx = i % N
          let ty = floor(i / N)
          let sx = CX + (tx - ty - cu) * hw
          let sy = CY + (tx + ty + 1 - cv) * hh
          path([[sx, sy - hh], [sx + hw, sy], [sx, sy + hh], [sx - hw, sy]], fill: alpha(T.k == -2 ? #e53935 : (T.k >= 10 && T.k <= 15 ? ZC[floor((T.k - 10) / 2)] : #ffffff), 0.45), stroke: alpha(#ffffff, 0.7), width: 1, closed: true)
        }
        if len(POKS) > 0 {
          rect(CX - 72, MAPT + 10, 148, 30, fill: HI)
          rect(CX - 74, MAPT + 8, 148, 30, fill: LO)
          rect(CX - 72, MAPT + 10, 144, 26, fill: LCD)
          text("${len(POKS)} · $${fmtNum(PCOST)}", CX, MAPT + 23, size: 12, align: center, color: PCOST > funds ? RED : LCDG, font: SILK)
        }
      }
      if sel >= 0 && tool < 0 {
        let tx = sel % N
        let ty = floor(sel / N)
        let sx = CX + (tx - ty - cu) * hw
        let sy = CY + (tx + ty + 1 - cv) * hh
        path([[sx, sy - hh], [sx + hw, sy], [sx, sy + hh], [sx - hw, sy]], stroke: floor(time * 3) % 2 == 0 ? #ffffff : #f2d23a, width: 2, closed: true)
      }

      onPress: {
        if y > MAPT && y < MAPB && tool >= 0 && (TOOLS[tool].k < 20) {
          let u = cu + (x - CX) / hw
          let v = cv + (y - CY) / hh
          let fx = floor((u + v) / 2)
          let fy = floor((v - u) / 2)
          if fx >= 0 && fy >= 0 && fx < N && fy < N {
            ds = fy * N + fx
            de = ds
            dragging = true
          }
        }
      }
      onDrag: {
        if dragging {
          let u = cu + (x - CX) / hw
          let v = cv + (y - CY) / hh
          let fx = clamp(floor((u + v) / 2), max(0, sx0 - 11), min(N - 1, sx0 + 11))
          let fy = clamp(floor((v - u) / 2), max(0, sy0 - 11), min(N - 1, sy0 + 11))
          de = fy * N + fx
        } else {
          cu = clamp(cu - dx / hw, -N, N)
          cv = clamp(cv - dy / hh, 0, 2 * N)
        }
      }
      onDragEnd: {
        if dragging {
          dragging = false
          commit = commit + 1
        }
      }
      onTap: {
        dragging = false
        if y > MAPT && y < MAPB {
          let u = cu + (x - CX) / hw
          let v = cv + (y - CY) / hh
          let fx = floor((u + v) / 2)
          let fy = floor((v - u) / 2)
          if fx >= 0 && fy >= 0 && fx < N && fy < N {
            if tool >= 0 {
              ds = fy * N + fx
              de = ds
              commit = commit + 1
            } else {
              sel = sel == fy * N + fx ? -1 : fy * N + fx
            }
          } else {
            sel = -1
          }
        }
      }
    }

    Column {
      fill: true
      gap: 0
      // The top bar: money, people and the date on LCDs, the demand meter, the advisor, approval, speed and the panels
      Column {
        fill: width
        height: TOP + HUDH
        gap: 0
        background: BAR
        Column {
          fill: width
          weight: 1
          padding: [8, TOP + 6, 8, 0]
          gap: 5
          Row {
            fill: width
            gap: 5
            align: center
            Lcd { value: "$${fmtNum(funds)}"; art: ICON.COIN; tint: funds < 0 ? RED : LCDG; sub: "${lastNet >= 0 ? "+" : ""}${fmtNum(lastNet)}"; subTint: lastNet < 0 ? RED : DIM; weight: 1.4 }
            Lcd { value: fmtNum(pop); art: ICON.PERSON; tint: GOLD; weight: 1 }
            Lcd { value: "${MONTHS[month % 12]} ${1970 + floor(month / 12)}"; tint: INK; width: 96 }
          }
          Row {
            fill: width
            gap: 5
            align: center
            // demand for homes, shops and industry: bars up for more wanted, down for too many
            Canvas {
              width: 52
              height: 36
              rect(0, 0, 52, 36, fill: HI)
              rect(0, 0, 50, 34, fill: LO)
              rect(2, 2, 48, 32, fill: LCD)
              line(5, 16, 47, 16, stroke: alpha(DIM, 0.5), width: 1)
              for j in range(3) {
                let d = round(DEM[j] * 6) * 2
                rect(7 + j * 14, d >= 0 ? 16 - d : 16, 10, max(1, abs(d)), fill: ZC[j])
                text(["R", "C", "I"][j], 12 + j * 14, 30, size: 7, align: center, font: SILK, color: ZC[j])
              }
            }
            Row {
              weight: 1
              background: HI
              padding: [0, 0, 2, 2]
              Row {
                weight: 1
                background: LO
                padding: [2, 2, 0, 0]
                Row {
                  weight: 1
                  height: 32
                  padding: [7, 0]
                  align: center
                  background: LCD
                  Text { text: advice; font: PIX; fontSize: 12; color: GOLD; maxLines: 2; weight: 1 }
                }
              }
            }
            Lcd { value: "${approval}%"; art: approval >= 60 ? ICON.HAPPY : (approval >= 40 ? ICON.MEH : ICON.SAD); tint: approval < 40 ? RED : (approval >= 60 ? LCDG : GOLD); width: 72 }
          }
          Row {
            fill: width
            gap: 4
            align: center
            for s in range(4) {
              Box { width: 40; onTap: speed = s; Btn { label: ["II", ">", ">>", ">>>"][s]; on: speed == s } }
            }
            Spacer { weight: 1 }
            Box { width: 62; onTap: panel = panel == "data" ? "" : "data"; Btn { label: "data"; on: panel == "data" || overlay != "" } }
            Box { width: 74; onTap: panel = panel == "budget" ? "" : "budget"; Btn { label: "budget"; on: panel == "budget" } }
            Box { width: 56; onTap: { panel = panel == "city" ? "" : "city"; confirmNew = false }; Btn { label: "city"; on: panel == "city" } }
          }
        }
        Spacer { fill: width; height: 2; background: HI }
        Spacer { fill: width; height: 3; background: LO }
      }

      Box {
        fill: width
        weight: 1
        // zoom
        Column {
          fill: true
          align: end
          padding: [0, 10, 10, 0]
          gap: 6
          Box { width: 40; onTap: zoom = min(4, zoom + 1); Btn { label: "+"; fsize: 15 } }
          Box { width: 40; onTap: zoom = max(0, zoom - 1); Btn { label: "-"; fsize: 15 } }
        }
        // a note from city hall, or a fire to look at
        if toastLeft > 0 && toast != "" {
          Column {
            fill: true
            justify: end
            align: center
            padding: [14, 0, 14, 10]
            Column {
              fill: width
              background: HI
              padding: [2, 2, 0, 0]
              onTap: {
                if toastAt >= 0 {
                  cu = toastAt % N - floor(toastAt / N)
                  cv = toastAt % N + floor(toastAt / N) + 1
                  zoom = max(zoom, 3)
                }
                toastLeft = 0
              }
              Column {
                fill: width
                background: LO
                padding: [0, 0, 2, 2]
                Row {
                  fill: width
                  gap: 8
                  align: center
                  padding: [10, 7]
                  background: toastAt >= 0 ? #6a2420 : FACE
                  Canvas { width: 20; height: 20; sprite(toastAt >= 0 ? ICON.FIRE : ICON.HALL, 0, 0, 2, palette: IPAL) }
                  Text { text: toast; font: PIX; fontSize: 13; color: INK; weight: 1 }
                }
              }
            }
          }
        }
        // what's on the tile being looked at
        if sel >= 0 && tool < 0 && panel == "" && ready {
          Column {
            fill: width
            padding: [8, 8, 58, 0]
            Column {
              fill: width
              background: HI
              padding: [2, 2, 0, 0]
              Column {
                fill: width
                background: LO
                padding: [0, 0, 2, 2]
                Column {
                  fill: width
                  background: FACE
                  gap: 0
                  Row {
                    fill: width
                    align: center
                    padding: [8, 4, 4, 4]
                    background: TBAR
                    Text {
                      text: SK >= 20 ? get(BLD, str(SK)).n : (SK >= 10 ? ZNAME[SK - 10] : TNAME[SK])
                      font: SILK
                      fontSize: 11
                      color: GOLD
                      weight: 1
                      maxLines: 1
                    }
                    Box { width: 28; onTap: sel = -1; Btn { label: "x" } }
                  }
                  Column {
                    fill: width
                    gap: 2
                    padding: [10, 6, 10, 8]
                    if SK >= 10 && SK <= 15 {
                      Stat { label: SL < 0 ? "abandoned" : (SL == 0 ? "empty lot" : "level"); value: SL == 0 ? "" : "${abs(SL)} of ${CAPL[sel]}" }
                      Stat { label: SK <= 11 ? "residents" : "jobs"; value: fmtNum(SK <= 11 ? popT[sel] : jobT[sel]) }
                      Stat { label: "power · water"; value: "${powered[sel] ? "yes" : "no"} · ${WATERED[sel] ? "yes" : "no"}"; tint: powered[sel] ? INK : RED }
                      Stat { label: "land value"; value: str(round(LV[sel])) }
                      Stat { label: "pollution · crime · traffic"; value: "${round(POLL[SB])} · ${round(CRIME[SB])} · ${round(CONG[SB] * 100)}%" }
                      Text {
                        font: PIX
                        fontSize: 13
                        color: GOLD
                        text: !ROAD[sel] ? "needs a road within 2 tiles"
                          : (!powered[sel] ? (CONNECT[sel] ? "not enough power: build another plant" : "no power: join it to a plant")
                          : (SL < 0 ? "left empty: people won't move here"
                          : (SL >= CAPL[sel] ? (SK % 2 == 0 ? "light zones stop at level 2" : (!WATERED[sel] ? "needs water to grow taller" : (SK <= 11 ? "grows with land value and health care" : (SK <= 13 ? "grows with land value" : "grows with education"))))
                          : (SCORE[sel] > 0.1 + SL * 0.1 ? "growing" : "no demand here now: see the demand bars, pollution, crime and traffic"))))
                      }
                    } else if SK >= 20 {
                      Stat { label: "upkeep"; value: "$${get(BLD, str(SK)).up}/mo" }
                      if SK <= 24 {
                        Stat { label: "makes"; value: "${get(BLD, str(SK)).mw} MW" }
                        Stat { label: "the city uses"; value: "${round(mwUse)} of ${supply} MW"; tint: pratio < 1 ? RED : INK }
                      } else if SK <= 31 {
                        Stat { label: "pumps"; value: SK == 30 ? (SHORE[sel] ? "2400 (by water)" : "1200 (2400 by water)") : "500" }
                        Stat { label: "the city uses"; value: "${round(wdem)} of ${wsupply}"; tint: wratio < 1 ? RED : INK }
                      } else {
                        Stat { label: "reaches"; value: "${get(BLD, str(SK)).r} tiles" }
                      }
                      Stat { label: "power"; value: SK >= 50 || SK <= 24 ? "needs none" : (powered[sel] ? "yes" : "no: closed"); tint: SK < 50 && SK > 24 && !powered[sel] ? RED : INK }
                    } else {
                      Stat { label: "land value"; value: str(round(LV[sel])) }
                      if SK == 3 || SK == 6 {
                        Stat { label: "traffic"; value: "${round(CONG[SB] * 100)}%"; tint: CONG[SB] > 1 ? RED : INK }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }

      // The bottom: what the tool does, the tools of the open tab, and the tabs
      Column {
        fill: width
        height: BARH + BOT
        gap: 0
        background: BAR
        Spacer { fill: width; height: 3; background: HI }
        Column {
          fill: width
          gap: 6
          padding: [8, 6, 8, BOT + 6]
          Row {
            fill: width
            background: HI
            padding: [0, 0, 2, 2]
            Row {
              weight: 1
              background: LO
              padding: [2, 2, 0, 0]
              Row {
                weight: 1
                padding: [8, 4]
                background: LCD
                Text {
                  text: tool >= 0 ? "${T.n}${T.sub == "drag" ? "" : " · " + T.sub} · $${fmtNum(T.cost)}${T.k < 20 ? " a tile · drag on the map" : " · tap the map"}"
                    : (cat == 0 ? "drag to move · tap a tile to look at it" : "pick a tool")
                  font: PIX
                  fontSize: 13
                  maxLines: 1
                  color: LCDG
                  weight: 1
                }
              }
            }
          }
          Row {
            fill: width
            height: 48
            gap: 6
            if cat == 0 {
              Column {
                weight: 1
                justify: center
                gap: 3
                Text { text: "demand  R ${round(demR * 100)}   C ${round(demC * 100)}   I ${round(demI * 100)}"; font: SILK; fontSize: 10; color: INK; align: center }
                Text { text: "power ${round(mwUse)}/${supply} MW · water ${round(wdem)}/${wsupply}"; font: SILK; fontSize: 9; color: DIM; align: center }
              }
            } else {
              for t in TOOLS.filter(t => t.cat == cat) {
                Box {
                  width: BW
                  onTap: {
                    if mile < t.u {
                      toast = "unlocks at ${fmtNum(MILES[t.u - 1].p)} people"
                      toastLeft = 3
                      toastAt = -1
                    } else {
                      tool = tool == t.id ? -1 : t.id
                      sel = -1
                    }
                  }
                  Btn { art: ICON[t.ic]; pal: merge(IPAL, {c: t.c ?? #78c850}); sub: mile < t.u ? "lock" : "$${fmtNum(t.cost)}"; on: tool == t.id; dim: mile < t.u }
                }
              }
            }
          }
          Row {
            fill: width
            gap: 4
            for c in range(6) {
              Box {
                weight: 1
                onTap: {
                  cat = c
                  if c == 0 || (tool >= 0 && TOOLS[tool].cat != c) { tool = -1 }
                  dragging = false
                }
                Btn { art: ICON[CATIC[c]]; label: CATS[c]; on: cat == c; fsize: 8 }
              }
            }
          }
        }
      }
    }

    // Windows over the map
    if panel != "" && !over {
      Column {
        fill: true
        padding: [10, TOP + HUDH + 8, 10, BOT + BARH + 8]
        Column {
          fill: width
          background: HI
          padding: [2, 2, 0, 0]
          Column {
            fill: width
            background: LO
            padding: [0, 0, 2, 2]
            Column {
              fill: width
              gap: 0
              background: FACE
              Row {
                fill: width
                align: center
                padding: [10, 4, 4, 4]
                background: TBAR
                Text { text: panel == "budget" ? "budget · a month" : (panel == "city" ? "city hall" : "data maps"); font: SILK; fontSize: 12; color: GOLD; weight: 1 }
                Box { width: 28; onTap: panel = ""; Btn { label: "x" } }
              }
              Column {
                fill: width
                scroll: true
                gap: 6
                padding: [12, 10, 12, 12]
                if panel == "budget" {
                  Row {
                    fill: width
                    align: center
                    gap: 6
                    Text { text: "homes tax"; font: PIX; fontSize: 14; color: INK; weight: 1 }
                    Box { width: 30; onTap: taxR = max(0, taxR - 1); Btn { label: "-"; fsize: 12 } }
                    Text { text: "${taxR}%"; font: SILK; fontSize: 12; color: GOLD; width: 40; align: center }
                    Box { width: 30; onTap: taxR = min(20, taxR + 1); Btn { label: "+"; fsize: 12 } }
                    Text { text: "+$${fmtNum(incR)}"; font: SILK; fontSize: 10; color: GRN; width: 66; align: end }
                  }
                  Row {
                    fill: width
                    align: center
                    gap: 6
                    Text { text: "shops tax"; font: PIX; fontSize: 14; color: INK; weight: 1 }
                    Box { width: 30; onTap: taxC = max(0, taxC - 1); Btn { label: "-"; fsize: 12 } }
                    Text { text: "${taxC}%"; font: SILK; fontSize: 12; color: GOLD; width: 40; align: center }
                    Box { width: 30; onTap: taxC = min(20, taxC + 1); Btn { label: "+"; fsize: 12 } }
                    Text { text: "+$${fmtNum(incC)}"; font: SILK; fontSize: 10; color: GRN; width: 66; align: end }
                  }
                  Row {
                    fill: width
                    align: center
                    gap: 6
                    Text { text: "industry tax"; font: PIX; fontSize: 14; color: INK; weight: 1 }
                    Box { width: 30; onTap: taxI = max(0, taxI - 1); Btn { label: "-"; fsize: 12 } }
                    Text { text: "${taxI}%"; font: SILK; fontSize: 12; color: GOLD; width: 40; align: center }
                    Box { width: 30; onTap: taxI = min(20, taxI + 1); Btn { label: "+"; fsize: 12 } }
                    Text { text: "+$${fmtNum(incI)}"; font: SILK; fontSize: 10; color: GRN; width: 66; align: end }
                  }
                  Text { text: "higher taxes slow growth and cost approval"; font: PIX; fontSize: 12; color: DIM }
                  Spacer { height: 2 }
                  Stat { label: "roads and lines"; value: "-$${fmtNum(costRoads)}"; tint: RED }
                  Stat { label: "power, water and services"; value: "-$${fmtNum(costSvc)}"; tint: RED }
                  if loan > 0 {
                    Stat { label: "loan (${fmtNum(loan)} owed)"; value: "-$${fmtNum(loanPay)}"; tint: RED }
                  }
                  Stat { label: "a month"; value: "${net >= 0 ? "+" : "-"}$${fmtNum(abs(net))}"; tint: net < 0 ? RED : GRN }
                  Stat { label: "a year"; value: "${net >= 0 ? "+" : "-"}$${fmtNum(abs(net) * 12)}"; tint: net < 0 ? RED : GRN }
                  Spacer { height: 2 }
                  if loan == 0 {
                    Row {
                      Box {
                        width: 170
                        onTap: {
                          funds = funds + 10000
                          loan = 12000
                          toast = "borrowed $10,000: $120 a month until $12,000 is paid back"
                          toastLeft = 5
                          toastAt = -1
                        }
                        Btn { label: "borrow $10,000" }
                      }
                    }
                  } else {
                    Text { text: "pay off the loan before borrowing again"; font: PIX; fontSize: 12; color: DIM }
                  }
                  if redMonths > 0 {
                    Text { text: "in the red for ${redMonths} month${redMonths == 1 ? "" : "s"}: after 12 the council removes you"; font: PIX; fontSize: 13; color: RED }
                  }
                } else if panel == "city" {
                  Stat { label: "population"; value: fmtNum(pop) }
                  Stat { label: "jobs: shops · industry"; value: "${fmtNum(jobsC)} · ${fmtNum(jobsI)}" }
                  Stat { label: "unemployed"; value: "${round(unemp * 100)}%"; tint: unemp > 0.15 ? RED : INK }
                  Stat { label: "approval"; value: "${approval}%" }
                  Stat { label: "power"; value: "${round(mwUse)} of ${supply} MW"; tint: pratio < 1 ? RED : INK }
                  Stat { label: "water"; value: "${round(wdem)} of ${wsupply}"; tint: wratio < 1 ? RED : INK }
                  Stat { label: "land value · pollution · crime"; value: "${round(avgLV)} · ${round(avgPoll)} · ${round(avgCrime)}" }
                  Stat { label: "fire · health · school cover"; value: "${round(avgFire * 100)}% · ${round(avgHealth * 100)}% · ${round(avgEdu * 100)}%" }
                  if mile < len(MILES) {
                    Stat { label: "next milestone"; value: "${fmtNum(MILES[mile].p)} people"; tint: GOLD }
                  }
                  if len(popHist) >= 2 {
                    Text { text: "population, last ${len(popHist)} months"; font: PIX; fontSize: 12; color: DIM }
                    Sparkline { values: popHist; min: 0; area: true; height: 40; fill: width; color: GRN; background: LCD }
                    Text { text: "money"; font: PIX; fontSize: 12; color: DIM }
                    Sparkline { values: cashHist; area: true; height: 40; fill: width; color: GOLD; background: LCD }
                  }
                  Row {
                    fill: width
                    gap: 6
                    Box { width: 110; onTap: disasters = !disasters; Btn { label: disasters ? "fires: on" : "fires: off"; on: disasters } }
                    Spacer { weight: 1 }
                    Box {
                      width: 140
                      onTap: {
                        if confirmNew {
                          kind = []
                          confirmNew = false
                        } else {
                          confirmNew = true
                        }
                      }
                      Btn { label: confirmNew ? "sure? tap again" : "new city"; on: confirmNew }
                    }
                  }
                } else {
                  Flow {
                    fill: width
                    gap: 6
                    for o in ["power", "water", "land value", "pollution", "crime", "traffic", "police", "fire", "health", "education", "parks", "off"] {
                      Box { width: DW; onTap: { overlay = o == "off" || overlay == o ? "" : o; panel = "" }; Btn { label: o; on: overlay == o } }
                    }
                  }
                  Text { text: "power: yellow is powered, orange short of power, red not joined to a plant. the rest: the deeper the color, the more"; font: PIX; fontSize: 12; color: DIM }
                }
              }
            }
          }
        }
      }
    }

    // Removed from office
    if over {
      Column {
        fill: true
        justify: center
        padding: 24
        background: alpha(#000000, 0.7)
        Column {
          fill: width
          background: HI
          padding: [2, 2, 0, 0]
          Column {
            fill: width
            background: LO
            padding: [0, 0, 2, 2]
            Column {
              fill: width
              gap: 10
              align: center
              padding: [16, 16]
              background: FACE
              Canvas { width: 36; height: 28; sprite(ICON.SAD, 0, 0, 4, palette: IPAL) }
              Text { text: "removed from office"; font: SILK; fontSize: 16; color: RED; align: center }
              Text { text: "a year in the red was too long for the council. ${fmtNum(pop)} people lived in your city."; font: PIX; fontSize: 14; color: INK; align: center }
              Box { width: 180; onTap: kind = []; Btn { label: "start a new city"; on: true } }
            }
          }
        }
      }
    }
  }
}
