widget "agents" {
  page: 2
  order: 2
  size: 3x5
  minSize: 3x3

  meta { owl: 10 }

  // The coding agents installed in Linux, as the launcher knows them: no shell command needed.
  source ag = android.agents

  Column {
    gap: 6
    Text { text: "coding agents"; style: muted }
    if len(ag.installed) == 0 {
      Text { text: "none installed yet"; style: small }
    }
    Flow {
      gap: 6
      for a in ag.installed key a.bin {
        Button { text: a.name; onTap: open(a.key) }
      }
    }
    Button { text: "manage"; color: muted; onTap: launcher("agents") }
  }
}
