app "last outpost" {
  meta { owl: 21; description: "Tower defense: build and upgrade guns, cannons, frost and tesla towers by the road, hold twenty waves and a boss, and spend medals on research that carries you to ever harder fronts"; version: "1.0"; license: "MIT"; category: "games" }
  // How it works: the battle is on a grid of 9 by 13 tiles. The road is a list of eight corners in
  // tile units, and everything that walks it has `d`, how far along it is; `every frame` moves `d` by
  // its speed times `dt` and works out the spot on the road from that. The Shader draws the ground and
  // the road from the same eight corners, so a map is just its corners and its colors.
  // Towers fire when their time comes round: guns and tesla hit at once (a tracer, a zigzag), cannon
  // shells fly and burst where the target was, frost slows all in reach. Hits are summed per enemy
  // and taken off once a frame.
  // Between battles is command: medals from every wave held buy research that persists (damage,
  // range, more scrap, more hearts, two more towers). Fronts don't stop: each makes enemies 25%
  // tougher than the last, so research is what carries you further.
  title: ""
  statusBar: false
  edge: true
  back: mode != "base"
  onBack: {
    if mode == "play" {
      lost = true
      fled = true
      mode = "over"
      overAt = gt
      waveOn = false
    } else {
      mode = "base"
      foes = []
      towers = []
      shells = []
      fx = []
      booms = []
      pops = []
      queue = []
      sel = null
    }
  }
  fps: mode == "play" ? 60 : 30
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" shape-rendering="crispEdges"><clipPath id="t"><rect width="256" height="256" rx="56"/></clipPath><g clip-path="url(#t)"><path fill="#4f6b35" d="M0 0h152v8h-152zM160 0h8v8h-8zM232 0h24v8h-24zM0 8h104v8h-104zM112 8h56v8h-56zM232 8h24v8h-24zM0 16h8v8h-8zM16 16h152v8h-152zM232 16h24v8h-24zM0 24h24v8h-24zM32 24h16v8h-16zM56 24h88v8h-88zM152 24h16v8h-16zM232 24h24v8h-24zM0 32h24v8h-24zM152 32h16v8h-16zM232 32h24v8h-24zM0 40h16v8h-16zM160 40h8v8h-8zM232 40h24v8h-24zM0 48h24v8h-24zM160 48h8v8h-8zM232 48h24v8h-24zM0 56h24v8h-24zM160 56h8v8h-8zM232 56h24v8h-24zM0 64h24v8h-24zM160 64h8v8h-8zM232 64h24v8h-24zM0 72h24v8h-24zM232 72h8v8h-8zM248 72h8v8h-8zM0 80h24v8h-24zM232 80h24v8h-24zM0 88h24v8h-24zM232 88h24v8h-24zM0 96h24v8h-24zM160 96h8v8h-8zM232 96h24v8h-24zM0 104h24v8h-24zM232 104h24v8h-24zM0 112h24v8h-24zM232 112h24v8h-24zM0 120h24v8h-24zM232 120h24v8h-24zM0 128h24v8h-24zM160 128h8v8h-8zM232 128h24v8h-24zM0 136h24v8h-24zM160 136h8v8h-8zM232 136h24v8h-24zM0 144h24v8h-24zM160 144h8v8h-8zM232 144h24v8h-24zM232 152h24v8h-24zM232 160h24v8h-24zM232 168h24v8h-24zM232 176h24v8h-24zM232 184h24v8h-24zM232 192h24v8h-24zM232 200h24v8h-24zM232 208h24v8h-24zM0 216h104v8h-104zM112 216h144v8h-144zM0 224h48v8h-48zM56 224h40v8h-40zM104 224h112v8h-112zM224 224h32v8h-32zM0 232h16v8h-16zM24 232h120v8h-120zM152 232h104v8h-104zM0 240h120v8h-120zM128 240h8v8h-8zM144 240h112v8h-112zM0 248h256v8h-256z"/><path fill="#3e5629" d="M152 0h8v8h-8zM104 8h8v8h-8zM8 16h8v8h-8zM24 24h8v8h-8zM48 24h8v8h-8zM144 24h8v8h-8zM16 40h8v8h-8zM240 72h8v8h-8zM104 216h8v8h-8zM48 224h8v8h-8zM96 224h8v8h-8zM216 224h8v8h-8zM16 232h8v8h-8zM144 232h8v8h-8zM120 240h8v8h-8zM136 240h8v8h-8z"/><path fill="#4a3a26" d="M168 0h8v8h-8zM224 0h8v8h-8zM168 8h8v8h-8zM168 16h8v8h-8zM224 16h8v8h-8zM168 24h8v8h-8zM168 32h8v8h-8zM224 32h8v8h-8zM168 40h8v8h-8zM168 48h8v8h-8zM224 48h8v8h-8zM168 56h8v8h-8zM168 64h8v8h-8zM224 64h8v8h-8zM224 72h8v8h-8zM224 80h8v8h-8zM224 88h8v8h-8zM168 96h8v8h-8zM224 96h8v8h-8zM224 104h8v8h-8zM224 112h8v8h-8zM224 120h8v8h-8zM168 128h8v8h-8zM224 128h8v8h-8zM168 136h8v8h-8zM224 136h8v8h-8zM168 144h8v8h-8zM224 144h8v8h-8zM0 152h24v8h-24zM160 152h16v8h-16zM224 152h8v8h-8zM224 160h8v8h-8zM224 168h8v8h-8zM224 176h8v8h-8zM224 184h8v8h-8zM224 192h8v8h-8zM224 200h8v8h-8zM0 208h72v8h-72zM80 208h40v8h-40zM128 208h104v8h-104z"/><path fill="#a88c60" d="M176 0h48v8h-48zM184 8h40v8h-40zM176 16h8v8h-8zM176 32h8v8h-8zM176 48h8v8h-8zM184 56h40v8h-40zM176 64h48v8h-48zM184 72h16v8h-16zM208 72h16v8h-16zM208 80h16v8h-16zM184 88h16v8h-16zM208 88h16v8h-16zM176 96h32v8h-32zM216 96h8v8h-8zM184 104h16v8h-16zM208 104h16v8h-16zM208 112h16v8h-16zM184 120h16v8h-16zM208 120h16v8h-16zM176 128h48v8h-48zM176 136h48v8h-48zM176 144h48v8h-48zM176 152h48v8h-48zM0 160h32v8h-32zM160 160h64v8h-64zM0 168h80v8h-80zM120 168h24v8h-24zM152 168h72v8h-72zM0 176h40v8h-40zM48 176h24v8h-24zM128 176h96v8h-96zM0 184h80v8h-80zM120 184h104v8h-104zM0 192h72v8h-72zM128 192h96v8h-96zM0 200h80v8h-80zM120 200h104v8h-104z"/><path fill="#8a7048" d="M208 96h8v8h-8zM144 168h8v8h-8zM40 176h8v8h-8z"/><path fill="#2a2a1e" d="M152 40h8v8h-8zM152 48h8v8h-8zM152 56h8v8h-8zM152 64h8v8h-8zM152 96h8v8h-8zM152 128h8v8h-8zM152 136h8v8h-8zM152 144h8v8h-8zM152 152h8v8h-8zM32 160h40v8h-40zM80 160h40v8h-40zM128 160h32v8h-32z"/><path fill="#16130f" d="M176 8h8v8h-8zM224 8h8v8h-8zM184 16h8v8h-8zM216 16h8v8h-8zM176 24h8v8h-8zM224 24h8v8h-8zM24 32h128v8h-128zM24 40h8v8h-8zM144 40h8v8h-8zM176 40h8v8h-8zM224 40h8v8h-8zM24 48h8v8h-8zM144 48h8v8h-8zM184 48h8v8h-8zM216 48h8v8h-8zM24 56h8v8h-8zM144 56h8v8h-8zM176 56h8v8h-8zM224 56h8v8h-8zM24 64h8v8h-8zM56 64h64v8h-64zM144 64h8v8h-8zM24 72h8v8h-8zM56 72h8v8h-8zM112 72h56v8h-56zM24 80h8v8h-8zM56 80h8v8h-8zM24 88h8v8h-8zM56 88h8v8h-8zM112 88h56v8h-56zM24 96h8v8h-8zM56 96h8v8h-8zM112 96h8v8h-8zM144 96h8v8h-8zM24 104h8v8h-8zM56 104h8v8h-8zM112 104h56v8h-56zM24 112h8v8h-8zM56 112h8v8h-8zM24 120h8v8h-8zM56 120h8v8h-8zM112 120h56v8h-56zM24 128h8v8h-8zM56 128h64v8h-64zM144 128h8v8h-8zM24 136h8v8h-8zM144 136h8v8h-8zM24 144h8v8h-8zM144 144h8v8h-8zM24 152h128v8h-128zM72 160h8v8h-8zM120 160h8v8h-8zM80 168h8v8h-8zM112 168h8v8h-8zM72 176h8v8h-8zM120 176h8v8h-8zM72 192h8v8h-8zM120 192h8v8h-8zM80 200h8v8h-8zM112 200h8v8h-8zM72 208h8v8h-8zM120 208h8v8h-8z"/><path fill="#7a6a52" d="M32 56h112v8h-112zM32 64h24v8h-24zM120 64h24v8h-24zM32 72h24v8h-24zM32 80h24v8h-24zM32 88h24v8h-24zM32 96h24v8h-24zM120 96h24v8h-24zM32 104h24v8h-24zM32 112h24v8h-24zM32 120h24v8h-24zM32 128h24v8h-24zM120 128h24v8h-24zM32 136h112v8h-112zM32 144h112v8h-112z"/><path fill="#c8b48a" d="M32 40h112v8h-112zM32 48h112v8h-112z"/><path fill="#3e5c6b" d="M64 72h48v8h-48zM64 80h48v8h-48zM64 88h16v8h-16zM96 88h16v8h-16zM64 96h16v8h-16zM96 96h16v8h-16zM64 104h48v8h-48zM64 112h48v8h-48zM64 120h48v8h-48z"/><path fill="#f2b84b" d="M192 24h8v8h-8zM208 24h8v8h-8zM184 80h16v8h-16zM80 88h16v8h-16zM80 96h16v8h-16zM184 112h16v8h-16zM88 176h8v8h-8zM104 176h8v8h-8z"/><path fill="#8a97a3" d="M112 80h56v8h-56zM112 112h56v8h-56z"/><path fill="#f4ecd8" d="M168 72h16v8h-16zM168 80h16v8h-16zM168 88h16v8h-16zM168 104h16v8h-16zM168 112h16v8h-16zM168 120h16v8h-16z"/><path fill="#e07a2e" d="M192 16h24v8h-24zM184 24h8v8h-8zM200 24h8v8h-8zM216 24h8v8h-8zM184 32h8v8h-8zM216 32h8v8h-8zM184 40h8v8h-8zM216 40h8v8h-8zM192 48h24v8h-24zM200 72h8v8h-8zM200 80h8v8h-8zM200 88h8v8h-8zM200 104h8v8h-8zM200 112h8v8h-8zM200 120h8v8h-8zM88 168h24v8h-24zM80 176h8v8h-8zM96 176h8v8h-8zM112 176h8v8h-8zM80 184h8v8h-8zM112 184h8v8h-8zM80 192h8v8h-8zM112 192h8v8h-8zM88 200h24v8h-24z"/><path fill="#b8402e" d="M192 32h24v8h-24zM192 40h24v8h-24zM88 184h24v8h-24zM88 192h24v8h-24z"/></g></svg>"""

  state mode = "base"
  // command, kept between battles: medals to spend, research levels, the furthest front open and
  // held, and the front picked to fight next
  state medals = 0 persist
  state res = [0, 0, 0, 0, 0, 0, 0, 0] persist
  state front = 1 persist
  state best = 0 persist
  state pick = 1 persist
  // a battle: the front fought, waves held so far, whether one is coming, and the time since it was sent
  state fought = 1
  state wave = 0
  state waveOn = false
  state wt = 0
  state waveAt = -10
  // who is still to come in this wave, each with the time it steps on the road
  state queue = []
  state foes = []
  state towers = []
  state shells = []
  state fx = []
  state booms = []
  state pops = []
  state cash = 0
  state hearts = 0
  state earned = 0
  // the tile picked, [column, row], or null
  state sel = null
  state spd = 1
  // game time in seconds (twice as fast at x2), and ids for new things
  state gt = 0
  state nextId = 0
  state lost = false
  // lost by leaving with Back, not by the outpost falling
  state fled = false
  state overAt = 0
  state hurtAt = -10
  // a line over the buttons that says why a tap didn't do anything, and when it was set
  state note = ""
  state noteAt = -10
  // set by the store's screenshots to hold a scene still while it's drawn in each theme
  state still = false

  let W = screenWidth ?? 400
  let H = screenHeight ?? 800
  let TOP = max(screenTop ?? 0, 10)
  let BOT = screenInset ?? 0

  // The front: which map, and how tough its enemies are (25% more each front, with no end).
  let fr = mode == "base" ? pick : fought
  let diff = pow(1.25, fr - 1)
  // The maps: the road's eight corners in tiles (columns 0 to 8, rows 0 to 12; it starts off the map
  // and ends at the outpost), and the ground's colors. glow makes the road's edge lava.
  let MAPS = [
    {name: "DUST FLATS", pts: [[1, -1], [1, 3], [7, 3], [7, 7], [1, 7], [1, 10], [4, 10], [4, 12]], g1: #b49a64, g2: #9c8250, rd: #dcc792, re: #7a6440, hi: #ecdfb4, glow: 0},
    {name: "PINE RIDGE", pts: [[7, -1], [7, 2], [2, 2], [2, 5], [6, 5], [6, 9], [2, 9], [2, 12]], g1: #4f6b35, g2: #3e5629, rd: #a88c60, re: #4a3a26, hi: #8fbf4a, glow: 0},
    {name: "SALT MARSH", pts: [[4, -1], [4, 2], [1, 2], [1, 6], [7, 6], [7, 11], [4, 11], [4, 12]], g1: #6a8a74, g2: #57735f, rd: #d6cfb4, re: #5c5a48, hi: #b4e0cc, glow: 0},
    {name: "FROST LINE", pts: [[1, -1], [1, 9], [3, 9], [3, 1], [5, 1], [5, 9], [7, 9], [7, 12]], g1: #c3d2da, g2: #aebfc8, rd: #828e98, re: #4f5a64, hi: #f4f8fa, glow: 0},
    {name: "CINDER WORKS", pts: [[-1, 2], [6, 2], [6, 5], [2, 5], [2, 9], [6, 9], [6, 12], [6, 12]], g1: #4a3c3a, g2: #3a2e2d, rd: #6e4a34, re: #e0622e, hi: #f2b84b, glow: 1}
  ]
  let mp = MAPS[(fr - 1) % 5]
  let PTS = mp.pts
  // the road as seven straight pieces, each with where it starts along the road (s0)
  let LEGS = range(7).map(i => {ax: PTS[i][0], ay: PTS[i][1], bx: PTS[i + 1][0], by: PTS[i + 1][1], len: abs(PTS[i + 1][0] - PTS[i][0]) + abs(PTS[i + 1][1] - PTS[i][1])})
  let ROUTE = LEGS.map((g, i) => merge(g, {s0: sum(LEGS.take(i).map(h => h.len)) ?? 0}))
  let TOTAL = sum(LEGS.map(g => g.len))
  // flyers go straight from the road's start to the outpost
  let FLEN = sqrt(pow(PTS[7][0] - PTS[0][0], 2) + pow(PTS[7][1] - PTS[0][1], 2))
  // the tiles the road covers, where nothing can be built
  let BLOCK = flatten(LEGS.map(g => range(g.len + 1).map(k => "${g.ax + sign(g.bx - g.ax) * k},${g.ay + sign(g.by - g.ay) * k}")))

  // The battle's layout: the top bar, the map's 9 x 13 tiles as big as fit, the bar of buttons.
  let BH = 64
  let BY = H - BOT - 18 - BH
  let GTOP = TOP + 44
  let avail = BY - 36 - GTOP
  let C = min(W / 9, avail / 13)
  let OX = (W - 9 * C) / 2
  let OY = GTOP + (avail - 13 * C) / 2
  // one art pixel, in dp: a tower is 9 of them on an 11-pixel tile
  let P = C / 11
  let bw = (W - 32 - 24) / 4

  // Command's layout, as sky forge's hangar: the outpost on show, a row per research, the fight button.
  let HROW = clamp((H - BOT - TOP - 360) / 8, 52, 60)
  let rowsTop = H - BOT - 96 - 8 * HROW
  let showP = clamp((rowsTop - 64 - TOP - 80) / 13, 3, 9)
  let showY = TOP + 80 + (rowsTop - 64 - TOP - 80) / 2
  let BTN = 96

  // Research: what each level costs in medals, and what it gives.
  let RES = [
    {n: "ARMORY", cost: [3, 6, 10, 16, 25]},
    {n: "OPTICS", cost: [4, 9, 18]},
    {n: "SUPPLY", cost: [2, 5, 9, 15]},
    {n: "WALLS", cost: [3, 7, 14]},
    {n: "BOUNTY", cost: [4, 9, 18]},
    {n: "SALVAGE", cost: [2, 5, 10]},
    {n: "FROST TOWER", cost: [5]},
    {n: "TESLA TOWER", cost: [8]}
  ]
  let dmgK = 1 + 0.12 * (res[0] ?? 0)
  let rngK = 1 + 0.08 * (res[1] ?? 0)
  let startCash = 150 + 40 * (res[2] ?? 0)
  let maxHearts = 20 + 5 * (res[3] ?? 0)
  let bountyK = 1 + 0.1 * (res[4] ?? 0)
  let sellK = 0.6 + 0.1 * (res[5] ?? 0)
  let unlocked = [true, true, (res[6] ?? 0) > 0, (res[7] ?? 0) > 0]
  let RSTAT = [
    (res[0] ?? 0) == 0 ? "TOWERS HIT HARDER" : "+${12 * res[0]}% TOWER DAMAGE",
    (res[1] ?? 0) == 0 ? "TOWERS REACH FURTHER" : "+${8 * res[1]}% TOWER RANGE",
    "START WITH ${startCash} SCRAP",
    "${maxHearts} HEARTS A BATTLE",
    (res[4] ?? 0) == 0 ? "MORE SCRAP A KILL" : "+${10 * res[4]}% SCRAP A KILL",
    "SELL TOWERS FOR ${round(sellK * 100)}%",
    unlocked[2] ? "SLOWS ALL IN REACH, AIR TOO" : "UNLOCKS THE FROST TOWER",
    unlocked[3] ? "LIGHTNING JUMPS TO THE NEXT" : "UNLOCKS THE TESLA TOWER"
  ]

  // The towers, per level: cost (to build, then each upgrade), damage, seconds between shots, range in tiles.
  let TW = [
    {n: "GUN", cost: [50, 60, 110], dmg: [4, 7, 12], rate: [0.4, 0.33, 0.25], rng: [2.2, 2.5, 2.8], air: true, slow: [1, 1, 1], chain: [1, 1, 1], splash: 0},
    {n: "CANNON", cost: [90, 100, 180], dmg: [14, 24, 40], rate: [1.7, 1.5, 1.3], rng: [2.6, 2.9, 3.2], air: false, slow: [1, 1, 1], chain: [1, 1, 1], splash: 0.95},
    {n: "FROST", cost: [70, 80, 140], dmg: [1, 2, 3], rate: [1.1, 1, 0.9], rng: [1.8, 2.1, 2.4], air: true, slow: [0.55, 0.45, 0.35], chain: [1, 1, 1], splash: 0},
    {n: "TESLA", cost: [130, 150, 260], dmg: [9, 15, 24], rate: [1, 0.9, 0.8], rng: [2.4, 2.7, 3], air: true, slow: [1, 1, 1], chain: [3, 4, 5], splash: 0}
  ]
  // The enemies: health on the first wave, speed in tiles a second, scrap for a kill, hearts it takes.
  let FOE = {
    c: {hp: 28, v: 1, b: 5, dm: 1, air: false},
    r: {hp: 15, v: 1.9, b: 3, dm: 1, air: false},
    b: {hp: 110, v: 0.55, b: 14, dm: 3, air: false},
    f: {hp: 22, v: 1.15, b: 7, dm: 1, air: true},
    B: {hp: 900, v: 0.4, b: 90, dm: 10, air: false}
  }

  let selT = sel == null ? null : towers.find(t => t.c == sel[0] && t.r == sel[1])
  let boss = foes.find(e => e.k == "B")
  let flick = floor(gt * 10) % 2

  // The art: one letter per pixel, colored by PAL. Heads face up and turn to their target.
  let PAL = {K: #16130f, O: #e07a2e, Y: #f2b84b, R: #b8402e, W: #f4ecd8, S: #c8b48a, D: #7a6a52, g: #a6cf4f, G: #4f7a2a, m: #b26ab8, M: #5a2d5c, B: #3e5c6b, L: #8a97a3, C: #8fe3e0}
  // towers' heads without their outlines, for a crowded map
  let LITE = remove(PAL, "K")
  let FLASH = {K: #f2b84b, O: #f4ecd8, Y: #f4ecd8, R: #f4ecd8, W: #f4ecd8, S: #f4ecd8, D: #f4ecd8, g: #f4ecd8, G: #f4ecd8, m: #f4ecd8, M: #f4ecd8, B: #f4ecd8, L: #f4ecd8, C: #f4ecd8}
  let HEADS = [
    [".K.K.", ".W.W.", ".S.S.", "KSKSK", "KBBBK", "KBYBK", "KBBBK", ".KKK."],
    ["..KKK..", "..KDK..", "..KDK..", "..KDK..", ".KKDKK.", "KRRRRRK", "KRRWRRK", "KRRRRRK", ".KKKKK."],
    ["...K...", "..KCK..", ".KCWCK.", "KCWCCCK", ".KCCCK.", "..KCK..", ".KBBBK.", ".KKKKK."],
    ["..KKK..", ".KYWYK.", ".KYYYK.", "..KKK..", ".KLLLK.", "..KDK..", ".KLLLK.", "..KDK..", ".KLLLK.", ".KKKKK."]
  ]
  // where each head's pivot sits, in art pixels from its top left
  let PIVOT = [[2.5, 5.5], [3.5, 6.5], [3.5, 5], [3.5, 6.5]]
  let CRAWL = [["K.....K", ".KOOOK.", "KOYOYOK", ".ORRRO.", "KORRROK", ".KOOOK.", "K.....K"], [".K...K.", "KKOOOKK", ".OYOYO.", "KORRROK", ".ORRRO.", "KKOOOKK", ".K...K."]]
  let RUNNER = [["..K..", ".KgK.", "KgWgK", ".KgK.", "KgGgK", "K...K"], ["..K..", ".KgK.", "KgWgK", ".KgK.", "KgGgK", ".K.K."]]
  let BRUTE = [[".KKKKKKK.", "KSSSSSSSK", "KSDSDSDSK", "KSSSSSSSK", "KDDDDDDDK", "KSRSSSRSK", "KSSSSSSSK", ".KKKKKKK.", "K.K...K.K"], [".KKKKKKK.", "KSSSSSSSK", "KSDSDSDSK", "KSSSSSSSK", "KDDDDDDDK", "KSRSSSRSK", "KSSSSSSSK", ".KKKKKKK.", ".K.K.K.K."]]
  let FLYER = [["....K....", "...KmK...", "K.KmWmK.K", "mKmmmmmKm", "mmmKmKmmm", "m..KmK..m", "....K...."], ["....K....", "m..KmK..m", "mmKmWmKmm", ".KmmmmmK.", "...KmK...", "...KmK...", "....K...."]]
  let BOSS = [["....KKKKK....", "...KRRRRRK...", "..KRYRRRYRK..", ".KRRRRRRRRRK.", "KRRDDDDDDDRRK", "KRDSSSSSSSDRK", "KRDSWSSSWSDRK", "KRDSSSSSSSDRK", "KRRDDDDDDDRRK", ".KRRRRRRRRRK.", "K.KKRRRRRKK.K", "K...KKKKK...K", "KK.........KK"], ["....KKKKK....", "...KRRRRRK...", "..KRYRRRYRK..", ".KRRRRRRRRRK.", "KRRDDDDDDDRRK", "KRDSSSSSSSDRK", "KRDSWSSSWSDRK", "KRDSSSSSSSDRK", "KRRDDDDDDDRRK", ".KRRRRRRRRRK.", "K.KKRRRRRKK.K", "KK..KKKKK..KK", "...........KK"]]
  let FORT = ["....K......", "....KRR....", "....KRRR...", "....K......", "K.K.K.K.K.K", "KSKSKSKSKSK", "KSSSSSSSSSK", "KSDSSKSSDSK", "KSSSKYKSSSK", "KSSSKYKSSSK", "KKKKKKKKKKK"]
  let MEDAL = [".RRBRR.", "..RBR..", "..KKK..", ".KYYYK.", "KYYWYYK", "KYWYYYK", ".KYYYK.", "..KKK.."]
  // a piece of scrap: a nut
  let NUT = [".KKK.", "KYSYK", "KSKSK", "KYSYK", ".KKK."]
  let HEART = [".KK...KK.", "KRRK.KRRK", "KRWRKRRRK", "KRRRRRRRK", ".KRRRRRK.", "..KRRRK..", "...KRK...", "....K...."]
  let BOOM = [[".............", ".............", ".............", ".............", ".............", ".....OO......", ".....YWY.....", ".....ORY.....", ".............", ".............", ".............", ".............", "............."], [".............", ".............", "......R......", "......OO.....", "...OOYYYO....", "...OYYWWOO...", "...OOYWWYOR..", "...ROWWWY....", "...ROYOYR....", ".....RO.R....", "......R......", ".............", "............."], [".............", "....RR.......", "...RRROROR...", "..ROOYYYOO...", "..OYYYYYYYR..", "..OOYWWYWYR..", "..RYWWWWWYR..", "..OOYWWWYOO..", "..ROYYWWOOR..", "..ROOYOYORR..", "....ROORO....", ".....RR......", "............."], [".............", ".....Ds......", "..DDDsssDD...", "..ssssOOOsD..", "..ssO..Osss..", ".DsOO...OOs..", ".sss.....Oss.", "DsssO....Os..", "..DOO..OOsss.", ".DsssOOOsss..", "...ssssssDD..", "....sDsD.D...", "............."], [".............", ".....Ds......", "...D..ss..s..", "...sss..s....", ".ss.......D..", "...........s.", ".s.........D.", "..........ssD", ".ss......DsD.", "..DD....DsD..", "..D....s.Ds..", "...ssDDDs....", ".....D......."]]
  // a 3x5 pixel font
  let FONT = {"A": ["aaa", "a.a", "aaa", "a.a", "a.a"], "B": ["aa.", "a.a", "aaa", "a.a", "aaa"], "C": ["aaa", "a..", "a..", "a..", "aaa"], "D": ["aa.", "a.a", "a.a", "a.a", "aa."], "E": ["aaa", "a..", "aa.", "a..", "aaa"], "F": ["aaa", "a..", "aa.", "a..", "a.."], "G": ["aaa", "a..", "a.a", "a.a", "aaa"], "H": ["a.a", "a.a", "aaa", "a.a", "a.a"], "I": ["aaa", ".a.", ".a.", ".a.", "aaa"], "J": ["..a", "..a", "..a", "a.a", ".a."], "K": ["a.a", "aa.", "a..", "aa.", "a.a"], "L": ["a..", "a..", "a..", "a..", "aaa"], "M": ["a.a", "aaa", "a.a", "a.a", "a.a"], "N": ["aaa", "a.a", "a.a", "a.a", "a.a"], "O": ["aaa", "a.a", "a.a", "a.a", "aaa"], "P": ["aaa", "a.a", "aaa", "a..", "a.."], "Q": ["aaa", "a.a", "a.a", "aaa", "..a"], "R": ["aaa", "a.a", "aa.", "a.a", "a.a"], "S": ["aaa", "a..", "aaa", "..a", "aaa"], "T": ["aaa", ".a.", ".a.", ".a.", ".a."], "U": ["a.a", "a.a", "a.a", "a.a", "aaa"], "V": ["a.a", "a.a", "a.a", "a.a", ".a."], "W": ["a.a", "a.a", "aaa", "aaa", "a.a"], "X": ["a.a", "a.a", ".a.", "a.a", "a.a"], "Y": ["a.a", "a.a", ".a.", ".a.", ".a."], "Z": ["aaa", "..a", ".a.", "a..", "aaa"], "0": ["aaa", "a.a", "a.a", "a.a", "aaa"], "1": [".a.", "aa.", ".a.", ".a.", "aaa"], "2": ["aaa", "..a", "aaa", "a..", "aaa"], "3": ["aaa", "..a", "aaa", "..a", "aaa"], "4": ["a.a", "a.a", "aaa", "..a", "..a"], "5": ["aaa", "a..", "aaa", "..a", "aaa"], "6": ["aaa", "a..", "aaa", "a.a", "aaa"], "7": ["aaa", "..a", "..a", "..a", "..a"], "8": ["aaa", "a.a", "aaa", "a.a", "aaa"], "9": ["aaa", "a.a", "aaa", "..a", "aaa"], "-": ["...", "...", "aaa", "...", "..."], "+": ["...", ".a.", "aaa", ".a.", "..."], "!": [".a.", ".a.", ".a.", "...", ".a."], ".": ["...", "...", "...", "...", ".a."], ":": ["...", ".a.", "...", ".a.", "..."], "x": ["...", "a.a", ".a.", "a.a", "..."], "/": ["..a", "..a", ".a.", "a..", "a.."], "?": ["aa.", "..a", ".a.", "...", ".a."], "<": ["..a", ".a.", "a..", ".a.", "..a"], ">": ["a..", ".a.", "..a", ".a.", "a.."]}

  // What the picked tower does, for the line over the buttons.
  let STATLINE = selT == null ? "" : (selT.k == 0 ? "GUN LV${selT.lv}: ${round(selT.dmg)} DAMAGE, ${fixed(1 / selT.rate, 1)} SHOTS/S, AIR TOO"
    : (selT.k == 1 ? "CANNON LV${selT.lv}: ${round(selT.dmg)} SPLASH, GROUND ONLY"
    : (selT.k == 2 ? "FROST LV${selT.lv}: SLOWS ${round((1 - selT.slow) * 100)}% IN REACH, AIR TOO" : "TESLA LV${selT.lv}: ${round(selT.dmg)} DAMAGE, JUMPS TO ${selT.chain}")))
  let hint = gt - noteAt < 2.5 && noteAt <= gt ? note : (selT != null ? STATLINE : (sel != null ? "GUN: ALL ROUND - CANNON: SPLASH, NOT AIR" : (waveOn ? "" : (len(towers) == 0 ? "TAP AN EMPTY TILE TO BUILD A TOWER" : "BUILD, THEN SEND THE NEXT WAVE"))))

  // Every line of text, drawn in the pixel font: s, x, y, size, color, and a from 0 (left) to 1 (right).
  let labels = (mode == "play" ? [
    {s: str(cash), x: 14 + 5 * 2.8 + 8, y: TOP + 14, p: 2.8, c: #f2b84b, a: 0},
    {s: "WAVE ${min(wave + 1, 20)}/20", x: W / 2, y: TOP + 14, p: 2.8, c: #f4ecd8, a: 0.5},
    {s: str(hearts), x: W - 14 - 9 * 2.2 - 8, y: TOP + 14, p: 2.8, c: gt - hurtAt < 0.5 && flick == 0 ? #b8402e : #f4ecd8, a: 1}
  ] : []) + (mode == "play" && sel == null ? [
    {s: waveOn ? "${len(queue) + len(foes)} LEFT" : "SEND WAVE ${wave + 1}", x: 16 + (W - 32 - 88) / 2, y: BY + BH / 2 - 9, p: 3.6, c: waveOn ? #c8b48a : #16130f, a: 0.5},
    {s: "x${spd}", x: W - 16 - 40, y: BY + BH / 2 - 9, p: 3.6, c: spd > 1 ? #f2b84b : #f4ecd8, a: 0.5}
  ] : []) + (mode == "play" && sel != null && selT == null ? flatten(range(4).map(i => [
    {s: TW[i].n, x: 16 + i * (bw + 8) + bw / 2, y: BY + BH - 14, p: 1.8, c: unlocked[i] ? #f4ecd8 : #7a6a52, a: 0.5},
    {s: unlocked[i] ? str(TW[i].cost[0]) : "LOCKED", x: 16 + i * (bw + 8) + bw / 2 + (unlocked[i] ? 6 : 0), y: BY + BH - 28, p: 1.8, c: unlocked[i] ? (cash >= TW[i].cost[0] ? #f2b84b : #b8402e) : #7a6a52, a: 0.5}
  ])) : []) + (mode == "play" && selT != null ? [
    {s: selT.lv >= 3 ? "MAX LEVEL" : "UPGRADE", x: 16 + (W - 40) / 4, y: BY + 14, p: 2.8, c: selT.lv >= 3 ? #7a6a52 : #f4ecd8, a: 0.5},
    {s: selT.lv >= 3 ? "" : str(TW[selT.k].cost[selT.lv]), x: 16 + (W - 40) / 4 + 7, y: BY + 38, p: 2.8, c: selT.lv < 3 && cash >= TW[selT.k].cost[selT.lv] ? #f2b84b : #b8402e, a: 0.5},
    {s: "SELL", x: W - 16 - (W - 40) / 4, y: BY + 14, p: 2.8, c: #f4ecd8, a: 0.5},
    {s: "+${floor(selT.spent * sellK)}", x: W - 16 - (W - 40) / 4, y: BY + 38, p: 2.8, c: #f2b84b, a: 0.5}
  ] : []) + (mode == "play" && !waveOn && wave == 0 && gt < 3 ? [
    {s: "FRONT ${fought}", x: W / 2, y: OY + 4 * C, p: 6, c: #f2b84b, a: 0.5},
    {s: mp.name, x: W / 2, y: OY + 4 * C + 44, p: 3.6, c: #f4ecd8, a: 0.5}
  ] : []) + (mode == "play" && waveOn && gt - waveAt < 1.8 ? [
    {s: "WAVE ${wave + 1}", x: W / 2, y: OY + 4 * C, p: 7, c: #f2b84b, a: 0.5}
  ] : []) + (mode == "play" && boss != null && boss.t < 2.5 && floor(boss.t * 4) % 2 == 0 ? [
    {s: "BOSS", x: W / 2, y: OY + 5.5 * C, p: 9, c: #b8402e, a: 0.5}
  ] : []) + (mode == "base" ? [
    {s: "LAST OUTPOST", x: W / 2, y: TOP + 14, p: 4.4, c: #f2b84b, a: 0.5},
    {s: str(medals), x: 16 + 7 * 2.6 + 8, y: TOP + 52, p: 2.6, c: #f2b84b, a: 0},
    {s: best > 0 ? "HELD ${best}" : "", x: W - 16, y: TOP + 52, p: 2.6, c: #c8b48a, a: 1},
    {s: "FIGHT FRONT ${pick}", x: W / 2, y: H - BOT - 76, p: 3.6, c: #16130f, a: 0.5},
    {s: pick > 1 ? "<" : "", x: 34, y: H - BOT - 70, p: 4, c: #16130f, a: 0.5},
    {s: pick < front ? ">" : "", x: W - 34, y: H - BOT - 70, p: 4, c: #16130f, a: 0.5}
  ] + flatten(range(8).map(i => [[res[i] ?? 0, len(RES[i].cost)]].map(q => [
    {s: RES[i].n, x: 28, y: rowsTop + i * HROW + 8, p: 2.2, c: q[0] > 0 ? #f4ecd8 : #c8b48a, a: 0},
    {s: q[0] >= q[1] ? (q[1] == 1 ? "OWNED" : "MAX") : str(RES[i].cost[q[0]]), x: W - 16 - BTN / 2 + (q[0] >= q[1] ? 0 : 7), y: rowsTop + i * HROW + 12, p: 2.4,
      c: q[0] >= q[1] ? #c8b48a : (medals >= RES[i].cost[q[0]] ? #f2b84b : #7a6a52), a: 0.5}
  ])[0])) : []) + (mode == "over" ? [
    {s: lost && !fled ? "OUTPOST" : "FRONT ${fought}", x: W / 2, y: H * 0.22, p: 8, c: lost ? #b8402e : #a6cf4f, a: 0.5},
    {s: lost ? (fled ? "LEFT" : "LOST") : "HELD", x: W / 2, y: H * 0.22 + 56, p: 8, c: lost ? #b8402e : #a6cf4f, a: 0.5},
    {s: "WAVES ${wave}/20", x: W / 2, y: H * 0.22 + 140, p: 3.6, c: #f4ecd8, a: 0.5},
    {s: "MEDALS +${earned}", x: W / 2, y: H * 0.22 + 182, p: 3.6, c: #f2b84b, a: 0.5},
    {s: lost ? "RESEARCH AT COMMAND AND TRY AGAIN" : "FRONT ${fought + 1} IS OPEN", x: W / 2, y: H * 0.22 + 226, p: 2.2, c: #f4ecd8, a: 0.5},
    {s: gt - overAt > 1.2 ? "TAP FOR COMMAND" : "", x: W / 2, y: H * 0.66, p: 3, c: #f4ecd8, a: 0.5}
  ] : []) + pops.map(q => {s: q.s, x: OX + (q.x + 0.5) * C, y: OY + (q.y + 0.2) * C - q.t * 36, p: q.p ?? 2, c: q.c, a: 0.5})

  // What a frame costs to draw, in Canvas drawing calls (a sprite costs one per run of a color
  // along a row), out of 2000: past 1500 health bars, shadows and the outlines of towers' heads are left out.
  let ink = 300 + len(towers) * 28 + (sum(foes.map(e => e.k == "B" ? 70 : (e.k == "b" ? 32 : (e.k == "f" ? 24 : 16)))) ?? 0)
    + (sum(booms.map(b => b.s >= 1 ? 45 : 2)) ?? 0) + len(fx) * 8 + len(shells) * 3
    + (sum(labels.map(l => len(l.s) * (l.p >= 3 ? 14 : 7))) ?? 0)
  let rich = ink < 1500

  every frame {
    if !still {
      let st = dt * (mode == "play" ? spd : 1)
      gt = gt + st
      booms = booms.map(b => merge(b, {t: b.t + st})).filter(b => b.t < 0.62)
      fx = fx.map(f => merge(f, {t: f.t + st})).filter(f => f.t < 0.4)
      pops = pops.map(q => merge(q, {t: q.t + st})).filter(q => q.t < 1.2)
      shells = shells.map(s => merge(s, {t: s.t + st}))

      if mode == "play" && waveOn {
        wt = wt + st
        // Who's due steps onto the road, two a frame at most, while there's room to draw them.
        let nDue = len(foes) < 36 ? count(queue.take(2), q => q.at <= wt) : 0
        if nDue > 0 {
          let hs = (1 + 0.17 * wave + 0.013 * wave * wave) * diff
          let pay = (1 + 0.05 * wave) * (1 + 0.1 * (fought - 1)) * bountyK
          foes = foes + queue.take(nDue).map((q, i) => [FOE[q.k]].map(b => {id: nextId + i, k: q.k, hp: b.hp * hs, mx: b.hp * hs, v: b.v * (1 + min(fought - 1, 10) * 0.03), b: max(1, round(b.b * pay)), dm: b.dm, air: b.air, d: 0, t: 0, x: PTS[0][0], y: PTS[0][1], p: 0, hx: 0, hy: 1, sl: 1, su: -10, hit: -10, o: q.o})[0])
          nextId = nextId + nDue
          queue = drop(queue, nDue)
        }

        // Everyone moves on, slower while frosted (a boss shrugs most of it off); flyers in a straight line.
        foes = foes.map(e => merge(e, {t: e.t + st, d: e.d + e.v * st * (gt < e.su ? (e.k == "B" ? max(e.sl, 0.7) : e.sl) : 1)}))
          .map(e => e.air
            ? merge(e, {x: lerp(PTS[0][0], PTS[7][0], min(1, e.d / FLEN)), y: lerp(PTS[0][1], PTS[7][1], min(1, e.d / FLEN)), p: e.d / FLEN, hx: (PTS[7][0] - PTS[0][0]) / FLEN, hy: (PTS[7][1] - PTS[0][1]) / FLEN})
            : [ROUTE.find(g => e.d < g.s0 + g.len) ?? ROUTE[6]].map(g => [clamp((e.d - g.s0) / max(g.len, 0.001), 0, 1)].map(u => merge(e, {
                x: g.ax + (g.bx - g.ax) * u, y: g.ay + (g.by - g.ay) * u, p: e.d / TOTAL,
                hx: lerp(e.hx, sign(g.bx - g.ax), min(1, 12 * st)), hy: lerp(e.hy, sign(g.by - g.ay), min(1, 12 * st))}))[0])[0])

        // Who reached the outpost takes hearts.
        let home = foes.filter(e => e.p >= 1)
        if len(home) > 0 {
          foes = foes.filter(e => e.p < 1)
          hearts = max(0, hearts - sum(home.map(e => e.dm)))
          hurtAt = gt
          let hb = booms + home.map(e => {x: PTS[7][0], y: PTS[7][1] - 0.2, t: 0, s: 1.2})
          booms = drop(hb, max(0, len(hb) - 10))
          if hearts <= 0 {
            mode = "over"
            lost = true
            overAt = gt
            waveOn = false
          }
        }
      }

      if mode == "play" && waveOn {
        // Towers whose time has come, each with what it can hit in reach, furthest along first.
        let armed = towers.filter(t => gt >= t.at).map(t => merge(t, {tg: foes.filter(e => (t.air || !e.air) && (e.x - t.c) * (e.x - t.c) + (e.y - t.r) * (e.y - t.r) < t.rr).sortBy(e => -e.p)})).filter(t => len(t.tg) > 0)
        if len(armed) > 0 {
          let guns = armed.filter(t => t.k == 0)
          let cans = armed.filter(t => t.k == 1)
          let frosts = armed.filter(t => t.k == 2)
          let teslas = armed.filter(t => t.k == 3)
          // lightning jumps on to the nearest one it hasn't hit yet, within a tile and a half
          let chains = teslas.map(t => reduce(range(t.chain - 1), (acc, j) => [last(acc)].map(z => [foes.filter(e => !any(acc, a => a.id == e.id) && (e.x - z.x) * (e.x - z.x) + (e.y - z.y) * (e.y - z.y) < 2.4).sortBy(e => (e.x - z.x) * (e.x - z.x) + (e.y - z.y) * (e.y - z.y)).first()].map(nx => nx == null ? acc : acc + [nx])[0])[0], [t.tg[0]]))
          let hits = guns.map(t => {id: t.tg[0].id, v: t.dmg})
            + flatten(frosts.map(t => t.tg.map(e => {id: e.id, v: t.dmg})))
            + flatten(teslas.map((t, i) => chains[i].map((e, j) => {id: e.id, v: t.dmg * pow(0.85, j)})))
          let chill = flatten(frosts.map(t => t.tg.map(e => {id: e.id, f: t.slow})))
          foes = foes.map(e => [[sum(hits.filter(h => h.id == e.id).map(h => h.v)) ?? 0, chill.filter(s => s.id == e.id).map(s => s.f)]].map(z => z[0] == 0 && len(z[1]) == 0 ? e
            : merge(e, {hp: e.hp - z[0], hit: z[0] > 0 && len(z[1]) == 0 ? gt : e.hit, sl: len(z[1]) > 0 ? reduce(z[1], (m, f) => min(m, f), 1) : e.sl, su: len(z[1]) > 0 ? gt + 1.6 : e.su}))[0])
          let flying = shells + cans.map(t => [t.tg[0]].map(e => {x0: t.c, y0: t.r, x1: e.x + e.hx * e.v * 0.3, y1: e.y + e.hy * e.v * 0.3, t: 0, T: 0.25 + 0.1 * sqrt((e.x - t.c) * (e.x - t.c) + (e.y - t.r) * (e.y - t.r)), v: t.dmg, sp: t.sp})[0])
          shells = drop(flying, max(0, len(flying) - 24))
          let sparks = fx + guns.map(t => {k: 0, pts: [[t.c, t.r], [t.tg[0].x, t.tg[0].y]], t: 0})
            + frosts.map(t => {k: 2, x: t.c, y: t.r, R: sqrt(t.rr), t: 0})
            + teslas.map((t, i) => {k: 3, pts: [[t.c, t.r - 0.45]] + chains[i].map(e => [e.x, e.y]), t: 0, s: random(1000)})
          fx = drop(sparks, max(0, len(sparks) - 30))
          towers = towers.map(t => [armed.find(a => a.id == t.id)].map(a => a == null ? t : merge(t, {at: gt + t.rate, f: gt, a: t.k == 1 || t.k == 0 ? deg(atan2(a.tg[0].x - t.c, -(a.tg[0].y - t.r))) : t.a}))[0])
        }

        // Cannon shells burst where they land, hurting everything on the ground nearby.
        let land = shells.filter(s => s.t >= s.T)
        if len(land) > 0 {
          shells = shells.filter(s => s.t < s.T)
          foes = foes.map(e => [e.air ? 0 : sum(land.filter(s => (e.x - s.x1) * (e.x - s.x1) + (e.y - s.y1) * (e.y - s.y1) < s.sp * s.sp).map(s => s.v)) ?? 0].map(v => v == 0 ? e : merge(e, {hp: e.hp - v, hit: gt}))[0])
          let lb = booms + land.map(s => {x: s.x1, y: s.y1, t: 0, s: 1})
          booms = drop(lb, max(0, len(lb) - 10))
        }

        // The dead pay their scrap and go up in smoke.
        let dead = foes.filter(e => e.hp <= 0)
        if len(dead) > 0 {
          foes = foes.filter(e => e.hp > 0)
          cash = cash + sum(dead.map(e => e.b))
          let db = booms + dead.map(e => {x: e.x, y: e.y, t: 0, s: e.k == "B" ? 2.4 : (e.k == "b" ? 1.1 : 0.6)})
          booms = drop(db, max(0, len(db) - 10))
          let dp = pops + dead.map(e => {x: e.x, y: e.y, t: 0, s: "+${e.b}", c: #f2b84b})
          pops = drop(dp, max(0, len(dp) - 10))
        }

        // A wave held: scrap for the next, medals for command, and after twenty, the front is held.
        if len(queue) == 0 && len(foes) == 0 {
          waveOn = false
          wave = wave + 1
          shells = []
          let m = 1 + floor((fought - 1) / 2)
          medals = medals + m
          earned = earned + m
          let bonus = 20 + 5 * wave
          cash = cash + bonus
          pops = pops + [{x: 4, y: 5, t: 0, s: "WAVE BONUS +${bonus}", c: #f4ecd8, p: 3}]
          if wave >= 20 {
            let prize = 5 + 3 * fought
            medals = medals + prize
            earned = earned + prize
            best = max(best, fought)
            front = max(front, fought + 1)
            pick = fought + 1
            mode = "over"
            lost = false
            overAt = gt
          }
        }
      }
    }
  }

  Box {
    fill: true
    background: mp.g2
    // The ground and the road, in art pixels, from the same corners the enemies walk.
    Shader {
      fill: true
      fallback: mp.g1
      uniforms: {
        dpw: W,
        px: P,
        ox: OX,
        oy: OY,
        cs: C,
        t: gt,
        glow: mp.glow,
        wa: [PTS[0][0], PTS[0][1], PTS[1][0], PTS[1][1]],
        wb: [PTS[2][0], PTS[2][1], PTS[3][0], PTS[3][1]],
        wc: [PTS[4][0], PTS[4][1], PTS[5][0], PTS[5][1]],
        wd: [PTS[6][0], PTS[6][1], PTS[7][0], PTS[7][1]],
        g1: mp.g1,
        g2: mp.g2,
        rd: mp.rd,
        re: mp.re,
        hi: mp.hi
      }
      code: """
        uniform float dpw;
        uniform float px;
        uniform float ox;
        uniform float oy;
        uniform float cs;
        uniform float t;
        uniform float glow;
        uniform float4 wa;
        uniform float4 wb;
        uniform float4 wc;
        uniform float4 wd;
        uniform half4 g1;
        uniform half4 g2;
        uniform half4 rd;
        uniform half4 re;
        uniform half4 hi;
        float rnd(float2 c) { return fract(sin(dot(c, float2(12.9898, 78.233))) * 43758.5453); }
        // how far p is from a straight piece of road, in tiles; square, so corners stay square
        float leg(float2 p, float2 a, float2 b) {
          float2 d = max(max(min(a, b) - p, p - max(a, b)), float2(0.0));
          return max(d.x, d.y);
        }
        half4 main(float2 p) {
          float2 q = p * (dpw / size.x);
          float2 cell = floor(q / px);
          float2 w = (cell + 0.5) * px;
          float2 g = (w - float2(ox, oy)) / cs - 0.5;
          float d = min(min(min(leg(g, wa.xy, wa.zw), leg(g, wa.zw, wb.xy)), min(leg(g, wb.xy, wb.zw), leg(g, wb.zw, wc.xy))),
            min(min(leg(g, wc.xy, wc.zw), leg(g, wc.zw, wd.xy)), leg(g, wd.xy, wd.zw)));
          float n = rnd(cell);
          float patch = sin(w.x * 0.031 + 1.3 * sin(w.y * 0.017)) + sin(w.y * 0.027 + 1.1 * sin(w.x * 0.021 + 2.0));
          half4 c = patch > 0.8 ? g2 : g1;
          // the tiles, a faint checker, so it's clear where a tower goes
          float2 tile = floor(g + 0.5);
          if (mod(tile.x + tile.y, 2.0) > 0.5) { c.rgb *= half(0.95); }
          if (n > 0.95) { c = mix(c, hi, 0.5); } else if (n < 0.05) { c = mix(c, g2, 0.8); c.rgb *= half(0.9); }
          if (d < 0.3) {
            c = rd;
            if (n > 0.88) { c = mix(rd, re, 0.3); } else if (n < 0.06) { c.rgb *= half(1.08); }
          } else if (d < 0.4) {
            c = re;
            if (glow > 0.5) { c = mix(re, hi, half(0.5 + 0.5 * sin(t * 3.0 + (w.x + w.y) * 0.08))); }
          } else if (d < 0.48 && n > 0.5) {
            c.rgb *= half(0.85);
          }
          return c;
        }
      """
    }
    Canvas {
      fill: true
      ripple: false
      let ex = OX + (PTS[7][0] + 0.5) * C
      let ey = OY + (PTS[7][1] + 0.5) * C
      let shake = gt - hurtAt < 0.3 ? sin(gt * 90) * 2 : 0
      // the tile picked
      if mode == "play" && sel != null {
        rect(OX + sel[0] * C, OY + sel[1] * C, C, C, fill: alpha(#f4ecd8, selT == null ? 0.25 : 0.12))
        rect(OX + sel[0] * C, OY + sel[1] * C, C, C, stroke: #f4ecd8, width: 2)
      }
      // the outpost at the road's end, shaking when it's hit
      sprite(FORT, ex - 5.5 * P * 1.3 + shake, ey - 6.5 * P * 1.3, P * 1.3, palette: gt - hurtAt < 0.15 ? FLASH : PAL)
      // enemies on the ground
      for e in foes {
        if !e.air {
          let sx = OX + (e.x + 0.5 - e.hy * e.o) * C
          let sy = OY + (e.y + 0.5 + e.hx * e.o) * C
          let f = floor(e.t * (e.k == "r" ? 12 : 7)) % 2
          let art = e.k == "c" ? CRAWL[f] : (e.k == "r" ? RUNNER[f] : (e.k == "b" ? BRUTE[f] : BOSS[f]))
          let sz = P * (e.k == "B" ? 1.15 : (e.k == "b" ? 0.85 : 0.9))
          if gt < e.su {
            circle(sx, sy, len(art[0]) * sz * 0.62, fill: alpha(#8fe3e0, 0.45))
          }
          rotate(deg(atan2(e.hx, -e.hy)), sx, sy) {
            sprite(art, sx - len(art[0]) * sz / 2, sy - len(art) * sz / 2, sz, palette: gt - e.hit < 0.06 ? FLASH : PAL)
          }
        }
      }
      // towers: a stone plate, a pip per level above the first, and the head turned to its target
      for t in towers {
        let sx = OX + (t.c + 0.5) * C
        let sy = OY + (t.r + 0.5) * C
        let hd = HEADS[t.k]
        if rich {
          rect(sx - 4.5 * P + P, sy - 4.5 * P + P, 9 * P, 9 * P, fill: alpha(#16130f, 0.3))
        }
        rect(sx - 4.5 * P, sy - 4.5 * P, 9 * P, 9 * P, fill: #16130f)
        rect(sx - 3.5 * P, sy - 3.5 * P, 7 * P, 7 * P, fill: #7a6a52)
        rect(sx - 3.5 * P, sy - 3.5 * P, 7 * P, P, fill: #c8b48a)
        for j in range(t.lv - 1) {
          rect(sx + 2.5 * P - j * 1.5 * P, sy + 2.5 * P, P, P, fill: #f2b84b)
        }
        rotate(t.k <= 1 ? t.a : 0, sx, sy) {
          sprite(hd, sx - PIVOT[t.k][0] * P, sy - PIVOT[t.k][1] * P, P, palette: t.k == 3 && gt - t.f < 0.15 ? FLASH : (rich ? PAL : LITE))
          if t.k == 0 && gt - t.f < 0.05 {
            circle(sx, sy - 6.5 * P, 1.6 * P, fill: #f2b84b)
          }
        }
      }
      // cannon shells in flight: one arc up and down (sin takes radians), the ball a little bigger at
      // the top, and its shadow on the ground smaller and fainter the higher it is
      for s in shells {
        let u = clamp(s.t / s.T, 0, 1)
        let lift = sin(u * 3.1416)
        let sx = OX + (lerp(s.x0, s.x1, u) + 0.5) * C
        let sy = OY + (lerp(s.y0, s.y1, u) + 0.5) * C
        let r = 1.7 * P * (1 + lift * 0.35)
        circle(sx, sy, 1.5 * P * (1 - lift * 0.4), fill: alpha(#16130f, 0.35 - lift * 0.15))
        circle(sx, sy - lift * C * 0.6, r, fill: #16130f)
        circle(sx - r * 0.35, sy - lift * C * 0.6 - r * 0.35, r * 0.35, fill: #7a6a52)
      }
      // flyers, over everything on the ground
      for e in foes {
        if e.air {
          let sx = OX + (e.x + 0.5 - e.hy * e.o) * C
          let sy = OY + (e.y + 0.5 + e.hx * e.o) * C
          let art = FLYER[floor(e.t * 8) % 2]
          if rich {
            circle(sx + 0.3 * C, sy + 0.45 * C, 0.26 * C, fill: alpha(#16130f, 0.22))
          }
          if gt < e.su {
            circle(sx, sy, 0.42 * C, fill: alpha(#8fe3e0, 0.45))
          }
          rotate(deg(atan2(e.hx, -e.hy)), sx, sy) {
            sprite(art, sx - 4.5 * P * 0.9, sy - 3.5 * P * 0.9, P * 0.9, palette: gt - e.hit < 0.06 ? FLASH : PAL)
          }
        }
      }
      // health bars on the hurt
      if rich {
        for e in foes {
          if e.hp < e.mx {
            let sx = OX + (e.x + 0.5 - e.hy * e.o) * C
            let sy = OY + (e.y + 0.5 + e.hx * e.o) * C - (e.k == "B" ? 0.85 : 0.5) * C
            let bwid = e.k == "B" ? C * 1.2 : C * 0.6
            rect(sx - bwid / 2 - 1, sy - 1, bwid + 2, 5, fill: #16130f)
            rect(sx - bwid / 2, sy, bwid * clamp(e.hp / e.mx, 0, 1), 3, fill: e.hp / e.mx > 0.5 ? #a6cf4f : (e.hp / e.mx > 0.25 ? #f2b84b : #b8402e))
          }
        }
      }
      // shots: a gun's tracer, the frost's ring, the tesla's zigzag
      for f in fx {
        if f.k == 0 && f.t < 0.06 {
          line(OX + (f.pts[0][0] + 0.5) * C, OY + (f.pts[0][1] + 0.5) * C, OX + (f.pts[1][0] + 0.5) * C, OY + (f.pts[1][1] + 0.5) * C, stroke: alpha(#f4ecd8, 0.8), width: 1.5)
        } else if f.k == 2 {
          circle(OX + (f.x + 0.5) * C, OY + (f.y + 0.5) * C, f.R * C * min(1, f.t / 0.3), stroke: alpha(#8fe3e0, max(0, 1 - f.t / 0.4)), width: 3)
        } else if f.k == 3 && f.t < 0.2 {
          let zz = flatten(range(len(f.pts) - 1).map(i => range(4).map(j => [lerp(f.pts[i][0], f.pts[i + 1][0], j / 4) + (j == 0 ? 0 : (hash(f.s, i, j, floor(gt * 30)) - 0.5) * 0.4), lerp(f.pts[i][1], f.pts[i + 1][1], j / 4) + (j == 0 ? 0 : (hash(f.s, i, j, 7, floor(gt * 30)) - 0.5) * 0.4)]))) + [last(f.pts)]
          let zp = zz.map(z => [OX + (z[0] + 0.5) * C, OY + (z[1] + 0.5) * C])
          path(zp, stroke: alpha(#8fe3e0, 0.6), width: 5, cap: round)
          path(zp, stroke: #f4ecd8, width: 2, cap: round)
        }
      }
      // explosions: a puff for the small, the big one for brutes, bosses and shells
      for b in booms {
        if b.t >= 0 {
          let bx = OX + (b.x + 0.5) * C
          let by = OY + (b.y + 0.5) * C
          if b.s < 1 {
            circle(bx, by, C * 0.45 * min(1, b.t / 0.25) * b.s * 1.6, fill: alpha(#e07a2e, max(0, 1 - b.t / 0.5)))
            circle(bx, by, C * 0.25 * b.s * 1.6 * max(0, 1 - b.t / 0.3), fill: #f4ecd8)
          } else {
            sprite(BOOM[min(4, floor(b.t / 0.125))], bx - 6.5 * P * b.s, by - 6.5 * P * b.s, P * b.s, palette: PAL)
          }
        }
      }
      // the picked tower's reach
      if mode == "play" && selT != null {
        circle(OX + (selT.c + 0.5) * C, OY + (selT.r + 0.5) * C, sqrt(selT.rr) * C, fill: alpha(#f4ecd8, 0.1))
        circle(OX + (selT.c + 0.5) * C, OY + (selT.r + 0.5) * C, sqrt(selT.rr) * C, stroke: alpha(#f4ecd8, 0.6), width: 1.5)
      }
      if gt - hurtAt < 0.4 && mode == "play" {
        rect(0, 0, W, H, fill: alpha(#b8402e, 0.25 * (1 - (gt - hurtAt) / 0.4)))
      }

      // The battle's bars: scrap, wave and hearts on top; the buttons below.
      if mode == "play" {
        rect(0, 0, W, GTOP - 4, fill: alpha(#16130f, 0.82))
        sprite(NUT, 14, TOP + 14, 2.8, palette: PAL)
        sprite(HEART, W - 14 - 9 * 2.2, TOP + 14, 2.2, palette: PAL)
        if boss != null {
          rect(14, GTOP - 12, W - 28, 6, fill: alpha(#16130f, 0.6), radius: 2)
          rect(15, GTOP - 11, (W - 30) * clamp(boss.hp / boss.mx, 0, 1), 4, fill: #b8402e)
        }
        rect(0, BY - 34, W, H - BY + 34, fill: alpha(#16130f, 0.86))
        text(hint, W / 2, BY - 17, size: 11, align: center, color: gt - noteAt < 2.5 && noteAt <= gt ? #f2b84b : #c8b48a, font: "mono", bold: true)
        if sel == null {
          rect(16, BY, W - 32 - 88, BH, fill: waveOn ? alpha(#f4ecd8, 0.08) : #f2b84b, radius: 8)
          if !waveOn {
            rect(16, BY + BH - 6, W - 32 - 88, 6, fill: #e07a2e, radius: 3)
          }
          rect(W - 16 - 80, BY, 80, BH, fill: alpha(#f4ecd8, spd > 1 ? 0.2 : 0.1), radius: 8)
        } else if selT == null {
          for i in range(4) {
            let bx = 16 + i * (bw + 8)
            let ok = unlocked[i] && cash >= TW[i].cost[0]
            rect(bx, BY, bw, BH, fill: alpha(#f4ecd8, ok ? 0.16 : 0.05), radius: 8)
            layer(unlocked[i] ? (ok ? 1 : 0.6) : 0.25) {
              sprite(HEADS[i], bx + bw / 2 - len(HEADS[i][0]) * 2.4 / 2, BY + 5, 2.4, palette: PAL)
            }
            if unlocked[i] {
              sprite(NUT, bx + bw / 2 - (len(str(TW[i].cost[0])) * 4 - 1) * 1.8 / 2 - 2, BY + BH - 28, 1.8, palette: PAL)
            }
          }
        } else {
          rect(16, BY, (W - 40) / 2, BH, fill: alpha(#f4ecd8, selT.lv < 3 && cash >= TW[selT.k].cost[selT.lv] ? 0.16 : 0.05), radius: 8)
          rect(24 + (W - 40) / 2, BY, (W - 40) / 2, BH, fill: alpha(#f4ecd8, 0.1), radius: 8)
          if selT.lv < 3 {
            sprite(NUT, 16 + (W - 40) / 4 - (len(str(TW[selT.k].cost[selT.lv])) * 4 - 1) * 2.8 / 2 - 9, BY + 38, 2.8, palette: PAL)
          }
        }
      }

      // Command: the outpost on show, a row per research, and the fight button.
      if mode == "base" || mode == "over" {
        rect(0, 0, W, H, fill: alpha(#16130f, 0.62))
      }
      if mode == "base" {
        sprite(MEDAL, 16, TOP + 50, 2.6, palette: PAL)
        let bob = sin(gt * 1.6) * 3
        sprite(FORT, W / 2 - 5.5 * showP + showP, showY - 5.5 * showP + showP, showP, palette: {K: alpha(#16130f, 0.4), S: alpha(#16130f, 0.4), D: alpha(#16130f, 0.4), R: alpha(#16130f, 0.4), Y: alpha(#16130f, 0.4)})
        sprite(FORT, W / 2 - 5.5 * showP, showY - 5.5 * showP, showP, palette: PAL)
        for i in range(2) {
          let tk = i == 0 ? 0 : (unlocked[3] ? 3 : 1)
          let hx = W / 2 + (i == 0 ? -1 : 1) * 9 * showP
          let hy = showY + 2 * showP
          let tp = showP * 0.7
          rect(hx - 4.5 * tp, hy - 4.5 * tp, 9 * tp, 9 * tp, fill: #16130f)
          rect(hx - 3.5 * tp, hy - 3.5 * tp, 7 * tp, 7 * tp, fill: #7a6a52)
          rect(hx - 3.5 * tp, hy - 3.5 * tp, 7 * tp, tp, fill: #c8b48a)
          rotate(tk <= 1 ? (i == 0 ? -30 : 30) + bob * 4 : 0, hx, hy) {
            sprite(HEADS[tk], hx - PIVOT[tk][0] * tp, hy - PIVOT[tk][1] * tp, tp, palette: PAL)
          }
        }
        text(gt - noteAt < 2.5 && noteAt <= gt ? note : (best == 0 && sum(res) == 0 ? "HOLD THE ROAD, EARN MEDALS, RESEARCH, GO ON" : "${mp.name}: ENEMIES x${fixed(diff, 1)} TOUGH"), W / 2, rowsTop - 24, size: 11, align: center, color: gt - noteAt < 2.5 && noteAt <= gt ? #f2b84b : #c8b48a, font: "mono", bold: true)
        for i in range(8) {
          let ry = rowsTop + i * HROW
          let o = res[i] ?? 0
          let mx = len(RES[i].cost)
          rect(16, ry, W - 32, HROW - 6, fill: alpha(#16130f, 0.78), radius: 6)
          for j in range(mx) {
            rect(28 + j * 13, ry + 24, 10, 6, fill: j < o ? #a6cf4f : alpha(#f4ecd8, 0.12), radius: 1)
          }
          text(RSTAT[i], 28, ry + 38, size: 10, color: #c8b48a, font: "mono")
          rect(W - 16 - BTN, ry, BTN, HROW - 6, fill: o >= mx ? alpha(#f4ecd8, 0.04) : (medals >= RES[i].cost[o] ? alpha(#f2b84b, 0.18) : alpha(#f4ecd8, 0.06)), radius: 6)
          if o < mx {
            sprite(MEDAL, W - 16 - BTN / 2 - (len(str(RES[i].cost[o])) * 4 - 1) * 2.4 / 2 - 9, ry + 11, 2, palette: PAL)
          }
        }
        rect(16, H - BOT - 84, W - 32, 64, fill: #f2b84b, radius: 8)
        rect(16, H - BOT - 84 + 58, W - 32, 6, fill: #e07a2e, radius: 3)
        text(mp.name, W / 2, H - BOT - 36, size: 11, align: center, color: #5a2d5c, font: "mono", bold: true)
      }

      for l in labels {
        for i in range(len(l.s)) {
          let ch = sub(l.s, i, i + 1)
          let lx = l.x - (len(l.s) * 4 - 1) * l.p * l.a + i * 4 * l.p
          if ch != " " {
            if l.p >= 3 && (rich || mode == "base") && l.c != #16130f {
              sprite(get(FONT, ch, FONT["?"]), lx + l.p / 3, l.y + l.p / 3, l.p, palette: {a: #16130f})
            }
            sprite(get(FONT, ch, FONT["?"]), lx, l.y, l.p, palette: {a: l.c})
          }
        }
      }

      onTap: {
        let gc = floor((x - OX) / C)
        let gr = floor((y - OY) / C)
        let row = floor((y - rowsTop) / HROW)
        if mode == "over" && gt - overAt > 1.2 {
          mode = "base"
          foes = []
          towers = []
          shells = []
          fx = []
          booms = []
          pops = []
          queue = []
          sel = null
          note = ""
        } else if mode == "play" && y >= OY && y < OY + 13 * C && x >= OX && x < OX + 9 * C {
          // a tap on the map picks a tile: a tower to upgrade or sell, or an empty one to build on
          let here = towers.find(t => t.c == gc && t.r == gr)
          if sel != null && sel[0] == gc && sel[1] == gr {
            sel = null
          } else if here != null {
            sel = [gc, gr]
          } else if any(BLOCK, b => b == "${gc},${gr}") {
            sel = null
          } else {
            sel = [gc, gr]
          }
        } else if mode == "play" && y >= BY && y <= BY + BH {
          if sel == null {
            if x > W - 16 - 80 {
              spd = spd == 1 ? 2 : 1
            } else if !waveOn {
              // The next wave: one kind of enemy leads, others follow from wave 6, and a boss every tenth.
              let nw = wave + 1
              let kind = nw % 10 == 0 ? "B" : (nw % 5 == 0 ? "b" : (nw >= 3 && nw % 3 == 0 ? "f" : (nw % 4 == 2 ? "r" : "c")))
              let cnt = kind == "B" ? 1 : (kind == "b" ? 2 + floor(nw / 4) : (kind == "f" ? 4 + floor(nw / 3) : (kind == "r" ? 8 + floor(nw / 2) : 6 + floor(nw * 0.7))))
              let gap = kind == "b" ? 1.6 : (kind == "f" ? 0.9 : (kind == "r" ? 0.42 : 0.75))
              let lead = range(cnt).map(i => {k: kind, at: i * gap})
              let extra = nw >= 6 && kind != "c" && kind != "B" ? range(floor(nw / 2)).map(i => {k: nw % 2 == 0 ? "c" : "r", at: cnt * gap + 1.5 + i * 0.6}) : []
              let escort = kind == "B" ? range(6 + floor(nw / 4)).map(i => {k: "r", at: 2.5 + i * 0.5}) + range(nw >= 20 ? 4 : 2).map(i => {k: "b", at: 6 + i * 2}) : []
              queue = (lead + extra + escort).map(q => merge(q, {o: (random() - 0.5) * 0.36})).sortBy(q => q.at)
              waveOn = true
              wt = 0
              waveAt = gt
            }
          } else if selT == null {
            let i = clamp(floor((x - 16) / (bw + 8)), 0, 3)
            let ty = TW[i]
            if len(towers) >= 48 {
              note = "THE OUTPOST CAN'T SUPPLY MORE THAN 48 TOWERS"
              noteAt = gt
            } else if !unlocked[i] {
              note = "RESEARCH THE ${ty.n} TOWER AT COMMAND"
              noteAt = gt
            } else if cash < ty.cost[0] {
              note = "${ty.cost[0] - cash} MORE SCRAP NEEDED"
              noteAt = gt
            } else {
              cash = cash - ty.cost[0]
              towers = towers + [{id: nextId, k: i, c: sel[0], r: sel[1], lv: 1, at: gt, f: -10, a: 0, spent: ty.cost[0], rr: pow(ty.rng[0] * rngK, 2), dmg: ty.dmg[0] * dmgK, rate: ty.rate[0], air: ty.air, slow: ty.slow[0], chain: ty.chain[0], sp: ty.splash}]
              nextId = nextId + 1
            }
          } else {
            let tw = selT
            let ty = TW[tw.k]
            if x < W / 2 {
              if tw.lv >= 3 {
                note = "${ty.n} IS AS GOOD AS IT GETS"
                noteAt = gt
              } else if cash < ty.cost[tw.lv] {
                note = "${ty.cost[tw.lv] - cash} MORE SCRAP NEEDED"
                noteAt = gt
              } else {
                cash = cash - ty.cost[tw.lv]
                towers = towers.map(t => t.id == tw.id ? merge(t, {lv: tw.lv + 1, spent: tw.spent + ty.cost[tw.lv], rr: pow(ty.rng[tw.lv] * rngK, 2), dmg: ty.dmg[tw.lv] * dmgK, rate: ty.rate[tw.lv], slow: ty.slow[tw.lv], chain: ty.chain[tw.lv]}) : t)
              }
            } else {
              cash = cash + floor(tw.spent * sellK)
              towers = towers.filter(t => t.id != tw.id)
              sel = null
            }
          }
        } else if mode == "play" {
          sel = null
        } else if mode == "base" && y >= rowsTop && row < 8 && (y - rowsTop) % HROW < HROW - 6 && x > W - 16 - BTN && x < W - 16 {
          let o = res[row] ?? 0
          let mx = len(RES[row].cost)
          if o >= mx {
            note = "${RES[row].n} IS DONE"
            noteAt = gt
          } else if medals < RES[row].cost[o] {
            note = RES[row].cost[o] - medals == 1 ? "1 MORE MEDAL NEEDED" : "${RES[row].cost[o] - medals} MORE MEDALS NEEDED"
            noteAt = gt
          } else {
            medals = medals - RES[row].cost[o]
            res = set(res, row, o + 1)
            note = mx == 1 ? "${RES[row].n} READY" : "${RES[row].n} LEVEL ${o + 1}"
            noteAt = gt
          }
        } else if mode == "base" && y > H - BOT - 84 && y < H - BOT - 20 && x > 16 && x < W - 16 {
          if x < 16 + 64 {
            pick = max(1, pick - 1)
          } else if x > W - 16 - 64 {
            pick = min(front, pick + 1)
          } else {
            mode = "play"
            fought = pick
            wave = 0
            waveOn = false
            wt = 0
            waveAt = -10
            queue = []
            foes = []
            towers = []
            shells = []
            fx = []
            booms = []
            pops = []
            cash = startCash
            hearts = maxHearts
            earned = 0
            sel = null
            spd = 1
            gt = 0
            lost = false
            fled = false
            hurtAt = -10
            note = ""
            noteAt = -10
          }
        }
      }
    }
  }
}
