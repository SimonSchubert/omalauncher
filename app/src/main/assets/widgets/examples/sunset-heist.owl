app "sunset heist" {
  meta { owl: 22; description: "A sunny city by the sea, seen from above: drive, get out, take any car, race rivals, chase down cars and run missions for cash, jump the ramps and shake off the police"; version: "1.0"; license: "MIT"; category: "games" }
  // How it works: the city is made from a seed in lets, 12 by 16 cells of 32 units, each a block with
  // roads along its edges, and a kind: docks on the north shore, a canal across the middle, hotels on the
  // beach, houses in the south, towers downtown and a few landmarks. Only the cells around the camera are drawn. Two scenes share one camera: the
  // ground first, so nothing on it is ever sorted under it, then everything that stands on it. Traffic
  // drives on the right along the road grid and picks a turn at each corner; the police drive straight
  // at you and slide along buildings. The stick comes from onTouch: wherever a thumb goes down,
  // pushed the way to drive or walk.
  title: ""
  statusBar: false
  edge: true
  fps: mode == "play" ? 60 : 30
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" rx="56" fill="#8fd0ec"/>
    <path d="M0 176H256V200A56 56 0 0 1 200 256H56A56 56 0 0 1 0 200Z" fill="#2a9cb8"/>
    <path d="M30 176V96H74V176ZM86 176V60H128V176ZM140 176V112H176V176Z" fill="#e8dcc4"/>
    <path d="M74 176V96H82V176ZM128 176V60H136V176ZM176 176V112H184V176Z" fill="#b8ab92"/>
    <path d="M38 108H66M38 124H66M38 140H66M94 74H120M94 90H120M94 106H120M94 122H120M148 124H168M148 140H168" stroke="#5f86a8" stroke-width="7"/>
    <path d="M196 176C196 132 206 112 222 98" stroke="#7a5a3a" stroke-width="7" fill="none"/>
    <path d="M222 98C200 92 186 100 180 110M222 98C240 86 252 92 256 100M222 98C226 80 220 70 208 66" stroke="#2f8f6f" stroke-width="9" fill="none" stroke-linecap="round"/>
    <path d="M150 206H214L206 224H158Z" fill="#d23a32"/>
  </svg>"""

  asset roadTex = base64""
  asset parkTex = base64""
  asset beachTex = base64""
  asset facadeTex = base64""
  asset glowTex = base64""
  asset beamTex = base64""
  asset roofTex = base64""
  asset heliTex = base64""
  asset seaTex = base64""
  asset docksTex = base64""
  asset lawnTex = base64""
  asset plazaTex = base64""
  asset dirtTex = base64""
  asset canalTex = base64""
  asset canalBeachTex = base64""
  asset poolTex = base64""
  asset courtTex = base64"iVBORw0KGgoAAAANSUhEUgAAACAAAABACAYAAAB7jnWuAAAAmklEQVR42u3ZwQ2AIAxAUQZjFAdxJidxHC6cMR3A2EJJwfxDg4kEXxooiimfVyulNmnfQu7fRzaFZkxpk1xERgrPAAAAAAAA0AJ6wg0wIwAAAAAAgAtAU/PdASMb0DDg6yEWhBmgHdzSzwywpncPwDZfxz0rhTnwr2UYXoiWKMVLbEa8DwAAAABACCD8kIpzQgAAAADg5/XMDDyu2eBnP1wGLQAAAABJRU5ErkJggg=="
  asset ribTex = base64"iVBORw0KGgoAAAANSUhEUgAAACAAAAAQCAYAAAB3AH1ZAAAAL0lEQVR42mOIikj5P5CYAUS8fv0BjFet2EZX9qgDRh0w6oBRB4w6YNQBg8cBA4kBAQqHMyW8ENMAAAAASUVORK5CYII="
  asset edgeWTex = base64"iVBORw0KGgoAAAANSUhEUgAAABIAAACAAgMAAAB7DtGMAAAACVBMVEVSUlbqwDLq6uQrqiBiAAAAKUlEQVQoz2NgGEAgACUXAAEyyYCFJMYcYkly3TlqPvHmo8cptvgdBAAAMl8gwboHYqAAAAAASUVORK5CYII="
  asset edgeNTex = base64"iVBORw0KGgoAAAANSUhEUgAAAIAAAAASAgMAAADu/j4QAAAACVBMVEVSUlbq6uTqwDKjP0pLAAAAJUlEQVQoz2NgAAHWUAYMEBqAxCGogHIw6obB4waCYBUQYcEgAACv3w9HszkBfQAAAABJRU5ErkJggg=="
  asset edgeSTex = base64"iVBORw0KGgoAAAANSUhEUgAAAIAAAAASAgMAAADu/j4QAAAACVBMVEVSUlbqwDLq6uQrqiBiAAAAIUlEQVQoz2NgAIFQIMKCSQBcqzDFVi0gRQHlYNQNg8ENAI11E5i/YrZnAAAAAElFTkSuQmCC"
  asset skidTex = base64"iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAIElEQVR42mMQEZJgAOITaJgBB8ZQxzBqwKgBowYMFwMArEiiAW6IzpwAAAAASUVORK5CYII="

  state mode = "title"
  state cash = 0 persist
  state gt = 0
  // set by the store's screenshots (screens.txt) to hold a scene still while it's drawn in each theme
  state still = false
  // every finger down, from onTouch
  state fingers = []
  // the player, in world units; heading in degrees, 0 toward +z (south, down the screen), 90 toward +x (east)
  state px = 112
  state pz = 322.5
  state ph = 90
  // the car's forward speed, and its velocity, which the tires pull toward where it points: a drift when they let go
  state pv = 0
  state pvx = 0
  state pvz = 0
  state inCar = true
  state pcol = 1
  // what you drive: an index into TYPES and VEH
  state ptype = 1
  state dmg = 0
  // Off a ramp: how high the car is, how fast it rises, and where and when it took off (null on the ground).
  state py = 0
  state pvy = 0
  state air = null
  // Driven into the water: where the car went under and when (null on land); a moment later you're wasted.
  state sunk = null
  state camX = 112
  state camZ = 322.5
  state cars = []
  // Parked vehicles, to get into: a few of each kind wait by the curb near the start, and again in a new game.
  let STARTERS = [{id: -1, t: 2, x: 106, z: 315.3, h: 90, c: 1, dmg: 0, wreck: false}, {id: -2, t: 6, x: 113.5, z: 315.6, h: 90, c: 2, dmg: 0, wreck: false}, {id: -3, t: 4, x: 121, z: 315.3, h: 90, c: 0, dmg: 0, wreck: false}, {id: -4, t: 3, x: 138, z: 315.3, h: 90, c: 3, dmg: 0, wreck: false}, {id: -5, t: 5, x: 148.5, z: 315.3, h: 90, c: 4, dmg: 0, wreck: false}, {id: -6, t: 0, x: 106, z: 324.8, h: 270, c: 7, dmg: 0, wreck: false}, {id: -7, t: 7, x: 114, z: 324.8, h: 270, c: 3, dmg: 0, wreck: false}, {id: -8, t: 8, x: 122, z: 324.8, h: 270, c: 1, dmg: 0, wreck: false}]
  state parked = STARTERS
  state peds = []
  state cops = []
  state nextId = 1
  state heat = 0
  state crimeAt = -100
  state seenAt = -100
  state hitAt = -100
  state copAt = -100
  // Missions: the one running (null for none), the mission spot the map leads you to (an index into GIVERS), the
  // rivals in a race, the car to stop in a takedown, the jump just landed, and the best race times by race.
  state mis = null
  state track = null
  state rivals = []
  state prey = null
  state landed = null
  state best = {} persist
  // The missions passed (indexes into GIVERS), ticked off in the list, on the map and over their spots; they can be
  // played again.
  state done = [] persist
  state msg = ""
  state msgAt = -100
  // skid marks on the road, and smoke and sparks in the air
  state skids = []
  state skidAt = -100
  state fx = []
  state fxAt = -100
  // You on foot: health and armor, which takes the damage first. Guns: ammo for each of WEAPONS, the one in hand (-1:
  // none), whether the fire button is held, and when the last shot went. Damage this frame, taken from armor first.
  state hp = 100
  state armor = 0
  state ammo = [0, 0, 0]
  state gun = -1
  state firing = false
  state shotAt = -100
  state hurt = 0
  // Tracers of recent shots, police on foot, explosions to set off and those burning, pickups taken and when.
  state shots = []
  state officers = []
  state blasts = []
  state booms = []
  state taken = []

  let C = 32
  // The roads round the edge are whole roads, both lanes: the land reaches half a road past the grid on the west,
  // north and south, with a strip of sand past that on the west and south (the beach is the east edge). Off it is
  // the sea, and a car driven into it, or into the canal, goes under.
  let E = 4.5
  let W = screenWidth ?? 400
  let H = screenHeight ?? 800
  let TOP = max(screenTop ?? 0, 12)
  let BOT = screenInset ?? 0
  // Daylight: a hazy sky the far streets fade into, and the sun high in the south-west.
  let SKY = #a8d2e4
  let LIGHT = [-0.35, 1, 0.45]
  // Painted signs and awnings, and the colors of flat roofs.
  let SIGNS = [#d23a32, #2f6fb8, #e8a23a, #2f8a5a, #f2d94e]
  let ROOFT = [#f4efe6, #e2d4bc, #d6dce2, #c8b8a4]
  let TINTS = [#f2e2c4, #d6e0ea, #ecc8ae, #dcdccc]
  let PAINT = [#ececea, #c8302c, #2a5aa8, #f0c030, #34373e, #8a2234, #2f7a4a, #b4b8bc]
  let SHIRTS = [#d84a3a, #3a7ac8, #e8b830, #f0f0ea, #4a8a4a]
  let SPRAY = [176, 256]
  // Where you wake up after being wasted.
  let HOSPITAL = [3 * C + 6, 6 * C + 16]
  // Guns: damage a hit, shots a second, reach, how far off straight ahead it still finds a target, ammo a pickup gives.
  let WEAPONS = [
    {name: "pistol", dmg: 30, rate: 3, range: 22, cone: 45, give: 24},
    {name: "SMG", dmg: 14, rate: 10, range: 18, cone: 40, give: 90},
    {name: "shotgun", dmg: 80, rate: 1.1, range: 11, cone: 55, give: 10}
  ]
  // Without a gun: a punch, at arm's length, at people only; it knocks them down rather than out.
  let FIST = {name: "fists", dmg: 20, rate: 2.5, range: 2.6, cone: 70}
  // Pickups on the sidewalks, made from the seed: health, armor, the three guns, cash.
  let PICK_COLOR = [#ff3b5c, #3d8bff, #ffb03b, #ffb03b, #ffb03b, #3ccf6e]
  let PICKS = range(52).map(i => {id: i, x: floor(hash(i, 91) * 11) * 32 + (hash(i, 96) < 0.5 ? 6 : 26), z: floor(hash(i, 92) * 16) * 32 + 8 + hash(i, 94) * 16, k: hash(i, 95) < 0.28 ? 0 : (hash(i, 95) < 0.48 ? 1 : (hash(i, 95) < 0.62 ? 2 : (hash(i, 95) < 0.74 ? 3 : (hash(i, 95) < 0.84 ? 4 : 5))))}).filter(p => abs(p.z - (10 * 32 + 16)) > 10)

  // The city: cells by row. Landmarks where SPOTS puts them; the canal across row 10, under a bridge at every
  // crossing and out to sea under the coast road; the beach in the last column, docks along the north shore,
  // hotels facing the beach, houses in the south, and blocks of one to four buildings between, tallest downtown,
  // with a park here and there. What's in a cell, `b`, is what you can't drive through; its `k` says how it's drawn.
  let SPOTS = [{cx: 1, cz: 6, k: "stadium"}, {cx: 3, cz: 6, k: "hosp"}, {cx: 5, cz: 7, k: "spray"}, {cx: 5, cz: 9, k: "police"}, {cx: 8, cz: 4, k: "gas"}, {cx: 2, cz: 11, k: "gas"}, {cx: 7, cz: 13, k: "gas"}, {cx: 7, cz: 7, k: "build"}, {cx: 2, cz: 3, k: "build"}, {cx: 5, cz: 5, k: "plaza"}, {cx: 2, cz: 9, k: "park"}, {cx: 8, cz: 2, k: "park"}, {cx: 4, cz: 14, k: "court"}, {cx: 9, cz: 12, k: "court"}]
  let CELL0 = flatten(range(16).map(cz => range(12).map(cx => {cx: cx, cz: cz, k: (first(SPOTS.filter(s => s.cx == cx && s.cz == cz)) ?? {k: cz == 10 ? "canal" : (cx == 11 ? "beach" : (cz <= 1 ? "docks" : (cx == 10 ? "hotel" : (cz >= 12 ? (hash(cx, cz, 1) < 0.12 ? "park" : "suburb") : (hash(cx, cz, 1) < 0.12 && cx != 5 ? "park" : "city")))))}).k})))
  let CELLS = CELL0.map(c => merge(c, {b: {
    city: hash(c.cx, c.cz, 2) < (c.cx >= 3 && c.cx <= 7 && c.cz >= 3 && c.cz <= 8 ? 0.45 : 0.2)
      ? [{k: "bldg", x: c.cx * C + 16, z: c.cz * C + 16, w: 15, d: 15, h: 14 + hash(c.cx, c.cz, 3) * 12 + (c.cx >= 3 && c.cx <= 7 && c.cz >= 3 && c.cz <= 8 ? 10 : 0), u: hash(c.cx, c.cz, 6) < 0.7 ? 8 + hash(c.cx, c.cz, 7) * 12 : 0, heli: hash(c.cx, c.cz, 8) < 0.5, t: hash(c.cx, c.cz, 4), n: hash(c.cx, c.cz, 5)}]
      : range(4).filter(i => hash(c.cx, c.cz, 10 + i) > 0.2).map(i => {k: "bldg", x: c.cx * C + 11.5 + i % 2 * 9, z: c.cz * C + 11.5 + floor(i / 2) * 9, w: 6.5 + hash(c.cx, c.cz, 20 + i) * 1.5, d: 6.5 + hash(c.cx, c.cz, 30 + i) * 1.5, h: 4 + pow(hash(c.cx, c.cz, 40 + i), 2) * 16 + (c.cx >= 3 && c.cx <= 7 && c.cz >= 3 && c.cz <= 8 ? 6 : 0), u: 0, heli: false, t: hash(c.cx, c.cz, 50 + i), n: hash(c.cx, c.cz, 60 + i)}),
    // A gantry crane's legs and two stacks under its boom; a shed; fuel tanks; or a yard of stacked containers.
    docks: c.cz == 0 && c.cx % 3 == 1
      ? range(4).map(i => {k: "post", x: c.cx * C + 11 + i % 2 * 10, z: c.cz * C + 7.5 + floor(i / 2) * 7.5, w: 1, d: 1, h: 14}) + range(2).map(i => {k: "cont", x: c.cx * C + 11.5 + i * 9, z: c.cz * C + 21.5, w: 6.4, d: 2.6, n: 1 + i, h: 2.6 + i * 2.6})
      : (hash(c.cx, c.cz, 2) < 0.3 ? [{k: "ware", x: c.cx * C + 16, z: c.cz * C + 15.5, w: 18, d: 13, h: 6}]
      : (hash(c.cx, c.cz, 2) < 0.45 ? [{k: "tank", x: c.cx * C + 11.5, z: c.cz * C + 17, w: 7.5, d: 7.5, h: 6}, {k: "tank", x: c.cx * C + 20.5, z: c.cz * C + 12, w: 6, d: 6, h: 5}]
      : range(8).filter(i => hash(c.cx, c.cz, 10 + i) > 0.25).map(i => {k: "cont", x: c.cx * C + 11.5 + i % 2 * 9, z: c.cz * C + 9 + floor(i / 2) * 4.6, w: 6.4, d: 2.6, n: 1 + floor(hash(c.cx, c.cz, 20 + i) * 3), h: 2.6 + floor(hash(c.cx, c.cz, 20 + i) * 3) * 2.6}))),
    hotel: [{k: "hotel", x: c.cx * C + 14, z: c.cz * C + 16, w: 13, d: 17, h: 8 + hash(c.cx, c.cz, 3) * 7, t: floor(hash(c.cx, c.cz, 4) * 5), n: hash(c.cx, c.cz, 5)}],
    suburb: range(4).filter(i => hash(c.cx, c.cz, 10 + i) > 0.15).map(i => {k: "house", x: c.cx * C + 11 + i % 2 * 10, z: c.cz * C + 11 + floor(i / 2) * 10, w: 5.5, d: 5, h: 2.4, r: hash(c.cx, c.cz, 50 + i), t: hash(c.cx, c.cz, 60 + i)}),
    canal: [{k: "water", x: c.cx * C + (c.cx == 11 ? 18.5 : 16), z: c.cz * C + 16, w: c.cx == 11 ? 27 : 22, d: 18, h: 0}],
    beach: c.cz == 0 ? [{k: "light", x: c.cx * C + 24, z: c.cz * C + 8, w: 3.6, d: 3.6, h: 17}] : [],
    stadium: [{k: "stadium", x: c.cx * C + 16, z: c.cz * C + 16, w: 19, d: 19, h: 5}],
    hosp: [{k: "hosp", x: c.cx * C + 16.5, z: c.cz * C + 15, w: 15, d: 13, h: 9}],
    police: [{k: "police", x: c.cx * C + 16, z: c.cz * C + 13, w: 15, d: 10, h: 6}, {k: "copcar", x: c.cx * C + 12, z: c.cz * C + 22.5, w: 4.2, d: 2, h: 1.5}, {k: "copcar", x: c.cx * C + 19, z: c.cz * C + 22.5, w: 4.2, d: 2, h: 1.5}],
    spray: [{k: "spray", x: c.cx * C + 16, z: c.cz * C + 13, w: 14, d: 11, h: 5}],
    gas: [{k: "shop", x: c.cx * C + 16, z: c.cz * C + 9.5, w: 12, d: 4, h: 3.2}, {k: "pump", x: c.cx * C + 13, z: c.cz * C + 18, w: 1, d: 1.6, h: 1.4}, {k: "pump", x: c.cx * C + 19, z: c.cz * C + 18, w: 1, d: 1.6, h: 1.4}],
    build: [{k: "frame", x: c.cx * C + 14, z: c.cz * C + 14, w: 13, d: 12, h: 7}, {k: "post", x: c.cx * C + 23.5, z: c.cz * C + 23.5, w: 1.4, d: 1.4, h: 30}],
    plaza: [{k: "fount", x: c.cx * C + 16, z: c.cz * C + 16, w: 6, d: 6, h: 0.8}]
  }[c.k] ?? []}))
  // What each kind of cell is paved with, and its color on the map.
  let GROUND = {park: parkTex, beach: beachTex, docks: docksTex, suburb: lawnTex, court: lawnTex, plaza: plazaTex, build: dirtTex, canal: canalTex, stadium: parkTex}
  let KCOL = {park: #5c9a44, beach: #e8d09c, canal: #2a8ca8, docks: #8a8780, suburb: #78a858, court: #78a858, plaza: #c8b494, stadium: #3ccf6e, hosp: #f4f2ec, police: #3d8bff, spray: #e07a2a, gas: #3ccf6e, build: #a8845a, hotel: #e8c8b0}
  // Stunt ramps, facing the way to jump, `y` high and throwing the car up by `k` of its speed: one in every park,
  // one on the beach, and two steep ones to clear the canal, from the park north of it and up the beach at its mouth.
  let RAMPS = [{x: 2 * C + 16, z: 9 * C + 20, h: 0, y: 2.4, k: 0.45}, {x: 11 * C + 19, z: 11 * C + 14, h: 180, y: 2.4, k: 0.45}, {x: 11 * C + 19, z: 5 * C + 16, h: 0, y: 1.6, k: 0.3}] + CELLS.filter(c => c.k == "park" && !(c.cx == 2 && c.cz == 9)).map(c => {x: c.cx * C + 16, z: c.cz * C + 16, h: floor(hash(c.cx, c.cz, 9) * 4) * 90, y: 1.6, k: 0.3})
  // Missions start at spots on the streets, each a column in its color with its name over it; the list (the
  // MISSIONS button) leads you to one. Races run over corners of the road grid, each leg along one road, from a
  // start line half a block past the first corner, round and back to it.
  let RACES = [
    {name: "harbor run", pts: [[2, 7], [9, 7], [9, 3], [6, 3], [6, 1], [3, 1], [3, 5], [1, 5], [1, 7], [2, 7]]},
    {name: "canal circuit", pts: [[3, 11], [9, 11], [9, 15], [4, 15], [4, 13], [1, 13], [1, 9], [3, 9], [3, 11]]}
  ]
  let RPATH = RACES.map(r => [[r.pts[0][0] * C + sign(r.pts[1][0] - r.pts[0][0]) * 16, r.pts[0][1] * C + sign(r.pts[1][1] - r.pts[0][1]) * 16]] + drop(r.pts, 1).map(p => [p[0] * C, p[1] * C]))
  // How far along its race each corner is.
  let RCUM = RPATH.map(P => range(len(P)).map(i => sum(range(i).map(j => dist(P[j], P[j + 1])))))
  let GIVERS = [
    {k: "race", r: 0, name: "street race", sub: "harbor run", x: RPATH[0][0][0], z: RPATH[0][0][1], col: #ff4f6a, car: true, pay: "up to $500", goal: "Beat three racers round the harbor. Drive through every checkpoint; the first back to the start wins."},
    {k: "race", r: 1, name: "street race", sub: "canal circuit", x: RPATH[1][0][0], z: RPATH[1][0][1], col: #ff4f6a, car: true, pay: "up to $500", goal: "Beat three racers over the canal bridges and round the suburbs. Drive through every checkpoint; the first back wins."},
    {k: "takedown", name: "takedown", sub: "for the precinct", x: 5 * C + 16, z: 9 * C, col: #4f8bff, car: true, pay: "$350", goal: "A red sports car is on the run. Catch it and ram it until it's wrecked, within 2:30, before it gets away."},
    {k: "getaway", name: "getaway", sub: "hot car", x: 4 * C + 16, z: C, col: #b06cff, car: false, pay: "$500", goal: "Take the hot car with three stars on it, lose the police, and drive it into the garage with no stars left."},
    {k: "stunt", name: "stunt tour", sub: "three ramps", x: C, z: 7 * C + 16, col: #f2c230, car: true, pay: "$150 a jump", goal: "Land a jump off each marked ramp in turn within 2:30. Hit it fast, the way its stripes point."},
    {k: "cargo", name: "fragile cargo", sub: "champagne", x: 8 * C + 16, z: 2 * C, col: #3ccf6e, car: true, pay: "up to $450", goal: "Drive a crate of champagne across town before the clock runs out. Every knock breaks bottles, and the pay drops."},
    {k: "courier", name: "courier", sub: "three drops", x: 5 * C + 16, z: 6 * C, col: #ffb03b, car: false, pay: "$80 a drop", goal: "Take three parcels, one after another, each to its door before the clock runs out."}
  ]
  // The stunt tour's ramps: the three park ramps nearest its start.
  let STUNT = take(sortBy(drop(RAMPS, 2), r => dist([r.x, r.z], [C, 7 * C + 16])), 3)
  // Doors on the roads to deliver to, and crossings for a takedown's car to start from.
  let DROPS = flatten(range(1, 16).map(cz => range(0, 11).map(cx => [cx * C + 16, cz * C])))
  let XING = flatten(range(2, 15).map(z => range(2, 11).map(x => [x, z])))
  // Shadows: everything standing casts one away from the sun (LIGHT), its footprint swept toward the north-east by
  // its height. One flat mesh per row of cells, made once; a row's shadows reach at most into the row north of it.
  let SHADES = range(16).map(cz => [flatten(range(12).map(cx => CELLS[cz * 12 + cx].b)).filter(b => b.h > 0 && b.k != "water" && b.k != "tank")].map(bs => mesh(
    flatten(bs.map(b => [[(b.h + (b.u ?? 0)) * 0.35, (b.h + (b.u ?? 0)) * -0.45]].map(s => [[b.x - b.w / 2, 0, b.z - b.d / 2], [b.x - b.w / 2 + s[0], 0, b.z - b.d / 2 + s[1]], [b.x + b.w / 2 + s[0], 0, b.z - b.d / 2 + s[1]], [b.x + b.w / 2 + s[0], 0, b.z + b.d / 2 + s[1]], [b.x + b.w / 2, 0, b.z + b.d / 2], [b.x - b.w / 2, 0, b.z + b.d / 2]])[0])),
    range(len(bs)).map(i => range(6).map(j => i * 6 + j))
  ))[0])
  // A container ship tied up at the docks.
