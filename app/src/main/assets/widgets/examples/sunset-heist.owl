  let GUN2 = mesh([[-0.06, 0.26, -0.2], [0.06, 0.26, -0.2], [-0.06, 0.38, -0.2], [0.06, 0.38, -0.2], [-0.06, 0.26, 1.25], [0.06, 0.26, 1.25], [-0.06, 0.38, 1.25], [0.06, 0.38, 1.25], [-0.09, 0.15, 0.55], [0.09, 0.15, 0.55], [-0.09, 0.26, 0.55], [0.09, 0.26, 0.55], [-0.09, 0.15, 0.95], [0.09, 0.15, 0.95], [-0.09, 0.26, 0.95], [0.09, 0.26, 0.95], [-0.1, 0.05, -0.85], [0.1, 0.05, -0.85], [-0.1, 0.35, -0.85], [0.1, 0.35, -0.85], [-0.1, 0.05, -0.2], [0.1, 0.05, -0.2], [-0.1, 0.35, -0.2], [0.1, 0.35, -0.2], [-0.08, -0.12, -0.25], [0.08, -0.12, -0.25], [-0.08, 0.16, -0.25], [0.08, 0.16, -0.25], [-0.08, -0.12, -0.07], [0.08, -0.12, -0.07], [-0.08, 0.16, -0.07], [0.08, 0.16, -0.07]], [[0, 4, 6, 2], [1, 3, 7, 5], [0, 1, 5, 4], [2, 6, 7, 3], [0, 2, 3, 1], [4, 5, 7, 6], [8, 12, 14, 10], [9, 11, 15, 13], [8, 9, 13, 12], [10, 14, 15, 11], [8, 10, 11, 9], [12, 13, 15, 14], [16, 20, 22, 18], [17, 19, 23, 21], [16, 17, 21, 20], [18, 22, 23, 19], [16, 18, 19, 17], [20, 21, 23, 22], [24, 28, 30, 26], [25, 27, 31, 29], [24, 25, 29, 28], [26, 30, 31, 27], [24, 26, 27, 25], [28, 29, 31, 30]], [#3a3a4c, #3a3a4c, #3a3a4c, #3a3a4c, #3a3a4c, #3a3a4c, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #121018, #121018, #121018, #121018, #121018, #121018])
  let CROSS = mesh([[-0.6, -0.18, -0.18], [0.6, -0.18, -0.18], [-0.6, 0.18, -0.18], [0.6, 0.18, -0.18], [-0.6, -0.18, 0.18], [0.6, -0.18, 0.18], [-0.6, 0.18, 0.18], [0.6, 0.18, 0.18], [-0.18, -0.6, -0.18], [0.18, -0.6, -0.18], [-0.18, 0.6, -0.18], [0.18, 0.6, -0.18], [-0.18, -0.6, 0.18], [0.18, -0.6, 0.18], [-0.18, 0.6, 0.18], [0.18, 0.6, 0.18]], [[0, 4, 6, 2], [1, 3, 7, 5], [0, 1, 5, 4], [2, 6, 7, 3], [0, 2, 3, 1], [4, 5, 7, 6], [8, 12, 14, 10], [9, 11, 15, 13], [8, 9, 13, 12], [10, 14, 15, 11], [8, 10, 11, 9], [12, 13, 15, 14]], [null, null, null, null, null, null, null, null, null, null, null, null])
  let BODY = mesh([[-0.3, 0.8, -0.15], [0.3, 0.8, -0.15], [-0.3, 0.92, -0.15], [0.3, 0.92, -0.15], [-0.3, 0.8, 0.15], [0.3, 0.8, 0.15], [-0.3, 0.92, 0.15], [0.3, 0.92, 0.15], [-0.35, 0.9, -0.2], [0.35, 0.9, -0.2], [-0.35, 1.6, -0.2], [0.35, 1.6, -0.2], [-0.35, 0.9, 0.2], [0.35, 0.9, 0.2], [-0.35, 1.6, 0.2], [0.35, 1.6, 0.2], [-0.22, 1.62, -0.2], [0.22, 1.62, -0.2], [-0.22, 2.04, -0.2], [0.22, 2.04, -0.2], [-0.22, 1.62, 0.2], [0.22, 1.62, 0.2], [-0.22, 2.04, 0.2], [0.22, 2.04, 0.2]], [[0, 4, 6, 2], [1, 3, 7, 5], [0, 1, 5, 4], [2, 6, 7, 3], [0, 2, 3, 1], [4, 5, 7, 6], [8, 12, 14, 10], [9, 11, 15, 13], [8, 9, 13, 12], [10, 14, 15, 11], [8, 10, 11, 9], [12, 13, 15, 14], [16, 20, 22, 18], [17, 19, 23, 21], [16, 17, 21, 20], [18, 22, 23, 19], [16, 18, 19, 17], [20, 21, 23, 22]], [#2a2638, #2a2638, #2a2638, #2a2638, #2a2638, #2a2638, null, null, null, null, null, null, #e0b48c, #e0b48c, #e0b48c, #e0b48c, #e0b48c, #e0b48c])
  let LEG = mesh([[-0.13, -0.9, -0.14], [0.13, -0.9, -0.14], [-0.13, 0, -0.14], [0.13, 0, -0.14], [-0.13, -0.9, 0.14], [0.13, -0.9, 0.14], [-0.13, 0, 0.14], [0.13, 0, 0.14]], [[0, 4, 6, 2], [1, 3, 7, 5], [0, 1, 5, 4], [2, 6, 7, 3], [0, 2, 3, 1], [4, 5, 7, 6]], [#2a2638, #2a2638, #2a2638, #2a2638, #2a2638, #2a2638])
  let ARM = mesh([[-0.09, -0.62, -0.1], [0.09, -0.62, -0.1], [-0.09, 0, -0.1], [0.09, 0, -0.1], [-0.09, -0.62, 0.1], [0.09, -0.62, 0.1], [-0.09, 0, 0.1], [0.09, 0, 0.1], [-0.08, -0.74, -0.09], [0.08, -0.74, -0.09], [-0.08, -0.62, -0.09], [0.08, -0.62, -0.09], [-0.08, -0.74, 0.09], [0.08, -0.74, 0.09], [-0.08, -0.62, 0.09], [0.08, -0.62, 0.09]], [[0, 4, 6, 2], [1, 3, 7, 5], [0, 1, 5, 4], [2, 6, 7, 3], [0, 2, 3, 1], [4, 5, 7, 6], [8, 12, 14, 10], [9, 11, 15, 13], [8, 9, 13, 12], [10, 14, 15, 11], [8, 10, 11, 9], [12, 13, 15, 14]], [null, null, null, null, null, null, #e0b48c, #e0b48c, #e0b48c, #e0b48c, #e0b48c, #e0b48c])
  let CASHB = mesh([[-0.55, -0.2, -0.3], [0.55, -0.2, -0.3], [-0.55, 0.2, -0.3], [0.55, 0.2, -0.3], [-0.55, -0.2, 0.3], [0.55, -0.2, 0.3], [-0.55, 0.2, 0.3], [0.55, 0.2, 0.3], [-0.57, -0.06, -0.12], [0.57, -0.06, -0.12], [-0.57, 0.06, -0.12], [0.57, 0.06, -0.12], [-0.57, -0.06, 0.12], [0.57, -0.06, 0.12], [-0.57, 0.06, 0.12], [0.57, 0.06, 0.12]], [[0, 4, 6, 2], [1, 3, 7, 5], [0, 1, 5, 4], [2, 6, 7, 3], [0, 2, 3, 1], [4, 5, 7, 6], [8, 12, 14, 10], [9, 11, 15, 13], [8, 9, 13, 12], [10, 14, 15, 11], [8, 10, 11, 9], [12, 13, 15, 14]], [null, null, null, null, null, null, #e8f8ee, #e8f8ee, #e8f8ee, #e8f8ee, #e8f8ee, #e8f8ee])
  let GUNS = [GUN0, GUN1, GUN2]
  // Lamps on every other block corner.
  let LAMP = #e8e6dc
  let MANBOX = [[-0.3, 0, -0.15, 0.6, 0.9, 0.3, #2a2638], [-0.35, 0.9, -0.2, 0.7, 0.7, 0.4, null], [-0.22, 1.62, -0.2, 0.44, 0.42, 0.4, #e0b48c]]
  let MAN = mesh(
    flatten(MANBOX.map(b => range(8).map(i => [b[0] + i % 2 * b[3], b[1] + floor(i / 2) % 2 * b[4], b[2] + floor(i / 4) * b[5]]))),
    flatten(MANBOX.map((b, j) => FACES.map(f => f.map(i => i + j * 8)))),
    flatten(MANBOX.map(b => [b[6], b[6], b[6], b[6], b[6], b[6]]))
  )

  // The camera looks down at the player, a little from the south, higher the faster you drive and the narrower the screen.
  let D = clamp(38 * H / W, 40, 92) + (inCar ? abs(pv) * 0.5 + py * 1.2 : -6)
  let cam = {eye: [camX, D * 0.95, camZ + D * 0.3], look: [camX, 0, camZ - 2], fov: 48, near: 4, far: D * 2.4}
  let cx0 = max(0, floor((camX - W / H * D * 0.75 - 16) / C))
  let cx1 = min(11, floor((camX + W / H * D * 0.75 + 16) / C))
  let cz0 = max(0, floor((camZ - D * 0.7 - 10) / C))
  let cz1 = min(15, floor((camZ + D * 0.4 + 26) / C))
  let vis = flatten(range(cz0, cz1 + 1).map(cz => range(cx0, cx1 + 1).map(cx => CELLS[cz * 12 + cx])))
  // The cars and people on the screen, the only ones drawn: the ground in view reaches about W / H * D * 0.52 to
  // each side, 0.6 D up the screen and 0.4 D down it, and a few meters more takes in a long truck or a tall van.
  let VX = W / H * D * 0.55 + 6
  let VZ0 = camZ - D * 0.62 - 6
  let VZ1 = camZ + D * 0.4 + 6
  let seenCars = cars.filter(c => abs(c.x - camX) < VX && c.z > VZ0 && c.z < VZ1)
  let seenCops = cops.filter(c => abs(c.x - camX) < VX && c.z > VZ0 && c.z < VZ1)
  let seenParked = parked.filter(c => abs(c.x - camX) < VX && c.z > VZ0 && c.z < VZ1)
  let seenPeds = peds.filter(p => abs(p.x - camX) < VX && p.z > VZ0 && p.z < VZ1)
  let seenOfficers = officers.filter(o => abs(o.x - camX) < VX && o.z > VZ0 && o.z < VZ1)

  // The stick: wherever a thumb goes down, pushed the way to go. Its direction is a direction on the screen, the
  // world's too (north is up), and how far it's pushed, up to 55 dp, how fast.
  let stick = first(fingers)
  let reach = stick == null ? 0 : dist([stick.x - stick.startX, stick.y - stick.startY])
  let push = reach < 8 ? 0 : min(1, (reach - 8) / 47)
  let sdx = push == 0 ? 0 : (stick.x - stick.startX) / reach * push
  let sdy = push == 0 ? 0 : (stick.y - stick.startY) / reach * push
  // On foot: the nearest car within reach, parked or in traffic.
  let near = inCar || sunk != null ? null : first(sortBy(parked.filter(c => !c.wreck).map(c => merge(c, {kind: "parked", dd: dist([c.x, c.z], [px, pz])})) + cars.map(c => merge(c, {kind: "traffic", dd: dist([c.x, c.z], [px, pz])})) + cops.filter(c => c.out ?? false).map(c => merge(c, {kind: "police", t: 9, c: 0, dd: dist([c.x, c.z], [px, pz])})), c => c.dd).filter(c => c.dd < 5))
  let shown = gt - msgAt < 2.5
  // Pickups not taken in the last 90 seconds, near enough to the camera to matter.
  let gone = taken.filter(t => gt - t.t < 90).map(t => t.id)
  let nearPicks = PICKS.filter(p => abs(p.x - camX) < 80 && abs(p.z - camZ) < 120 && indexOf(gone, p.id) < 0)
  let nearShore = flatten(range(max(0, floor((camZ - 120) / C) + 3), min(22, floor((camZ + 120) / C) + 4)).map(r => SHORE_ROWS[r])).filter(p => abs(p.x - camX) < 80 && abs(p.z - camZ) < 120)
  // Each boat's place: how far along its lane, and which way it's going.
  let boats = BOATS.map(b => [(gt * b.sp + b.off) % (b.lane % 2 == 0 ? 1172 + 4 * E : 834 + 2 * E)].map(s => [b.lane % 2 == 0 ? 586 + 2 * E : 417 + E].map(L => merge(b, {x: b.lane == 0 ? -24 - E : (b.lane == 2 ? 400 : -24 - E + (s < L ? s : 2 * L - s)), z: b.lane == 1 ? -46 - E : (b.lane == 3 ? 540 + E : -46 - E + (s < L ? s : 2 * L - s)), h: (b.lane % 2 == 0 ? 0 : 90) + (s < L ? 0 : 180)}))[0])[0]).filter(b => abs(b.x - camX) < 90 && abs(b.z - camZ) < 120)
  let nearRamps = RAMPS.filter(r => abs(r.x - camX) < 80 && abs(r.z - camZ) < 120)
  // Missions: where the one running wants you now (the next checkpoint, the car to stop, the ramp's run-up, the
  // door), or the mission spot picked from the list; its color; and in a race, how far along you are and your place.
  let RACE = mis.k == "race" ? RPATH[mis.r] : null
  let goal = mis == null ? (track == null ? null : [GIVERS[track].x, GIVERS[track].z]) : (mis.k == "race" ? RACE[min(mis.i, len(RACE) - 1)] : (mis.k == "takedown" ? (prey == null ? null : [prey.x, prey.z]) : (mis.k == "stunt" ? [STUNT[min(mis.i, 2)]].map(r => dist([r.x, r.z], [px, pz]) < 18 ? [r.x, r.z] : [r.x - sin(rad(r.h)) * 14, r.z - cos(rad(r.h)) * 14])[0] : [mis.gx, mis.gz])))
  let mcol = mis != null ? GIVERS[mis.g].col : (track == null ? white : GIVERS[track].col)
  let gd = goal == null ? 0 : round(dist(goal, [px, pz]))
  let raceS = mis.k == "race" ? RCUM[mis.r][mis.i] - dist(RACE[mis.i], [px, pz]) : 0
  let place = 1 + count(rivals, r => r.s > raceS)
  let cargo = mis.k == "cargo" ? clamp(round(100 - (dmg - mis.d0) * 2), 0, 100) : 100
  let left = mis == null || mis.until == 0 ? 0 : max(0, mis.until - gt)
  let objective = mis.k == "race" ? (gt < mis.go ? "get ready" : "checkpoint ${mis.i} of ${len(RACE) - 1} · ${gd} m") : (mis.k == "takedown" ? "ram the red car · ${gd} m" : (mis.k == "getaway" ? (heat > 0 ? "lose the police" : "into the garage · ${gd} m") : (mis.k == "stunt" ? "ramp ${min(mis.i, 2) + 1} of 3 · ${gd} m" : (mis.k == "cargo" ? "deliver the champagne · ${gd} m" : (mis.k == "courier" ? "parcel ${mis.i + 1} of 3 · ${gd} m" : "")))))
  let status = mis.k == "race" ? (gt < mis.go ? "on the grid" : ["1st", "2nd", "3rd", "4th"][min(3, place - 1)] + " place · " + fmtTime(max(0, gt - mis.go), "m:ss", "UTC")) : (mis.k == "takedown" ? "its car ${max(0, round(prey.hp ?? 0))}% · " + fmtTime(left, "m:ss", "UTC") + " left" : (mis.k == "getaway" ? (heat > 0 ? "out of their sight the stars drop" : "no stars on you · keep it that way") : (mis.k == "stunt" ? "drive up the ramp fast · " + fmtTime(left, "m:ss", "UTC") + " left" : (mis.k == "cargo" ? "cargo ${cargo}% · " + fmtTime(left, "m:ss", "UTC") + " left" : (mis.k == "courier" ? fmtTime(left, "m:ss", "UTC") + " left" : "")))))
  let urgent = mis != null && (mis.until > 0 && left < 15 || mis.k == "cargo" && cargo < 40 || mis.k == "race" && place > 1 && gt > mis.go)
  // The way there along the roads, as a navigator shows it: from the crossing at either end of the road you're on
  // to the one at either end of the goal's road, whichever pair makes it shortest, with one turn between them.
  // On the goal's own stretch of road, or close to it, straight there; a turn you're already in is left out, so
  // the arrows never point back. In a race, the next two checkpoints.
  let onH = abs(pz - round(pz / C) * C) < 8
  let onV = abs(px - round(px / C) * C) < 8
  let sOpts = onH && !onV ? [[floor(px / C), round(pz / C)], [min(11, floor(px / C) + 1), round(pz / C)]] : (onV && !onH ? [[round(px / C), floor(pz / C)], [round(px / C), min(16, floor(pz / C) + 1)]] : [[round(px / C), round(pz / C)]])
  let gH = goal != null && abs(goal[1] - round(goal[1] / C) * C) < 8
  let gV = goal != null && abs(goal[0] - round(goal[0] / C) * C) < 8
  let tOpts = goal == null ? [] : (gH && !gV ? [[floor(goal[0] / C), round(goal[1] / C)], [min(11, floor(goal[0] / C) + 1), round(goal[1] / C)]] : (gV && !gH ? [[round(goal[0] / C), floor(goal[1] / C)], [round(goal[0] / C), min(16, floor(goal[1] / C) + 1)]] : [[round(goal[0] / C), round(goal[1] / C)]]))
  let pair = goal == null ? null : first(sortBy(flatten(sOpts.map(s => tOpts.map(t => [s, t]))), q => dist([q[0][0] * C, q[0][1] * C], [px, pz]) + (abs(q[0][0] - q[1][0]) + abs(q[0][1] - q[1][1])) * C + dist([q[1][0] * C, q[1][1] * C], goal)))
  let direct = goal != null && (dist(goal, [px, pz]) < 24 || (onH && gH && round(pz / C) == round(goal[1] / C) && floor(px / C) == floor(goal[0] / C)) || (onV && gV && round(px / C) == round(goal[0] / C) && floor(pz / C) == floor(goal[1] / C)))
  let route = goal == null ? [] : (mis.k == "race" ? [[px, pz]] + take(drop(RACE, mis.i), 2) : (direct || pair == null ? [[px, pz], goal] : [[px, pz]] + [[pair[0][0] * C, pair[0][1] * C], onH ? [pair[1][0] * C, pair[0][1] * C] : [pair[0][0] * C, pair[1][1] * C], [pair[1][0] * C, pair[1][1] * C]].filter(q => dist(q, [px, pz]) > 10) + [goal]))
  // Arrows painted on the road along it, every 6 m, near enough to the camera to show.
  let arrows = flatten(range(max(0, len(route) - 1)).map(i => [[route[i], route[i + 1], dist(route[i], route[i + 1])]].map(g => range(1, floor(g[2] / 6) + 1).map(k => {x: g[0][0] + (g[1][0] - g[0][0]) * k * 6 / g[2], z: g[0][1] + (g[1][1] - g[0][1]) * k * 6 / g[2], h: deg(atan2(g[1][0] - g[0][0], g[1][1] - g[0][1]))}))[0])).filter(a => abs(a.x - camX) < 70 && abs(a.z - camZ) < 100)
  // Where the goal shows on the screen, for its label, or for the arrow at the screen's edge that points to it.
  let gp = goal == null ? null : project([goal[0], 3, goal[1]], cam, W, H)
  let gOn = gp != null && gp.x > 30 && gp.x < W - 30 && gp.y > TOP + 100 && gp.y < H - BOT - 60
  let ga = goal == null ? 0 : atan2(goal[1] - pz, goal[0] - px)
  // The mission spot you're at, with none running, and those on the screen to name.
  let at = mis == null ? first(range(len(GIVERS)).filter(i => dist([GIVERS[i].x, GIVERS[i].z], [px, pz]) < 9)) : null
  let nearGivers = mis != null ? [] : range(len(GIVERS)).filter(i => abs(GIVERS[i].x - camX) < 80 && abs(GIVERS[i].z - camZ) < 120).map(i => merge(GIVERS[i], {i: i, done: indexOf(done, i) >= 0}))
  // The HUD's lettering: tall, heavy and condensed, outlined in black straight over the game, no panels.
  let ANTON = "https://raw.githubusercontent.com/google/fonts/main/ofl/anton/Anton-Regular.ttf"
  // A white fist on the attack button with no gun in hand.
  asset FIST_ICON = base64""
  let OUTL = [[-1.6, -1.6], [1.6, -1.6], [-1.6, 1.6], [1.6, 1.6], [2, 2.6]]
  let HUD = mode != "play" ? [] : [{s: "$" + pad(str(max(0, cash)), 8, "0"), x: W - 16, y: TOP + 30, size: 34, c: #6cc04a, a: "end"}]
    + range(5).map(i => {s: "★", x: W - 16 - (4 - i) * 25, y: TOP + 66, size: 25, c: i < heat ? (floor(gt * 4) % 2 == 0 ? #f2c230 : #ff3a2a) : #a8a8a8, a: "end"})
    + (inCar ? [{s: upper(TYPES[ptype].name) + " " + max(0, round(100 - dmg)) + "%", x: W - 16, y: TOP + 96, size: 17, c: dmg > 60 ? #ff3a2a : white, a: "end"}] : [])
    // Top left: MISSIONS (or where the picked one is) to open the list, or the running mission's lines and QUIT.
    + (mis == null ? [{s: track == null ? "MISSIONS" : upper(GIVERS[track].name), x: 16, y: TOP + 30, size: 24, c: track == null ? #f2c230 : mcol, a: "start"}, {s: track == null ? "${len(done)} OF ${len(GIVERS)} DONE · TAP FOR THE LIST" : gd + " M · TAP FOR THE LIST", x: 16, y: TOP + 54, size: 13, c: white, a: "start"}]
      : [{s: upper(GIVERS[mis.g].name), x: 16, y: TOP + 30, size: 20, c: mcol, a: "start"}, {s: upper(objective), x: 16, y: TOP + 56, size: 17, c: white, a: "start"}, {s: upper(status), x: 16, y: TOP + 80, size: 17, c: urgent ? #ff3a2a : white, a: "start"}, {s: "QUIT", x: 16, y: TOP + 106, size: 15, c: #a8a8a8, a: "start"}])
    + (mis.k == "race" && gt < mis.go + 0.8 ? [{s: gt < mis.go ? str(ceil(mis.go - gt)) : "GO", x: W / 2, y: H * 0.36, size: 90, c: gt < mis.go ? white : #6cc04a, a: "center"}, {s: "BE FIRST BACK TO THE START", x: W / 2, y: H * 0.36 + 64, size: 20, c: white, a: "center"}] : [])
    + (shown ? [{s: upper(first(split(msg, " · ")) ?? ""), x: W / 2, y: H * 0.36, size: 46, c: startsWith(msg, "wasted") || startsWith(msg, "busted") || startsWith(msg, "wrecked") || startsWith(msg, "too late") || startsWith(msg, "failed") ? #d8242a : #f2c230, a: "center"}]
      + drop(split(msg, " · "), 1).map((m, i) => {s: upper(m), x: W / 2, y: H * 0.36 + 40 + i * 26, size: 20, c: white, a: "center"}) : [])

  every frame {
    if !still {
      gt = gt + (mode == "list" ? 0 : dt)
      let T = TYPES[ptype]
      if !inCar && (py != 0 || air != null) {
        py = 0
        pvy = 0
        air = null
      }
      // Lost off the map (no position, or past its edge): back on the street by a parked car, so the game never shows
      // only sky.
      if px == null || pz == null || camX == null || camZ == null || px < -60 || pz < -60 || px > 12 * C + 60 || pz > 16 * C + 60 {
        px = 112
        pz = 318
        camX = 112
        camZ = 318
        inCar = false
        pv = 0
        pvx = 0
        pvz = 0
        parked = parked + [{id: nextId, t: 1, x: 112, z: 322.5, h: 90, c: pcol ?? 1, dmg: 0, wreck: false}]
        nextId = nextId + 1
      }
      if mode == "play" {
        if inCar {
          // The car turns to face where the stick points and speeds up to how far it's pushed; let go and it rolls to a
          // stop. Its velocity keeps going the way it went, the tires pulling it round to where the car points, much
          // less in a sharp turn at speed: a drift, which leaves marks.
          let fx0 = sin(rad(ph))
          let fz0 = cos(rad(ph))
          let fwd = pvx * fx0 + pvz * fz0
          let lat = pvz * fx0 - pvx * fz0
          // How far the car must turn to face where the stick points; the further it's pushed, the faster it goes.
          // In the air off a ramp nothing steers, brakes or grips: it flies on as it left.
          let turnBy = push == 0 || air != null ? 0 : ((deg(atan2(sdx, sdy)) - ph + 540) % 360) - 180
          // Each kind its own: top speed, pick-up, how it turns and how well its tires hold.
          let drift = fwd > T.top * 0.42 && abs(turnBy) > 50
          let want = push * T.top * (abs(turnBy) > 110 ? 0.35 : 1)
          let f1 = air != null ? fwd : clamp((fwd + (fwd < want ? T.acc : (push > 0 ? -30 : 0)) * dt) * pow(push > 0 ? 0.92 : 0.6, dt), -4, T.top)
          let l1 = air != null ? lat : lat * pow(drift ? T.drift : T.grip, dt)
          let vx1 = fx0 * f1 - fz0 * l1
          let vz1 = fz0 * f1 + fx0 * l1
          let nx = px + vx1 * dt
          let nz = pz + vz1 * dt
          // Walls: a move into one keeps the part along it, so the car slides along buildings instead of stopping dead;
          // straight into one, it bounces. A bump or a ram can shove the car into a wall's reach: from there, any move
          // out is let through.
          let stuck = any(CELLS[floor(pz / C) * 12 + floor(px / C)].b ?? [], b => b.k != "water" && b.h >= py && abs(px - b.x) < b.w / 2 + T.wid / 2 + 0.3 && abs(pz - b.z) < b.d / 2 + T.wid / 2 + 0.3)
          let hitXZ = !stuck && any(CELLS[floor(nz / C) * 12 + floor(nx / C)].b ?? [], b => b.k != "water" && b.h >= py && abs(nx - b.x) < b.w / 2 + T.wid / 2 + 0.3 && abs(nz - b.z) < b.d / 2 + T.wid / 2 + 0.3)
          let hitX = hitXZ && (!stuck && any(CELLS[floor(pz / C) * 12 + floor(nx / C)].b ?? [], b => b.k != "water" && b.h >= py && abs(nx - b.x) < b.w / 2 + T.wid / 2 + 0.3 && abs(pz - b.z) < b.d / 2 + T.wid / 2 + 0.3))
          let hitZ = hitXZ && (!stuck && any(CELLS[floor(nz / C) * 12 + floor(px / C)].b ?? [], b => b.k != "water" && b.h >= py && abs(px - b.x) < b.w / 2 + T.wid / 2 + 0.3 && abs(nz - b.z) < b.d / 2 + T.wid / 2 + 0.3))
          let both = hitX && hitZ
          // How fast it met the wall: what of its speed the wall took.
          let impact = !hitXZ ? 0 : (both ? dist([vx1, vz1]) : (hitX ? abs(vx1) : abs(vz1)))
          if impact > 18 {
            haptic()
            dmg = dmg + impact * 0.2 * T.armor
            fx = drop(fx, max(0, len(fx) - 30)) + range(8).map(i => {k: "spark", x: px + fx0 * 2, y: 0.8, z: pz + fz0 * 2, vx: random() * 16 - 8, vy: random() * 8, vz: random() * 16 - 8, life: 0.4 + random() * 0.3})
          }
          let vx2 = !hitXZ || !hitX ? vx1 : -vx1 * 0.2
          let vz2 = !hitXZ || !both && hitX ? vz1 : -vz1 * 0.2
          ph = ph + clamp(turnBy, -1, 1) * min(abs(turnBy), (drift ? 230 : 190) * T.turn * clamp(abs(f1) / 6, 0.4, 1) * dt)
          pvx = vx2
          pvz = vz2
          pv = vx2 * fx0 + vz2 * fz0
          px = !hitXZ || !hitX ? nx : px
          pz = !hitXZ || !both && hitX ? nz : pz
          if air == null && abs(l1) > 3.5 && gt - skidAt > 0.05 {
            skids = drop(skids, max(0, len(skids) - 50)) + [{x: px - fx0 * T.len * 0.3, z: pz - fz0 * T.len * 0.3, h: ph, t: gt, w: T.wid}]
            skidAt = gt
          }
          // Ramps: on one the car rides up the slope, and leaving the top fast enough it flies until gravity brings it
          // down. A long jump pays; one that comes down in the canal or the sea goes under, as driving in does.
          if air == null {
            let ramp = first(RAMPS.filter(r => abs((px - r.x) * cos(rad(r.h)) - (pz - r.z) * sin(rad(r.h))) < 2.4 && abs((px - r.x) * sin(rad(r.h)) + (pz - r.z) * cos(rad(r.h))) < 3.2))
            let along = ramp == null ? 0 : (px - ramp.x) * sin(rad(ramp.h)) + (pz - ramp.z) * cos(rad(ramp.h))
            let up = ramp == null ? 0 : pvx * sin(rad(ramp.h)) + pvz * cos(rad(ramp.h))
            py = ramp == null ? 0 : clamp((along + 3) / 6, 0, 1) * ramp.y
            if ramp != null && along > 2.4 && up > 8 {
              air = {t: gt, x: px, z: pz, rx: ramp.x, rz: ramp.z}
              pvy = up * ramp.k
            }
          } else {
            py = py + pvy * dt
            pvy = pvy - 24 * dt
            if py <= 0 {
              let span = dist([px, pz], [air.x, air.z])
              let airT = gt - air.t
              let wet = any(CELLS[floor(pz / C) * 12 + floor(px / C)].b ?? [], b => b.k == "water" && abs(px - b.x) < b.w / 2 && abs(pz - b.z) < b.d / 2) || !(px > -E - 3.3 && px < 12 * C && pz > -E && pz < 16 * C + E + 3.4 && (pz > 0 || px < 11 * C + E) || any(nearShore, s => !s.flat && pow((px - s.x) * 2 / s.w, 2) + pow((pz - s.z) * 2 / s.d, 2) < 1))
              landed = {rx: air.rx, rz: air.rz, t: airT, wet: wet}
              py = 0
              pvy = 0
              air = null
              haptic()
              msgAt = gt
              if !wet {
                dmg = dmg + 4 * T.armor
                let bonus = airT > 0.5 ? round(span + airT * 20) : 0
                cash = cash + bonus
                msg = bonus > 0 ? "stunt · ${round(span)} m · +$${bonus}" : msg
                msgAt = bonus > 0 ? gt : msgAt
              }
            }
          }
          // Off the land into the sea, or over the quay into the canal: the car goes under, and you with it.
          if air == null && (any(CELLS[floor(pz / C) * 12 + floor(px / C)].b ?? [], b => b.k == "water" && abs(px - b.x) < b.w / 2 && abs(pz - b.z) < b.d / 2) || !(px > -E - 3.3 && px < 12 * C && pz > -E && pz < 16 * C + E + 3.4 && (pz > 0 || px < 11 * C + E) || any(nearShore, s => !s.flat && pow((px - s.x) * 2 / s.w, 2) + pow((pz - s.z) * 2 / s.d, 2) < 1))) {
            sunk = {at: gt, x: px, z: pz, h: ph, t: ptype, c: pcol}
            fx = drop(fx, max(0, len(fx) - 30)) + range(16).map(i => {k: "drop", x: px, y: 0.5, z: pz, vx: random() * 10 - 5, vy: 5 + random() * 7, vz: random() * 10 - 5, life: 0.6 + random() * 0.5})
            haptic()
            inCar = false
            firing = false
            pv = 0
            pvx = 0
            pvz = 0
          }
          // A damaged car smokes, more the worse it is.
          if dmg > 45 && gt - fxAt > 0.25 - dmg / 600 {
            fx = drop(fx, max(0, len(fx) - 30)) + [{k: "smoke", x: px + fx0 * 1.6, y: 1, z: pz + fz0 * 1.6, vx: random() - 0.5, vy: 2.5, vz: random() - 0.5, life: 1.4}]
            fxAt = gt
          }
        } else if sunk != null {
          if gt - sunk.at > 1.6 {
            hp = 0
          }
        } else {
          let nx = px + sdx * 10 * dt
          let nz = pz + sdy * 10 * dt
          if abs(sdx) + abs(sdy) > 0.15 {
            ph = deg(atan2(sdx, sdy))
          }
          px = !(nx > -E - 3.3 && nx < 12 * C && pz > -E && pz < 16 * C + E + 3.4 && (pz > 0 || nx < 11 * C + E) || any(nearShore, s => !s.flat && pow((nx - s.x) * 2 / s.w, 2) + pow((pz - s.z) * 2 / s.d, 2) < 1)) || any(CELLS[floor(pz / C) * 12 + floor(nx / C)].b ?? [], b => abs(nx - b.x) < b.w / 2 + 0.5 && abs(pz - b.z) < b.d / 2 + 0.5) ? px : nx
          pz = !(px > -E - 3.3 && px < 12 * C && nz > -E && nz < 16 * C + E + 3.4 && (nz > 0 || px < 11 * C + E) || any(nearShore, s => !s.flat && pow((px - s.x) * 2 / s.w, 2) + pow((nz - s.z) * 2 / s.d, 2) < 1)) || any(CELLS[floor(nz / C) * 12 + floor(px / C)].b ?? [], b => abs(px - b.x) < b.w / 2 + 0.5 && abs(nz - b.z) < b.d / 2 + 0.5) ? pz : nz
        }
        if mis.k == "race" && gt < mis.go {
          px = mis.sx
          pz = mis.sz
          ph = mis.sh
          pv = 0
          pvx = 0
          pvz = 0
        }
        // The camera keeps you in the middle: close behind on foot, with a look ahead in the car.
        camX = camX + (px + (inCar ? pvx * 0.45 : 0) - camX) * min(1, (inCar ? 5 : 14) * dt)
        camZ = camZ + (pz + (inCar ? pvz * 0.45 : 0) - camZ) * min(1, (inCar ? 5 : 14) * dt)
      }
      if mode == "title" {
        // The title drifts over the city.
        camX = 190 + sin(gt * 0.07) * 120
        camZ = 270 + cos(gt * 0.05) * 160
      }

      // Traffic: slow behind the car just ahead in the lane (or you), move, and turn where the planned turn meets the new lane.
      // Each car keeps its heading's direction, (dx, dz) = (round(sin), round(cos)), and the planned turn's, (ndx, ndz),
      // worked out once when they change; the lane is 2.5 to the right of the direction, (-dz, dx).
      // Only a car going the same way holds one up: two waiting on each other across a junction would wait forever.
      let lanes = groupBy(cars, c => c.h)
      cars = cars.map(c => [TYPES[c.t].len / 2 + 6].map(gap => [c.v + (((any(lanes[c.h] ?? [], o => o.id != c.id && (o.x - c.x) * c.dx + (o.z - c.z) * c.dz > 0 && (o.x - c.x) * c.dx + (o.z - c.z) * c.dz < gap && abs((o.x - c.x) * c.dz - (o.z - c.z) * c.dx) < 2) || (px - c.x) * c.dx + (pz - c.z) * c.dz > 0 && (px - c.x) * c.dx + (pz - c.z) * c.dz < gap && abs((px - c.x) * c.dz - (pz - c.z) * c.dx) < 2) ? 0 : min(12, TYPES[c.t].top * 0.4)) - c.v) * min(1, 3 * dt)].map(v => merge(c, {v: v, x: c.x + c.dx * v * dt, z: c.z + c.dz * v * dt, vh: c.vh + ((c.h - c.vh + 540) % 360 - 180) * min(1, 8 * dt)}))[0])[0])
      cars = cars.map(c => (c.x - (c.mx * C - (c.dz + c.ndz) * 2.5)) * c.dx + (c.z - (c.mz * C + (c.dx + c.ndx) * 2.5)) * c.dz >= 0
        ? merge(c, {h: c.nh, dx: c.ndx, dz: c.ndz, x: c.ndx != 0 ? c.x : c.mx * C - c.ndz * 2.5, z: c.ndx != 0 ? c.mz * C + c.ndx * 2.5 : c.z, mx: c.mx + c.ndx, mz: c.mz + c.ndz, plan: true})
        : c)
      // At the next corner: on, left or right where a road goes on (on more often), else back.
      cars = cars.map(c => c.plan ? [[[c.h, c.h, (c.h + 90) % 360, (c.h + 270) % 360].filter(d => d == 90 ? c.mx < 11 : (d == 270 ? c.mx > 0 : (d == 0 ? c.mz < 16 : c.mz > 0)))].map(o => len(o) > 0 ? o[random(len(o))] : (c.h + 180) % 360)[0]].map(nh => merge(c, {plan: false, nh: nh, ndx: round(sin(rad(nh))), ndz: round(cos(rad(nh)))}))[0] : c)
      // Traffic stays around you, as in the big city games: new cars start at a crossing a block or two off, just out of
      // view, mostly heading your way so they drive into the picture; once well behind you they're gone.
      cars = cars.filter(c => dist([c.x, c.z], [camX, camZ]) < 120)
      if len(cars) < 28 {
        let sx0 = clamp(round(camX / C) + random(-2, 2), 0, 11)
        let sz0 = clamp(round(camZ / C) + random(-3, 2), 0, 16)
        let opts = sortBy([0, 90, 180, 270].filter(d => d == 90 ? sx0 < 11 : (d == 270 ? sx0 > 0 : (d == 0 ? sz0 < 16 : sz0 > 0))), d => dist([(sx0 + round(sin(rad(d)))) * C, (sz0 + round(cos(rad(d)))) * C], [camX, camZ]))
        let sh = random() < 0.75 ? opts[0] : opts[random(len(opts))]
        let sp = [sx0 * C - round(cos(rad(sh))) * 2.5 + round(sin(rad(sh))) * 6, sz0 * C + round(sin(rad(sh))) * 2.5 + round(cos(rad(sh))) * 6]
        if (abs(sp[0] - camX) > W / H * D * 0.5 + 6 || sp[1] < camZ - D * 0.75 - 6 || sp[1] > camZ + D * 0.35 + 6) && !any(cars, o => dist([o.x, o.z], sp) < 7) {
          cars = cars + [{id: nextId, x: sp[0], z: sp[1], h: sh, vh: sh, nh: sh, dx: round(sin(rad(sh))), dz: round(cos(rad(sh))), ndx: round(sin(rad(sh))), ndz: round(cos(rad(sh))), mx: sx0 + round(sin(rad(sh))), mz: sz0 + round(cos(rad(sh))), v: 10, c: random(len(PAINT)), t: SPAWN[random(len(SPAWN))], plan: true}]
          nextId = nextId + 1
        }
      }

      // A car left in a lane is shoved toward the curb by the traffic it's in the way of (traffic is only near the camera).
      parked = parked.map(p => abs(p.x - camX) > 125 || abs(p.z - camZ) > 125 ? p : [first(cars.filter(c => dist([c.x, c.z], [p.x, p.z]) < TYPES[c.t ?? 1].r + TYPES[p.t ?? 1].r))].map(c => c == null ? p : merge(p, {x: p.x - round(cos(rad(c.h))) * 6 * dt, z: p.z + round(sin(rad(c.h))) * 6 * dt}))[0])

      // People on the sidewalks, now and then turning back; knocked over, they lie still, then get up and hurry on.
      peds = peds.map(p => p.down > 0 && ((p.gone ?? false) || gt - p.down < 3) ? p : merge(p, {x: p.x + round(sin(rad(p.h))) * p.v * dt, z: p.z + round(cos(rad(p.h))) * p.v * dt, h: random() < 0.002 || abs(p.z + round(cos(rad(p.h))) * 1.2 - (10 * C + 16)) < 9.5 ? (p.h + 180) % 360 : p.h}))
      peds = peds.filter(p => dist([p.x, p.z], [camX, camZ]) < 140 && (!(p.gone ?? false) || gt - p.down < 8))
      if len(peds) < 14 {
        let qx = clamp(floor(camX / C) + random(-3, 3), 0, 10)
        let qz = clamp(floor(camZ / C) + random(-3, 3), 0, 15)
        let side = random(4)
        let along = 6 + random() * 20
        let sp = side == 0 ? [qx * C + along, qz * C + 6] : (side == 1 ? [qx * C + along, qz * C + 26] : (side == 2 ? [qx * C + 6, qz * C + along] : [qx * C + 26, qz * C + along]))
        if dist(sp, [camX, camZ]) > 50 && abs(sp[1] - (10 * C + 16)) > 10 {
          peds = peds + [{id: nextId, x: sp[0], z: sp[1], h: side < 2 ? (random() < 0.5 ? 90 : 270) : (random() < 0.5 ? 0 : 180), v: 1.3 + random() * 0.6, c: random(5), down: 0}]
          nextId = nextId + 1
        }
      }

      fx = fx.map(f => merge(f, {x: f.x + f.vx * dt, y: f.y + f.vy * dt, z: f.z + f.vz * dt, vy: f.k == "spark" || f.k == "drop" ? f.vy - 20 * dt : f.vy * (f.k == "fire" ? pow(0.3, dt) : 1), life: f.life - dt})).filter(f => f.life > 0)
      shots = shots.filter(t => gt - t.t < 0.08)
      booms = booms.filter(b => gt - b.t < 1.2)
      if len(skids) > 0 && gt - skids[0].t > 8 {
        skids = drop(skids, 1)
      }

      if mode == "play" {
        // Driving into people knocks them over: that's a crime, and the police take note.
        if inCar && py < 1 && abs(pv) > 6 && any(peds, p => p.down == 0 && dist([p.x, p.z], [px, pz]) < T.r * 0.8 + 0.3) {
          peds = peds.map(p => p.down == 0 && dist([p.x, p.z], [px, pz]) < T.r * 0.8 + 0.3 ? merge(p, {down: gt, v: 4.5, h: (p.h + 180) % 360}) : p)
          haptic()
          if gt - crimeAt > 1 {
            heat = min(5, heat + 1)
            crimeAt = gt
          }
        }
        // Officers on foot go down the same way, and that's a crime too.
        if inCar && py < 1 && abs(pv) > 6 && any(officers, o => o.down == 0 && dist([o.x, o.z], [px, pz]) < T.r * 0.8 + 0.3) {
          officers = officers.map(o => o.down == 0 && dist([o.x, o.z], [px, pz]) < T.r * 0.8 + 0.3 ? merge(o, {down: gt, hp: 0}) : o)
          haptic()
          if gt - crimeAt > 1 {
            heat = min(5, heat + 1)
            crimeAt = gt
          }
        }
        // Bumping traffic: driving into it slows you and dents the car; the other car is shoved out of the way and
        // waits a moment. Only a move toward it bounces, so you can always drive off again.
        // A hit needs real overlap, not just closeness.
        let bump = first(cars.filter(c => dist([c.x, c.z], [px, pz]) < (T.r + TYPES[c.t].r) * 0.75))
        if inCar && py < 1 && bump != null {
          let bd = max(0.1, dist([bump.x, bump.z], [px, pz]))
          if (bump.x - px) * pvx + (bump.z - pz) * pvz > 0 {
            if gt - hitAt > 0.4 {
              dmg = dmg + dist([pvx, pvz]) * 0.2 * T.armor
              hitAt = gt
              haptic()
            }
            pv = pv * 0.5
            pvx = pvx * 0.5
            pvz = pvz * 0.5
          }
          cars = cars.map(c => c.id == bump.id ? merge(c, {v: 0, x: c.x + (c.x - px) / bd * ((T.r + TYPES[c.t].r) * 0.75 + 0.1 - bd), z: c.z + (c.z - pz) / bd * ((T.r + TYPES[c.t].r) * 0.75 + 0.1 - bd)}) : c)
        }

        // Police: as many as the heat, up to four, coming from a crossing out of view. Far off they drive the roads, taking
        // at each crossing the turn that brings them nearest you; close by they drive straight at you, sliding along
        // buildings and swerving out of corners; lose them by far enough and they go back to the roads. No heat left,
        // they turn away and leave.
        if len(cops) < min(heat, 4) && gt - copAt > 1.5 {
          let qx = clamp(round(px / C) + random(-4, 4), 0, 11)
          let qz = clamp(round(pz / C) + random(-4, 4), 0, 16)
          let qopts = sortBy([0, 90, 180, 270].filter(d => (d == 90 ? qx < 11 : (d == 270 ? qx > 0 : (d == 0 ? qz < 16 : qz > 0)))), d => dist([(qx + round(sin(rad(d)))) * C, (qz + round(cos(rad(d)))) * C], [px, pz]))
          if dist([qx * C, qz * C], [px, pz]) > 80 && len(qopts) > 0 {
            let qh = qopts[0]
            cops = cops + [{id: nextId, x: qx * C - round(cos(rad(qh))) * 2.5 + round(sin(rad(qh))) * 3, z: qz * C + round(sin(rad(qh))) * 2.5 + round(cos(rad(qh))) * 3, h: qh, nh: qh, mx: qx + round(sin(rad(qh))), mz: qz + round(cos(rad(qh))), v: 14, road: true, plan: true}]
            nextId = nextId + 1
            copAt = gt
          }
        }
        // Their top speed: faster with more stars, but in a car never quite as fast as yours, so any car can get away.
        let copTop = inCar ? min(28 + heat * 2, max(20, T.top * 0.9)) : 28 + heat * 2
        // Close enough to chase directly; far enough to go back to the roads, from the nearest crossing.
        cops = cops.map(c => c.road && heat > 0 && dist([c.x, c.z], [px, pz]) < 26 ? merge(c, {road: false}) : c)
        cops = cops.map(c => !c.road && !(c.out ?? false) && dist([c.x, c.z], [px, pz]) > 70 ? [[round(c.x / C), round(c.z / C)]].map(n => [sortBy([0, 90, 180, 270].filter(d => (d == 90 ? n[0] < 11 : (d == 270 ? n[0] > 0 : (d == 0 ? n[1] < 16 : n[1] > 0)))), d => dist([(n[0] + round(sin(rad(d)))) * C, (n[1] + round(cos(rad(d)))) * C], [px, pz]))[0]].map(h => merge(c, {road: true, plan: true, h: h, nh: h, x: n[0] * C - round(cos(rad(h))) * 2.5, z: n[1] * C + round(sin(rad(h))) * 2.5, mx: n[0] + round(sin(rad(h))), mz: n[1] + round(cos(rad(h)))}))[0])[0] : c)
        // On the roads: along the lane, turning where the planned turn meets the new lane, as traffic does.
        cops = cops.map(c => !c.road || (c.out ?? false) ? c : [c.v + (copTop - c.v) * min(1, 2 * dt)].map(v => merge(c, {v: v, x: c.x + round(sin(rad(c.h))) * v * dt, z: c.z + round(cos(rad(c.h))) * v * dt}))[0])
        cops = cops.map(c => c.road && !(c.out ?? false) && (c.x - (c.mx * C - (round(cos(rad(c.h))) + round(cos(rad(c.nh)))) * 2.5)) * round(sin(rad(c.h))) + (c.z - (c.mz * C + (round(sin(rad(c.h))) + round(sin(rad(c.nh)))) * 2.5)) * round(cos(rad(c.h))) >= 0
          ? merge(c, {h: c.nh, x: round(sin(rad(c.nh))) != 0 ? c.x : c.mx * C - round(cos(rad(c.nh))) * 2.5, z: round(sin(rad(c.nh))) != 0 ? c.mz * C + round(sin(rad(c.nh))) * 2.5 : c.z, mx: c.mx + round(sin(rad(c.nh))), mz: c.mz + round(cos(rad(c.nh))), plan: true})
          : c)
        cops = cops.map(c => c.road && c.plan ? merge(c, {plan: false, nh: [sortBy([c.h, (c.h + 90) % 360, (c.h + 270) % 360].filter(d => (d == 90 ? c.mx < 11 : (d == 270 ? c.mx > 0 : (d == 0 ? c.mz < 16 : c.mz > 0)))), d => dist([(c.mx + round(sin(rad(d)))) * C, (c.mz + round(cos(rad(d)))) * C], [px, pz]) * (heat > 0 ? 1 : -1))].map(o => len(o) > 0 ? o[0] : (c.h + 180) % 360)[0]}) : c)
        // Chasing: straight at you (or away, with no heat), sliding along buildings.
        cops = cops.map(c => c.road || (c.out ?? false) ? merge(c, {ox: c.x, oz: c.z}) : [((deg(atan2(px - c.x, pz - c.z)) + (heat > 0 ? 0 : 180) - c.h + 540) % 360) - 180].map(t => merge(c, {h: c.h + clamp(t, -200 * dt, 200 * dt), v: c.v + ((gt < (c.stun ?? 0) ? 0 : copTop) * (1 - abs(t) / 300) - c.v) * min(1, 2 * dt)}))[0])
        cops = cops.map(c => c.road || (c.out ?? false) ? c : merge(c, {ox: c.x, oz: c.z, nx: c.x + sin(rad(c.h)) * c.v * dt, nz: c.z + cos(rad(c.h)) * c.v * dt}))
        cops = cops.map(c => c.road || (c.out ?? false) ? c : merge(c, {x: !(c.nx > -E - 3.3 && c.nx < 12 * C && c.z > -E && c.z < 16 * C + E + 3.4 && (c.z > 0 || c.nx < 11 * C + E) || any(nearShore, s => !s.flat && pow((c.nx - s.x) * 2 / s.w, 2) + pow((c.z - s.z) * 2 / s.d, 2) < 1)) || any(CELLS[floor(c.z / C) * 12 + floor(c.nx / C)].b ?? [], b => abs(c.nx - b.x) < b.w / 2 + 1.6 && abs(c.z - b.z) < b.d / 2 + 1.6) ? c.x : c.nx}))
        cops = cops.map(c => c.road || (c.out ?? false) ? c : merge(c, {z: !(c.x > -E - 3.3 && c.x < 12 * C && c.nz > -E && c.nz < 16 * C + E + 3.4 && (c.nz > 0 || c.x < 11 * C + E) || any(nearShore, s => !s.flat && pow((c.x - s.x) * 2 / s.w, 2) + pow((c.nz - s.z) * 2 / s.d, 2) < 1)) || any(CELLS[floor(c.nz / C) * 12 + floor(c.x / C)].b ?? [], b => abs(c.x - b.x) < b.w / 2 + 1.6 && abs(c.nz - b.z) < b.d / 2 + 1.6) ? c.z : c.nz}))
        // Wedged in a corner (trying to drive, going nowhere): swerve off at an angle and try again from there.
        cops = cops.map(c => !c.road && !(c.out ?? false) && c.v > 3 && c.x == c.ox && c.z == c.oz ? merge(c, {h: c.h + 100 + random() * 60, v: c.v * 0.6}) : c)
        // Left far behind, a car whose officer got out is gone too, so it doesn't keep another from taking up the chase.
        cops = cops.filter(c => heat > 0 && !(c.out ?? false) || dist([c.x, c.z], [px, pz]) < 130)
        if any(cops, c => dist([c.x, c.z], [px, pz]) < 70) {
          seenAt = gt
        }
        // Out of their sight for a while, the heat drops a star.
        if heat > 0 && gt - seenAt > 8 && gt - crimeAt > 8 {
          heat = heat - 1
          seenAt = gt
        }
        let ram = first(cops.filter(c => dist([c.x, c.z], [px, pz]) < (inCar ? T.r + 0.9 : 2.6)))
        if ram != null && heat > 0 && py < 1 && sunk == null && inCar {
          // A ram dents the car and slows it a little; the police car falls back and needs a moment before it can ram
          // again, so a car that keeps going gets away.
          if gt - hitAt > 0.5 && gt >= (ram.stun ?? 0) {
            dmg = dmg + 4 * T.armor
            hitAt = gt
            haptic()
            pv = pv * 0.85
            pvx = pvx * 0.85
            pvz = pvz * 0.85
          }
          let rd = max(0.1, dist([ram.x, ram.z], [px, pz]))
          cops = cops.map(c => c.id == ram.id ? merge(c, {v: -6, stun: gt >= (c.stun ?? 0) ? gt + 1.5 : c.stun, x: c.x + (c.x - px) / rd * (T.r + 1 - rd), z: c.z + (c.z - pz) / rd * (T.r + 1 - rd)}) : c)
        }
        // Caught on foot, by a police car or, at low heat, an officer: busted. They keep a quarter of the cash, and you
        // start again by the station.
        if !inCar && (ram != null && heat > 0 && sunk == null || heat <= 2 && any(officers, o => o.down == 0 && dist([o.x, o.z], [px, pz]) < 1.8)) {
          msg = "busted · -$" + fmtNum(floor(cash / 4))
          msgAt = gt
          cash = cash - floor(cash / 4)
          heat = 0
          cops = []
          officers = []
          ammo = [0, 0, 0]
          gun = -1
          px = 5 * C + 6
          pz = 9 * C + 16
          mis = null
        }
        // Too much damage and the car is done for: you climb out of the wreck.
        if inCar && dmg >= 100 {
          parked = drop(parked, max(0, len(parked) - 5)) + [{id: nextId, t: ptype, x: px, z: pz, h: ph, c: pcol, dmg: dmg, wreck: true}]
          nextId = nextId + 1
          inCar = false
          pv = 0
          pvx = 0
          pvz = 0
          px = px + cos(rad(ph)) * (TYPES[ptype].wid / 2 + 1.4)
          pz = pz - sin(rad(ph)) * (TYPES[ptype].wid / 2 + 1.4)
          msg = "wrecked"
          msgAt = gt
        }

        // Police on foot: a police car that reaches you while you're on foot stops and lets an officer out, who runs at
        // you and shoots about once a second when near; caught by one at low heat, you're busted. No heat, no officers.
        if !inCar && sunk == null && heat > 0 {
          let arrived = first(cops.filter(c => !(c.out ?? false) && dist([c.x, c.z], [px, pz]) < 18))
          if arrived != null {
            cops = cops.map(c => c.id == arrived.id ? merge(c, {out: true, v: 0}) : c)
            officers = officers + [{id: nextId, x: arrived.x + sin(rad(arrived.h + 90)) * 2, z: arrived.z + cos(rad(arrived.h + 90)) * 2, h: arrived.h, hp: 40, down: 0, shotAt: gt + random()}]
            nextId = nextId + 1
          }
        }
        if heat == 0 {
          officers = []
        }
        officers = officers.filter(o => (o.down == 0 || gt - o.down < 6) && dist([o.x, o.z], [px, pz]) < 120)
        officers = officers.map(o => o.down > 0 ? o : merge(o, {h: deg(atan2(px - o.x, pz - o.z))}))
        officers = officers.map(o => o.down > 0 ? o : merge(o, {nx: o.x + (dist([o.x, o.z], [px, pz]) > 8 ? sin(rad(o.h)) * 5.5 * dt : 0), nz: o.z + (dist([o.x, o.z], [px, pz]) > 8 ? cos(rad(o.h)) * 5.5 * dt : 0)}))
        // Stepped out into a wall's reach, an officer may walk out of it.
        officers = officers.map(o => o.down > 0 ? o : merge(o, {x: !(any(CELLS[floor(o.z / C) * 12 + floor(o.x / C)].b ?? [], b => abs(o.x - b.x) < b.w / 2 + 0.5 && abs(o.z - b.z) < b.d / 2 + 0.5)) && (!(o.nx > -E - 3.3 && o.nx < 12 * C && o.z > -E && o.z < 16 * C + E + 3.4 && (o.z > 0 || o.nx < 11 * C + E) || any(nearShore, s => !s.flat && pow((o.nx - s.x) * 2 / s.w, 2) + pow((o.z - s.z) * 2 / s.d, 2) < 1)) || any(CELLS[floor(o.z / C) * 12 + floor(o.nx / C)].b ?? [], b => abs(o.nx - b.x) < b.w / 2 + 0.5 && abs(o.z - b.z) < b.d / 2 + 0.5)) ? o.x : o.nx}))
        officers = officers.map(o => o.down > 0 ? o : merge(o, {z: !(any(CELLS[floor(o.z / C) * 12 + floor(o.x / C)].b ?? [], b => abs(o.x - b.x) < b.w / 2 + 0.5 && abs(o.z - b.z) < b.d / 2 + 0.5)) && (!(o.x > -E - 3.3 && o.x < 12 * C && o.nz > -E && o.nz < 16 * C + E + 3.4 && (o.nz > 0 || o.x < 11 * C + E) || any(nearShore, s => !s.flat && pow((o.x - s.x) * 2 / s.w, 2) + pow((o.nz - s.z) * 2 / s.d, 2) < 1)) || any(CELLS[floor(o.nz / C) * 12 + floor(o.x / C)].b ?? [], b => abs(o.x - b.x) < b.w / 2 + 0.5 && abs(o.nz - b.z) < b.d / 2 + 0.5)) ? o.z : o.nz}))
        let shooters = officers.filter(o => o.down == 0 && gt - o.shotAt > 1.1 && dist([o.x, o.z], [px, pz]) < 16)
        if len(shooters) > 0 {
          officers = officers.map(o => o.down == 0 && gt - o.shotAt > 1.1 && dist([o.x, o.z], [px, pz]) < 16 ? merge(o, {shotAt: gt + random() * 0.4}) : o)
          let hits = count(shooters, o => random() < 0.5)
          shots = drop(shots, max(0, len(shots) - 16)) + shooters.map(o => {x0: o.x, z0: o.z, x1: px + random() * 2 - 1, z1: pz + random() * 2 - 1, t: gt, c: 1})
          if inCar {
            dmg = dmg + hits * 4 * T.armor
          } else {
            hurt = hurt + hits * (6 + heat * 1.5)
          }
        }

        // Firing: the nearest target in front of you (police on foot first, then their cars, people, traffic), most shots
        // hitting; with nothing there, straight ahead. People shot stay down, cars shot enough blow up; both are crimes.
        // With no gun in hand, the same button punches.
        if firing && !inCar && (gun < 0 || ammo[gun] > 0) && gt - shotAt > 1 / (gun < 0 ? FIST : WEAPONS[gun]).rate {
          let w = gun < 0 ? FIST : WEAPONS[gun]
          let aims = officers.filter(o => o.down == 0).map(o => {k: "o", id: o.id, x: o.x, z: o.z, pri: 0}) + peds.filter(p => p.down == 0).map(p => {k: "p", id: p.id, x: p.x, z: p.z, pri: 30}) + (gun < 0 ? [] : cops.map(c => {k: "k", id: c.id, x: c.x, z: c.z, pri: 10}) + cars.map(c => {k: "c", id: c.id, x: c.x, z: c.z, pri: 40}))
          let tgt = first(sortBy(aims.filter(a => dist([a.x, a.z], [px, pz]) < w.range && abs(((deg(atan2(a.x - px, a.z - pz)) - ph + 540) % 360) - 180) < w.cone), a => a.pri + dist([a.x, a.z], [px, pz])))
          let hit = tgt != null && random() < 0.85
          let aimH = tgt != null ? deg(atan2(tgt.x - px, tgt.z - pz)) : ph
          ph = aimH
          shotAt = gt
          if gun >= 0 {
            ammo = set(ammo, gun, ammo[gun] - 1)
          }
          shots = gun < 0 ? shots : drop(shots, max(0, len(shots) - 16)) + [{x0: px + sin(rad(aimH)) * 0.9, z0: pz + cos(rad(aimH)) * 0.9, x1: tgt != null ? tgt.x + (hit ? 0 : random() * 3 - 1.5) : px + sin(rad(aimH)) * w.range, z1: tgt != null ? tgt.z + (hit ? 0 : random() * 3 - 1.5) : pz + cos(rad(aimH)) * w.range, t: gt, c: 0}]
          if hit && tgt.k == "o" {
            officers = officers.map(o => o.id == tgt.id ? merge(o, {hp: o.hp - w.dmg, down: o.hp - w.dmg <= 0 ? gt : 0}) : o)
            heat = min(5, max(2, heat + (gt - crimeAt > 2 ? 1 : 0)))
            crimeAt = gt
          }
          if hit && tgt.k == "p" {
            // Punched, they fall and get up again, hurrying off; shot, they stay down.
            peds = peds.map(p => p.id == tgt.id ? merge(p, gun < 0 ? {down: gt, v: 4.5, h: (p.h + 180) % 360} : {down: gt, gone: true}) : p)
            heat = min(5, heat + (gt - crimeAt > 1 ? 1 : 0))
            crimeAt = gt
          }
          if hit && tgt.k == "k" {
            let wreck = first(cops.filter(c => c.id == tgt.id && (c.hp ?? 80) - w.dmg <= 0))
            cops = cops.map(c => c.id == tgt.id ? merge(c, {hp: (c.hp ?? 80) - w.dmg}) : c).filter(c => (c.hp ?? 1) > 0)
            if wreck != null {
              blasts = blasts + [{x: wreck.x, z: wreck.z}]
              parked = drop(parked, max(0, len(parked) - 5)) + [{id: nextId, t: 1, x: wreck.x, z: wreck.z, h: wreck.h, c: 0, dmg: 100, wreck: true}]
              nextId = nextId + 1
            }
            heat = min(5, max(2, heat + (gt - crimeAt > 2 ? 1 : 0)))
            crimeAt = gt
          }
          if hit && tgt.k == "c" {
            let wreck = first(cars.filter(c => c.id == tgt.id && (c.hp ?? 60) - w.dmg <= 0))
            cars = cars.map(c => c.id == tgt.id ? merge(c, {hp: (c.hp ?? 60) - w.dmg, v: 0}) : c).filter(c => (c.hp ?? 1) > 0)
            if wreck != null {
              blasts = blasts + [{x: wreck.x, z: wreck.z}]
              parked = drop(parked, max(0, len(parked) - 5)) + [{id: nextId, t: wreck.t ?? 1, x: wreck.x, z: wreck.z, h: wreck.h, c: wreck.c, dmg: 100, wreck: true}]
              nextId = nextId + 1
              heat = min(5, heat + (gt - crimeAt > 1 ? 1 : 0))
              crimeAt = gt
            }
          }
        }
        if gun >= 0 && ammo[gun] <= 0 {
          // Out of ammo: the next gun that has some, or none.
          gun = first(range(3).map(i => (gun + 1 + i) % 3).filter(i => ammo[i] > 0)) ?? -1
        }

        // Explosions: fire and smoke, people close by knocked flat, and you hurt (or your car dented) by how near you are.
        if len(blasts) > 0 {
          let nearest = min(blasts.map(b => dist([b.x, b.z], [px, pz])))
          if nearest < 8 {
            if inCar {
              dmg = dmg + 40 * (1 - nearest / 8) * T.armor
            } else {
              hurt = hurt + 55 * (1 - nearest / 8)
            }
          }
          peds = peds.map(p => p.down == 0 && any(blasts, b => dist([b.x, b.z], [p.x, p.z]) < 6) ? merge(p, {down: gt, gone: true}) : p)
          officers = officers.map(o => o.down == 0 && any(blasts, b => dist([b.x, b.z], [o.x, o.z]) < 6) ? merge(o, {down: gt, hp: 0}) : o)
          fx = drop(fx, max(0, len(fx) - 40)) + flatten(blasts.map(b => range(14).map(i => {k: i % 3 == 0 ? "smoke" : "fire", x: b.x, y: 1, z: b.z, vx: random() * 10 - 5, vy: 3 + random() * 6, vz: random() * 10 - 5, life: 0.6 + random() * 0.8})))
          booms = booms + blasts.map(b => merge(b, {t: gt}))
          blasts = []
          haptic()
        }

        // Pickups: walk or drive through one to take it; it comes back after a minute and a half.
        let got = first(nearPicks.filter(p => dist([p.x, p.z], [px, pz]) < (inCar ? 3.2 : 2)))
        if got != null {
          taken = drop(taken, max(0, len(taken) - 40)) + [{id: got.id, t: gt}]
          haptic()
          msgAt = gt
          if got.k == 0 {
            hp = min(100, hp + 50)
            msg = "+ health"
          }
          if got.k == 1 {
            armor = min(100, armor + 50)
            msg = "+ armor"
          }
          if got.k >= 2 && got.k <= 4 {
            ammo = set(ammo, got.k - 2, ammo[got.k - 2] + WEAPONS[got.k - 2].give)
            gun = gun < 0 ? got.k - 2 : gun
            msg = WEAPONS[got.k - 2].name + " · " + fmtNum(ammo[got.k - 2])
          }
          if got.k == 5 {
            cash = cash + 100
            msg = "+$100"
          }
        }

        // Damage taken this frame: armor first, then health; at none, wasted: you wake by the hospital without your guns.
        if hurt > 0 {
          let fromArmor = min(armor, hurt)
          armor = armor - fromArmor
          hp = hp - (hurt - fromArmor)
          hurt = 0
          haptic()
        }
        if hp <= 0 {
          msg = (sunk != null ? "wasted · drowned · -$" : "wasted · -$") + fmtNum(min(cash, 100))
          sunk = null
          msgAt = gt
          cash = max(0, cash - 100)
          hp = 100
          armor = 0
          ammo = [0, 0, 0]
          gun = -1
          heat = 0
          cops = []
          officers = []
          inCar = false
          pv = 0
          pvx = 0
          pvz = 0
          px = HOSPITAL[0]
          pz = HOSPITAL[1]
          camX = px
          camZ = pz
          mis = null
        }

        // Missions. Each kind runs here; a mission ends passed (the pay, a message) or failed (a message why).
        if mis == null && (len(rivals) > 0 || prey != null) {
          rivals = []
          prey = null
        }
        // A race: the rivals drive the course at their own pace, slower into corners, holding back when far ahead and
        // pushing when far behind, each in its own line, eased round the corners; you go through the checkpoints.
        if mis.k == "race" && gt >= mis.go {
          let rp = RACE
          let cum = RCUM[mis.r]
          let total = last(cum)
          let ps = raceS
          rivals = rivals.map(r => [clamp(count(cum, c => c <= r.s) - 1, 0, len(rp) - 2)].map(i => merge(r, {v: r.v + ((r.s >= total ? 0 : (cum[i + 1] - r.s < 14 && i + 2 < len(rp) ? 17 : r.top * clamp(1 - (r.s - ps) / 400, 0.82, 1.15))) * (gt < r.slow ? 0.5 : 1) - r.v) * min(1, 2 * dt)}))[0])
          rivals = rivals.map(r => [min(r.s + r.v * dt, total)].map(s => [clamp(count(cum, c => c <= s) - 1, 0, len(rp) - 2)].map(i => [[rp[i], rp[i + 1], min(1, (s - cum[i]) / max(1, cum[i + 1] - cum[i]))]].map(g => [[g[0][0] + (g[1][0] - g[0][0]) * g[2] - sign(g[1][1] - g[0][1]) * r.lane, g[0][1] + (g[1][1] - g[0][1]) * g[2] + sign(g[1][0] - g[0][0]) * r.lane]].map(p => merge(r, {s: s, x: r.x + (p[0] - r.x) * min(1, 5 * dt), z: r.z + (p[1] - r.z) * min(1, 5 * dt), h: dist([p[0] - r.x, p[1] - r.z]) > 0.2 ? deg(atan2(p[0] - r.x, p[1] - r.z)) : r.h}))[0])[0])[0])[0])
          // Rubbing a rival slows it a moment and knocks you about.
          let rub = first(rivals.filter(r => dist([r.x, r.z], [px, pz]) < T.r + 1.6))
          if rub != null && inCar {
            rivals = rivals.map(r => r.id == rub.id ? merge(r, {slow: gt + 0.8}) : r)
            if gt - hitAt > 0.4 {
              haptic()
              hitAt = gt
              dmg = dmg + 2 * T.armor
              pvx = pvx * 0.85 + (px - rub.x) * 2
              pvz = pvz * 0.85 + (pz - rub.z) * 2
            }
          }
          if dist(rp[mis.i], [px, pz]) < 11 {
            haptic()
            if mis.i == len(rp) - 1 {
              let pl = 1 + count(rivals, r => r.s >= total)
              let secs = gt - mis.go
              let prize = [500, 250, 120, 0][min(3, pl - 1)]
              let rname = RACES[mis.r].name
              let record = secs < get(best, rname, 9999)
              cash = cash + prize
              best = record ? set(best, rname, secs) : best
              msg = (pl == 1 ? "1st place" : (pl == 2 ? "2nd place" : (pl == 3 ? "3rd place" : "failed · 4th place"))) + " · " + fmtTime(secs, "m:ss", "UTC") + (record ? " · new best" : "") + (prize > 0 ? " · +$" + fmtNum(prize) : "")
              msgAt = gt
              done = pl <= 3 && indexOf(done, mis.g) < 0 ? done + [mis.g] : done
              mis = null
            } else {
              mis = merge(mis, {i: mis.i + 1})
            }
          }
        }
        // A takedown: the car drives the roads at speed, at each crossing taking the turn that leads away from you,
        // easing off when it's well ahead. Every ram dents it by how hard you hit and slows it a moment; wrecked, it blows up.
        if mis.k == "takedown" && prey != null {
          prey = [prey].map(c => [c.v + ((gt < c.slow ? 9 : (dist([c.x, c.z], [px, pz]) > 140 ? 19 : 27)) - c.v) * min(1, 1.5 * dt)].map(v => merge(c, {v: v, x: c.x + round(sin(rad(c.h))) * v * dt, z: c.z + round(cos(rad(c.h))) * v * dt, vh: c.vh + clamp(((c.h - c.vh + 540) % 360) - 180, -360 * dt, 360 * dt)}))[0])[0]
          prey = [prey].map(c => (c.x - (c.mx * C - (round(cos(rad(c.h))) + round(cos(rad(c.nh)))) * 2.5)) * round(sin(rad(c.h))) + (c.z - (c.mz * C + (round(sin(rad(c.h))) + round(sin(rad(c.nh)))) * 2.5)) * round(cos(rad(c.h))) >= 0
            ? merge(c, {h: c.nh, x: round(sin(rad(c.nh))) != 0 ? c.x : c.mx * C - round(cos(rad(c.nh))) * 2.5, z: round(sin(rad(c.nh))) != 0 ? c.mz * C + round(sin(rad(c.nh))) * 2.5 : c.z, mx: c.mx + round(sin(rad(c.nh))), mz: c.mz + round(cos(rad(c.nh))), plan: true})
            : c)[0]
          prey = [prey].map(c => c.plan ? merge(c, {plan: false, nh: [sortBy([c.h, (c.h + 90) % 360, (c.h + 270) % 360].filter(d => (d == 90 ? c.mx < 11 : (d == 270 ? c.mx > 1 : (d == 0 ? c.mz < 15 : c.mz > 1)))), d => random() * 50 - dist([(c.mx + round(sin(rad(d)))) * C, (c.mz + round(cos(rad(d)))) * C], [px, pz]))].map(o => len(o) > 0 ? o[0] : (c.h + 180) % 360)[0]}) : c)[0]
          let pd = dist([prey.x, prey.z], [px, pz])
          if inCar && py < 1 && pd < T.r + 2.3 && gt - prey.hitAt > 0.6 {
            let hard = clamp(dist([pvx - sin(rad(prey.h)) * prey.v, pvz - cos(rad(prey.h)) * prey.v]) * 1.6, 8, 40)
            let hpLeft = prey.hp - hard
            haptic()
            dmg = dmg + 3 * T.armor
            pv = pv * 0.6
            pvx = pvx * 0.6
            pvz = pvz * 0.6
            fx = drop(fx, max(0, len(fx) - 30)) + range(8).map(i => {k: "spark", x: (px + prey.x) / 2, y: 0.8, z: (pz + prey.z) / 2, vx: random() * 16 - 8, vy: random() * 8, vz: random() * 16 - 8, life: 0.4 + random() * 0.3})
            if hpLeft <= 0 {
              blasts = blasts + [{x: prey.x, z: prey.z}]
              parked = drop(parked, max(0, len(parked) - 5)) + [{id: nextId, t: 2, x: prey.x, z: prey.z, h: prey.vh, c: 1, dmg: 100, wreck: true}]
              nextId = nextId + 1
              cash = cash + 350
              msg = "target down · +$350"
              msgAt = gt
              prey = null
              done = indexOf(done, mis.g) < 0 ? done + [mis.g] : done
              mis = null
            } else {
              prey = merge(prey, {hp: hpLeft, slow: gt + 1.2, hitAt: gt})
              msg = "hit · its car " + round(hpLeft) + "%"
              msgAt = gt - 1.4
            }
          }
          if prey != null && pd > 320 {
            msg = "failed · it got away"
            msgAt = gt
            mis = null
          }
        }
        // A getaway: into the garage with no stars on you.
        if mis.k == "getaway" && inCar && dist([mis.gx, mis.gz], [px, pz]) < 9 {
          if heat == 0 {
            cash = cash + 500
            msg = "clean getaway · +$500"
            msgAt = gt
            done = indexOf(done, mis.g) < 0 ? done + [mis.g] : done
            mis = null
          } else {
            if gt - msgAt > 3 {
              msg = "they're still on you · lose them first"
              msgAt = gt
            }
          }
        }
        // A stunt tour: a jump counts when it's off the marked ramp, long enough, and doesn't end in the canal.
        if mis.k == "stunt" && landed != null {
          let r = STUNT[mis.i]
          if landed.rx == r.x && landed.rz == r.z && !landed.wet && landed.t > 0.4 {
            cash = cash + 150
            haptic()
            if mis.i == 2 {
              cash = cash + 100
              msg = "stunt tour done · +$550"
              done = indexOf(done, mis.g) < 0 ? done + [mis.g] : done
              mis = null
            } else {
              msg = "jump ${mis.i + 1} of 3 · +$150 · on to the next ramp"
              mis = merge(mis, {i: mis.i + 1})
            }
            msgAt = gt
          }
        }
        if landed != null {
          landed = null
        }
        // Fragile cargo: delivered, it pays for the bottles still whole.
        if mis.k == "cargo" {
          if cargo <= 0 {
            msg = "failed · the champagne's all broken"
            msgAt = gt
            mis = null
          } else {
            if inCar && dist([mis.gx, mis.gz], [px, pz]) < 8 {
              let pay = round(mis.pay * cargo / 100)
              cash = cash + pay
              msg = "delivered · ${cargo}% whole · +$" + fmtNum(pay)
              msgAt = gt
              done = indexOf(done, mis.g) < 0 ? done + [mis.g] : done
              mis = null
            }
          }
        }
        // A courier run: each parcel delivered sends you to the next door, with more time on the clock.
        if mis.k == "courier" && dist([mis.gx, mis.gz], [px, pz]) < 7 {
          cash = cash + 80
          haptic()
          if mis.i == 2 {
            let bonus = round(left * 2)
            cash = cash + bonus
            msg = "all three delivered · +$" + fmtNum(80 + bonus)
            done = indexOf(done, mis.g) < 0 ? done + [mis.g] : done
            mis = null
          } else {
            let opts = DROPS.filter(p => dist(p, [px, pz]) > 120 && dist(p, [px, pz]) < 230)
            let np = opts[random(len(opts))]
            msg = "parcel ${mis.i + 1} delivered · +$80 · on to the next"
            mis = merge(mis, {i: mis.i + 1, gx: np[0], gz: np[1], until: mis.until + dist(np, [px, pz]) * 1.3 / 15 + 10})
          }
          msgAt = gt
        }
        // Out of the car a mission needs, or out of time: failed.
        if mis != null && (GIVERS[mis.g].car || mis.k == "getaway") && !inCar && sunk == null {
          msg = "failed · you lost the car"
          msgAt = gt
          mis = null
        }
        if mis != null && mis.until > 0 && gt > mis.until {
          msg = "failed · out of time"
          msgAt = gt
          mis = null
        }
        // The paint shop: a new color and the police lose you, for $40.
        if inCar && heat > 0 && mis.k != "getaway" && dist(SPRAY, [px, pz]) < 6 {
          heat = 0
          cash = max(0, cash - 40)
          pcol = (pcol + 1 + random(6)) % len(PAINT)
          msg = "fresh paint · they've lost you"
          msgAt = gt
        }
      }
    }
  }

  Box {
    fill: true
    background: SKY
    Canvas {
      fill: true
      // The ground: the sea, its waves drifting, then the cells' road, park and beach tiles in the sun.
      // The sea all round, in a scene of its own: drawn first, nothing on land can sort under it, even with the
      // camera out over the water.
      scene(cam, light: LIGHT, ambient: 0.7, fog: SKY) {
        model(TILE, at: [12 * C + 300, -0.5, camZ], scale: 600, color: #2a8ca8, ambient: 0.8)
        model(WAVES, at: [12 * C + 100, -0.4, floor(camZ / 20) * 20 + gt * 1.5 % 20], scale: 200, image: seaTex, color: white, ambient: 0.8)
        if camX < 120 {
          model(TILE, at: [-300, -0.5, camZ], scale: 600, color: #2a8ca8, ambient: 0.8)
          model(WAVES, at: [-100, -0.4, floor(camZ / 20) * 20 + gt * 1.5 % 20], scale: 200, image: seaTex, color: white, ambient: 0.8)
        }
        if camZ > 380 {
          model(TILE, at: [camX, -0.5, 16 * C + 300], scale: 600, color: #2a8ca8, ambient: 0.8)
          model(WAVES, at: [floor(camX / 20) * 20 + gt * 1.5 % 20, -0.4, 16 * C + 100], scale: 200, image: seaTex, color: white, ambient: 0.8)
        }
        if camZ < 200 {
          model(TILE, at: [camX, -0.5, -300], scale: 600, color: #2a8ca8, ambient: 0.8)
          model(WAVES, at: [floor(camX / 20) * 20 + gt * 1.5 % 20, -0.4, -100], scale: 200, image: seaTex, color: white, ambient: 0.8)
        }
      }
      scene(cam, light: LIGHT, ambient: 0.7, fog: SKY) {
        // The shore: surf first, the land over it.
        for p in nearShore {
          if p.flat {
            model(TILE, at: [p.x, -0.12, p.z], scale: [p.w, 1, p.d], color: #d6ba8c)
          } else {
            model(TILE, at: [p.x, -0.35, p.z], scale: [p.w * 1.6, 1, p.d * 1.6], image: glowTex, color: alpha(white, 0.3 + 0.1 * sin(gt * 1.3 + p.z * 0.1 + p.x * 0.1)), ambient: 1)
            model(CYL, at: [p.x, -0.3, p.z], scale: [p.w, 0.36, p.d], color: p.rock ? #8a8498 : #d6ba8c, smooth: false)
          }
        }
        for s in ISLES {
          if s.r > 0 && abs(s.x - camX) < 100 && abs(s.z - camZ) < 130 {
            model(TILE, at: [s.x, -0.32, s.z], scale: s.r * 2.8, image: glowTex, color: alpha(white, 0.25 + 0.08 * sin(gt * 1.3 + s.x)), ambient: 1)
            model(CYL, at: [s.x, -0.3, s.z], scale: [s.r * 2, 0.4, s.r * 2], color: #d6ba8c)
          }
        }
        if camZ < 120 && camX < 140 {
          model(TILE, at: [18, -0.32, -20 - E], turn: [0, -42, 0], scale: [9, 1, 44], image: glowTex, color: alpha(white, 0.2), ambient: 1)
        }
        for c in vis {
          model(TILE, at: [c.cx * C + 16, 0, c.cz * C + 16], scale: C, image: c.k == "canal" && c.cx == 11 ? canalBeachTex : (GROUND[c.k] ?? roadTex), color: white)
        }
        // The outer half of the roads round the edge, past the grid: west, north and south; asphalt at their corners,
        // and sand by the beach south of the coast road.
        for c in vis.filter(c => c.cx == 0 || c.cz == 0 || c.cz == 15) {
          if c.cx == 0 {
            model(TILE, at: [-E / 2, 0, c.cz * C + 16], scale: [E, 1, C], image: edgeWTex, color: white)
          }
          if c.cz == 0 && c.cx < 11 {
            model(TILE, at: [c.cx * C + 16, 0, -E / 2], scale: [C, 1, E], image: edgeNTex, color: white)
          }
          if c.cz == 15 && c.cx < 11 {
            model(TILE, at: [c.cx * C + 16, 0, 16 * C + E / 2], scale: [C, 1, E], image: edgeSTex, color: white)
          }
          if (c.cx == 0 || c.cx == 11) && (c.cz == 0 || c.cz == 15) {
            model(TILE, at: [c.cx == 0 ? -E / 2 : 11 * C + E / 2, 0, c.cz == 0 ? -E / 2 : 16 * C + E / 2], scale: E, color: #525256)
          }
          if c.cx == 11 && c.cz == 15 {
            model(TILE, at: [11 * C + E + (C - E) / 2, 0, 16 * C + E / 2], scale: [C - E, 1, E], color: #e5cd99)
          }
        }
      }
      // Marks on the ground: the shadows of buildings, trees and cars, pools and pitches, skid marks.
      scene(cam, ambient: 1, fog: SKY) {
        for cz in range(cz0, min(15, cz1 + 1) + 1) {
          model(SHADES[cz], at: [0, 0.03, 0], color: alpha(#1a2430, 0.36), twoSided: true)
        }
        for c in vis {
          if c.k == "park" {
            for i in range(3) {
              model(TILE, at: [c.cx * C + 10 + hash(c.cx, c.cz, 70 + i) * 12 + 1.6, 0.04, c.cz * C + 10 + hash(c.cx, c.cz, 80 + i) * 12 - 2], scale: 6, image: glowTex, color: alpha(#1a2430, 0.5))
            }
          }
          if c.k == "suburb" {
            model(TILE, at: [c.cx * C + 17.2, 0.04, c.cz * C + 8], scale: 5, image: glowTex, color: alpha(#1a2430, 0.5))
          }
          if c.k == "hotel" {
            for j in range(2) {
              model(TILE, at: [c.cx * C + 28.5, 0.04, c.cz * C + 6.5 + j * 14], scale: 6, image: glowTex, color: alpha(#1a2430, 0.4))
            }
          }
          // Round tanks cast round shadows.
          for b in c.b {
            if b.k == "tank" {
              model(CYL, at: [b.x + b.h * 0.2, 0.03, b.z - b.h * 0.26], scale: [b.w * 1.25, 0.01, b.d * 1.25], color: alpha(#1a2430, 0.36))
            }
          }
          if c.k == "beach" && c.cz > 0 {
            for i in range(3) {
              model(TILE, at: [c.cx * C + 18 + hash(c.cz, i) * 6, 0.04, c.cz * C + 2.5 + i * 11], scale: 6.5, image: glowTex, color: alpha(#1a2430, 0.4))
            }
          }
          // Pools lit from inside, light under the gas canopy, the stadium's pitch, the court, the fountain.
          if c.k == "hotel" {
            model(TILE, at: [c.cx * C + 23, 0.05, c.cz * C + 16], scale: [3.4, 1, 12], image: poolTex, color: #c8e0ff)
          }
          if c.k == "suburb" && hash(c.cx, c.cz, 7) < 0.6 {
            model(TILE, at: [c.cx * C + 16, 0.05, c.cz * C + 16], scale: [3, 1, 4.4], image: poolTex, color: #c8e0ff)
          }
          if c.k == "gas" {
            model(TILE, at: [c.cx * C + 18.5, 0.05, c.cz * C + 15], scale: [13, 1, 8], color: alpha(#1a2430, 0.3))
          }
          if c.k == "stadium" {
            model(TILE, at: [c.cx * C + 16, 0.04, c.cz * C + 16], scale: [7, 1, 10], color: #2f8f5a)
            model(TILE, at: [c.cx * C + 16, 0.05, c.cz * C + 16], scale: [0.15, 1, 10], color: alpha(white, 0.7))
          }
          if c.k == "court" {
            model(TILE, at: [c.cx * C + 16, 0.05, c.cz * C + 16], scale: [9, 1, 17], image: courtTex, color: #a8a2c0)
          }
          if c.k == "plaza" {
            for j in range(4) {
              model(TILE, at: [c.cx * C + 11 + j % 2 * 13, 0.04, c.cz * C + 7.5 + floor(j / 2) * 13], scale: 5, image: glowTex, color: alpha(#1a2430, 0.45))
            }
          }
          if c.k == "canal" {
            model(TILE, at: [c.cx * C + 6.5, 0.04, c.cz * C + 16], scale: [2.6, 1, 18], color: alpha(black, 0.35))
            if c.cx < 11 {
              model(TILE, at: [c.cx * C + 25.5, 0.04, c.cz * C + 16], scale: [2.6, 1, 18], color: alpha(black, 0.35))
            }
          }
        }
        // Rings spreading where a car went under.
        if sunk != null {
          for i in range(3) {
            if gt - sunk.at > i * 0.35 {
              model(TILE, at: [sunk.x, 0.06, sunk.z], scale: 3 + (gt - sunk.at - i * 0.35) * 9, image: glowTex, color: alpha(white, max(0, 0.5 - (gt - sunk.at - i * 0.35) * 0.4)), ambient: 1)
            }
          }
        }
        for b in boats {
          model(TILE, at: [b.x - sin(rad(b.h)) * 9, 0.02, b.z - cos(rad(b.h)) * 9], turn: [0, b.h + 180, 0], scale: [5, 1, 14], image: beamTex, color: alpha(white, b.sail ? 0.15 : 0.35))
        }
        // Yellow and black chevrons on the run-up to each ramp.
        for r in nearRamps {
          for j in range(3) {
            model(TILE, at: [r.x - sin(rad(r.h)) * (4.5 + j * 1.6), 0.06, r.z - cos(rad(r.h)) * (4.5 + j * 1.6)], turn: [0, r.h, 0], scale: [3.6, 1, 0.7], color: alpha(#f2c230, 0.85))
          }
        }
        for s in skids {
          model(TILE, at: [s.x, 0.03, s.z], turn: [0, s.h, 0], scale: [(s.w ?? 2) * 1.15, 1, 0.9], image: skidTex, color: alpha(white, 0.8 - (gt - s.t) / 10))
        }
        for c in seenCars + seenCops {
          model(TILE, at: [c.x + 0.6, 0.04, c.z - 0.75], turn: [0, c.h, 0], scale: [TYPES[c.t ?? 1].wid * 1.5, 1, TYPES[c.t ?? 1].len * 1.25], image: glowTex, color: alpha(#1a2430, 0.7))
        }
        for p in seenParked {
          model(TILE, at: [p.x + 0.6, 0.04, p.z - 0.75], turn: [0, p.h, 0], scale: [TYPES[p.t ?? 1].wid * 1.5, 1, TYPES[p.t ?? 1].len * 1.25], image: glowTex, color: alpha(#1a2430, 0.7))
        }
        if inCar {
          model(TILE, at: [px + 0.6 + py * 0.35, 0.04, pz - 0.75 - py * 0.45], turn: [0, ph, 0], scale: [TYPES[ptype].wid * 1.5, 1, TYPES[ptype].len * 1.25], image: glowTex, color: alpha(#1a2430, 0.7 / (1 + py * 0.3)))
          model(TILE, at: [px - sin(rad(ph)) * (TYPES[ptype].len / 2 + 0.5), 0.06, pz - cos(rad(ph)) * (TYPES[ptype].len / 2 + 0.5)], turn: [0, ph, 0], scale: [push == 0 && pv > 3 ? 5 : 3.5, 1, push == 0 && pv > 3 ? 4 : 2.5], image: glowTex, color: alpha(#ff2a3a, push == 0 && pv > 3 ? 0.6 : 0.3))
        } else if sunk == null {
          model(TILE, at: [px + 0.5, 0.04, pz - 0.6], scale: 2.4, image: glowTex, color: alpha(#1a2430, 0.55))
        }
        for p in nearPicks {
          model(TILE, at: [p.x, 0.07, p.z], scale: 5 + sin(gt * 4 + p.id), image: glowTex, color: alpha(PICK_COLOR[p.k], 0.4))
        }
        for b in booms {
          model(TILE, at: [b.x, 0.09, b.z], scale: 26 * (1 - (gt - b.t) / 1.2), image: glowTex, color: alpha(#ff9a3a, 0.8 * (1 - (gt - b.t) / 1.2)))
        }
        if gt - shotAt < (gun < 0 ? 0.15 : 0.06) {
          model(TILE, at: [px + sin(rad(ph)) * 1.2, 0.09, pz + cos(rad(ph)) * 1.2], scale: gun < 0 ? 3 : 5, image: glowTex, color: alpha(gun < 0 ? #ffffff : #ffd36b, 0.7))
        }
        // The way to the goal, painted on the road; the goal and each mission spot glow.
        for a in arrows {
          model(CHEV, at: [a.x, 0.08, a.z], turn: [0, a.h, 0], scale: 2.6, color: alpha(mcol, 0.85), twoSided: true)
        }
        if goal != null {
          model(TILE, at: [goal[0], 0.08, goal[1]], scale: 12 + 2 * sin(gt * 5), image: glowTex, color: alpha(mcol, 0.6))
        }
        for g in nearGivers {
          model(TILE, at: [g.x, 0.08, g.z], scale: 10 + 1.5 * sin(gt * 4), image: glowTex, color: alpha(g.col, 0.55))
        }
        for r in rivals {
          model(TILE, at: [r.x + 0.6, 0.04, r.z - 0.75], turn: [0, r.h, 0], scale: [TYPES[r.t].wid * 1.5, 1, TYPES[r.t].len * 1.25], image: glowTex, color: alpha(#1a2430, 0.7))
        }
        if prey != null {
          model(TILE, at: [prey.x + 0.6, 0.04, prey.z - 0.75], turn: [0, prey.vh, 0], scale: [3, 1, 5.5], image: glowTex, color: alpha(#1a2430, 0.7))
        }
      }
      // What stands on it.
      scene(cam, light: LIGHT, ambient: 0.58, fog: SKY) {
        for c in vis {
          for b in c.b {
            if b.k == "bldg" {
              model(BOX, at: [b.x, b.h / 2, b.z], scale: [b.w, b.h, b.d], image: facadeTex, color: TINTS[floor(b.t * 4)])
              // A tower's narrower top, then the roof, gravel or a helipad, and a painted sign over the street.
              if b.u > 0 {
                model(BOX, at: [b.x, b.h + 0.1, b.z], scale: [b.w + 0.3, 0.2, b.d + 0.3], image: roofTex, color: #ece6dc)
                model(BOX, at: [b.x, b.h + b.u / 2, b.z], scale: [b.w * 0.62, b.u, b.d * 0.62], image: facadeTex, color: TINTS[floor(b.t * 4)])
              }
              model(BOX, at: [b.x, b.h + b.u + 0.2, b.z], scale: [(b.u > 0 ? b.w * 0.62 : b.w) + 0.3, 0.4, (b.u > 0 ? b.d * 0.62 : b.d) + 0.3], image: b.heli && b.u == 0 ? heliTex : roofTex, color: b.heli && b.u == 0 ? white : ROOFT[floor(b.n * 4)])
              if b.n < 0.6 {
                model(BOX, at: [b.x, b.h * 0.78, b.z + b.d / 2 + 0.3], scale: [b.w * 0.7, min(1.6, b.h * 0.12), 0.3], color: SIGNS[floor(b.n / 0.6 * 5)])
              }
            }
            if b.k == "cont" {
              for j in range(b.n) {
                model(BOX, at: [b.x, 1.25 + j * 2.6, b.z], scale: [6.2, 2.5, 2.5], image: ribTex, color: CONT[floor(hash(b.x, b.z, j) * 7)])
              }
            }
            if b.k == "post" {
              model(BOX, at: [b.x, b.h / 2, b.z], scale: [b.w, b.h, b.d], color: b.h > 20 ? #e0b030 : #e08a2a)
            }
            if b.k == "ware" {
              model(BOX, at: [b.x, b.h / 2, b.z], scale: [b.w, b.h, b.d], image: ribTex, color: #c8c4b8)
              model(BOX, at: [b.x, b.h + 0.15, b.z], scale: [b.w + 0.3, 0.3, b.d + 0.3], image: roofTex, color: #ece6dc)
              for j in range(2) {
                model(BOX, at: [b.x - 4.5 + j * 9, 1.7, b.z + b.d / 2 + 0.05], scale: [3.6, 3.4, 0.1], color: #2a2638)
                model(BOX, at: [b.x - 4.5 + j * 9, 3.8, b.z + b.d / 2 + 0.25], scale: [1.2, 0.25, 0.4], color: LAMP)
              }
            }
            if b.k == "tank" {
              model(CYL, at: [b.x, b.h / 2, b.z], scale: [b.w, b.h, b.d], color: #d8d0e8)
              model(CYL, at: [b.x, b.h + 0.2, b.z], scale: [b.w * 0.9, 0.4, b.d * 0.9], color: #c8324b)
            }
            if b.k == "hotel" {
              // Pastel and art deco: a painted band under the roof and an upright sign over the coast road.
              model(BOX, at: [b.x, b.h / 2, b.z], scale: [b.w, b.h, b.d], image: facadeTex, color: PASTEL[b.t])
              model(BOX, at: [b.x, b.h - 0.6, b.z], scale: [b.w + 0.25, 0.3, b.d + 0.25], color: white)
              model(BOX, at: [b.x, b.h + 0.2, b.z], scale: [b.w + 0.3, 0.4, b.d + 0.3], image: roofTex, color: #ece6dc)
              model(BOX, at: [b.x + b.w / 2 + 0.3, b.h * 0.6, b.z], scale: [0.4, b.h * 0.6, 3], color: SIGNS[(floor(b.n * 5) + 2) % 5])
            }
            if b.k == "house" {
              model(BOX, at: [b.x, b.h / 2, b.z], scale: [b.w, b.h, b.d], color: PASTEL[floor(b.t * 5)])
              model(ROOF, at: [b.x, b.h, b.z], turn: [0, b.t < 0.5 ? 0 : 90, 0], scale: [b.t < 0.5 ? b.w + 0.6 : b.d + 0.6, 1.6, b.t < 0.5 ? b.d + 0.6 : b.w + 0.6], color: ROOFS[floor(b.r * 4)])
              model(BOX, at: [b.x, 1.2, b.z + b.d / 2 + 0.03], scale: [1.2, 0.8, 0.06], color: #7a5238)
            }
            if b.k == "stadium" {
              model(RING, at: [b.x, 0, b.z])
              for j in range(4) {
                model(BOX, at: [b.x + (j % 2 * 2 - 1) * 8.6, 6, b.z + (floor(j / 2) * 2 - 1) * 8.6], scale: [0.4, 12, 0.4], color: #3a3550)
                model(BOX, at: [b.x + (j % 2 * 2 - 1) * 8.6, 12.2, b.z + (floor(j / 2) * 2 - 1) * 8.6], scale: [2, 0.9, 2], color: #e8e6dc)
              }
            }
            if b.k == "hosp" {
              model(BOX, at: [b.x, b.h / 2, b.z], scale: [b.w, b.h, b.d], image: facadeTex, color: #e8e4f0)
              model(BOX, at: [b.x, b.h + 0.2, b.z], scale: [b.w + 0.3, 0.4, b.d + 0.3], image: roofTex, color: #ece6dc)
              model(CROSS, at: [b.x, b.h + 0.6, b.z], turn: [90, 0, 0], scale: [4, 4, 1], color: #ff3b5c, ambient: 1)
              model(BOX, at: [b.x - b.w / 2 - 0.6, 2.6, b.z], scale: [1.2, 0.4, 6], color: #d23a32)
            }
            if b.k == "police" {
              model(BOX, at: [b.x, b.h / 2, b.z], scale: [b.w, b.h, b.d], image: facadeTex, color: #c8d4e8)
              model(BOX, at: [b.x, b.h + 0.2, b.z], scale: [b.w + 0.3, 0.4, b.d + 0.3], image: heliTex, color: white)
              model(BOX, at: [b.x, b.h * 0.72, b.z + b.d / 2 + 0.3], scale: [b.w * 0.6, 1, 0.3], color: #2f5fb0)
            }
            if b.k == "copcar" {
              model(VEH[9], at: [b.x, 0, b.z], turn: [0, 90, 0], color: #f4f4f0)
              model(BOX, at: [b.x, 1.62, b.z], turn: [0, 90, 0], scale: [1.3, 0.22, 0.4], color: floor(gt * 3 + b.x) % 2 == 0 ? #ff3040 : #3070ff, ambient: 1)
            }
            if b.k == "spray" {
              model(BOX, at: [b.x, b.h / 2, b.z], scale: [b.w, b.h, b.d], image: ribTex, color: #b8b0a0)
              model(BOX, at: [b.x, b.h + 0.15, b.z], scale: [b.w + 0.3, 0.3, b.d + 0.3], image: roofTex, color: #ece6dc)
              model(BOX, at: [b.x, 1.8, b.z + b.d / 2 + 0.05], scale: [6, 3.6, 0.1], color: #1a1626)
              model(BOX, at: [b.x, 4.1, b.z + b.d / 2 + 0.25], scale: [7, 0.6, 0.3], color: #e07a2a)
            }
            if b.k == "shop" {
              model(BOX, at: [b.x, b.h / 2, b.z], scale: [b.w, b.h, b.d], image: facadeTex, color: #f4f0e8)
              model(BOX, at: [b.x, b.h - 0.4, b.z + b.d / 2 + 0.1], scale: [b.w, 0.5, 0.2], color: #2f9a50)
            }
            if b.k == "pump" {
              model(BOX, at: [b.x, b.h / 2, b.z], scale: [b.w, b.h, b.d], color: #e8e4f0)
              model(BOX, at: [b.x, 2.8, b.z], scale: [0.3, 2.8, 0.3], color: #a49ebc)
            }
            if b.k == "frame" {
              // A tower going up: floors on columns, the top one bare, a girder waiting on it.
              for j in range(3) {
                model(BOX, at: [b.x, 0.15 + j * 3.4, b.z], scale: [b.w, 0.3, b.d], color: #8a8498)
              }
              for j in range(4) {
                model(BOX, at: [b.x + (j % 2 * 2 - 1) * (b.w / 2 - 0.4), 3.5, b.z + (floor(j / 2) * 2 - 1) * (b.d / 2 - 0.4)], scale: [0.5, 7, 0.5], color: #6a6478)
              }
              model(BOX, at: [b.x, 7.2, b.z - 2], scale: [8, 0.5, 0.5], color: #e08a2a)
            }
            if b.k == "fount" {
              model(CYL, at: [b.x, 0.3, b.z], scale: [6, 0.6, 6], color: #a49ebc)
              model(CYL, at: [b.x, 0.62, b.z], scale: [5.2, 0.05, 5.2], color: #35a8d0, ambient: 0.9)
              model(CYL, at: [b.x, 1.4 + 0.2 * sin(gt * 5), b.z], scale: [0.5, 1.8 + 0.4 * sin(gt * 5), 0.5], color: alpha(#bfefff, 0.85), ambient: 1)
              for j in range(8) {
                model(BOX, at: [b.x + sin(rad(j * 45)) * (gt * 1.3 + j * 0.37) % 1 * 2.4, 0.7 + 2.6 * sin(rad(180 * ((gt * 1.3 + j * 0.37) % 1))), b.z + cos(rad(j * 45)) * (gt * 1.3 + j * 0.37) % 1 * 2.4], scale: 0.25, color: #bfefff, ambient: 1)
              }
            }
            if b.k == "light" {
              // The lighthouse: red and white bands up to the lit lamp room.
              for j in range(4) {
                model(CYL, at: [b.x, 1.75 + j * 3.5, b.z], scale: [3.4 - j * 0.3, 3.5, 3.4 - j * 0.3], color: j % 2 == 0 ? #e8e4f0 : #d23a52)
              }
              model(CYL, at: [b.x, 15, b.z], scale: 2, color: #fff4c0, ambient: 1)
              model(CONE, at: [b.x, 16.7, b.z], scale: [2.6, 1.4, 2.6], color: #d23a52)
            }
          }
          // A tower crane turning slowly over the site, its hook going in and out.
          if c.k == "build" {
            for j in range(4) {
              model(BOX, at: [c.cx * C + 23.5 + sin(rad(gt * 8 + c.cx * 40)) * (j * 6 - 3), 30.4, c.cz * C + 23.5 + cos(rad(gt * 8 + c.cx * 40)) * (j * 6 - 3)], turn: [0, gt * 8 + c.cx * 40, 0], scale: [0.9, 0.9, 6], color: #e0b030)
            }
            model(BOX, at: [c.cx * C + 23.5 - sin(rad(gt * 8 + c.cx * 40)) * 6, 29.8, c.cz * C + 23.5 - cos(rad(gt * 8 + c.cx * 40)) * 6], turn: [0, gt * 8 + c.cx * 40, 0], scale: [2, 1.6, 2.4], color: #6a6478)
            model(BOX, at: [c.cx * C + 23.5 + sin(rad(gt * 8 + c.cx * 40)) * (12 + 5 * sin(gt * 0.6)), 24, c.cz * C + 23.5 + cos(rad(gt * 8 + c.cx * 40)) * (12 + 5 * sin(gt * 0.6))], scale: [0.1, 12, 0.1], color: #2a2638)
            model(BOX, at: [c.cx * C + 23.5 + sin(rad(gt * 8 + c.cx * 40)) * (12 + 5 * sin(gt * 0.6)), 17.6, c.cz * C + 23.5 + cos(rad(gt * 8 + c.cx * 40)) * (12 + 5 * sin(gt * 0.6))], turn: [0, gt * 8 + c.cx * 40, 0], scale: [3, 0.5, 0.6], color: #e08a2a)
            model(BOX, at: [c.cx * C + 23.5 + sin(rad(gt * 8 + c.cx * 40)) * 20.5, 31, c.cz * C + 23.5 + cos(rad(gt * 8 + c.cx * 40)) * 20.5], scale: 0.5, color: floor(gt * 2) % 2 == 0 ? #ff3040 : #3a1018, ambient: 1)
          }
          // A gantry crane on the quay, its boom out over the water and a trolley running along it.
          if c.k == "docks" && c.cz == 0 && c.cx % 3 == 1 {
            for j in range(2) {
              model(BOX, at: [c.cx * C + 16, 13.6, c.cz * C + 7.5 + j * 7.5], scale: [11, 0.8, 0.8], color: #e08a2a)
            }
            for j in range(4) {
              model(BOX, at: [c.cx * C + 16, 14.5, c.cz * C + 13 - j * 11], scale: [2.6, 1, 11], color: #e08a2a)
            }
            model(BOX, at: [c.cx * C + 16, 13.4, c.cz * C - 8 + sin(gt * 0.4 + c.cx) * 12], scale: [3.2, 1.4, 2.6], color: #e8e4f0)
            model(BOX, at: [c.cx * C + 16, 9, c.cz * C - 8 + sin(gt * 0.4 + c.cx) * 12], scale: [0.12, 8, 0.12], color: #2a2638)
            model(BOX, at: [c.cx * C + 16, 4.6, c.cz * C - 8 + sin(gt * 0.4 + c.cx) * 12], scale: [2.5, 2.5, 6.2], turn: [0, 0, 0], image: ribTex, color: CONT[c.cx % 7])
          }
          // The quay's edge along the north shore.
          if c.cz == 0 && c.k == "docks" {
            model(BOX, at: [c.cx * C + 16, 0.1, c.cz * C - 0.25], scale: [32, 0.6, 0.5], color: #a49ebc)
          }
          if c.k == "gas" {
            model(BOX, at: [c.cx * C + 16, 4.4, c.cz * C + 18], scale: [12, 0.5, 7], color: #f4f2ec)
            for j in range(2) {
              model(BOX, at: [c.cx * C + 16, 4.4, c.cz * C + 14.45 + j * 7.1], scale: [12.3, 0.7, 0.15], color: #2f9a50)
              model(BOX, at: [c.cx * C + 9.95 + j * 12.1, 4.4, c.cz * C + 18], scale: [0.15, 0.7, 7.3], color: #2f9a50)
            }
            model(BOX, at: [c.cx * C + 25.5, 4.5, c.cz * C + 25.5], scale: [0.3, 9, 0.3], color: #3a3550)
            model(BOX, at: [c.cx * C + 25.5, 9.4, c.cz * C + 25.5], scale: [3, 1.6, 0.4], color: #2f9a50)
          }
          if c.k == "plaza" {
            for j in range(4) {
              model(BOX, at: [c.cx * C + 9.5 + j % 2 * 13, 0.4, c.cz * C + 9.5 + floor(j / 2) * 13], scale: [2.4, 0.8, 2.4], color: #b8a888)
              model(CROWN, at: [c.cx * C + 9.5 + j % 2 * 13, 2.6, c.cz * C + 9.5 + floor(j / 2) * 13], scale: 3.2, color: #2f8f5a, smooth: false)
            }
          }
          if c.k == "court" {
            for j in range(2) {
              model(BOX, at: [c.cx * C + 16, 1.6, c.cz * C + 7.8 + j * 16.4], scale: [0.25, 3.2, 0.25], color: #a49ebc)
              model(BOX, at: [c.cx * C + 16, 3.2, c.cz * C + 8.1 + j * 15.8], scale: [1.8, 1.1, 0.12], color: #e8e4f0, ambient: 0.9)
            }
          }
          if c.k == "suburb" {
            model(TRUNK, at: [c.cx * C + 16, 1, c.cz * C + 9.5], scale: [0.4, 2, 0.4], color: #6b4a32)
            model(CROWN, at: [c.cx * C + 16, 2.8, c.cz * C + 9.5], scale: 3, color: hash(c.cx, c.cz, 8) < 0.5 ? #2f8f5a : #3a7a4a, smooth: false)
            if hash(c.cx, c.cz, 7) >= 0.6 {
              model(TRUNK, at: [c.cx * C + 16, 1, c.cz * C + 16], scale: [0.4, 2, 0.4], color: #6b4a32)
              model(CROWN, at: [c.cx * C + 16, 2.8, c.cz * C + 16], scale: 3.4, color: #2f8f5a, smooth: false)
            }
          }
          if c.k == "hotel" {
            for j in range(2) {
              model(TRUNK, at: [c.cx * C + 26.5, 3, c.cz * C + 9 + j * 14], scale: [0.45, 6, 0.45], color: #7a5a3a)
              model(CROWN, at: [c.cx * C + 26.5, 6.2, c.cz * C + 9 + j * 14], turn: [0, j * 50, 0], scale: [4.5, 1.1, 4.5], color: #2f8f6f, smooth: false)
            }
          }
          // The canal's rails along both quays, and along each bridge.
          if c.k == "canal" {
            model(BOX, at: [c.cx * C + (c.cx == 11 ? 18.5 : 16), 0.45, c.cz * C + 6.9], scale: [c.cx == 11 ? 27 : 22, 0.9, 0.2], color: #8a8498)
            model(BOX, at: [c.cx * C + (c.cx == 11 ? 18.5 : 16), 0.45, c.cz * C + 25.1], scale: [c.cx == 11 ? 27 : 22, 0.9, 0.2], color: #8a8498)
            model(BOX, at: [c.cx * C + 5.1, 0.55, c.cz * C + 16], scale: [0.3, 1.1, 18.4], color: #a49ebc)
            if c.cx < 11 {
              model(BOX, at: [c.cx * C + 26.9, 0.55, c.cz * C + 16], scale: [0.3, 1.1, 18.4], color: #a49ebc)
            }
          }
          if c.k != "beach" && c.cx < 11 && (c.cx + c.cz) % 2 == 0 {
            model(BOX, at: [c.cx * C + 6.5, 3.5, c.cz * C + 6.5], scale: [0.3, 7, 0.3], color: #3a3550)
            model(BOX, at: [c.cx * C + 6.5, 7.1, c.cz * C + 6.5], scale: [1.1, 0.3, 1.1], color: LAMP)
          }
          if c.k == "park" {
            for i in range(3) {
              model(TRUNK, at: [c.cx * C + 10 + hash(c.cx, c.cz, 70 + i) * 12, 1.5, c.cz * C + 10 + hash(c.cx, c.cz, 80 + i) * 12], scale: [0.6, 3, 0.6], color: #6b4a32)
              model(CROWN, at: [c.cx * C + 10 + hash(c.cx, c.cz, 70 + i) * 12, 4, c.cz * C + 10 + hash(c.cx, c.cz, 80 + i) * 12], scale: 4, color: #2f8f5a, smooth: false)
            }
          }
          if c.k == "beach" && c.cz > 0 {
            for i in range(3) {
              model(TRUNK, at: [c.cx * C + 16 + hash(c.cz, i) * 6, 3, c.cz * C + 5 + i * 11], scale: [0.5, 6, 0.5], color: #7a5a3a)
              model(CROWN, at: [c.cx * C + 16 + hash(c.cz, i) * 6, 6.2, c.cz * C + 5 + i * 11], turn: [0, i * 40, 0], scale: [5, 1.2, 5], color: #2f8f6f, smooth: false)
            }
          }
        }
        // The ship at the docks: a hull, its bridge at the stern, containers stacked on deck.
        if camZ < 140 && camX < 260 {
          for j in range(5) {
            model(BOX, at: [100 + j * 16, 1.2, -20], scale: [16, 4.4, j == 4 ? 10 : 13], color: #7a2a24)
          }
          model(BOX, at: [97, 6.5, -20], scale: [6, 6.6, 11], image: facadeTex, color: #e8e4f0)
          model(BOX, at: [172.5, 2.6, -20], scale: [1, 0.5, 6], color: #f4f2ec)
          for s in SHIP {
            for j in range(s.n) {
              model(BOX, at: [s.x, 4.65 + j * 2.5, s.z], scale: [6.2, 2.4, 2.4], image: ribTex, color: CONT[s.c])
            }
          }
        }
        // Boulders on the rocks; palms and umbrellas on the sand.
        for p in nearShore {
          if p.rock {
            model(CROWN, at: [p.x + (hash(p.z, 261) - 0.5) * p.w * 0.6, 0.3, p.z + (hash(p.z, 262) - 0.5) * p.d * 0.6], turn: [0, hash(p.z, 263) * 90, 0], scale: [2.6, 1.6, 2.2], color: #6a6478, smooth: false)
            model(CROWN, at: [p.x + (hash(p.z, 264) - 0.5) * p.w * 0.6, 0.2, p.z + (hash(p.z, 265) - 0.5) * p.d * 0.6], scale: [1.8, 1.2, 1.6], color: #5a5468, smooth: false)
          }
          if !p.rock && !p.flat && p.w > 11 && p.d > 11 && hash(p.x, p.z, 266) < 0.5 {
            model(TRUNK, at: [p.x - 2, 2.8, p.z], scale: [0.45, 5.6, 0.45], color: #7a5a3a)
            model(CROWN, at: [p.x - 2, 5.8, p.z], turn: [0, hash(p.x, 267) * 90, 0], scale: [4.5, 1.1, 4.5], color: #2f8f6f, smooth: false)
            model(BOX, at: [p.x + 2.5, 1, p.z + 1], scale: [0.12, 2, 0.12], color: #e8e4f0)
            model(CONE, at: [p.x + 2.5, 2.1, p.z + 1], scale: [3, 0.7, 3], color: SIGNS[floor(hash(p.x, p.z, 268) * 5)])
          }
        }
        // The pier south of the beach, with lamps and a café at its end.
        if camZ > 400 {
          model(BOX, at: [208, 0.35, 524 + E], scale: [4.5, 0.3, 26], color: #6a4a3a)
          model(BOX, at: [208, 0.4, 538 + E], scale: [12, 0.3, 8], color: #6a4a3a)
          model(BOX, at: [208, 1.6, 539 + E], scale: [6, 2.4, 4], image: facadeTex, color: #f4a6c0)
          model(BOX, at: [208, 2.9, 539 + E], scale: [6.3, 0.3, 4.3], color: #35e0ff, ambient: 1)
          for j in range(3) {
            model(BOX, at: [205.6, 1.3, 516 + E + j * 8], scale: [0.15, 2, 0.15], color: #3a3550)
            model(BOX, at: [205.6, 2.4, 516 + E + j * 8], scale: 0.4, color: LAMP, ambient: 1)
          }
        }
        // The breakwater, and its light.
        if camZ < 120 && camX < 140 {
          for m in MOLE {
            model(CROWN, at: [m.x, 0.3, m.z], turn: [0, m.x * 20, 0], scale: [m.s, 1.4, m.s * 0.9], color: #6a6478, smooth: false)
          }
          model(CYL, at: [33, 2, -38 - E], scale: [1, 4, 1], color: #e8e4f0)
          model(BOX, at: [33, 4.3, -38 - E], scale: 0.8, color: floor(gt * 1.5) % 2 == 0 ? #ff3040 : #3a1018, ambient: 1)
        }
        // The islands: a villa with its pool and jetty, a palm, a beacon.
        for s in ISLES {
          if s.r > 0 && abs(s.x - camX) < 100 && abs(s.z - camZ) < 130 {
            if s.k == "villa" {
              model(BOX, at: [s.x - 2, 1.6, s.z - 2], scale: [9, 3.2, 6], image: facadeTex, color: #e8e4f0)
              model(BOX, at: [s.x - 2, 3.35, s.z - 2], scale: [9.4, 0.3, 6.4], color: #ff4fa3, ambient: 1)
              model(BOX, at: [s.x + 4, 0.15, s.z + 3], scale: [3.5, 0.1, 5], color: #5ad8f0, ambient: 1)
              model(BOX, at: [s.x - 6, 0.3, s.z - s.r - 4], scale: [2, 0.25, 10], color: #6a4a3a)
              for j in range(3) {
                model(TRUNK, at: [s.x - 8 + j * 7, 2.8, s.z + 6 - j % 2 * 2], scale: [0.45, 5.6, 0.45], color: #7a5a3a)
                model(CROWN, at: [s.x - 8 + j * 7, 5.8, s.z + 6 - j % 2 * 2], turn: [0, j * 40, 0], scale: [4.5, 1.1, 4.5], color: #2f8f6f, smooth: false)
              }
            }
            if s.k == "palm" {
              model(TRUNK, at: [s.x, 2.8, s.z], scale: [0.45, 5.6, 0.45], color: #7a5a3a)
              model(CROWN, at: [s.x, 5.8, s.z], scale: [4.5, 1.1, 4.5], color: #2f8f6f, smooth: false)
            }
            if s.k == "beacon" {
              model(CYL, at: [s.x, 3, s.z], scale: [1.2, 6, 1.2], color: #3ccf6e)
              model(BOX, at: [s.x, 6.4, s.z], scale: 0.9, color: floor(gt * 2 + 1) % 2 == 0 ? #3ccf6e : #10301a, ambient: 1)
              model(CROWN, at: [s.x + 2.5, 0.2, s.z + 1], scale: [2.4, 1.3, 2], color: #6a6478, smooth: false)
            }
          }
        }
        // Boats: a hull with a cabin and its own color; sailboats a mast and sail.
        for b in boats {
          model(HULL, at: [b.x, 0, b.z], turn: [sin(gt * 2 + b.off) * 2, b.h, sin(gt * 1.6 + b.off) * 3], color: b.c)
          if b.sail {
            model(BOX, at: [b.x, 4.2, b.z], scale: [0.15, 7, 0.15], color: #d8d0e8)
            model(SAIL, at: [b.x, 0, b.z], turn: [0, b.h, 14], color: #e8e4f0, twoSided: true)
          } else {
            model(BOX, at: [b.x - sin(rad(b.h)) * 0.6, 1.4, b.z - cos(rad(b.h)) * 0.6], turn: [0, b.h, 0], scale: [1.6, 1, 2.2], color: #2a2638)
          }
        }
        for r in nearRamps {
          model(RAMPM, at: [r.x, 0, r.z], turn: [0, r.h, 0], scale: [4, r.y, 6])
        }
        if goal != null && mis.k != "takedown" {
          model(MARK, at: [goal[0], 3, goal[1]], scale: [mis.k == "race" ? 9 : 5, 6, mis.k == "race" ? 9 : 5], color: alpha(mcol, 0.3 + 0.12 * sin(gt * 5)), ambient: 1, twoSided: true)
        }
        if mis.k == "race" && mis.i < len(RACE) - 1 {
          model(MARK, at: [RACE[mis.i + 1][0], 2, RACE[mis.i + 1][1]], scale: [7, 4, 7], color: alpha(mcol, 0.15), ambient: 1, twoSided: true)
        }
        for g in nearGivers {
          model(MARK, at: [g.x, 4, g.z], scale: [3.4, 8, 3.4], color: alpha(g.col, 0.35 + 0.12 * sin(gt * 4)), ambient: 1, twoSided: true)
        }
        for r in rivals {
          model(VEH[r.t], at: [r.x, 0, r.z], turn: [0, r.h, 0], color: r.c)
        }
        if prey != null {
          model(VEH[2], at: [prey.x, 0, prey.z], turn: [0, prey.vh, 0], color: #d8242a)
          model(CONE, at: [prey.x, 4.2 + 0.4 * sin(gt * 6), prey.z], turn: [180, gt * 120, 0], scale: [1.6, 1.4, 1.6], color: #ff3a2a, ambient: 1)
        }
        if heat > 0 && mis.k != "getaway" {
          model(MARK, at: [SPRAY[0], 3, SPRAY[1]], scale: [5, 6, 5], color: alpha(#ff4fa3, 0.3 + 0.12 * sin(gt * 5)), ambient: 1, twoSided: true)
        }
        for p in seenParked {
          model(VEH[p.t ?? 1], at: [p.x, 0, p.z], turn: [0, p.h, 0], color: p.wreck ? #2e2a28 : PAINT[p.c])
        }
        for c in seenCars {
          model(VEH[c.t ?? 1], at: [c.x, 0, c.z], turn: [0, c.vh, 0], color: PAINT[c.c])
        }
        for c in seenCops {
          model(VEH[9], at: [c.x, 0, c.z], turn: [0, c.h, 0], color: #f4f4f0)
          model(BOX, at: [c.x, 1.62, c.z], turn: [0, c.h, 0], scale: [1.3, 0.22, 0.4], color: floor(gt * 6) % 2 == 0 ? #ff3040 : #3070ff, ambient: 1)
        }
        for p in seenPeds {
          // People walk in step: legs swing about their hips and arms the other way about their shoulders.
          if p.down > 0 && ((p.gone ?? false) || gt - p.down < 3) {
            model(MAN, at: [p.x, 0.3, p.z], turn: [-90, p.h, 0], scale: 1.8, color: SHIRTS[p.c])
          } else {
            let pStep = sin(gt * p.v * 5 + p.id)
            let pBob = abs(cos(gt * p.v * 5 + p.id)) * 0.1
            let pSide = [cos(rad(p.h)), sin(rad(p.h))]
            model(BODY, at: [p.x, pBob, p.z], turn: [0, p.h, 0], scale: 1.8, color: SHIRTS[p.c])
            model(LEG, at: [p.x - pSide[0] * 0.29, 1.62 + pBob, p.z + pSide[1] * 0.29], turn: [pStep * 32, p.h, 0], scale: 1.8)
            model(LEG, at: [p.x + pSide[0] * 0.29, 1.62 + pBob, p.z - pSide[1] * 0.29], turn: [-pStep * 32, p.h, 0], scale: 1.8)
            model(ARM, at: [p.x - pSide[0] * 0.79, 2.79 + pBob, p.z + pSide[1] * 0.79], turn: [-pStep * 26, p.h, 0], scale: 1.8, color: SHIRTS[p.c])
            model(ARM, at: [p.x + pSide[0] * 0.79, 2.79 + pBob, p.z - pSide[1] * 0.79], turn: [pStep * 26, p.h, 0], scale: 1.8, color: SHIRTS[p.c])
          }
        }
        if inCar {
          model(VEH[ptype], at: [px, py, pz], turn: [air != null ? clamp(-pvy * 1.5, -16, 16) : (py > 0 ? -18 : 0), ph, 0], color: PAINT[pcol])
          if ptype == 9 && py == 0 {
            model(BOX, at: [px, 1.62, pz], turn: [0, ph, 0], scale: [1.3, 0.22, 0.4], color: floor(gt * 6) % 2 == 0 ? #ff3040 : #3070ff, ambient: 1)
          }
        } else if sunk != null {
          if gt - sunk.at < 0.7 {
            model(VEH[sunk.t], at: [sunk.x, -(gt - sunk.at) * 2.6, sunk.z], turn: [(gt - sunk.at) * 40, sunk.h, 0], color: PAINT[sunk.c])
          }
        } else {
          // A punch lunges you forward; walking bobs you and swings your legs and arms.
          let jab = gun < 0 && gt - shotAt < 0.15
          let youX = px + (jab ? sin(rad(ph)) * 0.4 : 0)
          let youZ = pz + (jab ? cos(rad(ph)) * 0.4 : 0)
          let walking = abs(sdx) + abs(sdy) > 0.15 ? 1 : 0
          let youBob = abs(cos(gt * 13)) * 0.14 * walking
          let youStep = sin(gt * 13) * walking
          let youSide = [cos(rad(ph)), sin(rad(ph))]
          model(BODY, at: [youX, youBob, youZ], turn: [0, ph, 0], scale: 1.8, color: #ffffff)
          model(LEG, at: [youX - youSide[0] * 0.29, 1.62 + youBob, youZ + youSide[1] * 0.29], turn: [youStep * 38, ph, 0], scale: 1.8)
          model(LEG, at: [youX + youSide[0] * 0.29, 1.62 + youBob, youZ - youSide[1] * 0.29], turn: [-youStep * 38, ph, 0], scale: 1.8)
          model(ARM, at: [youX - youSide[0] * 0.79, 2.79 + youBob, youZ + youSide[1] * 0.79], turn: [gun >= 0 ? -80 : (jab ? -90 : -youStep * 30), ph, 0], scale: 1.8, color: #ffffff)
          model(ARM, at: [youX + youSide[0] * 0.79, 2.79 + youBob, youZ - youSide[1] * 0.79], turn: [gun >= 0 ? -70 : youStep * 30, ph, 0], scale: 1.8, color: #ffffff)
          if gun >= 0 {
            model(GUNS[gun], at: [px - cos(rad(ph)) * 0.79 + sin(rad(ph)) * 1.15, 2.7, pz + sin(rad(ph)) * 0.79 + cos(rad(ph)) * 1.15], turn: [0, ph, 0], scale: 1.6)
          }
        }
        // Pickups float and turn above their glow.
        for p in nearPicks {
          if p.k == 0 {
            model(CROSS, at: [p.x, 1.4 + sin(gt * 3 + p.id) * 0.2, p.z], turn: [0, gt * 90, 0], scale: 1.1, color: PICK_COLOR[0], ambient: 1)
          }
          if p.k == 1 {
            model(MARK, at: [p.x, 1.4 + sin(gt * 3 + p.id) * 0.2, p.z], turn: [90, gt * 90, 0], scale: [1.4, 0.3, 1.7], color: PICK_COLOR[1], ambient: 1)
          }
          if p.k >= 2 && p.k <= 4 {
            model(GUNS[p.k - 2], at: [p.x, 1.3 + sin(gt * 3 + p.id) * 0.2, p.z], turn: [0, gt * 90, 0], scale: 2.4)
          }
          if p.k == 5 {
            model(CASHB, at: [p.x, 1.3 + sin(gt * 3 + p.id) * 0.2, p.z], turn: [0, gt * 90, 0], scale: 1.3, color: PICK_COLOR[5], ambient: 0.9)
          }
        }
        for o in seenOfficers {
          if o.down > 0 {
            model(MAN, at: [o.x, 0.3, o.z], turn: [-90, o.h, 0], scale: 1.8, color: #2f4fd0)
          } else {
            let running = dist([o.x, o.z], [px, pz]) > 8
            let oBob = running ? abs(cos(gt * 11 + o.id)) * 0.12 : 0
            let oStep = running ? sin(gt * 11 + o.id) : 0
            let oSide = [cos(rad(o.h)), sin(rad(o.h))]
            model(BODY, at: [o.x, oBob, o.z], turn: [0, o.h, 0], scale: 1.8, color: #2f4fd0)
            model(LEG, at: [o.x - oSide[0] * 0.29, 1.62 + oBob, o.z + oSide[1] * 0.29], turn: [oStep * 36, o.h, 0], scale: 1.8)
            model(LEG, at: [o.x + oSide[0] * 0.29, 1.62 + oBob, o.z - oSide[1] * 0.29], turn: [-oStep * 36, o.h, 0], scale: 1.8)
            model(ARM, at: [o.x - oSide[0] * 0.79, 2.79 + oBob, o.z + oSide[1] * 0.79], turn: [-80, o.h, 0], scale: 1.8, color: #2f4fd0)
            model(ARM, at: [o.x + oSide[0] * 0.79, 2.79 + oBob, o.z - oSide[1] * 0.79], turn: [running ? oStep * 30 : -20, o.h, 0], scale: 1.8, color: #2f4fd0)
          }
          if o.down == 0 {
            model(GUN0, at: [o.x - cos(rad(o.h)) * 0.79 + sin(rad(o.h)) * 1.15, 2.7, o.z + sin(rad(o.h)) * 0.79 + cos(rad(o.h)) * 1.15], turn: [0, o.h, 0], scale: 1.6)
          }
        }
        for t in shots {
          model(BOX, at: [(t.x0 + t.x1) / 2, 1.4, (t.z0 + t.z1) / 2], turn: [0, deg(atan2(t.x1 - t.x0, t.z1 - t.z0)), 0], scale: [0.09, 0.09, dist([t.x0, t.z0], [t.x1, t.z1])], color: t.c == 0 ? #fff1a8 : #ff6a5a, ambient: 1)
        }
        for f in fx {
          model(BOX, at: [f.x, f.y, f.z], turn: [f.life * 200, f.life * 150, 0], scale: f.k == "spark" ? 0.25 : (f.k == "drop" ? 0.4 : (f.k == "fire" ? 0.6 + f.life : 1.6 - f.life * 0.6)), color: f.k == "spark" ? #ffd36b : f.k == "drop" ? alpha(#bfe8ff, 0.85) : (f.k == "fire" ? alpha(mix(#ff3a1a, #ffd36b, f.life / 1.4), 0.9) : alpha(#5a5468, f.life * 0.5)), ambient: f.k == "smoke" ? 0.6 : 1)
        }
      }

      // The stick where the thumb went down, and how fast the car goes.
      if mode == "play" {
        if stick != null {
          circle(stick.startX, stick.startY, 55, fill: alpha(black, 0.25), stroke: alpha(white, 0.35), width: 2)
          circle(stick.startX + sdx * 55, stick.startY + sdy * 55, 22, fill: alpha(white, 0.6))
        } else {
          text("TOUCH ANYWHERE AND PUSH THE WAY TO GO", W / 2 + 1.5, H * 0.7 + 1.5, size: 16, font: ANTON, align: center, color: black)
          text("TOUCH ANYWHERE AND PUSH THE WAY TO GO", W / 2, H * 0.7, size: 16, font: ANTON, align: center, color: white)
        }
        if inCar {
          for o in OUTL {
            text("${round(abs(pv) * 3.6)}", W - 52 + o[0], H - BOT - 62 + o[1], size: 34, font: ANTON, align: center, color: black)
          }
          text("${round(abs(pv) * 3.6)}", W - 52, H - BOT - 62, size: 34, font: ANTON, align: center, color: white)
          text("KM/H", W - 52, H - BOT - 36, size: 13, font: ANTON, align: center, color: white)
        }
        // The map: the blocks around you, north up, with the way to the goal, the mission spots, the paint shop and
        // the police on it.
        let MX = W - 136
        let MY = TOP + 126
        let s = 120 / (7 * C)
        clip(MX, MY, 120, 120) {
          rect(MX, MY, 120, 120, fill: #2a8ca8)
          rect(MX + 60 - px * s, MY + 60 - pz * s, 12 * C * s, 16 * C * s, fill: #6a6a6e)
          for cz in range(max(0, floor(pz / C) - 4), min(16, floor(pz / C) + 5)) {
            for cx in range(max(0, floor(px / C) - 4), min(12, floor(px / C) + 5)) {
              rect(MX + 60 + (cx * C + 6 - px) * s, MY + 60 + (cz * C + 6 - pz) * s, 20 * s, 20 * s, fill: KCOL[CELLS[cz * 12 + cx].k] ?? #b8b2a6)
            }
          }
          if len(route) > 1 {
            path(route.map(p => [MX + 60 + (p[0] - px) * s, MY + 60 + (p[1] - pz) * s]), stroke: black, width: 5, cap: round)
            path(route.map(p => [MX + 60 + (p[0] - px) * s, MY + 60 + (p[1] - pz) * s]), stroke: mcol, width: 3, cap: round)
          }
          if mis == null {
            for g, i in GIVERS {
              circle(MX + 60 + (g.x - px) * s, MY + 60 + (g.z - pz) * s, 4, fill: indexOf(done, i) >= 0 ? alpha(g.col, 0.35) : g.col, stroke: black, width: 1.5)
            }
          }
          for r in rivals {
            circle(MX + 60 + (r.x - px) * s, MY + 60 + (r.z - pz) * s, 3, fill: r.c, stroke: black, width: 1)
          }
          if goal != null {
            circle(clamp(MX + 60 + (goal[0] - px) * s, MX + 6, MX + 114), clamp(MY + 60 + (goal[1] - pz) * s, MY + 6, MY + 114), 5.5, fill: mcol, stroke: black, width: 2)
          }
          if heat > 0 && mis.k != "getaway" {
            circle(clamp(MX + 60 + (SPRAY[0] - px) * s, MX + 5, MX + 115), clamp(MY + 60 + (SPRAY[1] - pz) * s, MY + 5, MY + 115), 4, fill: #e07a2a)
          }
          for r in nearRamps {
            circle(MX + 60 + (r.x - px) * s, MY + 60 + (r.z - pz) * s, 2.4, fill: #f2d94e)
          }
          for p in nearPicks {
            circle(MX + 60 + (p.x - px) * s, MY + 60 + (p.z - pz) * s, 2.2, fill: PICK_COLOR[p.k])
          }
          for c in cops {
            circle(MX + 60 + (c.x - px) * s, MY + 60 + (c.z - pz) * s, 3, fill: floor(gt * 6) % 2 == 0 ? #ff3040 : #3070ff)
          }
          circle(MX + 60, MY + 60, 4, fill: white)
        }
        rect(MX - 1.5, MY - 1.5, 123, 123, stroke: black, width: 3)
      }
      if mode == "play" {
        for g in nearGivers {
          let q = project([g.x, 9, g.z], cam, W, H)
          if q != null {
            for o in OUTL {
              text((g.done ? "✓ " : "") + upper(g.name), q.x + o[0], q.y + o[1], size: 18, font: ANTON, align: center, color: black)
            }
            text((g.done ? "✓ " : "") + upper(g.name), q.x, q.y, size: 18, font: ANTON, align: center, color: g.col)
          }
        }
        if goal != null && gOn && mis.k != null {
          for o in OUTL {
            text(gd + " M", gp.x + o[0], gp.y - 34 + o[1], size: 18, font: ANTON, align: center, color: black)
          }
          text(gd + " M", gp.x, gp.y - 34, size: 18, font: ANTON, align: center, color: mcol)
        }
        if goal != null && !gOn {
          let ax = W / 2 + cos(ga) * (W / 2 - 34)
          let ay = clamp(H / 2 + sin(ga) * (H / 2 - 60), TOP + 120, H - BOT - 130)
          rotate(deg(ga), ax, ay) {
            path([[ax + 20, ay], [ax - 12, ay - 15], [ax - 5, ay], [ax - 12, ay + 15]], closed: true, fill: mcol, stroke: black, width: 3)
          }
          for o in OUTL {
            text(gd + " M", ax - cos(ga) * 34 + o[0], ay - sin(ga) * 30 + o[1], size: 16, font: ANTON, align: center, color: black)
          }
          text(gd + " M", ax - cos(ga) * 34, ay - sin(ga) * 30, size: 16, font: ANTON, align: center, color: mcol)
        }
      }
      for h in HUD {
        for o in OUTL {
          text(h.s, h.x + o[0], h.y + o[1], size: h.size, font: ANTON, align: h.a, color: black)
        }
        text(h.s, h.x, h.y, size: h.size, font: ANTON, align: h.a, color: h.c)
      }
      // Health and armor on foot: plain bars under the stars, framed in black.
      if mode == "play" && !inCar {
        rect(W - 146, TOP + 88, 130, 11, fill: black)
        rect(W - 144, TOP + 90, 126 * max(0, hp) / 100, 7, fill: #d8242a)
        if armor > 0 {
          rect(W - 146, TOP + 103, 130, 11, fill: black)
          rect(W - 144, TOP + 105, 126 * armor / 100, 7, fill: #4a8ad8)
        }
      }

      onTouch: fingers = touches
    }
    if mode == "play" {
      // Getting out, and in: the nearest car, parked or someone else's.
      Column {
        fill: true
        align: end
        justify: end
        gap: 10
        padding: [0, 0, 16, BOT + (inCar ? 96 : 28)]
        if inCar && abs(pv) < 4 && air == null {
          Text { text: "GET OUT"; width: 150; align: center; padding: [16, 10]; font: ANTON; fontSize: 20; background: alpha(black, 0.65); border: black; color: white; onTap: {
            parked = drop(parked, max(0, len(parked) - 5)) + [{id: nextId, t: ptype, x: px, z: pz, h: ph, c: pcol, dmg: dmg, wreck: false}]
            nextId = nextId + 1
            inCar = false
            pv = 0
            pvx = 0
            pvz = 0
            px = px + cos(rad(ph)) * (TYPES[ptype].wid / 2 + 1.4)
            pz = pz - sin(rad(ph)) * (TYPES[ptype].wid / 2 + 1.4)
          } }
        }
        if !inCar && near != null {
          Text { text: upper(near.kind != "parked" ? "take the " + TYPES[near.t ?? 1].name : "get in the " + TYPES[near.t ?? 1].name); width: 220; align: center; padding: [16, 10]; font: ANTON; fontSize: 20; background: alpha(black, 0.65); border: black; color: near.kind != "parked" ? #f2c230 : white; onTap: {
            // The car as it is now: near is worked out from the lists, so it changes as the car leaves them.
            let car = near
            if car.kind == "traffic" {
              cars = cars.filter(c => c.id != car.id)
              // A crime only when the police are close enough to see it.
              if any(cops, c => dist([c.x, c.z], [px, pz]) < 45) || any(officers, o => o.down == 0 && dist([o.x, o.z], [px, pz]) < 45) {
                heat = min(5, max(heat, 1))
                crimeAt = gt
              }
              dmg = 0
            } else if car.kind == "police" {
              // A police car whose officer stepped out: taking it is a bigger crime.
              cops = cops.filter(c => c.id != car.id)
              heat = min(5, max(heat + 1, 2))
              crimeAt = gt
              dmg = 0
            } else {
              parked = parked.filter(c => c.id != car.id)
              dmg = car.dmg
            }
            px = car.x
            pz = car.z
            ph = car.kind == "traffic" ? car.vh : car.h
            pcol = car.c
            ptype = car.t ?? 1
            msg = TYPES[car.t ?? 1].name
            msgAt = gt
            pv = 0
            pvx = 0
            pvz = 0
            inCar = true
          } }
        }
        // The gun in hand (tap for the next one), and the attack button, held to keep firing or punching.
        if !inCar && sunk == null && gun >= 0 {
          Text { text: upper(WEAPONS[gun].name) + " · " + fmtNum(ammo[gun]); width: 150; align: center; padding: [12, 8]; font: ANTON; fontSize: 18; background: alpha(black, 0.65); border: black; color: #f2c230; onTap: gun = first(range(1, 3).map(i => (gun + i) % 3).filter(i => ammo[i] > 0)) ?? gun }
        }
        if !inCar && sunk == null {
          // Round, dark and see-through with a white ring, as the attack button of a phone crime game: a fist, or the word
          // with a gun; red while held.
          Box {
            size: 92
            radius: 46
            align: center
            background: alpha(firing ? #d8242a : black, firing ? 0.75 : 0.5)
            border: 3
            borderColor: alpha(white, firing ? 1 : 0.85)
            scale: firing ? 0.93 : 1
            onPress: firing = true
            onRelease: firing = false
            if gun >= 0 {
              Text { text: "FIRE"; width: 92; align: center; font: ANTON; fontSize: 24; color: white }
            } else {
              Image { src: FIST_ICON; size: 58; label: "punch" }
            }
          }
        }
      }
    }
    if mode == "play" {
      // What you tap for MISSIONS or QUIT, drawn in the HUD: the list, or giving up the one running.
      Column {
        padding: [8, TOP + (mis == null ? 12 : 94), 0, 0]
        Box { width: mis == null ? 190 : 64; height: mis == null ? 54 : 26; onTap: {
          if mis == null {
            mode = "list"
          } else {
            msg = "failed · you gave up"
            msgAt = gt
            mis = null
          }
        } }
      }
      // At a mission spot with none running: what it is, what it pays, and the button to start.
      if mis == null && at != null {
        Column {
          fill: true
          align: center
          justify: center
          padding: [16, 0]
          Column {
            width: min(W - 32, 380)
            gap: 6
            padding: [16, 12]
            background: alpha(black, 0.72)
            border: black
            Text { text: (indexOf(done, at) >= 0 ? "✓ " : "") + upper(GIVERS[at].name) + " · " + upper(GIVERS[at].sub); font: ANTON; fontSize: 26; color: GIVERS[at].col }
            Text { text: GIVERS[at].goal; color: white }
            Text { text: (indexOf(done, at) >= 0 ? "done · again, it " : "") + "pays " + GIVERS[at].pay + (GIVERS[at].k == "race" && get(best, GIVERS[at].sub, null) != null ? " · your best " + fmtTime(get(best, GIVERS[at].sub, 0), "m:ss", "UTC") : ""); style: small; color: #6cc04a }
            Text { text: GIVERS[at].car && !inCar ? "GET A CAR FIRST" : "START"; fill: width; align: center; font: ANTON; fontSize: 22; padding: [16, 8]; border: black; background: GIVERS[at].car && !inCar ? alpha(white, 0.25) : GIVERS[at].col; color: black; onTap: {
              // The spot as it is now: at is worked out from where you are, so copy it first.
              let g = at
              let G = GIVERS[g]
              if g != null && (!G.car || inCar) {
                track = null
                if G.k == "race" {
                  // On the line in the right lane, three rivals beside and behind, the street cleared.
                  let P = RPATH[G.r]
                  let dx = sign(P[1][0] - P[0][0])
                  let dz = sign(P[1][1] - P[0][1])
                  px = P[0][0] - dz * 2.5
                  pz = P[0][1] + dx * 2.5
                  ph = deg(atan2(dx, dz))
                  pv = 0
                  pvx = 0
                  pvz = 0
                  heat = 0
                  cops = []
                  officers = []
                  cars = cars.filter(c => dist([c.x, c.z], P[0]) > 40)
                  rivals = range(3).map(k => [[k == 0 ? 0 : -9, k == 1 ? 2.5 : -2.5]].map(q => {id: k, s: q[0], lane: q[1], x: P[0][0] + dx * q[0] - dz * q[1], z: P[0][1] + dz * q[0] + dx * q[1], h: deg(atan2(dx, dz)), v: 0, slow: 0, top: [34, 36, 32][k], t: [2, 3, 0][k], c: [#e8a23a, #2a5aa8, #2f7a4a][k]})[0])
                  mis = {k: "race", g: g, r: G.r, i: 1, go: gt + 3, sx: P[0][0] - dz * 2.5, sz: P[0][1] + dx * 2.5, sh: deg(atan2(dx, dz)), until: 0}
                }
                if G.k == "takedown" {
                  let opts = XING.filter(q => dist([q[0] * C, q[1] * C], [px, pz]) > 90 && dist([q[0] * C, q[1] * C], [px, pz]) < 150)
                  let q = opts[random(len(opts))]
                  let h = first(sortBy([0, 90, 180, 270], d => -dist([(q[0] + round(sin(rad(d)))) * C, (q[1] + round(cos(rad(d)))) * C], [px, pz])))
                  prey = {x: q[0] * C - round(cos(rad(h))) * 2.5 + round(sin(rad(h))) * 3, z: q[1] * C + round(sin(rad(h))) * 2.5 + round(cos(rad(h))) * 3, h: h, vh: h, nh: h, mx: q[0] + round(sin(rad(h))), mz: q[1] + round(cos(rad(h))), v: 20, hp: 100, slow: 0, hitAt: -100, plan: true}
                  mis = {k: "takedown", g: g, until: gt + 150}
                  msg = "takedown · catch the red car · ram it till it's wrecked"
                }
                if G.k == "getaway" {
                  // The hot car: a muscle car, and three stars on it from the start.
                  let opts = DROPS.filter(p => dist(p, [px, pz]) > 220)
                  let d = opts[random(len(opts))]
                  if inCar {
                    parked = drop(parked, max(0, len(parked) - 5)) + [{id: nextId, t: ptype, x: px - 3, z: pz + 3, h: ph, c: pcol, dmg: dmg, wreck: false}]
                    nextId = nextId + 1
                  }
                  inCar = true
                  ptype = 3
                  pcol = 5
                  dmg = 0
                  pv = 0
                  pvx = 0
                  pvz = 0
                  heat = 3
                  crimeAt = gt
                  seenAt = gt
                  mis = {k: "getaway", g: g, gx: d[0], gz: d[1], until: 0}
                  msg = "getaway · lose the police · then into the garage"
                }
                if G.k == "stunt" {
                  mis = {k: "stunt", g: g, i: 0, until: gt + 150}
                  msg = "stunt tour · follow the arrows to the ramp · hit it fast"
                }
                if G.k == "cargo" {
                  let opts = DROPS.filter(p => dist(p, [px, pz]) > 200 && dist(p, [px, pz]) < 320)
                  let d = opts[random(len(opts))]
                  mis = {k: "cargo", g: g, gx: d[0], gz: d[1], d0: dmg, pay: 150 + round(dist(d, [px, pz])), until: gt + dist(d, [px, pz]) * 1.3 / 13 + 20}
                  msg = "fragile cargo · drive gently · every knock breaks bottles"
                }
                if G.k == "courier" {
                  let opts = DROPS.filter(p => dist(p, [px, pz]) > 120 && dist(p, [px, pz]) < 230)
                  let d = opts[random(len(opts))]
                  mis = {k: "courier", g: g, i: 0, gx: d[0], gz: d[1], until: gt + dist(d, [px, pz]) * 1.3 / 15 + 12}
                  msg = "courier · three parcels · follow the arrows"
                }
                msgAt = G.k == "race" ? -100 : gt
              }
            } }
          }
        }
      }
    }
    if mode == "list" {
      // The missions: pick one and the map, the arrows on the road and the arrow at the screen's edge lead you there.
      Column {
        fill: true
        scroll: true
        gap: 8
        padding: [16, TOP + 12, 16, BOT + 16]
        background: alpha(black, 0.8)
        Row {
          fill: width
          align: center
          Text { text: "MISSIONS"; font: ANTON; fontSize: 40; color: #f2c230 }
          Text { text: "${len(done)} OF ${len(GIVERS)} DONE"; font: ANTON; fontSize: 20; color: #6cc04a; padding: [10, 0, 0, 0]; weight: 1 }
          Text { text: "BACK"; font: ANTON; fontSize: 20; padding: [16, 8]; background: alpha(black, 0.65); border: black; color: white; onTap: mode = "play" }
        }
        Text { text: "Pick one, and the arrows on the road and on the map lead you to it. Drive into its marker to see what to do and start."; color: white }
        for g, i in GIVERS {
          Column {
            fill: width
            gap: 2
            padding: [12, 8]
            background: track == i ? alpha(g.col, 0.3) : alpha(black, 0.5)
            border: black
            onTap: {
              track = i
              mode = "play"
            }
            Text { text: (indexOf(done, i) >= 0 ? "✓ " : "") + upper(g.name) + " · " + upper(g.sub) + " · " + round(dist([g.x, g.z], [px, pz])) + " M"; font: ANTON; fontSize: 20; color: g.col }
            Text { text: g.goal; style: small; color: white }
            Text { text: "pays " + g.pay + (g.k == "race" && get(best, g.sub, null) != null ? " · your best " + fmtTime(get(best, g.sub, 0), "m:ss", "UTC") : ""); style: small; color: #6cc04a }
          }
        }
      }
    }
    if mode == "title" {
      Column {
        fill: true
        align: center
        justify: center
        gap: 12
        padding: 24
        background: alpha(black, 0.35)
        Text { text: "SUNSET HEIST"; font: ANTON; fontSize: 56; color: #f2c230; align: center }
        Text { text: cash > 0 ? "$" + pad(str(cash), 8, "0") + " SAVED" : ""; font: ANTON; fontSize: 22; color: #6cc04a; align: center }
        Spacer { height: 12 }
        Text { text: "touch anywhere and push the way you want to drive"; align: center }
        Text { text: "get out anywhere and take any car · pick a mission from the list or drive into a marker · jump the ramps · lose the police at the paint shop"; style: muted; align: center }
        Text { text: "TAP TO DRIVE"; font: ANTON; fontSize: 26; color: #f2c230; align: center; padding: [20, 8]; background: black }
        onTap: {
          mode = "play"
          heat = 0
          cops = []
          px = 112
          pz = 322.5
          ph = 90
          pv = 0
          pvx = 0
          pvz = 0
          py = 0
          pvy = 0
          air = null
          inCar = true
          ptype = 1
          hp = 100
          armor = 0
          ammo = [0, 0, 0]
          gun = -1
          officers = []
          parked = STARTERS
          dmg = 0
          camX = 112
          camZ = 322.5
          mis = null
        }
      }
    }
  }
}
