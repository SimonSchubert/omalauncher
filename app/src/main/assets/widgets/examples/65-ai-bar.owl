widget "ai bar" {
  page: 1
  order: 30
  size: 6x2
  minSize: 4x2
  meta { description: "The launcher's prompt bar and recent apps, written in owl: type to find an app, Enter opens it or asks your agent, tap the agent's name to pick another"; version: "1.0"; license: "MIT"; category: "productivity"; owl: 11 }
  padding: 0
  background: transparent

  source ag = android.agents
  source r = android.recent
  source apps = android.apps
  state q = ""
  // The agent picked from the menu under its name; "" follows the launcher's default.
  state pick = "" persist
  state menu = false

  let agent = find(ag.installed, a => a.bin == pick) ?? ag.default
  let query = lower(trim(q))
  // What the strip shows while typing: the recent apps and every Android app, most used first.
  let android = map(filter(apps, a => !any(r, x => x.key == "a:" + a.key)), a => {key: "a:" + a.key, name: a.name, icon: a.icon, score: a.score})
  let matches = query == "" ? [] : take(sortBy(filter(flatten([r, android]), x => contains(lower(x.name), query)), x => -x.score), 8)
  // Enter opens the first match when the name starts with what's typed, like the bar; anything else goes to the agent.
  let opens = len(matches) > 0 && startsWith(lower(matches[0].name), query)
  let strip = query == "" ? take(r, 8) : matches

  Column {
    gap: 6
    // The agent menu takes the strip's place while it's open, as the bar's pops up above it.
    Row {
      visible: menu
      gap: 4
      height: 52
      align: center
      for a in ag.installed key a.bin {
        Box {
          size: 50
          padding: 5
          radius: 12
          border: a.bin == agent.bin ? 1 : 0
          borderColor: accent
          Image { src: a.icon; size: 40; onTap: { pick = a.bin; menu = false } }
        }
      }
      Text { text: "manage agents…"; color: muted; padding: [8, 12]; onTap: { menu = false; launcher("agents") } }
    }
    Row {
      visible: !menu
      gap: 2
      height: 52
      for x, i in strip key x.key {
        Box {
          size: 50
          padding: 3
          radius: 12
          border: opens && i == 0 ? 1 : 0
          borderColor: accent
          Image { src: x.icon; size: 44; onTap: { open(x.key); q = "" } }
        }
      }
    }
    Row {
      align: center
      gap: 10
      padding: [14, 12]
      border: 1
      borderColor: border
      background: alpha(background, 0.9)
      Text {
        spans: [agent == null ? "agent" : agent.bin, {text: menu ? " ⌃" : " ⌄", color: muted}]
        color: agent == null ? muted : accent
        onTap: {
          if agent == null {
            launcher("agents")
          } else {
            menu = !menu
          }
        }
      }
      Input {
        weight: 1
        text: q
        clear: true
        placeholder: agent == null ? "open an app…" : "open an app or ask ${agent.bin}…"
        onChange: { q = value; menu = false }
        onSubmit: {
          if opens {
            open(matches[0].key)
          } else {
            ask(value, agent.bin)
          }
          q = ""
        }
      }
    }
  }
}
