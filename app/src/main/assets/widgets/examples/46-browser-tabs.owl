face "work" {
  // A whole page with two tabs, a terminal and a page from the web. The one out of sight keeps its
  // place: scroll a page, switch to the shell and back, and it is where you left it.

  meta { owl: 18; description: "One page, two tabs: a shell in tmux and a web page, each keeping its place while the other shows"; version: "1.0"; license: "MIT"; category: "productivity" }

  state tab = "shell"
  state title = ""

  Column {
    gap: 8
    padding: [12, 8]

    Row {
      gap: 12
      Text { text: "shell"; style: small; color: tab == "shell" ? accent : muted; onTap: tab = "shell" }
      Text { text: "web"; style: small; color: tab == "web" ? accent : muted; onTap: tab = "web" }
      Spacer { weight: 1 }
      // Only the page has a history; the shell's Back is tmux's own.
      Text { text: "‹"; style: small; color: tab == "web" ? muted : transparent; onTap: web("back") }
      Text { text: title; style: small; color: muted; maxLines: 1 }
    }

    // A tab that goes away is disposed, and comes back to its own page: a terminal's process and a web
    // page's scroll both survive it.
    if tab == "shell" {
      Terminal { command: "tmux new -A -s face"; weight: 1 }
    } else {
      Browser { url: "https://lobste.rs/"; weight: 1; onTitle: title = value }
    }

    Spacer { height: screenInset }
  }
}
