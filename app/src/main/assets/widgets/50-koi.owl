widget "koi pond" {
  meta { description: "A pixel-art koi pond in your theme's colors. Tap the water to feed the koi"; version: "1.2"; license: "MIT"; category: "fun" }
  page: 1
  order: 6
  size: 6x3
  minSize: 2x2
  padding: 0

  // Pixel-art koi in theme colors. A Canvas keeps nothing between frames, so
  // every koi is a function of `time`: the head swims a path, and the body is
  // drawn where the head was a moment ago, as blocky discs on a pixel grid.
  //
  // Tap the water to feed them. A tap stores each koi's body and speed as they
  // are, and works out a route from there the way a fish would swim it: turn
  // in an arc from where it's facing, swim straight, and slip onto a circle
  // round the food. After a while it leaves along that circle the same way,
  // onto its home loop. Another tap starts a new route from wherever it is.
  state fedAt = -100
  state foodX = 0
  state foodY = 0
  state fromK = []
  state plan = []

  // Paths are in fractions of the tile: x = sin(t), y = cos(ratio * t + ph).
  // `spots` are [segment, side] pairs that get a patch in `spot`.
  let koi = [
    {cx: 0.46, cy: 0.50, rx: 0.32, ry: 0.30, ratio: 1, ph: 0.3, speed: 0.22, dir: 1, body: foreground, spot: red, spots: [[0, 0], [2, 1], [3, 0], [6, -1], [7, 1]]},
    {cx: 0.50, cy: 0.48, rx: 0.38, ry: 0.36, ratio: 1, ph: -0.4, speed: 0.18, dir: -1, body: orange, spot: foreground, spots: [[2, -1], [5, 1]]}
  ]
  // Body half-width per segment in art pixels, head first.
  let profile = [2, 3, 3, 3, 3, 3, 3, 2, 2, 2, 1, 1, 1, 1, 0]

  // Seconds since the last tap. `time` starts again from 0 when the tile's
  // frame clock restarts (say, after its page was off screen), so a tap that
  // seems to be in the future was really long ago.
  let since = time >= fedAt ? time - fedAt : 1000
  // Long enough to swim there, eat, swim home and for the body to follow.
  let feeding = since < 30

  // One art pixel, in dp. With no padding the Canvas is the whole tile.
  let p = clamp(round(min(tileWidth ?? 300, tileHeight ?? 200) / 70), 2, 5)
  // The koi are worked out here rather than in the Canvas, because onTap
  // stores how they are at the tap. The Canvas fills the tile.
  let W = tileWidth ?? 300
  let H = tileHeight ?? 200
  // Body segments are this far apart, in dp.
  let ds = 1.5 * p
  let turn = 2 * rad(180)

  // Lambdas in lets can't be called directly, only passed to map and friends,
  // so they take one list of arguments.

  // Each koi's home loop and its circle round the food, in dp. `s2` is which
  // way round the food it swims: 1 turns from x towards y.
  let rig = koi.map((f, i) => [(12 + i * 6) * p].map(fr => {
    i: i, f: f, fr: fr, s2: -f.dir, cx: f.cx * W, cy: f.cy * H, rx: f.rx * W, ry: f.ry * H,
    fx: clamp(foodX, fr + 4 * p, W - fr - 4 * p), fy: clamp(foodY, fr + 4 * p, H - fr - 4 * p)
  })[0])

  // [rig, angle] → the home loop there as [x, y], and which way it runs, per
  // unit of angle: [dx, dy].
  let homeAt = v => [
    v[0].cx + v[0].rx * sin(v[1]), v[0].cy + v[0].ry * cos(v[0].f.ratio * v[1] + v[0].f.ph),
    v[0].f.dir * v[0].rx * cos(v[1]), -v[0].f.dir * v[0].ry * v[0].f.ratio * sin(v[0].f.ratio * v[1] + v[0].f.ph)
  ]

  // Idle, the body is just the loop: step back along it directly, by the
  // loop's speed halfway back, so the body keeps its length where the loop
  // speeds up or slows down. From [rig, angle offset].
  let loop = v => [v[0].f.ph + v[0].f.dir * time * v[0].f.speed + v[1]]
    .map(th => range(len(profile) + 1).map(k => th - v[0].f.dir * k * ds / 2 / max(sqrt(pow(v[0].rx * cos(th), 2) + pow(v[0].ry * v[0].f.ratio * sin(v[0].f.ratio * th + v[0].f.ph), 2)), 1))
      .map((m, k) => th - v[0].f.dir * k * ds / max(sqrt(pow(v[0].rx * cos(m), 2) + pow(v[0].ry * v[0].f.ratio * sin(v[0].f.ratio * m + v[0].f.ph), 2)), 1))
      .map(t => [[v[0], t]].map(homeAt)[0]))[0]

  // [point, centre, angle] → the point turned about the centre.
  let spin = v => [
    v[1][0] + (v[0][0] - v[1][0]) * cos(v[2]) - (v[0][1] - v[1][1]) * sin(v[2]),
    v[1][1] + (v[0][0] - v[1][0]) * sin(v[2]) + (v[0][1] - v[1][1]) * cos(v[2])
  ]

  // A route: from [point, heading, s1, R, centre, s2, r] turn s1 on a circle of
  // radius R, then swim straight and join the circle of radius r round the
  // centre, going s2 (1 or -1) round it. The straight runs along u, from t1 on
  // the first circle to t2 on the second; phi is the turn before it. `ok` is
  // false when the two circles are too close for one.
  let route = v => [[v[0][0] - v[2] * v[3] * v[1][1], v[0][1] + v[2] * v[3] * v[1][0]]]
    // [first centre, dx, dy, k] between the centres
    .map(c => [c, v[4][0] - c[0], v[4][1] - c[1], v[5] * v[6] - v[2] * v[3]])
    // [.., distance², straight length]
    .map(w => [w[0], w[1], w[2], w[3], max(w[1] * w[1] + w[2] * w[2], 0.001), sqrt(max(w[1] * w[1] + w[2] * w[2] - w[3] * w[3], 0))])
    .map(w => [w, [(w[5] * w[1] + w[3] * w[2]) / w[4], (w[5] * w[2] - w[3] * w[1]) / w[4]]])
    .map(w => [w[0], w[1], v[2] * (atan2(w[1][1], w[1][0]) - atan2(v[1][1], v[1][0]))])
    .map(w => [w[0], w[1], w[2] - turn * floor(w[2] / turn)])
    .map(w => {
      ok: w[0][4] > pow(abs(w[0][3]) + 0.01, 2),
      a: v[0], s1: v[2], R: v[3], c1: w[0][0], phi: w[2], u: w[1], lam: w[0][5],
      t1: [w[0][0][0] + v[2] * v[3] * w[1][1], w[0][0][1] - v[2] * v[3] * w[1][0]],
      c2: v[4], s2: v[5], r2: v[6],
      t2: [v[4][0] + v[5] * v[6] * w[1][1], v[4][1] - v[5] * v[6] * w[1][0]],
      len: v[3] * w[2] + w[0][5]
    })[0]

  // [route, distance along it] → [x, y]. Past the straight it carries on round
  // the second circle.
  let along = v => v[1] < v[0].R * v[0].phi ? [[v[0].a, v[0].c1, v[0].s1 * v[1] / v[0].R]].map(spin)[0] :
    v[1] < v[0].R * v[0].phi + v[0].lam ? [v[0].t1[0] + v[0].u[0] * (v[1] - v[0].R * v[0].phi), v[0].t1[1] + v[0].u[1] * (v[1] - v[0].R * v[0].phi)] :
    [[v[0].t2, v[0].c2, v[0].s2 * (v[1] - v[0].R * v[0].phi - v[0].lam) / v[0].r2]].map(spin)[0]

  // [route, its length, start, speed at the start, speed at the end] → a leg:
  // the route swum from time t0, taking T seconds. The distance swum eases
  // from one speed to the other, so it neither jerks off nor brakes hard.
  let legOf = v => [clamp(v[1] / (20 * p), 0.8, 5)].map(T => {
    c: v[0], S: max(v[1], 0.001), t0: v[2], T: T,
    m0: clamp(v[3] * T / max(v[1], 0.001), 0, 3), m1: clamp(v[4] * T / max(v[1], 0.001), 0, 3)
  })[0]
  // [leg, tau] → how far along it the koi is at time tau.
  let swum = v => [clamp((v[1] - v[0].t0) / v[0].T, 0, 1)]
    .map(g => v[0].S * (3 * g * g - 2 * g * g * g + v[0].m0 * (g * g * g - 2 * g * g + g) + v[0].m1 * (g * g * g - g * g)))[0]

  // Each koi's trip since the last tap: `go` to the food, round it from `arr`,
  // `back` from `tl`, and home from `ret`, its loop shifted by `dh` so it joins
  // where it arrives. onTap works these out and keeps them in `plan`, so the
  // frame after a tap doesn't have to.
  let trips = rig.map(r => [fromK[r.i]].map(k => k == null ? {r: r, go: null, dh: 0} :
    // Where the head was at the tap, and which way it faced
    [[[k.body[0][0], k.body[0][1]], k.body[0][0] - k.body[1][0], k.body[0][1] - k.body[1][1]]]
      .map(h => [h[0], [h[1] / max(sqrt(h[1] * h[1] + h[2] * h[2]), 0.001), h[2] / max(sqrt(h[1] * h[1] + h[2] * h[2]), 0.001)]])
      // The shortest route there, turning as tightly as the koi can (7 px)
      // unless the food is so close that it needs a wider turn.
      .map(h => flatten([7, 12, 20, 30].map(m => [1, -1].map(s1 => [h[0], h[1], s1, m * p, [r.fx, r.fy], r.s2, r.fr]))).map(route)
        .filter(c => c.ok).sortBy(c => c.len + c.R)[0])
      .map(c => [[c, c.len, fedAt, k.speed, r.fr * r.f.speed]].map(legOf)[0])
      // [go, arrival, angle offset round the food]
      .map(g => [g, fedAt + g.T, atan2(g.c.t2[0] - r.fx, g.c.t2[1] - r.fy) - r.f.dir * r.f.speed * (fedAt + g.T)])
      // [.., leaving, its angle round the food]
      .map(w => [w[0], w[1], w[2], w[1] + 4 + r.i * 0.6, w[2] + r.f.dir * r.f.speed * (w[1] + 4 + r.i * 0.6)])
      .map(w => [w, [r.fx + r.fr * sin(w[4]), r.fy + r.fr * cos(w[4])], [r.f.dir * cos(w[4]), -r.f.dir * sin(w[4])]])
      // Home: the shortest route to any of 24 points on the loop, ending on a
      // turn that lines up with it there. [route, loop angle, speed, length]
      .map(w => [w[0], flatten(range(24).map(j => [j * turn / 24, [[r, j * turn / 24]].map(homeAt)[0]])
        .map(q => [q[0], q[1], sqrt(q[1][2] * q[1][2] + q[1][3] * q[1][3])])
        .map(q => [q[0], q[1], [q[1][2] / q[2], q[1][3] / q[2]], q[2]])
        .map(q => [1, -1].map(s3 => [1, -1].map(s1 => [w[1], w[2], s1, 7 * p, [q[1][0] - s3 * 7 * p * q[2][1], q[1][1] + s3 * 7 * p * q[2][0]], s3, 7 * p])
          .map(route).filter(c => c.ok)
          .map(c => [c, q[0], q[3] * r.f.speed, c.len + 7 * p * [s3 * (atan2(q[2][1], q[2][0]) - atan2(c.u[1], c.u[0]))].map(a => a - turn * floor(a / turn))[0]]))))
        .map(q => flatten(q)).sortBy(q => q[3])[0]])
      .map(w => [w[0], [[w[1][0], w[1][3], w[0][3], r.fr * r.f.speed, w[1][2]]].map(legOf)[0], w[1][1]])
      .map(w => {
        r: r, go: w[0][0], arr: w[0][1], dl: w[0][2], tl: w[0][3],
        back: w[1], ret: w[0][3] + w[1].T,
        dh: w[2] - r.f.ph - r.f.dir * r.f.speed * (w[0][3] + w[1].T)
      })[0])[0])

  // [trip, tau] → the head at time tau, as [x, y].
  let headAt = v => v[0].go == null || v[1] >= v[0].ret ? [[v[0].r, v[0].r.f.ph + v[0].r.f.dir * v[0].r.f.speed * v[1] + v[0].dh]].map(homeAt)[0] :
    v[1] < v[0].arr ? [[v[0].go, v[1]]].map(swum).map(s => [v[0].go.c, s]).map(along)[0] :
    v[1] < v[0].tl ? [v[0].dl + v[0].r.f.dir * v[0].r.f.speed * v[1]].map(th => [v[0].r.fx + v[0].r.fr * sin(th), v[0].r.fy + v[0].r.fr * cos(th)])[0] :
    [[v[0].back, v[1]]].map(swum).map(s => [v[0].back.c, s]).map(along)[0]

  // [trip, tau] → how far the head has swum since the tap. Along the home
  // loop that's its speed summed with Simpson's rule, close enough for the
  // few seconds the body takes to follow it there.
  let odometer = v => v[1] < v[0].arr ? [[v[0].go, v[1]]].map(swum)[0] :
    v[1] < v[0].tl ? v[0].go.S + v[0].r.fr * v[0].r.f.speed * (v[1] - v[0].arr) :
    v[1] < v[0].ret ? v[0].go.S + v[0].r.fr * v[0].r.f.speed * (v[0].tl - v[0].arr) + [[v[0].back, v[1]]].map(swum)[0] :
    [[v[0].r.f.ph + v[0].r.f.dir * v[0].r.f.speed * v[0].ret + v[0].dh, v[0].r.f.ph + v[0].r.f.dir * v[0].r.f.speed * v[1] + v[0].dh]]
      .map(a => [a[0], (a[0] + a[1]) / 2, a[1]].map(th => [[v[0].r, th]].map(homeAt)[0]).map(q => sqrt(q[2] * q[2] + q[3] * q[3])))
      .map(q => v[0].go.S + v[0].r.fr * v[0].r.f.speed * (v[0].tl - v[0].arr) + v[0].back.S + v[0].r.f.speed * (v[1] - v[0].ret) / 6 * (q[0] + 4 * q[1] + q[2]))[0]

  // The trips planned at the last tap. Before any, and on the home loop, the
  // loop follows the tile's size now.
  let live = rig.map((r, i) => plan[i] ?? {r: r, go: null, dh: 0})

  // Each head's speed in dp/s, over the last tenth of a second.
  let speeds = live.map(t => [[t, time], [t, time - 0.1]].map(headAt))
    .map(q => sqrt(pow(q[0][0] - q[1][0], 2) + pow(q[0][1] - q[1][1], 2)) / 0.1)

  // Feeding, the body lies along the head's path, a segment's length apart:
  // find when the head was each distance back, between 32 samples of the
  // odometer, and put the segment where the head was then. Further back than
  // the tap it lies along the body as it was at the tap. Once it's all back on
  // the home loop, the idle body takes over.
  let bodies = live.map((t, i) => !feeding || t.go == null || time > t.ret + 6 ? [[rig[i], t.dh]].map(loop)[0] :
    [range(33).map(j => time - j * min(since, 25) / 32)]
      .map(ts => [ts, ts.map(tau => [t, tau]).map(odometer)])
      .map(w => [w[0], w[1].map(o => w[1][0] - o)])
      .map(w => range(len(profile) + 1).map(k => k * ds >= w[1][32] ?
          [clamp((k * ds - w[1][32]) / ds, 0, len(profile) - 0.001)]
            .map(x => [fromK[i].body[floor(x)], fromK[i].body[floor(x) + 1], x - floor(x)])
            .map(q => [lerp(q[0][0], q[1][0], q[2]), lerp(q[0][1], q[1][1], q[2])])[0] :
          [clamp(count(w[1], o => o <= k * ds) - 1, 0, 31)]
            .map(j => [[t, lerp(w[0][j], w[0][j + 1], clamp((k * ds - w[1][j]) / max(w[1][j + 1] - w[1][j], 0.001), 0, 1))]].map(headAt)[0])[0]))[0])

  // The lily pad only changes with the tile's size, so its rects are worked out
  // here, once, rather than every frame: [x, y, w, h, color]. A pixel disc a row
  // at a time, with a thin slit running down and right from the centre (one
  // pixel wide, widening towards the edge), a darker rim below, faint veins and
  // a highlight along the top. Rows are half a dp taller than a pixel so no
  // seam shows where p isn't whole device pixels.
  let leaf = mix(mix(green, foreground, 0.3), background, 0.3)
  // Centre column and row, and radius, in art pixels
  let pad = [floor((tileWidth ?? 300) * 0.66 / p), floor((tileHeight ?? 200) * 0.38 / p), round(0.13 * min(tileWidth ?? 300, tileHeight ?? 200) / p)]
  let slope = 0.8
  let padRects = flatten([
    // Rows: [j, half width, slit column, slit width]
    range(1 - pad[2], pad[2]).map(j => [j, floor(sqrt(pad[2] * pad[2] - j * j) + 0.5), pad[0] + round(slope * j), 1 + floor(j * 1.5 / pad[2])])
      .map(r => r[0] > 0 ?
        [[(pad[0] - r[1]) * p, (pad[1] + r[0]) * p, max(r[2] - pad[0] + r[1], 0) * p, p + 0.5, leaf],
         [(r[2] + r[3]) * p, (pad[1] + r[0]) * p, max(pad[0] + r[1] - r[2] - r[3] + 1, 0) * p, p + 0.5, leaf]] :
        [[(pad[0] - r[1]) * p, (pad[1] + r[0]) * p, (2 * r[1] + 1) * p, p + 0.5, leaf]]),
    // The rim: the pixels just below the lower half's edge, [j, half, half of the row below]
    range(0, pad[2]).map(j => [j, floor(sqrt(pad[2] * pad[2] - j * j) + 0.5), j + 1 < pad[2] ? floor(sqrt(pad[2] * pad[2] - (j + 1) * (j + 1)) + 0.5) : -1])
      .filter(r => r[2] < r[1])
      .map(r => [[(pad[0] - r[1]) * p, (pad[1] + r[0] + 1) * p, (r[1] - r[2]) * p, p, mix(leaf, background, 0.5)],
                 [(pad[0] + r[2] + 1) * p, (pad[1] + r[0] + 1) * p, (r[1] - r[2]) * p, p, mix(leaf, background, 0.5)]]),
    // Veins: at right angles to the slit, and opposite it
    [[-1, slope], [-slope, -1], [1, -slope]].map(v => range(3, pad[2] - 2).map(r => [(pad[0] + round(v[0] * r / sqrt(1 + slope * slope))) * p, (pad[1] + round(v[1] * r / sqrt(1 + slope * slope))) * p, p, p, mix(leaf, background, 0.1)])),
    // Highlight along the top-left edge
    [range(-3, 4).map(q => [(pad[0] + round(cos(rad(q * 9 - 115)) * (pad[2] - 2))) * p, (pad[1] + round(sin(rad(q * 9 - 115)) * (pad[2] - 2))) * p, p, p, mix(leaf, foreground, 0.2)])]
  ].map(group => flatten(group)))

  Canvas {
    let fed = since

    onTap: {
      // Before fedAt changes: bodies and speeds read it.
      fromK = bodies.map((b, i) => {body: b, speed: speeds[i]})
      fedAt = time
      foodX = x
      foodY = y
      plan = trips
    }

    clip(0, 0, width, height) {
      // Food: a pixel ring where it landed, and pellets the koi nibble away.
      if fed < 2.5 {
        for q in range(20) {
          let qa = rad(q * 18)
          rect(floor((foodX + cos(qa) * fed * 14 * p) / p) * p, floor((foodY + sin(qa) * fed * 14 * p) / p) * p, p, p, fill: alpha(accent, 0.8 * (1 - fed / 2.5)))
        }
      }
      if fed < 6 {
        for j in range(5 - fed) {
          let qa = rad(j * 72 + 20)
          rect(floor((foodX + cos(qa) * 3 * p) / p) * p, floor((foodY + sin(qa) * 3 * p) / p) * p, p, p, fill: yellow)
        }
      }

      for f, i in koi {
        let body = bodies[i]
        let sway = sin(time * 4 + i * 2)
        let fin = mix(f.body, background, 0.25)

        // Tail first, so the head lands on top.
        for k in range(len(profile) - 1, -1, -1) {
          let x = body[k][0]
          let y = body[k][1]
          // Heading, from the neighbouring points on the path
          let hx0 = body[max(k - 1, 0)][0] - body[k + 1][0]
          let hy0 = body[max(k - 1, 0)][1] - body[k + 1][1]
          let hl = max(sqrt(hx0 * hx0 + hy0 * hy0), 0.001)
          let hx = hx0 / hl
          let hy = hy0 / hl
          let px = floor(x / p) * p
          let py = floor(y / p) * p
          let h = profile[k]

          if k == len(profile) - 1 {
            // Tail: two lobes of small blocks fanning out, swinging with the swim.
            for j in range(1, 5) {
              for side in [-1, 1] {
                let spread = j * 0.7 * side + sway * j * 0.4
                let tx = floor((x - hx * j * p * 1.1 - hy * spread * p) / p) * p
                let ty = floor((y - hy * j * p * 1.1 + hx * spread * p) / p) * p
                rect(tx, ty, (j < 3 ? 2 : 1) * p, (j < 3 ? 2 : 1) * p, fill: fin)
              }
            }
          }
          if k == 2 {
            // Pectoral fins: small blocks swept back from each side.
            for side in [-1, 1] {
              for j in range(1, 3) {
                let out = h + j * 1.2 + sway * 0.4 * side
                let fx = floor((x - hy * side * out * p - hx * (j * 1.3) * p) / p) * p
                let fy = floor((y + hx * side * out * p - hy * (j * 1.3) * p) / p) * p
                rect(fx, fy, (3 - j % 2) * p, (2 - j % 2) * p, fill: fin)
              }
            }
          }
          if h > 0 {
            // A blocky disc: two overlapping rects make a pixel circle. Half a dp
            // extra keeps seams from showing where p isn't whole device pixels.
            rect(px - h * p, py - (h - 1) * p, (2 * h + 1) * p + 0.5, (2 * h - 1) * p + 0.5, fill: f.body)
            rect(px - (h - 1) * p, py - h * p, (2 * h - 1) * p + 0.5, (2 * h + 1) * p + 0.5, fill: f.body)
          } else {
            rect(px, py, p, p, fill: f.body)
          }
          for sp in f.spots {
            if sp[0] == k {
              let sx = floor((x - hy * sp[1] * h * 0.4 * p) / p) * p
              let sy = floor((y + hx * sp[1] * h * 0.4 * p) / p) * p
              let sh = max(h - 1, 1)
              rect(sx - sh * p, sy - (sh - 1) * p, (2 * sh + 1) * p, (2 * sh - 1) * p, fill: f.spot)
              rect(sx - (sh - 1) * p, sy - sh * p, (2 * sh - 1) * p, (2 * sh + 1) * p, fill: f.spot)
            }
          }
          if k == 0 {
            for side in [-1, 1] {
              rect(floor((x + hx * p - hy * side * 1.5 * p) / p) * p, floor((y + hy * p + hx * side * 1.5 * p) / p) * p, p, p, fill: background)
            }
          }
        }
      }

      // The lily pad floats above the fish, drifting a pixel or two.
      let drift = round(sin(time * 0.07) * 2) * p
      for r in padRects {
        rect(r[0] + drift, r[1], r[2], r[3], fill: r[4])
      }
    }
  }
}
