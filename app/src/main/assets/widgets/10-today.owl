    ja {
      title: "天気"; loading: "天気…"; offline: "天気を取得できません"; city: "都市 · 空欄 = 自動"; here: "現在地を使う"
      feels: "体感"; humidity: "湿度"; rainToday: "今日の降水"; uv: "UV 指数"; pressure: "気圧"
      visibility: "視程"; next24: "今後 24 時間"; now: "現在"; days: "3 日間"; today: "今日"
      sunrise: "日の出"; sunset: "日の入り"; moon: "月"; kmh: "km/h"; yr: "yr.no を開く ↗"
      monthYear: "yyyy年M月"
      // The words Japanese forecasts use: 弱い, 強い and 激しい for how hard it falls, にわか for showers.
      sky: (code, desc) => get({
        "113": "晴れ", "116": "晴れ時々曇り", "119": "曇り", "122": "本曇り", "143": "もや",
        "176": "ところにより雨", "179": "ところにより雪", "182": "ところによりみぞれ", "185": "ところにより着氷性の霧雨",
