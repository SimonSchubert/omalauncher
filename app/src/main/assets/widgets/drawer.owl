panel "app drawer" {
  // The app drawer: swiping up on home opens it, above the prompt bar. It's a panel like any other, so it's yours to
  // change: ask your agent to edit it, or pick another panel in settings › gestures. .stock-drawer.owl next to it is
  // this file as the launcher ships it, kept up to date: compare the two to see what changed in a newer launcher.
  meta { description: "The launcher's app drawer, written in owl: your apps by kind, search as you type in the prompt bar, and each app's long-press menu"; version: "1.4"; license: "MIT"; category: "system"; owl: 16 }
  // The launcher's gear, as its settings buttons draw it; currentColor takes the accent.
  asset gear = base64""
  // A shopping bag with a sparkle cut out of it, the app store tile's icon; currentColor takes the tint.
  asset bag = base64""
  // What the drawer says, in the phone's language where it has a set, and in English where it doesn't. The action
  // words (pin, info, ...) are appAction's, so a long-press menu names each with get(str, word).
  strings {
    en {
      personal: "personal"; work: "work"; apps: "apps"; linux: "linux"; shortcuts: "shortcuts"; android: "android"
      workApps: "work apps"; workPaused: "work apps paused"; linuxApps: "linux apps"; appStore: "app store"
      pin: "add to home"; info: "app info"; uninstall: "uninstall"; remove: "remove"; edit: "edit"; voice: "edit by voice"; share: "share"
      settings: "settings"; turnOn: "turn on"; pause: "pause"; installing: "installing…"; installLinux: "install linux"
      open: "open"; ask: "ask"; askInstallLinux: "ask an agent · install linux"; askInstallAgent: "ask an agent · install one"
      askAgent: (bin, text) => "ask ${bin}: ${text}"
    }
    id {
      personal: "pribadi"; work: "kerja"; apps: "aplikasi"; linux: "linux"; shortcuts: "pintasan"; android: "android"
      workApps: "aplikasi kerja"; workPaused: "aplikasi kerja dijeda"; linuxApps: "aplikasi linux"; appStore: "toko aplikasi"
      pin: "tambah ke layar utama"; info: "info aplikasi"; uninstall: "uninstal"; remove: "hapus"; edit: "edit"; voice: "edit dengan suara"; share: "bagikan"
      settings: "setelan"; turnOn: "aktifkan"; pause: "jeda"; installing: "menginstal…"; installLinux: "instal linux"
      open: "buka"; ask: "tanya"; askInstallLinux: "tanya agen · instal linux"; askInstallAgent: "tanya agen · instal satu"
      askAgent: (bin, text) => "tanya ${bin}: ${text}"
    }
    es {
      personal: "personal"; work: "trabajo"; apps: "apps"; linux: "linux"; shortcuts: "accesos directos"; android: "android"
      workApps: "apps de trabajo"; workPaused: "apps de trabajo en pausa"; linuxApps: "apps de linux"; appStore: "tienda de apps"
      pin: "agregar a inicio"; info: "info de la app"; uninstall: "desinstalar"; remove: "quitar"; edit: "editar"; voice: "editar por voz"; share: "compartir"
      settings: "configuración"; turnOn: "activar"; pause: "pausar"; installing: "instalando…"; installLinux: "instalar linux"
      open: "abrir"; ask: "preguntar"; askInstallLinux: "preguntar a un agente · instalar linux"; askInstallAgent: "preguntar a un agente · instalar uno"
      askAgent: (bin, text) => "preguntar a ${bin}: ${text}"
    }
    pt {
      personal: "pessoal"; work: "trabalho"; apps: "apps"; linux: "linux"; shortcuts: "atalhos"; android: "android"
      workApps: "apps de trabalho"; workPaused: "apps de trabalho pausados"; linuxApps: "apps linux"; appStore: "loja de apps"
      pin: "adicionar à tela inicial"; info: "informações do app"; uninstall: "desinstalar"; remove: "remover"; edit: "editar"; voice: "editar por voz"; share: "compartilhar"
      settings: "configurações"; turnOn: "ativar"; pause: "pausar"; installing: "instalando…"; installLinux: "instalar linux"
      open: "abrir"; ask: "perguntar"; askInstallLinux: "perguntar a um agente · instalar linux"; askInstallAgent: "perguntar a um agente · instalar um"
      askAgent: (bin, text) => "perguntar ao ${bin}: ${text}"
    }
    de {
      personal: "persönlich"; work: "arbeit"; apps: "apps"; linux: "linux"; shortcuts: "verknüpfungen"; android: "android"
      workApps: "arbeits-apps"; workPaused: "arbeits-apps pausiert"; linuxApps: "linux-apps"; appStore: "app-store"
      pin: "zum startbildschirm hinzufügen"; info: "app-info"; uninstall: "deinstallieren"; remove: "entfernen"; edit: "bearbeiten"; voice: "per sprache bearbeiten"; share: "teilen"
      settings: "einstellungen"; turnOn: "aktivieren"; pause: "pausieren"; installing: "wird installiert…"; installLinux: "linux installieren"
      open: "öffnen"; ask: "fragen"; askInstallLinux: "einen agenten fragen · linux installieren"; askInstallAgent: "einen agenten fragen · einen installieren"
      askAgent: (bin, text) => "${bin} fragen: ${text}"
    }
    zh {
      personal: "个人"; work: "工作"; apps: "应用"; linux: "linux"; shortcuts: "快捷方式"; android: "android"
      workApps: "工作应用"; workPaused: "工作应用已暂停"; linuxApps: "linux 应用"; appStore: "应用商店"
      pin: "添加到主屏幕"; info: "应用信息"; uninstall: "卸载"; remove: "移除"; edit: "编辑"; voice: "语音编辑"; share: "分享"
      settings: "设置"; turnOn: "开启"; pause: "暂停"; installing: "正在安装…"; installLinux: "安装 linux"
      open: "打开"; ask: "提问"; askInstallLinux: "问智能体 · 安装 linux"; askInstallAgent: "问智能体 · 先装一个"
      askAgent: (bin, text) => "问 ${bin}：${text}"
    }
    ru {
      personal: "личные"; work: "рабочие"; apps: "приложения"; linux: "linux"; shortcuts: "ярлыки"; android: "android"
      workApps: "рабочие приложения"; workPaused: "рабочие приложения приостановлены"; linuxApps: "приложения linux"; appStore: "магазин приложений"
      pin: "добавить на главный экран"; info: "о приложении"; uninstall: "удалить"; remove: "убрать"; edit: "изменить"; voice: "изменить голосом"; share: "поделиться"
      settings: "настройки"; turnOn: "включить"; pause: "приостановить"; installing: "установка…"; installLinux: "установить linux"
      open: "открыть"; ask: "спросить"; askInstallLinux: "спросить агента · установить linux"; askInstallAgent: "спросить агента · установить агента"
      askAgent: (bin, text) => "спросить ${bin}: ${text}"
    }
    ja {
      personal: "個人用"; work: "仕事用"; apps: "アプリ"; linux: "linux"; shortcuts: "ショートカット"; android: "android"
      workApps: "仕事用アプリ"; workPaused: "仕事用アプリは一時停止中"; linuxApps: "linux アプリ"; appStore: "アプリストア"
      pin: "ホームに追加"; info: "アプリ情報"; uninstall: "アンインストール"; remove: "削除"; edit: "編集"; voice: "音声で編集"; share: "共有"
      settings: "設定"; turnOn: "オンにする"; pause: "一時停止"; installing: "インストール中…"; installLinux: "linux をインストール"
      open: "開く"; ask: "聞く"; askInstallLinux: "エージェントに聞く · linux をインストール"; askInstallAgent: "エージェントに聞く · まずインストール"
      askAgent: (bin, text) => "${bin} に聞く：${text}"
    }
    uk {
      personal: "особисті"; work: "робочі"; apps: "додатки"; linux: "linux"; shortcuts: "ярлики"; android: "android"
      workApps: "робочі додатки"; workPaused: "робочі додатки призупинено"; linuxApps: "додатки linux"; appStore: "магазин додатків"
      pin: "додати на головний екран"; info: "про додаток"; uninstall: "видалити"; remove: "прибрати"; edit: "змінити"; voice: "змінити голосом"; share: "поділитися"
      settings: "налаштування"; turnOn: "увімкнути"; pause: "призупинити"; installing: "встановлення…"; installLinux: "встановити linux"
      open: "відкрити"; ask: "запитати"; askInstallLinux: "запитати агента · встановити linux"; askInstallAgent: "запитати агента · встановити агента"
      askAgent: (bin, text) => "запитати ${bin}: ${text}"
    }
    fr {
      personal: "perso"; work: "pro"; apps: "applis"; linux: "linux"; shortcuts: "raccourcis"; android: "android"
      workApps: "applis pro"; workPaused: "applis pro en pause"; linuxApps: "applis linux"; appStore: "boutique d’applis"
      pin: "ajouter à l’accueil"; info: "infos sur l’appli"; uninstall: "désinstaller"; remove: "retirer"; edit: "modifier"; voice: "modifier à la voix"; share: "partager"
      settings: "paramètres"; turnOn: "activer"; pause: "mettre en pause"; installing: "installation…"; installLinux: "installer linux"
      open: "ouvrir"; ask: "demander"; askInstallLinux: "demander à un agent · installer linux"; askInstallAgent: "demander à un agent · en installer un"
      askAgent: (bin, text) => "demander à ${bin} : ${text}"
    }
    tr {
      personal: "kişisel"; work: "iş"; apps: "uygulamalar"; linux: "linux"; shortcuts: "kısayollar"; android: "android"
      workApps: "iş uygulamaları"; workPaused: "iş uygulamaları duraklatıldı"; linuxApps: "linux uygulamaları"; appStore: "uygulama mağazası"
      pin: "ana ekrana ekle"; info: "uygulama bilgileri"; uninstall: "yüklemeyi kaldır"; remove: "kaldır"; edit: "düzenle"; voice: "sesle düzenle"; share: "paylaş"
      settings: "ayarlar"; turnOn: "etkinleştir"; pause: "duraklat"; installing: "yükleniyor…"; installLinux: "linux’u yükle"
      open: "aç"; ask: "sor"; askInstallLinux: "bir ajana sor · linux’u yükle"; askInstallAgent: "bir ajana sor · önce ajan yükle"
      // Not "${bin}’a sor": the suffix follows the name's vowels.
      askAgent: (bin, text) => "${bin} ile sor: ${text}"
    }
    it {
      personal: "personali"; work: "lavoro"; apps: "app"; linux: "linux"; shortcuts: "scorciatoie"; android: "android"
      workApps: "app di lavoro"; workPaused: "app di lavoro in pausa"; linuxApps: "app linux"; appStore: "store delle app"
      pin: "aggiungi alla schermata home"; info: "informazioni app"; uninstall: "disinstalla"; remove: "rimuovi"; edit: "modifica"; voice: "modifica con la voce"; share: "condividi"
      settings: "impostazioni"; turnOn: "attiva"; pause: "metti in pausa"; installing: "installazione…"; installLinux: "installa linux"
      open: "apri"; ask: "chiedi"; askInstallLinux: "chiedi a un agente · installa linux"; askInstallAgent: "chiedi a un agente · installane uno"
      askAgent: (bin, text) => "chiedi a ${bin}: ${text}"
    }
    vi {
      personal: "cá nhân"; work: "công việc"; apps: "ứng dụng"; linux: "linux"; shortcuts: "lối tắt"; android: "android"
      workApps: "ứng dụng công việc"; workPaused: "ứng dụng công việc đã tạm dừng"; linuxApps: "ứng dụng linux"; appStore: "cửa hàng ứng dụng"
      pin: "thêm vào màn hình chính"; info: "thông tin ứng dụng"; uninstall: "gỡ cài đặt"; remove: "gỡ"; edit: "chỉnh sửa"; voice: "chỉnh sửa bằng giọng nói"; share: "chia sẻ"
      settings: "cài đặt"; turnOn: "bật"; pause: "tạm dừng"; installing: "đang cài đặt…"; installLinux: "cài đặt linux"
      open: "mở"; ask: "hỏi"; askInstallLinux: "hỏi tác nhân · cài đặt linux"; askInstallAgent: "hỏi tác nhân · cài một tác nhân"
      askAgent: (bin, text) => "hỏi ${bin}: ${text}"
    }
    ar {
      personal: "شخصي"; work: "العمل"; apps: "التطبيقات"; linux: "linux"; shortcuts: "الاختصارات"; android: "android"
      workApps: "تطبيقات العمل"; workPaused: "تطبيقات العمل متوقفة مؤقتا"; linuxApps: "تطبيقات linux"; appStore: "متجر التطبيقات"
      pin: "إضافة إلى الشاشة الرئيسية"; info: "معلومات التطبيق"; uninstall: "إلغاء التثبيت"; remove: "إزالة"; edit: "تعديل"; voice: "تعديل بالصوت"; share: "مشاركة"
      settings: "الإعدادات"; turnOn: "تفعيل"; pause: "إيقاف مؤقت"; installing: "جارٍ التثبيت…"; installLinux: "تثبيت linux"
      open: "فتح"; ask: "اسأل"; askInstallLinux: "اسأل وكيلا · ثبّت linux"; askInstallAgent: "اسأل وكيلا · ثبّت واحدا"
      askAgent: (bin, text) => "اسأل ${bin}: ${text}"
    }
    fa {
      personal: "شخصی"; work: "کاری"; apps: "برنامه‌ها"; linux: "linux"; shortcuts: "میان‌برها"; android: "android"
      workApps: "برنامه‌های کاری"; workPaused: "برنامه‌های کاری در مکث"; linuxApps: "برنامه‌های linux"; appStore: "فروشگاه برنامه"
      pin: "افزودن به صفحه اصلی"; info: "اطلاعات برنامه"; uninstall: "حذف نصب"; remove: "برداشتن"; edit: "ویرایش"; voice: "ویرایش با صدا"; share: "هم‌رسانی"
      settings: "تنظیمات"; turnOn: "روشن کردن"; pause: "مکث"; installing: "در حال نصب…"; installLinux: "نصب linux"
      open: "باز کردن"; ask: "پرسیدن"; askInstallLinux: "از عامل بپرسید · نصب linux"; askInstallAgent: "از عامل بپرسید · نصب یک عامل"
      askAgent: (bin, text) => "از ${bin} بپرسید: ${text}"
    }
  }
  source d = android.drawer
  source ag = android.agents
  // The app whose long-press menu is open, by key, and the shortcuts it offers: null while they load, and the menu
  // waits for them, so it opens whole rather than growing.
  state menu = ""
  state menuShortcuts = null
  state tab = "personal"
  // The result picked with the arrow or Tab keys, -1 for the ask row; null follows the ranking.
  state pick = null

  // As the launcher's drawer fits them: a column for every 76 dp.
  let cols = max(1, floor(((screenWidth ?? 400) - 24) / 76))
  let typed = trim(query)
  let searching = typed != ""
  let mine = d.apps.filter(a => (tab == "work") == (a.profile == "work"))
  // Each section's id keys its rows; its title is the one shown.
  let sections = tab == "work" ? [
      {id: "shortcuts", title: str.shortcuts, apps: mine.filter(a => a.kind == "shortcut")},
      {id: "work", title: d.work.paused ? str.workPaused : str.workApps, apps: mine.filter(a => a.kind == "android"), work: true}
    ] : [
      // The store first, then the apps from it, so there's always a way to get more; not while the list loads.
      {id: "apps", title: str.apps, apps: flatten([len(d.apps) > 0 ? [{store: true}] : [], mine.filter(a => a.kind == "owl")])},
      {id: "linux", title: str.linux, apps: mine.filter(a => a.kind == "linux"), linux: true},
      {id: "shortcuts", title: str.shortcuts, apps: mine.filter(a => a.kind == "shortcut")},
      {id: "android", title: str.android, apps: mine.filter(a => a.kind == "android")}
    ]
  // A title, then rows of cols apps. Without Linux, its section is an offer to install it.
  let rows = flatten(sections.filter(s => len(s.apps) > 0 || s.work || (s.linux && !linux)).map(s => flatten([
      [{key: "h:" + s.id, title: s.linux && !linux ? str.linuxApps : s.title, work: s.work, offer: s.linux && !linux}],
      chunk(s.apps, cols).map((cells, r) => {key: s.id + ":" + r, cells: cells})
    ])))
  // Every profile's apps match while typing, best first; the list runs up from the bar, so the best sits right above it.
  let hits = searching ? rank(d.apps, typed) : []
  let hitRows = chunk(hits, cols).map((cells, r) => {key: "q:" + r, start: r * cols, cells: cells})
  // Enter opens the best match when it names an app well, as the bar does; anything else, a prompt of more lines among it, goes to the agent.
  let opens = len(hits) > 0 && strongMatch(hits[0], typed)
  // What Enter acts on: a result by its place in hits, or -1 for the ask row.
  let chosen = pick ?? (opens ? 0 : -1)
  let agent = ag.default
  // With a keyboard: Up and Tab move the pick away from the bar, Down and Shift+Tab back; the ask row sits lowest.
  onKey: {
    if searching {
      pick = clamp(chosen + (value == "up" || value == "tab" ? 1 : -1), -1, len(hits) - 1)
    }
  }

  // Typing starts the pick over, at the best match.
  on typed { pick = null }

  // How much the drawer covers home: near-opaque, as home's widgets showing through make the icons hard to read.
  opacity: 0.97
  // keyboard: false (with owl: 15 in meta) leaves the keyboard down as the drawer opens, until the bar is tapped.
  enter: searching ? (chosen >= 0 ? "▸ " + str.open : "⏎ " + str.ask) : ""
  // An empty bar's Enter does nothing, as on home.
  onSubmit: {
    if searching {
      if chosen >= 0 {
        open(hits[chosen].key)
      } else if !linux {
        launcher("linux")
      } else {
        ask(value)
      }
    }
  }

  // An app's icon as the drawer draws it: its own, its silhouette on a badge with monochrome icons, or its initials.
  component AppIcon(a) {
    Box {
      size: 52
      align: topEnd
      Box {
        size: 52
        align: center
        radius: 26 * corners
        background: a.hasIcon && !d.monochrome ? transparent : surface
        if a.hasIcon {
          Image { src: a.icon; size: d.monochrome ? 36 : 52; tint: d.monochrome ? accent : null; label: a.label }
        } else {
          Text { text: a.initials; fontSize: 18; color: accent }
        }
      }
      // The notification dot, on the edge of a round icon as stock launchers draw it.
      if a.dot {
        Box { size: 12; radius: 6; offset: [-2, 2]; background: accent; border: 2; borderColor: background }
      }
    }
  }

  component Cell(a, picked) {
    Column {
      weight: 1
      align: center
      gap: 6
      padding: [4, 10]
      radius: 16 * corners
      border: picked ? 2 : 0
      borderColor: accent
      // Paused work apps show dimmed; opening one turns work apps back on.
      opacity: a.paused ? 0.4 : 1
      onTap: open(a.key)
      onLongPress: {
        haptic()
        menuShortcuts = null
        menu = a.key
        menuShortcuts = shortcuts(a.key)
      }
      AppIcon { a: a }
      // Always two lines tall, so a row keeps its height whichever apps fill it.
      Text { text: a.name; fontSize: 12; align: center; maxLines: 2; minLines: 2; fill: width }
      Popup {
        visible: menu == a.key && menuShortcuts != null
        position: above
        onDismiss: menu = ""
        width: 200
        gap: 0
        // The app's shortcuts first, as stock launchers list them: tap to open, + to put one on home.
        for s in menuShortcuts key s.key {
          Row {
            fill: width
            align: center
            gap: 10
            padding: [12, 6]
            onTap: { menu = ""; open(s.key) }
            Image { src: s.icon; size: 24; tint: d.monochrome ? accent : null; label: s.name }
            Text { text: s.name; weight: 1; maxLines: 1 }
            Text { text: "[+]"; color: accent; onTap: { menu = ""; appAction("pin", s.key) } }
          }
        }
        Spacer { visible: len(menuShortcuts) > 0; height: 1; fill: width; background: border }
        for w in a.actions {
          Text { text: get(str, w, w); fontSize: 15; fill: width; padding: [12, 12]; onTap: { menu = ""; appAction(w, a.key) } }
        }
      }
    }
  }

  // The app store, before the apps it installs: the bag in the accent on the theme's surface, as the settings button
  // draws its gear, shaped like the apps' icons.
  component StoreCell() {
    Column {
      weight: 1
      align: center
      gap: 6
      padding: [4, 10]
      radius: 16 * corners
      onTap: launcher("store:apps")
      Box {
        size: 52
        radius: 12
        background: surface
        align: center
        Image { src: bag; size: 34; tint: accent; label: str.appStore }
      }
      Text { text: str.appStore; fontSize: 12; align: center; maxLines: 2; minLines: 2; fill: width }
    }
  }

  Column {
    gap: 0
    padding: [12, 0]
    Row {
      align: center
      padding: [0, 12, 0, 8]
      gap: 0
      // Typing searches every profile, so the tabs step aside.
      for t in d.work != null && !searching ? ["personal", "work"] : [] {
        Text { text: get(str, t); color: tab == t ? accent : muted; background: tab == t ? surface : transparent; radius: 18 * corners; padding: [14, 10]; onTap: tab = t }
      }
      Spacer { weight: 1 }
      Box {
        size: 44
        radius: 22 * corners
        background: surface
        align: center
        onTap: launcher("settings")
        Image { src: gear; size: 22; tint: accent; label: str.settings }
        // System updates are waiting: settings › system updates lists them.
        Box { visible: d.updates > 0; align: topEnd; size: 44; padding: 8; Box { size: 8; radius: 4; background: red } }
      }
    }
    Column {
      visible: !searching
      lazy: true
      weight: 1
      fill: width
      gap: 0
      for row in rows key row.key {
        if row.title != null {
          // A section's title, with the work switch or the offer to install Linux at its end.
          Row {
            fill: width
            gap: 0
            align: center
            padding: [8, 12, 0, 4]
            Text { text: row.title; color: muted; weight: 1 }
            Text { text: "[" + (d.work.paused ? str.turnOn : str.pause) + "]"; visible: row.work == true; color: accent; onTap: workApps("toggle") }
            Text { text: "[" + (d.linux == "installing" ? str.installing : str.installLinux) + "]"; visible: row.offer == true; color: accent; onTap: launcher("linux") }
          }
        } else {
          Row {
            fill: width
            gap: 0
            for a in row.cells {
              if a.store == true {
                StoreCell { }
              } else {
                Cell { a: a; picked: false }
              }
            }
            // A short last row keeps its cells the width of the others'.
            for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
          }
        }
      }
    }
    Column {
      visible: searching
      lazy: true
      reverse: true
      weight: 1
      fill: width
      gap: 0
      for row in hitRows key row.key {
        Row {
          fill: width
          gap: 0
          for a, i in row.cells { Cell { a: a; picked: row.start + i == chosen } }
          for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
        }
      }
    }
    // The one line above the bar that sends what's typed to the agent; outlined when that's what Enter does.
    Row {
      visible: searching
      fill: width
      gap: 4
      padding: [12, 10]
      border: chosen == -1 ? 2 : 0
      borderColor: accent
      radius: 16 * corners
      onTap: {
        if !linux {
          launcher("linux")
        } else if agent == null {
          launcher("agents")
        } else {
          ask(typed)
        }
      }
      Text { text: "⏎"; color: chosen == -1 ? accent : muted }
      Text {
        text: !linux ? str.askInstallLinux : agent == null ? str.askInstallAgent : str.askAgent(agent.bin, typed)
        color: chosen == -1 ? foreground : muted
        maxLines: 1
        weight: 1
      }
    }
  }
}
