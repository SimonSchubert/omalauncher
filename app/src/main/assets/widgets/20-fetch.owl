widget "fetch" {
  page: 1
  order: 2
  size: 3x3
  minSize: 2x2
  meta { description: "Your phone at a glance, fastfetch style, with or without Linux: CPU, memory, storage, battery and theme, plus Arch's packages once Linux is installed. Tap it for every detail"; version: "1.11"; license: "MIT"; category: "system"; owl: 16 }

  // What it says, in the phone's language where it has a set. Words fastfetch and Linux use as names (os, host,
