fake_id0: report a peer under another PRoot of the same user with the faked ids

getsockopt(SO_PEERCRED) got the faked ids only when this PRoot traces the
peer. A launcher that starts one PRoot per window has the peer under another
one, so the tracee saw the real user id on the other end of a Unix socket
while getuid() told it 0. Hermes compares the two before it talks to its
gateway and stopped with "Gateway inaccessible: unsafe_control_peer" in
every window but the one that started the gateway. A peer that runs as the
user PRoot itself runs as now gets the ids the calling tracee has.

diff --git a/src/extension/fake_id0/getsockopt.c b/src/extension/fake_id0/getsockopt.c
index e0874b4..0a3e290 100644
--- a/src/extension/fake_id0/getsockopt.c
+++ b/src/extension/fake_id0/getsockopt.c
@@ -1,4 +1,5 @@
 #include <sys/socket.h>  /* SOL_SOCKET,SO_PEERCRED */
+#include <unistd.h>      /* getuid(2) */
 
 #include "tracee/reg.h"
 #include "tracee/mem.h"
@@ -33,7 +34,15 @@ int handle_getsockopt_exit_end(Tracee *tracee) {
 		int status = read_data(tracee, &cred, cred_addr, sizeof(struct ucred));
 		if (status) return 0;
 		Config *peer_config = get_fake_id_for_pid(cred.pid);
-		if (peer_config == NULL) return 0;
+		if (peer_config == NULL) {
+			/* Not ours to trace. A peer that runs as the user PRoot
+			 * runs as is most likely under another PRoot of the same
+			 * guest, and to this tracee it is the user the tracee
+			 * itself appears as, just like the files that user owns.  */
+			Extension *extension = get_extension(tracee, fake_id0_callback);
+			if (extension == NULL || cred.uid != getuid()) return 0;
+			peer_config = talloc_get_type_abort(extension->config, Config);
+		}
 		cred.uid = peer_config->euid;
 		cred.gid = peer_config->egid;
 		write_data(tracee, cred_addr, &cred, sizeof(struct ucred));
