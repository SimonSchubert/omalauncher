diff --git a/src/tracee/affinity.c b/src/tracee/affinity.c
new file mode 100644
index 0000000..cea062c
--- /dev/null
+++ b/src/tracee/affinity.c
@@ -0,0 +1,332 @@
+/* -*- c-set-style: "K&R"; c-basic-offset: 8 -*-
+ *
+ * This file is part of PRoot.
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ */
+
+/* Keeping the tracer and its syscall-heavy tracees on one CPU.
+ *
+ * Every intercepted syscall is a round trip: the tracee stops, the
+ * tracer wakes, handles it and resumes the tracee.  When the two run on
+ * different CPUs, each half of the trip wakes an idle CPU, and phones
+ * power idle CPUs down deeply (a 455 us exit latency on the Pixel 9a's
+ * big cores): an intercepted syscall then costs hundreds of
+ * microseconds.  On one CPU the stop hands that CPU straight to the
+ * tracer and back, ~25 us.
+ *
+ * So the tracer stays on the CPU with the highest capacity, and a
+ * tracee that keeps stopping after short runs joins it there.  A
+ * pinned tracee that stops doing so goes back to every CPU, so it
+ * neither competes with the tracer nor wakes up later to compute on the
+ * tracer's CPU: that is noticed after long runs between its stops, or
+ * by a timer when it doesn't stop at all, since most syscalls (read,
+ * write, mmap, futex...) never stop a tracee under seccomp.
+ *
+ * PROOT_HOME_CPU=<n> picks the CPU, PROOT_HOME_CPU=off disables this.
+ */
+
+#define _GNU_SOURCE
+#include <sched.h>     /* sched_*affinity, CPU_*, */
+#include <stdio.h>     /* snprintf, */
+#include <stdlib.h>    /* getenv, atoi, strtoull, */
+#include <string.h>    /* strcmp, */
+#include <fcntl.h>     /* open, */
+#include <unistd.h>    /* read, close, */
+#include <time.h>      /* clock_gettime, */
+#include <errno.h>     /* errno, */
+
+#include "tracee/affinity.h"
+#include "tracee/tracee.h"
+#include "tracee/reg.h"
+#include "tracee/mem.h"
+#include "syscall/sysnum.h"
+#include "cli/note.h"
+#include "attribute.h"
+
+/* A run between two stops shorter than this counts as syscall-heavy.  */
+#define SHORT_RUN_NS     (1000 * 1000L)
+/* How often running pinned tracees are checked.  */
+#define CHECK_INTERVAL_MS 20
+#define CHECK_INTERVAL_NS (CHECK_INTERVAL_MS * 1000 * 1000L)
+/* How often the tracer checks that it is still on its CPU.  */
+#define VERIFY_INTERVAL_NS (250 * 1000 * 1000L)
+/* Consecutive short runs before a tracee is pinned.  */
+#define SHORT_RUNS_TO_PIN 2
+/* Consecutive long runs before a pinned tracee is released.  */
+#define LONG_RUNS_TO_UNPIN 2
+
+static int home_cpu = -1;
+static cpu_set_t home_set;
+/* Every CPU of the device, not the CPUs available when proot started:
+ * the kernel limits it to what the tracee's cpuset allows at that moment,
+ * and Android changes that as the app moves between the foreground and
+ * the background.  */
+static cpu_set_t all_set;
+
+/* Whether a pinned tracee used CPU since the last check: the timer is
+ * only needed then.  */
+static bool pinned_busy = false;
+static uint64_t last_check_ns;
+
+/* Android moves an app's processes between cpusets as it goes to the
+ * background and back, which resets their affinities: the tracer then
+ * isn't on its CPU, and tracees marked pinned may not be.  */
+static bool home_lost = false;
+static uint64_t last_verify_ns;
+
+static uint64_t now_ns(void)
+{
+	struct timespec t;
+	clock_gettime(CLOCK_MONOTONIC, &t);
+	return t.tv_sec * 1000000000ULL + t.tv_nsec;
+}
+
+static ssize_t read_file(const char *path, char *buf, size_t size)
+{
+	ssize_t length;
+	int fd;
+
+	fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	length = read(fd, buf, size - 1);
+	close(fd);
+	if (length < 0)
+		return -1;
+	buf[length] = '\0';
+	return length;
+}
+
+static int read_capacity(int cpu)
+{
+	char path[80];
+	char buf[16];
+
+	snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%d/cpu_capacity", cpu);
+	return read_file(path, buf, sizeof(buf)) > 0 ? atoi(buf) : 0;
+}
+
+void affinity_init(void)
+{
+	const char *env = getenv("PROOT_HOME_CPU");
+	long cpus;
+	int cpu;
+
+	if (env != NULL && strcmp(env, "off") == 0)
+		return;
+
+	cpus = sysconf(_SC_NPROCESSORS_CONF);
+	if (cpus < 2)
+		return;
+	CPU_ZERO(&all_set);
+	for (cpu = 0; cpu < cpus && cpu < CPU_SETSIZE; cpu++)
+		CPU_SET(cpu, &all_set);
+
+	if (env != NULL) {
+		home_cpu = atoi(env);
+		if (!CPU_ISSET(home_cpu, &all_set))
+			home_cpu = -1;
+	}
+	else {
+		int best = -1;
+		for (cpu = 0; cpu < CPU_SETSIZE; cpu++) {
+			int capacity;
+			if (!CPU_ISSET(cpu, &all_set))
+				continue;
+			capacity = read_capacity(cpu);
+			if (capacity >= best) {
+				best = capacity;
+				home_cpu = cpu;
+			}
+		}
+	}
+	if (home_cpu < 0)
+		return;
+
+	CPU_ZERO(&home_set);
+	CPU_SET(home_cpu, &home_set);
+	/* Started in the background its CPU may not be available yet:
+	 * verify_home() keeps trying.  */
+	home_lost = sched_setaffinity(0, sizeof(home_set), &home_set) < 0;
+	if (getenv("PROOT_VERBOSE") != NULL)
+		note(NULL, INFO, USER, "tracer pinned to CPU %d", home_cpu);
+}
+
+static void set_pinned(Tracee *tracee, bool pinned)
+{
+	const cpu_set_t *set = pinned ? &home_set : &all_set;
+
+	/* The scheduler can leave a released tracee on this CPU for a long
+	 * while: excluding the CPU for a moment moves it now.  */
+	if (!pinned) {
+		cpu_set_t others = all_set;
+		CPU_CLR(home_cpu, &others);
+		(void) sched_setaffinity(tracee->pid, sizeof(others), &others);
+	}
+
+	if (sched_setaffinity(tracee->pid, sizeof(*set), set) < 0)
+		return;
+	tracee->affinity.pinned = pinned;
+	tracee->affinity.short_runs = 0;
+	tracee->affinity.long_runs = 0;
+	tracee->affinity.checked_ns = 0;
+	VERBOSE(tracee, 3, "pid %d: %s", tracee->pid, pinned ? "pinned" : "unpinned");
+}
+
+/* A tracee marked pinned that isn't (any more) is pinned again after
+ * its next short runs.  */
+static void verify_pin(Tracee *tracee, void *data UNUSED)
+{
+	cpu_set_t set;
+
+	if (!tracee->affinity.pinned || tracee->terminated)
+		return;
+	if (sched_getaffinity(tracee->pid, sizeof(set), &set) == 0 && CPU_EQUAL(&set, &home_set))
+		return;
+	tracee->affinity.pinned = false;
+	tracee->affinity.short_runs = 0;
+}
+
+/* Put the tracer back on its CPU if Android moved it, see home_lost,
+ * and check the tracees it moved too.  The kernel updates the tasks of
+ * a cpuset one after another, so this is checked periodically rather
+ * than once when the tracer's move is noticed.  */
+static void verify_home(Tracee *tracee, uint64_t now)
+{
+	cpu_set_t set;
+
+	if (now - last_verify_ns < VERIFY_INTERVAL_NS)
+		return;
+	last_verify_ns = now;
+
+	if (sched_getaffinity(0, sizeof(set), &set) < 0 || !CPU_EQUAL(&set, &home_set)) {
+		if (!home_lost)
+			VERBOSE(tracee, 3, "tracer moved off CPU %d", home_cpu);
+		home_lost = sched_setaffinity(0, sizeof(home_set), &home_set) < 0;
+	}
+	else
+		home_lost = false;
+
+	foreach_tracee(verify_pin, NULL);
+}
+
+void affinity_on_stop(Tracee *tracee)
+{
+	uint64_t now, run;
+
+	if (home_cpu < 0)
+		return;
+
+	now = now_ns();
+	verify_home(tracee, now);
+	if (!tracee->affinity.known) {
+		/* New tracees inherit their parent's affinity, and the
+		 * kernel may have changed it (see home_lost).  The guest
+		 * restricting it, e.g. taskset, passes to its children.  */
+		cpu_set_t set;
+		tracee->affinity.known = true;
+		tracee->affinity.pinned = sched_getaffinity(tracee->pid, sizeof(set), &set) == 0
+			&& CPU_EQUAL(&set, &home_set);
+		if (tracee->parent != NULL && tracee->parent->affinity.guest)
+			tracee->affinity.guest = true;
+		return;
+	}
+	if (tracee->affinity.resumed_ns == 0 || tracee->affinity.guest)
+		return;
+
+	run = now - tracee->affinity.resumed_ns;
+	if (run >= SHORT_RUN_NS) {
+		tracee->affinity.short_runs = 0;
+		if (tracee->affinity.pinned
+		    && ++tracee->affinity.long_runs >= LONG_RUNS_TO_UNPIN)
+			set_pinned(tracee, false);
+		return;
+	}
+
+	tracee->affinity.long_runs = 0;
+	if (!tracee->affinity.pinned && !home_lost
+	    && ++tracee->affinity.short_runs >= SHORT_RUNS_TO_PIN)
+		set_pinned(tracee, true);
+}
+
+void affinity_on_restart(Tracee *tracee)
+{
+	if (home_cpu < 0)
+		return;
+	tracee->affinity.resumed_ns = now_ns();
+	if (tracee->affinity.pinned)
+		pinned_busy = true;
+}
+
+/* The period the event loop's timer needs for affinity_check(), in
+ * milliseconds, 0 if none.  */
+long affinity_timer_ms(void)
+{
+	return pinned_busy ? CHECK_INTERVAL_MS : 0;
+}
+
+/* A pinned tracee that hasn't stopped between two checks is released,
+ * whether it computes or waits: one left pinned while it waits would
+ * compute on the tracer's CPU when it wakes, with no stop to notice it
+ * by, and no timer running as nothing pinned looks busy any more.  */
+static void check_tracee(Tracee *tracee, void *data)
+{
+	uint64_t now = *(uint64_t *) data;
+
+	if (!tracee->running || !tracee->affinity.pinned || tracee->affinity.guest || tracee->terminated)
+		return;
+
+	if (tracee->affinity.checked_ns > tracee->affinity.resumed_ns)
+		set_pinned(tracee, false);
+	else {
+		tracee->affinity.checked_ns = now;
+		pinned_busy = true;
+	}
+}
+
+void affinity_check(void)
+{
+	uint64_t now;
+
+	if (home_cpu < 0 || !pinned_busy)
+		return;
+	now = now_ns();
+	if (now - last_check_ns < CHECK_INTERVAL_NS)
+		return;
+	last_check_ns = now;
+	pinned_busy = false;
+	foreach_tracee(check_tracee, &now);
+}
+
+/* The guest sees and sets affinities as if nothing were pinned: a pinned
+ * thread reports every CPU (nproc, make -j, thread pools), and a thread
+ * whose affinity the guest set is left alone from then on.  */
+void affinity_translate_exit(Tracee *tracee, word_t sysnum, word_t result)
+{
+	pid_t pid;
+	Tracee *target;
+
+	if (home_cpu < 0 || (long) result < 0)
+		return;
+
+	pid = (pid_t) peek_reg(tracee, ORIGINAL, SYSARG_1);
+	target = pid == 0 ? tracee : get_tracee(tracee, pid, false);
+	if (target == NULL)
+		return;
+
+	if (sysnum == PR_sched_setaffinity) {
+		target->affinity.known = true;
+		target->affinity.guest = true;
+		target->affinity.pinned = false;
+		return;
+	}
+
+	if (target->affinity.pinned && result > 0) {
+		size_t size = (size_t) result < sizeof(all_set) ? (size_t) result : sizeof(all_set);
+		(void) write_data(tracee, peek_reg(tracee, ORIGINAL, SYSARG_3), &all_set, size);
+	}
+}
